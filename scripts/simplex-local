#!/usr/bin/env bash
# Native macOS/Linux phone trial, without a container or the devfinity stack.
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
simplex_store="$(nix build "$repo_root#simplex-chat" --no-link --print-out-paths)"
hermes_store="$(nix build "$repo_root#hermes-agent" --no-link --print-out-paths)"
python_store="$(nix build "$repo_root#hermes-agent-runtime-python" --no-link --print-out-paths)"
export PATH="$hermes_store/bin:$simplex_store/bin:$python_store/bin:$PATH"
export HERMES_BUNDLED_PLUGINS="$hermes_store/share/hermes-agent/plugins"
export FINITE_SIMPLEX_LOCAL_HOME="${FINITE_SIMPLEX_LOCAL_HOME:-$HOME/.finite-simplex-test}"
exec "$python_store/bin/python3" "$repo_root/finite-agentd/simplex_local.py" "${@:-run}"
