#!/usr/bin/env python3
"""Restart one process in the default devfinity process-compose stack."""

from __future__ import annotations

import argparse
import re
import shlex
import stat
import subprocess
import sys
from collections.abc import Callable
from pathlib import Path

EX_USAGE = 64
EX_DATAERR = 65
EX_UNAVAILABLE = 69

PROCESS_KEY = re.compile(r"^  ([A-Za-z0-9_.-]+):(?:\s*(?:#.*)?)?$")


class RestartError(Exception):
    def __init__(self, message: str, exit_code: int) -> None:
        super().__init__(message)
        self.exit_code = exit_code


def script_repo_root() -> Path:
    return Path(__file__).resolve().parents[1]


def load_devfinity_env(env_file: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for line_number, line in enumerate(env_file.read_text(encoding="utf-8").splitlines(), 1):
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        try:
            fields = shlex.split(stripped, posix=True)
        except ValueError as error:
            raise RestartError(
                f"{env_file}:{line_number}: cannot parse devfinity env line: {error}",
                EX_DATAERR,
            ) from error
        if len(fields) != 2 or fields[0] != "export" or "=" not in fields[1]:
            raise RestartError(
                f"{env_file}:{line_number}: unsupported devfinity env line",
                EX_DATAERR,
            )
        key, value = fields[1].split("=", 1)
        values[key] = value
    return values


def required_env_path(values: dict[str, str], name: str, env_file: Path) -> Path:
    value = values.get(name, "")
    if not value:
        raise RestartError(
            f"default devfinity run env {env_file} is missing {name}; rerun `just dev up`",
            EX_DATAERR,
        )
    return Path(value)


def generated_process_names(process_compose_file: Path) -> list[str]:
    names: list[str] = []
    in_processes = False
    for line in process_compose_file.read_text(encoding="utf-8").splitlines():
        if not in_processes:
            if line.strip() == "processes:":
                in_processes = True
            continue

        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if not line.startswith(" "):
            break
        match = PROCESS_KEY.match(line)
        if match:
            names.append(match.group(1))
    return names


def ensure_default_run_files(repo_root: Path) -> tuple[Path, Path]:
    env_file = repo_root / ".local-state/devfinity/runs/default/env"
    if not env_file.is_file():
        raise RestartError(
            f"devfinity is not running: default run env is missing at {env_file}; start it with `just dev up`",
            EX_UNAVAILABLE,
        )

    values = load_devfinity_env(env_file)
    process_compose_file = required_env_path(
        values, "DEVFINITY_PROCESS_COMPOSE_FILE", env_file
    )
    process_compose_socket = required_env_path(
        values, "DEVFINITY_PROCESS_COMPOSE_SOCKET", env_file
    )

    if not process_compose_file.is_file():
        raise RestartError(
            "devfinity is not running: generated process-compose YAML is missing "
            f"at {process_compose_file}; restart devfinity with `just dev up`",
            EX_UNAVAILABLE,
        )

    try:
        socket_mode = process_compose_socket.stat().st_mode
    except FileNotFoundError as error:
        raise RestartError(
            f"devfinity is not running: process-compose socket is missing at {process_compose_socket}",
            EX_UNAVAILABLE,
        ) from error
    if not stat.S_ISSOCK(socket_mode):
        raise RestartError(
            f"devfinity process-compose control path is not a Unix socket: {process_compose_socket}",
            EX_UNAVAILABLE,
        )

    return process_compose_file, process_compose_socket


def run_process_compose(argv: list[str], cwd: Path) -> int:
    return subprocess.call(argv, cwd=cwd)


def restart_process(
    process: str,
    *,
    repo_root: Path,
    runner: Callable[[list[str], Path], int],
) -> int:
    process_compose_file, process_compose_socket = ensure_default_run_files(repo_root)
    process_names = generated_process_names(process_compose_file)
    if process not in process_names:
        suffix = ""
        if process_names:
            suffix = f"\nknown processes: {', '.join(process_names)}"
        raise RestartError(
            f"unknown devfinity process `{process}` in {process_compose_file}{suffix}",
            EX_DATAERR,
        )

    return runner(
        [
            "process-compose",
            "-U",
            "-u",
            str(process_compose_socket),
            "process",
            "restart",
            process,
        ],
        repo_root,
    )


def parse_args(argv: list[str] | None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Restart one process in the default devfinity stack."
    )
    parser.add_argument("process", help="process name from the generated process-compose YAML")
    return parser.parse_args(argv)


def main(
    argv: list[str] | None = None,
    *,
    repo_root: Path | None = None,
    runner: Callable[[list[str], Path], int] = run_process_compose,
) -> int:
    args = parse_args(argv)
    process = args.process.strip()
    if not process:
        print("devfinity restart: process name cannot be empty", file=sys.stderr)
        return EX_USAGE
    try:
        return restart_process(
            process,
            repo_root=repo_root or script_repo_root(),
            runner=runner,
        )
    except RestartError as error:
        print(f"devfinity restart: {error}", file=sys.stderr)
        return error.exit_code


if __name__ == "__main__":
    sys.exit(main())
