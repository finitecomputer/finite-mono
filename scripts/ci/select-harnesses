@dataclass
class HarnessSelection:
    run_rust: bool = False
    run_dashboard: bool = False
    run_dashboard_browser: bool = False
    run_commercial: bool = False
    run_hermes_bridge: bool = False
    run_nix_checks: bool = False
    run_skills_check: bool = False
    run_monitoring_nixos_contract: bool = False
    run_finite_status_contract: bool = False
    run_nix_service_packages: bool = False
    run_devfinity_smoke: bool = False
    run_brain_product_matrix: bool = False

    def select_all(self) -> None:
        for field in fields(self):
            setattr(self, field.name, True)

    def values(self) -> dict[str, str]:
        return {
            name: "true" if getattr(self, name) else "false"
            for name in OUTPUT_NAMES
        }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--event", default=os.environ.get("GITHUB_EVENT_NAME", ""))
    parser.add_argument("--base", default=os.environ.get("PR_BASE_SHA"))
    parser.add_argument("--head", default=os.environ.get("PR_HEAD_SHA"))
    parser.add_argument("--push-base", default=os.environ.get("PUSH_BEFORE_SHA"))
    parser.add_argument("--push-head", default=os.environ.get("PUSH_HEAD_SHA") or os.environ.get("GITHUB_SHA"))
    parser.add_argument("--github-output")
    parser.add_argument("--summary")
    changed_paths.add_changed_file_argument(parser)
    args = parser.parse_args()

    selection, reason, paths = select_harnesses(args)
    write_outputs(args.github_output, selection)
    write_summary(args.summary, selection, reason, paths)

    print(f"CI harness selection: {reason}")
    for name, value in selection.values().items():
        print(f"{name}={value}")

    return 0


def select_harnesses(args: argparse.Namespace) -> tuple[HarnessSelection, str, list[str]]:
    if args.changed_files is not None:
        paths = changed_paths.normalized_paths(args.changed_files)
        selection = select_for_paths(paths)
        reason = "changed-file override"
        note = apply_pull_request_packaging_gate(args.event, selection, paths)
        if note:
            reason = f"{reason}; {note}"
        return selection, reason, paths

    if args.event == "merge_group":
        selection = HarnessSelection()
        selection.select_all()
        return selection, "merge queue runs every required harness", []

    try:
        paths = changed_files_for_event(args)
    except subprocess.CalledProcessError as error:
        print(f"failed to compute changed files; selecting every harness: {error}", file=sys.stderr)
        selection = HarnessSelection()
        selection.select_all()
        # Conservative fallback: the changed path set is unknown, so packaging
        # stays selected.
        return selection, "could not compute changed files", []

    selection = select_for_paths(paths)
    reason = "selected from changed paths"
    note = apply_pull_request_packaging_gate(args.event, selection, paths)
    if note:
        reason = f"{reason}; {note}"
    return selection, reason, paths


def is_package_graph_path(path: str) -> bool:
    """Whether the path changes the nix service package derivations.

    These are the inputs that make a PR-time package build the difference
    between substituting warm cargoArtifacts from Cachix and paying the cold
    ~30-minute crane build inside devfinity-smoke:

    - Workspace manifests: crane's mkDummySrc scopes every mkCargoArtifacts
      to the member Cargo.toml files and the root Cargo.lock (cargoVendorDir
      also derives from the lock).
    - rust-toolchain.toml: the single Rust pin, read by the flake via
      fromRustupToolchainFile, part of every cargoArtifacts derivation.
    - .cargo/ config: cargo invocation settings for those artifact builds.
    - flake.nix / flake.lock: crane args, toolchain overlay, and inputs.
    - infra/nixos/: the packaged closures themselves (packages.nix and the
      NixOS modules) - the thing this job exists to validate.

    Everything else (Rust source, protos, SQL, docs) only affects thin final
    package derivations, which devfinity-smoke builds locally against warm
    cargoArtifacts.
    """
    return (
        path == "Cargo.lock"
        or path == "Cargo.toml"
        or path.endswith("/Cargo.toml")
        or path == "rust-toolchain.toml"
        or path.startswith(".cargo/")
        or path in ("flake.nix", "flake.lock")
        or path.startswith("infra/nixos/")
    )


def apply_pull_request_packaging_gate(
    event: str, selection: HarnessSelection, paths: list[str]
) -> str | None:
    if event != "pull_request":
        return None
    if not selection.run_nix_service_packages:
        return None
    if any(is_package_graph_path(path) for path in paths):
        return None
    selection.run_nix_service_packages = False
    return "nix service packages deferred to landing events"


def changed_files_for_event(args: argparse.Namespace) -> list[str]:
    if args.event == "pull_request":
        if not args.base or not args.head:
            raise subprocess.CalledProcessError(2, ["git", "diff"], "missing pull request base or head")
        diff_range = f"{args.base}...{args.head}"
    elif args.event == "push":
        if not args.push_base or set(args.push_base) == {"0"} or not args.push_head:
            raise subprocess.CalledProcessError(2, ["git", "diff"], "missing usable push base or head")
        diff_range = f"{args.push_base}..{args.push_head}"
    else:
        raise subprocess.CalledProcessError(2, ["git", "diff"], f"unsupported event: {args.event}")

    return changed_paths.normalized_paths(changed_paths.git_diff_changed_files(diff_range))


def select_for_paths(paths: list[str]) -> HarnessSelection:
    selection = HarnessSelection()
    for path in paths:
        apply_path(selection, path)
    apply_harness_dependencies(selection)
    return selection


def apply_harness_dependencies(selection: HarnessSelection) -> None:
    if selection.run_devfinity_smoke or selection.run_brain_product_matrix:
        selection.run_nix_service_packages = True


def apply_path(selection: HarnessSelection, path: str) -> None:
    if not path:
        return

    if is_global_path(path):
        selection.select_all()
        return

    if path == INFRA_JUSTFILE_PATH:
        selection.run_finite_status_contract = True
        selection.run_nix_checks = True
        return

    if path == FINITE_BRAIN_JUSTFILE_PATH:
        selection.run_brain_product_matrix = True
        selection.run_nix_checks = True
        return

    if path == FINITECHAT_JUSTFILE_PATH:
        selection.run_hermes_bridge = True
        selection.run_rust = True
        return

    if path == FINITE_IDENTITY_JUSTFILE_PATH:
        selection.run_nix_checks = True
        return

    if path == DASHBOARD_JUSTFILE_PATH:
        selection.run_dashboard = True
        selection.run_nix_checks = True
        return

    if path in NIX_CHECK_JUSTFILE_PATHS:
        selection.run_nix_checks = True
        return

    if is_monitoring_path(path) or path in MOVED_MONITORING_PATHS:
        apply_monitoring_path(selection, path)
        return

    if path in MONITORING_NIXOS_PATHS:
        apply_monitoring_path(selection, path)
        selection.run_nix_checks = True
        selection.run_nix_service_packages = True
        return

    if is_finite_skills_executable_doc(path):
        selection.run_skills_check = True
        return

    # Runbooks are fact-checked against their in-repo authorities by the
    # runbook-facts contract in the nix-checks job.
    if path.startswith("infra/runbooks/"):
        selection.run_nix_checks = True
        return

    if is_docs_only_path(path):
        return

    if path.startswith(WORKFLOW_PREFIX):
        selection.run_nix_checks = True
        return

    if (
        path.startswith(RUNTIME_IMAGE_CONTRACT_PREFIX)
        or path.startswith(IDENTITY_EDGE_CONTRACT_PREFIX)
        or path in MOVED_NIX_CHECK_PATHS
    ):
        selection.run_nix_checks = True
        return

    if path in FINITE_STATUS_PATHS:
        selection.run_finite_status_contract = True
        return

    if path in STRIPE_PRICE_CONTRACT_PATHS:
        selection.run_nix_checks = True
        return

    if path.startswith("finite-skills/"):
        selection.run_skills_check = True
        return

    if path.startswith("commercial-register/"):
        selection.run_commercial = True
        return

    if path.startswith("finitecomputer-v2/apps/dashboard/"):
        selection.run_dashboard = True
        if is_dashboard_browser_path(path):
            selection.run_dashboard_browser = True
        return

    if path.startswith("finitechat/packages/finitechat-chat-ui/"):
        selection.run_dashboard = True
        selection.run_dashboard_browser = True
        return

    if path in REMAINING_NIX_CHECK_PATHS:
        selection.run_nix_checks = True
        return

    if path.startswith("infra/nixos/"):
        selection.run_nix_checks = True
        selection.run_nix_service_packages = True
        return

    selection.select_all()


def is_global_path(path: str) -> bool:
    return (
        path in GLOBAL_EXACT_PATHS
        or path.startswith(GLOBAL_PREFIXES)
        or path.endswith(GLOBAL_SUFFIXES)
    )


def is_monitoring_path(path: str) -> bool:
    return path.startswith(MONITORING_PREFIX)


def apply_monitoring_path(selection: HarnessSelection, path: str) -> None:
    selection.run_monitoring_nixos_contract = True
    if path in RUNTIME_METRICS_SOURCE_PATHS:
        selection.run_finite_status_contract = True
        selection.run_nix_checks = True


def is_finite_skills_executable_doc(path: str) -> bool:
    return path.startswith("finite-skills/") and path.endswith("/SKILL.md")


def is_docs_only_path(path: str) -> bool:
    return path.endswith(".md") and not path.endswith("/SKILL.md") and path != "SKILL.md"


def is_dashboard_browser_path(path: str) -> bool:
    relative = path.removeprefix("finitecomputer-v2/apps/dashboard/")
    if relative.startswith("src/lib/"):
        return False
    return relative.startswith(
        (
            "browser/",
            "components/",
            "public/",
            "src/app/",
            "src/components/",
            "src/hooks/",
            "src/styles/",
        )
    ) or relative == "src/proxy.ts"


def write_outputs(path: str | None, selection: HarnessSelection) -> None:
    if not path:
        return
    with open(path, "a", encoding="utf-8") as stream:
        for key, value in selection.values().items():
            stream.write(f"{key}={value}\n")


def write_summary(path: str | None, selection: HarnessSelection, reason: str, paths: list[str]) -> None:
    if not path:
        return
    selected = [name.removeprefix("run_") for name, value in selection.values().items() if value == "true"]
    with open(path, "a", encoding="utf-8") as stream:
        stream.write("### CI harness selection\n\n")
        stream.write(f"- Reason: {reason}\n")
        stream.write(f"- Selected: `{', '.join(selected) if selected else 'none'}`\n")
        if paths:
            stream.write("- Changed paths:\n")
            for changed_path in paths:
                stream.write(f"  - `{changed_path}`\n")


if __name__ == "__main__":
    raise SystemExit(main())
