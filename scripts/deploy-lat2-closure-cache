#!/usr/bin/env bash
# Activate an exact CI-built finite-lat-2 closure without building on a
# production host. finite-lat-2 is the emergency replacement APP-PLANE host
# (ADR 0007) and deliberately runs no Agent Runner: there is no runner timer
# or worker unit to fence here.
#
# Two rollout shapes exist:
#   - go-live (Gate E): the first activation of product units out of import
#     mode. Pass --expect-startup; the dry-activation fence then allows
#     exactly the declared app-plane unit set to start and requires the
#     product health checks to pass after the switch.
#   - steady state (post go-live): ordinary deploys. The fence allows only
#     the declared app-plane unit set plus explicitly approved extras;
#     anything else named by dry activation refuses the rollout.
set -euo pipefail

LAT2="${FINITE_LAT2_TARGET:-root@64.34.80.19}"
mode="prepare"
mode_seen=0
expect_startup=0
artifact_dir=""
approved_extra_units=()

# The declared app-plane unit set: exactly the units the import-mode gate
# holds down (infra/nixos/hosts/finite-lat-2/default.nix). A dry activation
# may only name these, plus extras approved with --allow-unit.
expected_app_plane_units=(
  caddy.service
  finite-saas-core.service
  finitechat-server.service
  finitechat-hosted-device.service
  finite-saas-sites.service
  finite-brain-app.service
  finite-identity.service
  podman-finite-saas-dashboard.service
  finite-healthcheck.service
  finite-healthcheck.timer
  finite-postgres-backup.service
  finite-postgres-backup.timer
  finite-litestream-finite-chat-server.service
  finite-litestream-finite-brain.service
  finite-litestream-health.service
  finite-litestream-health.timer
  finite-hosted-web-chat-snapshot.service
  finite-hosted-web-chat-snapshot-health.service
  finite-hosted-web-chat-snapshot-health.timer
  finite-identity-backup.service
  finite-identity-backup-health.service
  finite-identity-backup-health.timer
  borgbackup-job-finite-hosted-web-chat-offsite.service
  finite-hosted-web-chat-offsite-health.service
  finite-hosted-web-chat-offsite-health.timer
  finite-runtime-metrics.service
  finite-runtime-metrics.timer
)

usage() {
  echo "usage: $0 [--validate-only|--prepare|--activate] [--expect-startup] [--allow-unit UNIT]... <lat2-closure-artifact-dir>" >&2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --validate-only|--prepare|--activate)
      if [[ "$mode_seen" == 1 ]]; then
        echo "choose exactly one rollout mode" >&2
        usage
        exit 64
      fi
      mode_seen=1
      case "$1" in
        --validate-only) mode="validate" ;;
        --prepare) mode="prepare" ;;
        --activate) mode="activate" ;;
      esac
      ;;
    --expect-startup)
      expect_startup=1
      ;;
    --allow-unit)
      shift
      if [[ $# -eq 0 || ! "$1" =~ ^[A-Za-z0-9@_.-]+\.(service|socket|timer|mount|target)$ ]]; then
        echo "invalid explicitly approved unit" >&2
        usage
        exit 64
      fi
      approved_extra_units+=("$1")
      ;;
    -*) usage; exit 64 ;;
    *)
      if [[ -n "$artifact_dir" ]]; then
        usage
        exit 64
      fi
      artifact_dir="$1"
      ;;
  esac
  shift
done

if [[ -z "$artifact_dir" ]]; then
  usage
  exit 64
fi

if [[ ! -d "$artifact_dir" ]]; then
  echo "artifact directory does not exist: $artifact_dir" >&2
  exit 66
fi
artifact_dir="$(cd "$artifact_dir" && pwd -P)"
manifest="$artifact_dir/manifest.json"
if [[ ! -f "$manifest" ]]; then
  echo "artifact manifest is missing: $manifest" >&2
  exit 66
fi

manifest_values_file="$(mktemp "${TMPDIR:-/tmp}/lat2-closure-manifest.XXXXXX")"
dry_output_file="$(mktemp "${TMPDIR:-/tmp}/lat2-dry-activate.XXXXXX")"
trap 'rm -f "$manifest_values_file" "$dry_output_file"' EXIT
python3 - "$manifest" > "$manifest_values_file" <<'PY'
import json
import re
import sys

with open(sys.argv[1], encoding="utf-8") as fh:
    data = json.load(fh)

if data.get("schema") != "finite.lat2.nixos-closure.v2":
    raise SystemExit(f"unexpected manifest schema: {data.get('schema')!r}")
if data.get("host") != "finite-lat-2":
    raise SystemExit(f"unexpected manifest host: {data.get('host')!r}")
if data.get("repository") != "finitecomputer/finite-mono":
    raise SystemExit(f"unexpected repository: {data.get('repository')!r}")

rev = data.get("rev")
system = data.get("system")
disko = data.get("disko")
kexec = data.get("kexec")
cache = data.get("cache")
if not isinstance(rev, str) or not re.fullmatch(r"[0-9a-f]{40}", rev):
    raise SystemExit(f"invalid rev: {rev!r}")
if not isinstance(system, str) or not re.fullmatch(
    r"/nix/store/[0-9a-z]{32}-nixos-system-finite-lat-2-[^/\s]+", system
):
    raise SystemExit(f"invalid system path: {system!r}")
if not isinstance(disko, str) or not re.fullmatch(r"/nix/store/[0-9a-z]{32}-disko", disko):
    raise SystemExit(f"invalid disko path: {disko!r}")
if not isinstance(kexec, str) or not re.fullmatch(r"/nix/store/[0-9a-z]{32}-kexec-tarball", kexec):
    raise SystemExit(f"invalid kexec path: {kexec!r}")
if cache != "nix-cache":
    raise SystemExit(f"invalid cache directory: {cache!r}")

print(rev)
print(system)
print(disko)
print(kexec)
print(cache)
PY

REV="$(sed -n '1p' "$manifest_values_file")"
SYSTEM="$(sed -n '2p' "$manifest_values_file")"
DISKO="$(sed -n '3p' "$manifest_values_file")"
KEXEC="$(sed -n '4p' "$manifest_values_file")"
CACHE_REL="$(sed -n '5p' "$manifest_values_file")"
CACHE_DIR="$artifact_dir/$CACHE_REL"

if [[ ! -d "$CACHE_DIR" || ! -f "$CACHE_DIR/nix-cache-info" ]]; then
  echo "artifact cache is missing or incomplete: $CACHE_DIR" >&2
  exit 66
fi

git fetch origin --prune
git merge-base --is-ancestor "$REV" origin/main || {
  echo "refusing: $REV is not on origin/main" >&2
  exit 65
}

echo "==> validated finite-lat-2 closure artifact"
echo "    rev=$REV"
echo "    system=$SYSTEM"
echo "    disko=$DISKO"
echo "    kexec=$KEXEC"
if [[ "$expect_startup" == 1 ]]; then
  echo "    mode=go-live (import-mode -> product startup expected)"
fi
if [[ ${#approved_extra_units[@]} -gt 0 ]]; then
  printf '    explicitly-approved-unit=%s\n' "${approved_extra_units[@]}"
fi
if [[ "$mode" == "validate" ]]; then
  exit 0
fi

echo "==> verifying lat2 host-local monitoring secrets"
ssh -o BatchMode=yes "$LAT2" 'bash -s' \
  < infra/nixos/scripts/check-lat-monitoring-secrets

echo "==> copying the prebuilt closure to finite-lat-2"
nix copy --no-check-sigs --option builders '' \
  --from "file://$CACHE_DIR" \
  --to "ssh-ng://$LAT2" \
  "$SYSTEM"

echo "==> dry-activating the candidate closure"
ssh -o BatchMode=yes "$LAT2" \
  "$SYSTEM/bin/switch-to-configuration" dry-activate \
  >"$dry_output_file" 2>&1
cat "$dry_output_file"

# App-plane fence: a rollout may only touch the declared app-plane unit set
# (units starting for the first time at go-live, or ordinary restarts in
# steady state). Anything else needs an explicit --allow-unit for this
# attempt; the default remains fail closed.
unexpected_units=""
while IFS= read -r unit; do
  approved=0
  for expected_unit in "${expected_app_plane_units[@]}"; do
    if [[ "$unit" == "$expected_unit" ]]; then
      approved=1
      break
    fi
  done
  if [[ "$approved" == 0 ]]; then
    for approved_unit in ${approved_extra_units[@]+"${approved_extra_units[@]}"}; do
      if [[ "$unit" == "$approved_unit" ]]; then
        approved=1
        break
      fi
    done
  fi
  if [[ "$approved" == 0 ]]; then
    unexpected_units+="${unit}"$'\n'
  fi
done < <({
  grep -Eo '[A-Za-z0-9@_.-]+\.(service|socket|timer|mount|target)' "$dry_output_file" || true
} | sort -u)
unexpected_units="${unexpected_units%$'\n'}"
if [[ -n "$unexpected_units" ]]; then
  echo "refusing app-plane rollout: dry activation names units outside the" >&2
  echo "declared app-plane set:" >&2
  printf '%s\n' "$unexpected_units" >&2
  exit 75
fi

if [[ "$mode" == "prepare" ]]; then
  echo "==> PREPARED rev=$REV (no activation performed)"
  exit 0
fi

echo "==> activating the fenced app-plane closure"
# shellcheck disable=SC2034
ssh -o BatchMode=yes "$LAT2" bash -s -- "$SYSTEM" "$expect_startup" "${approved_extra_units[@]+"${approved_extra_units[@]}"}" <<'LAT2'
set -euo pipefail
system="$1"
expect_startup="$2"
shift 2
approved_units=("${@-}")
[[ "$system" =~ ^/nix/store/[0-9a-z]{32}-nixos-system-finite-lat-2-[^/[:space:]]+$ ]] || exit 64
test -x "$system/bin/switch-to-configuration"
nix-store --check-validity "$system" >/dev/null

previous_system="$(readlink -f /run/current-system)"
previous_profile="$(readlink -f /nix/var/nix/profiles/system)"
if [[ "$previous_system" != "$previous_profile" ]]; then
  echo "refusing: current system and system profile already differ" >&2
  exit 73
fi

# This host runs no Agent Runner by design (ADR 0007). Refuse when a runner
# is LIVE on this host, or when the CANDIDATE closure would bring one. An
# inert never-startable husk unit in the OUTGOING closure is explicitly
# crossable: the 2026-08-29 finite-identity husk bug (#751) left exactly
# that behind, and /etc/systemd/system resolves into the running closure's
# read-only store path — so switching to a runner-free closure is the ONLY
# way such a leftover can ever be removed.
if systemctl is-active --quiet finite-saas-runner.service; then
  echo "refusing: finite-saas-runner.service is active on the app-plane host" >&2
  exit 74
fi
if ls "$system/etc/systemd/system/" | grep -qx "finite-saas-runner.service"; then
  echo "refusing: candidate closure contains finite-saas-runner.service" >&2
  exit 74
fi
if ls "$system/etc/systemd/system/" | grep -qx "finite-saas-runner-phala.service"; then
  echo "refusing: candidate closure contains finite-saas-runner-phala.service" >&2
  exit 74
fi

# Pre-mutation health gate. Steady state: the core product units must be
# active BEFORE crossing the boundary — a steady-state deploy never runs
# with the product down. Only --expect-startup permits down-before (the one
# import-mode -> product startup at go-live).
if [[ "$expect_startup" != "1" ]]; then
  for unit in finite-saas-core.service finitechat-server.service caddy.service postgresql.service; do
    systemctl is-active --quiet "$unit" || {
      echo "refusing steady-state switch: $unit is down before the mutation boundary" >&2
      exit 1
    }
  done
fi

containerd_pid="$(systemctl show containerd.service --property=MainPID --value)"
networkd_pid="$(systemctl show systemd-networkd.service --property=MainPID --value)"

# --- activation helpers (begin) ---------------------------------------------
# Monitoring-only units: read-only probes and metric publishers. Per
# infra/runbooks/platform-rollout.md a monitoring-only failure is NOT a
# rollback trigger; a failed core/chat unit is. 2026-09-02 (#799):
# finite-healthcheck.timer fired while app-plane units were mid-restart, its
# oneshot failed, switch-to-configuration exited nonzero, and the ERR trap
# reverted a chat binary whose one-time op-log fold had already completed —
# the forbidden old-binary/folded-database edge. So the timers are held
# across the boundary and the trap judges the failed unit set instead of
# the exit status alone.
monitoring_only_timers=(
  finite-healthcheck.timer
  finite-litestream-health.timer
  finite-hosted-web-chat-snapshot-health.timer
  finite-identity-backup-health.timer
  finite-hosted-web-chat-offsite-health.timer
  finite-runtime-metrics.timer
  finite-storage-health.timer
)
is_monitoring_only_unit() {
  local unit="$1" timer
  for timer in "${monitoring_only_timers[@]}"; do
    if [[ "$unit" == "$timer" || "$unit" == "${timer%.timer}.service" ]]; then
      return 0
    fi
  done
  return 1
}
failed_units() {
  systemctl --failed --plain --no-legend --no-pager | awk 'NF { print $1 }'
}
# Failed units that are NOT monitoring-only, one per line.
failed_units_outside_monitoring() {
  local unit
  while IFS= read -r unit; do
    is_monitoring_only_unit "$unit" || printf '%s\n' "$unit"
  done < <(failed_units)
}
# `systemctl mask` refuses store-symlinked units; stop suffices. Only timers
# present in the running closure are touched (/etc/systemd/system resolves
# into it), so a timer the candidate adds or drops is never an error.
stop_monitoring_timers() {
  local timer
  for timer in "${monitoring_only_timers[@]}"; do
    [[ -e "/etc/systemd/system/$timer" ]] || continue
    systemctl stop "$timer" || echo "warning: could not stop $timer before the boundary" >&2
  done
}
start_monitoring_timers() {
  local timer
  echo "==> re-arming monitoring timers on $(readlink -f /run/current-system)"
  for timer in "${monitoring_only_timers[@]}"; do
    [[ -e "/etc/systemd/system/$timer" ]] || continue
    systemctl start "$timer" || echo "warning: could not re-arm $timer after activation" >&2
  done
}
# Chat fold guard. The candidate closure's own unit file names the binary
# and the SQLite path; that binary's read-only `rollback-check` exits 0 only
# when restoring the pre-fold backup is still safe (every failure to open or
# read the database refuses). The trap may revert the binary only on that
# POSITIVE verdict: exit 0 AND "rollback_allowed":true in the printed JSON.
# Anything else — nonzero exit, unparseable output, missing binary or
# database, timeout — forbids the revert: an older binary must never serve a
# database whose fold state is unknown. A candidate closure that ships no
# chat unit is the one case the guard does not apply to.
chat_unit_file="$system/etc/systemd/system/finitechat-server.service"
chat_fold_reason=""
chat_fold_guard_applies() {
  [[ -e "$chat_unit_file" ]]
}
# Returns 0 exactly when reverting the binary is forbidden.
chat_fold_forbids_rollback() {
  local exec_start binary sqlite verdict check_status reason
  if ! chat_fold_guard_applies; then
    chat_fold_reason="candidate closure ships no finitechat-server unit; guard not applicable"
    return 1
  fi
  exec_start="$(sed -n 's/^ExecStart=//p' "$chat_unit_file" | head -n 1)"
  binary="${exec_start%% *}"
  sqlite="$(printf '%s\n' "$exec_start" | sed -n 's/.*--sqlite \([^ ]*\).*/\1/p')"
  if [[ ! -x "$binary" || -z "$sqlite" || ! -e "$sqlite" ]]; then
    chat_fold_reason="rollback-check unavailable (binary=${binary:-?} sqlite=${sqlite:-?}); fold state unknown"
    return 0
  fi
  check_status=0
  verdict="$(timeout 60 "$binary" rollback-check --sqlite "$sqlite" 2>/dev/null)" || check_status=$?
  reason="$(printf '%s\n' "$verdict" | sed -n 's/.*"reason":"\([^"]*\)".*/\1/p')"
  if [[ "$check_status" != 0 ]]; then
    chat_fold_reason="rollback-check exited $check_status (${reason:-no verdict printed})"
    return 0
  fi
  if [[ "$verdict" != *'"rollback_allowed":true'* ]]; then
    chat_fold_reason="rollback-check exited 0 without a parseable rollback_allowed:true verdict (${verdict:-no output})"
    return 0
  fi
  chat_fold_reason="rollback-check exit 0, rollback_allowed:true (${reason:-no reason given})"
  return 1
}
# A post-switch verification failure must reach the ERR trap (a bare `exit 1`
# inside `|| { ...; }` never did): the failing command after the final `||`
# fires it.
abort() {
  echo "$*" >&2
  return 1
}
# --- activation helpers (end) -----------------------------------------------

# Pre-boundary: a non-monitoring unit that is ALREADY failed would be
# indistinguishable, after the switch, from one this activation broke.
pre_failed="$(failed_units_outside_monitoring)"
if [[ -n "$pre_failed" ]]; then
  echo "refusing: non-monitoring units are already failed before the mutation boundary" >&2
  echo "(investigate, then systemctl reset-failed):" >&2
  printf '%s\n' "$pre_failed" >&2
  exit 1
fi

if ! chat_fold_guard_applies; then
  echo "==> chat fold guard: candidate closure ships no finitechat-server unit; guard not applicable"
elif chat_fold_forbids_rollback; then
  echo "==> chat fold guard: rollback-check FORBIDS reverting the binary ($chat_fold_reason);"
  echo "    a failed activation will ROLL FORWARD ONLY"
else
  echo "==> chat fold guard: positive safe verdict for now ($chat_fold_reason);"
  echo "    re-checked at rollback time, because the switch itself may fold the database"
fi

rollback() {
  status=$?
  trap - ERR
  if chat_fold_forbids_rollback; then
    echo "activation failed (exit $status) but REFUSING to revert to $previous_system:" >&2
    echo "finitechat-server rollback-check gave no positive safe verdict ($chat_fold_reason)." >&2
    echo "An older binary must never serve a chat database whose fold state is not proven safe;" >&2
    echo "ROLL FORWARD ONLY: $system stays in place — fix and activate a newer closure." >&2
    exit "$status"
  fi
  echo "activation failed; rolling back to $previous_system" >&2
  nix-env --option builders '' --profile /nix/var/nix/profiles/system --set "$previous_system" || true
  "$previous_system/bin/switch-to-configuration" switch || true
  exit "$status"
}
trap rollback ERR

echo "==> mutation boundary: switching finite-lat-2 to $system"
echo "==> holding monitoring timers across the boundary: ${monitoring_only_timers[*]}"
stop_monitoring_timers
# Re-armed on EVERY exit: success, the ERR-trap rollback, and the
# roll-forward refusal (each runs after the profile is where it will stay).
trap start_monitoring_timers EXIT
nix-env --option builders '' --profile /nix/var/nix/profiles/system --set "$system"
switch_status=0
"$system/bin/switch-to-configuration" switch || switch_status=$?
if [[ "$switch_status" != 0 ]]; then
  failed_outside="$(failed_units_outside_monitoring)"
  failed_all="$(failed_units | tr '\n' ' ')"
  if [[ -n "$failed_outside" || -z "$failed_all" ]]; then
    echo "switch-to-configuration exited $switch_status; failed units outside the monitoring-only allow-list:" >&2
    printf '%s\n' "${failed_outside:-(none listed: the failure is not a unit failure)}" >&2
    (exit "$switch_status") # fires the ERR trap: rollback (or roll-forward refusal)
  fi
  echo "WARNING: switch-to-configuration exited $switch_status but the only failed units are" >&2
  echo "WARNING: monitoring-only (${failed_all% }); per platform-rollout.md this is NOT a" >&2
  echo "WARNING: rollback trigger — continuing post-switch verification" >&2
fi
test "$(readlink -f /run/current-system)" = "$system"
test "$(readlink -f /nix/var/nix/profiles/system)" = "$system"

# Infra units whose PID must survive the switch UNLESS the operator
# explicitly approved restarting them via --allow-unit (the dry-activation
# fence and this assertion must agree; the lat4 peer wiring legitimately
# restarts networkd at the Gate E go-live).
pid_unchanged_unless_approved() {
  local unit="$1" before="$2" u now
  for u in "${approved_units[@]-}"; do
    [[ "$u" = "$unit" ]] && return 0
  done
  now="$(systemctl show "$unit" --property=MainPID --value)"
  if [[ "$now" != "$before" ]]; then
    echo "$unit restarted during activation (pid $before -> $now) without --allow-unit approval" >&2
    return 1
  fi
}
pid_unchanged_unless_approved containerd.service "$containerd_pid"
pid_unchanged_unless_approved systemd-networkd.service "$networkd_pid"
systemctl is-active --quiet containerd.service
systemctl is-active --quiet systemd-networkd.service

if [[ "$expect_startup" == "1" ]]; then
  # Go-live: every core product unit must be up after the switch.
  for unit in finite-saas-core.service finitechat-server.service caddy.service postgresql.service; do
    systemctl is-active --quiet "$unit" \
      || abort "$unit is not active after go-live activation"
  done
else
  # Steady state: the units the pre-mutation gate required active must
  # still be active after the switch.
  for unit in finite-saas-core.service finitechat-server.service caddy.service postgresql.service; do
    systemctl is-active --quiet "$unit" \
      || abort "$unit was active before and is down after a steady-state switch"
  done
fi

runner_check="$(systemctl cat finite-saas-runner.service >/dev/null 2>&1 && echo present || echo absent)"
[[ "$runner_check" == "absent" ]] \
  || abort "a runner unit appeared during activation; rolling back"
trap - ERR
echo "==> DEPLOYED system=$system"
LAT2
