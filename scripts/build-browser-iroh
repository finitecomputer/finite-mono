#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUSTFLAGS='--cfg getrandom_backend="wasm_js"'
cargo build --locked --release --target wasm32-unknown-unknown -p finite-browser-iroh
wasm-bindgen target/wasm32-unknown-unknown/release/finite_browser_iroh.wasm \
  --target web --out-dir finitecomputer-v2/apps/dashboard/public/iroh --out-name client
