#!/usr/bin/env bash
# Install the narrow Identity-to-Sites notification credential without
# returning its value to the operator shell or placing it in the repository.
set -euo pipefail

target="${1:-root@64.34.82.77}"

if [[ $# -gt 1 ]]; then
  printf 'usage: %s [root@finite-lat-1]\n' "$0" >&2
  exit 64
fi

remote_hostname="$(ssh -n -o BatchMode=yes "$target" hostname)"
if [[ "$remote_hostname" != "finite-lat-1" ]]; then
  printf 'refusing: %s reports hostname %s, expected finite-lat-1\n' \
    "$target" "$remote_hostname" >&2
  exit 65
fi

ssh -o BatchMode=yes "$target" 'bash -s' <<'REMOTE'
set -euo pipefail
test "$(hostname)" = finite-lat-1

environment_file=/etc/finite/identity-sites-notification.env
if test -e "$environment_file"; then
  test -f "$environment_file"
  test "$(stat -c %U:%G "$environment_file")" = root:root
  test "$(stat -c %a "$environment_file")" = 600
  test "$(sed -n 's/^FINITE_IDENTITY_SITES_NOTIFICATION_TOKEN=\([0-9a-f]\{64\}\)$/\1/p' "$environment_file" | wc -l)" = 1
  test "$(sed -n '/^[[:space:]]*#/d; /^[[:space:]]*$/d; p' "$environment_file" | wc -l)" = 1
  echo "Identity Sites notification credential already installed and valid"
  exit 0
fi

command -v openssl >/dev/null
install -d -m 0755 -o root -g root /etc/finite
temporary="$(mktemp /etc/finite/.identity-sites-notification.env.XXXXXX)"
cleanup() {
  rm -f "$temporary"
}
trap cleanup EXIT
umask 077
token="$(openssl rand -hex 32)"
printf 'FINITE_IDENTITY_SITES_NOTIFICATION_TOKEN=%s\n' "$token" > "$temporary"
unset token
chown root:root "$temporary"
chmod 0600 "$temporary"
mv -n "$temporary" "$environment_file"
trap - EXIT

test "$(stat -c %U:%G "$environment_file")" = root:root
test "$(stat -c %a "$environment_file")" = 600
test "$(sed -n 's/^FINITE_IDENTITY_SITES_NOTIFICATION_TOKEN=\([0-9a-f]\{64\}\)$/\1/p' "$environment_file" | wc -l)" = 1
echo "Installed $environment_file (root:root 0600; value not displayed)"
REMOTE
