def _load_mech():
    if os.path.exists(MECH_FILE):
        with open(MECH_FILE) as f:
            return json.load(f).get("rows", [])
    return []


_PATH_ROOTS = [
    "", "finitechat/crates/", "finite-brain/crates/", "finite-sites/crates/",
    "finitecomputer-v2/crates/", "finitecomputer-v2/apps/", "finitechat/apps/",
    "finitechat/", "finitecomputer-v2/deploy/finite-computer/images/",
    "finitecomputer-v2/", "infra/nixos/hosts/", "infra/nixos/modules/",
    "infra/nixos/", "infra/hosts/", "infra/scripts/", "infra/",
    "finite-skills/", "scripts/", "devfinity/",
]


def _resolve(path):
    p = path.strip()
    if p.startswith("/") or p.startswith("$"):
        return None
    for root in _PATH_ROOTS:
        cand = os.path.join(REPO, root, p)
        if os.path.exists(cand):
            return cand
    return None


def measure_rows(rows):
    """Approximate each shared thing's footprint from its evidence citations.

    loc = sum of cited line spans (+1 per bare line number, whole file when
    cited without lines); files = distinct resolvable paths. Evidence paths
    may be written relative to their component root; _resolve maps them into
    the repo. It skews low — it measures the documented surface, not every
    ripple — but it is consistent across rows, which is what prioritization
    needs. Unresolvable paths are reported so rows never silently score 0.
    """
    out, unresolved = {}, []
    for row in rows:
        files, total = {}, 0
        for ev in row.get("evidence", []):
            base = ev.split(" (")[0].strip()
            for piece in base.split(" + "):
                piece = piece.strip()
                if not piece or " " in piece:  # prose evidence, not a path
                    continue
                n = 0
                if ":" in piece:
                    path, _, lines = piece.partition(":")
                    path = path.strip()
                    for part in lines.split(","):
                        part = part.strip()
                        if "-" in part:
                            a, _, b = part.partition("-")
                            try:
                                n += max(1, int(b) - int(a) + 1)
                            except ValueError:
                                n += 1
                        else:
                            try:
                                int(part)
                                n += 1
                            except ValueError:
                                n = 0
                else:
                    path = piece
                    n = None
                p = _resolve(path)
                if p is None:
                    if not row.get("closed"):  # closed rows cite deleted files
                        unresolved.append("%s: %s" % (row.get("id"), path))
                    continue
                if p not in files:
                    try:
                        with open(p, errors="replace") as f:
                            files[p] = sum(1 for _ in f)
                    except OSError:
                        files[p] = 0
                total += files[p] if n is None else n
        out[row["id"]] = {"files": len(files), "loc": total}
    return out, unresolved


def render_html(d):
    payload = {
        "meta": {"rev": d.MAIN_REV, "updated": d.UPDATED,
                 "total": len(d.CONTRACTS)},
        "counts": dict(counts(d)),
        "principles": [list(p) for p in d.PRINCIPLES],
        "components": d.COMPONENTS,
        "contracts": d.CONTRACTS,
        "campaigns": sorted(d.CAMPAIGNS.items()),
        "kinds": KINDS,
        "lanes": d.BRAID.LANES,
        "braid": sorted(d.BRAID.SHARED_THINGS,
                        key=lambda b: (-len(b["touched"]), b["id"])),
        "sizes": d.SIZES,
        "mech": _load_mech(),
        "layout": {k: list(v) for k, v in LAYOUT.items()},
        "short": SHORT_LABELS,
        "draw": [
            {"from": a, "to": b, "status": c["status"], "name": c["name"]}
            for c in d.CONTRACTS if c["id"] in DRAW
            for a, b in DRAW[c["id"]]
        ],
    }
    return HTML.replace("__DATA__", json.dumps(payload, sort_keys=False))


def main():
    d = load_data()
    d.SIZES, d.UNRESOLVED = measure_rows(d.BRAID.SHARED_THINGS)
    for u in d.UNRESOLVED:
        print("WARN: unresolved evidence path in %s" % u)
    errs, warns = lint(d)
    for w in warns:
        print("WARN: %s" % w)
    if errs:
        for e in errs:
            print("ERROR: %s" % e)
        sys.exit(2)
    print("lint ok: %d contracts, %d components, %d campaigns"
          % (len(d.CONTRACTS), len(d.COMPONENTS), len(d.CAMPAIGNS)))

    outputs = {
        os.path.join(ARCH_DIR, "ARCHITECTURE.md"): render_md(d),
        os.path.join(ARCH_DIR, "fragment", "site", "index.html"): render_html(d),
        os.path.join(ARCH_DIR, "contracts.json"): json.dumps(
            {"meta": {"rev": d.MAIN_REV, "updated": d.UPDATED},
             "principles": d.PRINCIPLES, "hosts": d.HOSTS,
             "components": d.COMPONENTS, "contracts": d.CONTRACTS,
             "campaigns": d.CAMPAIGNS},
            indent=2, sort_keys=True) + "\n",
    }
    check = "--check" in sys.argv
    stale = []
    for path, content in outputs.items():
        if check:
            try:
                with open(path) as f:
                    if f.read() != content:
                        stale.append(path)
            except FileNotFoundError:
                stale.append(path)
        else:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w") as f:
                f.write(content)
            print("wrote %s" % os.path.relpath(path, REPO))
    if check:
        if stale:
            for p in stale:
                print("STALE: %s (run scripts/render-architecture)" % p)
            sys.exit(1)
        print("generated views are up to date")


if __name__ == "__main__":
    main()
