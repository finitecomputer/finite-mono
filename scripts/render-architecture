#!/usr/bin/env python3
"""Generate the architecture contract views from docs/architecture/contracts.py.

Outputs (all generated — never edit by hand):
  docs/architecture/ARCHITECTURE.md    the human document (aimed at simplicity)
  docs/architecture/site/index.html    the interactive board (publish via fragment)
  docs/architecture/contracts.json     machine-readable snapshot

Usage:
  scripts/render-architecture            regenerate everything
  scripts/render-architecture --check    lint + fail if generated files are stale

stdlib only; any python3 ≥ 3.9 works. The lint is the point: every contract
must declare its lifecycle, and dying/proposed work must name a campaign.
"""

import importlib.util
import json
import os
import sys
from collections import Counter

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ARCH_DIR = os.path.join(REPO, "docs", "architecture")
DATA_FILE = os.path.join(ARCH_DIR, "contracts.py")
BRAID_FILE = os.path.join(ARCH_DIR, "braid.py")
MECH_FILE = os.path.join(ARCH_DIR, "braid-mechanical.json")

STATUSES = ["current", "dying", "proposed", "kept", "dead"]
KINDS = ["edge", "convention", "data", "deploy", "duplication"]
BRAID_KINDS = ["wire-type", "protocol-impl", "file-format", "concept",
               "dup-logic", "implicit-coupling", "schema", "secret", "build-unit"]
DISPOSITIONS = ["interface", "die", "contested", "fine"]

# Diagram layout (SVG coords) and curated edge pairs — renderer-owned, not data.
LAYOUT = {
    # external column
    "workos":      (40, 120),
    "cloudflare":  (40, 260),
    "resend":      (40, 400),
    "ci":          (40, 540),
    # app plane (lat2)
    "dashboard":   (330, 60),
    "core":        (330, 210),
    "identity":    (330, 360),
    "chat-server": (560, 60),
    "hosted-device": (560, 210),
    "brain":       (560, 360),
    "sites":       (560, 510),
    "edge":        (330, 660),
    # runtime fleet
    "runner":      (790, 210),
    "agent-runtime": (790, 400),
    # clients
    "fbrain-cli":  (1020, 360),
    "fsite-cli":   (1020, 510),
    "chat-clients": (1020, 210),
}
NODE_W, NODE_H = 168, 52
SHORT_LABELS = {
    "edge": "edge (Caddy)",
    "chat-clients": "chat clients",
    "agent-runtime": "agent runtime",
    "hosted-device": "hosted-device",
}
DRAW = {
    "hd-chat-pair": [("hosted-device", "chat-server")],
    "dash-hd-vouch": [("dashboard", "hosted-device")],
    "hd-brain-idp": [("hosted-device", "brain")],
    "hd-sites-idp": [("hosted-device", "sites")],
    "runner-core-lease": [("runner", "core")],
    "runner-identity-names": [("runner", "identity")],
    "dash-core-api": [("dashboard", "core")],
    "core-workos": [("core", "workos")],
    "dash-workos": [("dashboard", "workos")],
    "mail-notification": [("brain", "resend"), ("sites", "resend")],
    "dash-sites-viewer-token": [("dashboard", "sites")],
    "sites-core-reconcile": [("sites", "core")],
    "agentd-chat-sync": [("agent-runtime", "chat-server")],
    "nostrjson-read": [("fbrain-cli", "identity"), ("fsite-cli", "identity")],
    # dead edges stay on the diagram as ghosts until the story is old news
    "brain-identity-resolution": [("brain", "identity")],
    "brain-core-roster": [("brain", "core")],
    "sites-identity-proofs": [("sites", "identity")],
    "hd-identity-bindings": [("hosted-device", "identity")],
}

STATUS_LABEL = {
    "current": "current",
    "dying": "dying",
    "proposed": "proposed",
    "kept": "kept by design",
    "dead": "DELETED",
}


def load_data():
    spec = importlib.util.spec_from_file_location("contracts_data", DATA_FILE)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    bspec = importlib.util.spec_from_file_location("braid_data", BRAID_FILE)
    bmod = importlib.util.module_from_spec(bspec)
    bspec.loader.exec_module(bmod)
    mod.BRAID = bmod
    return mod


def lint(d):
    errs, warns = [], []
    ids = set()
    for c in d.CONTRACTS:
        cid = c.get("id")
        if not cid:
            errs.append("contract without id: %r" % c.get("name"))
            continue
        if cid in ids:
            errs.append("duplicate contract id: %s" % cid)
        ids.add(cid)
        if c.get("kind") not in KINDS:
            errs.append("%s: bad kind %r" % (cid, c.get("kind")))
        if c.get("status") not in STATUSES:
            errs.append("%s: bad status %r" % (cid, c.get("status")))
        if not c.get("summary"):
            errs.append("%s: missing summary" % cid)
        if not c.get("owner"):
            errs.append("%s: missing owner" % cid)
        if c.get("status") in ("dying", "proposed") and not c.get("campaigns"):
            errs.append("%s: %s work must name a campaign" % (cid, c["status"]))
        if c.get("status") == "dead" and not c.get("closed"):
            errs.append("%s: dead contracts need a closed date" % cid)
        for p in c.get("parties", []):
            if p not in d.COMPONENTS and p not in d.HOSTS:
                errs.append("%s: unknown party %r" % (cid, p))
        for camp in c.get("campaigns", []):
            if camp not in d.CAMPAIGNS:
                errs.append("%s: unknown campaign %r" % (cid, camp))
        if c.get("kind") == "edge" and c.get("status") != "dead" and not c.get("via"):
            errs.append("%s: edges need a 'via' transport" % cid)
    used = {camp for c in d.CONTRACTS for camp in c.get("campaigns", [])}
    for camp in d.CAMPAIGNS:
        if camp not in used:
            warns.append("campaign %r closes no contracts (fine for meta-work)" % camp)
    # braid rows
    b_ids = set()
    for b in d.BRAID.SHARED_THINGS:
        bid = b.get("id")
        if not bid or not b.get("name"):
            errs.append("braid row without id/name: %r" % b.get("story", "")[:40])
            continue
        if bid in b_ids:
            errs.append("duplicate braid id: %s" % bid)
        b_ids.add(bid)
        if b.get("kind") not in BRAID_KINDS:
            errs.append("%s: bad braid kind %r" % (bid, b.get("kind")))
        if b.get("disposition") not in DISPOSITIONS:
            errs.append("%s: bad disposition %r" % (bid, b.get("disposition")))
        if not b.get("story") or not b.get("evidence"):
            errs.append("%s: braid rows need story + evidence" % bid)
        for lane in b.get("touched", []):
            if lane not in d.BRAID.LANES:
                errs.append("%s: unknown lane %r" % (bid, lane))
        owner = b.get("owner", "none")
        if owner != "none" and owner not in d.BRAID.LANES:
            errs.append("%s: owner %r is not a lane or 'none'" % (bid, owner))
        if b.get("disposition") == "interface" and owner == "none":
            errs.append("%s: interface rows must name the owning lane" % bid)
        if b.get("closed") and not str(b["closed"]).startswith("20"):
            errs.append("%s: closed must carry a date" % bid)
    return errs, warns


def counts(d):
    by_status = Counter(c["status"] for c in d.CONTRACTS)
    return by_status


# --------------------------------------------------------------------------- md

BADGE = {"current": "🟦", "dying": "🟧", "proposed": "🟪", "kept": "🟩", "dead": "⬛"}


def parties_str(d, c):
    if not c.get("parties"):
        return "—"
    return " ↔ ".join(d.COMPONENTS[p]["name"] if p in d.COMPONENTS else p
                      for p in c["parties"])


def render_md(d):
    cs = counts(d)
    total = len(d.CONTRACTS)
    L = []
    w = L.append
    w("<!-- GENERATED by scripts/render-architecture from contracts.py — "
      "edit the data module, never this file. -->")
    w("")
    w("# Finite Architecture — the contracts ledger")
    w("")
    w("Every place where *changing X forces changing Y*: runtime calls, "
      "shared protocols, data formats, deploy couplings, and duplicated "
      "implementations. The purpose of this ledger is to argue about each "
      "entry and delete it. Entries never silently disappear — deleted "
      "contracts stay so the downward trend is visible.")
    w("")
    w("**Verified against `origin/main` @ %s · updated %s · %d contracts: "
      "%d current, %d dying, %d proposed, %d kept, %d dead.**"
      % (d.MAIN_REV, d.UPDATED, total, cs["current"], cs["dying"],
         cs["proposed"], cs["kept"], cs["dead"]))
    w("")
    w("## The kernel (the rules contracts are reviewed against)")
    w("")
    for i, (title, body) in enumerate(d.PRINCIPLES, 1):
        w("%d. **%s** — %s" % (i, title, body))
    w("")
    w("## Scoreboard")
    w("")
    w("| status | meaning | count |")
    w("| --- | --- | --- |")
    w("| 🟦 current | live today | %d |" % cs["current"])
    w("| 🟧 dying | in flight or fully designed | %d |" % cs["dying"])
    w("| 🟪 proposed | audit proposal, not started | %d |" % cs["proposed"])
    w("| 🟩 kept | kept by design | %d |" % cs["kept"])
    w("| ⬛ dead | deleted (kept in the ledger) | %d |" % cs["dead"])
    w("")
    dead = [c for c in d.CONTRACTS if c["status"] == "dead"]
    if dead:
        w("Deleted so far: " + "; ".join(
            "**%s** (%s)" % (c["name"], c.get("closed", "?")) for c in dead) + ".")
        w("")
    # ---- the braid (primary view) ----
    braid = d.BRAID.SHARED_THINGS
    from collections import Counter as _C
    bc = _C(b["disposition"] for b in braid)
    sizes = d.SIZES
    closed_rows = [b for b in braid if b.get("closed")]
    open_rows = [b for b in braid if not b.get("closed")]
    w("## The braid — shared things (%d)" % len(braid))
    w("")
    w("Every shared thing must either become **a self-service interface with "
      "one owner, or die.** No third state. Sorted by evidence LOC (the "
      "documented lines that must move together) — the attack order; "
      "`files` counts the distinct files named in evidence.")
    w("")
    w("**%d interface · %d die · %d contested · %d closed.** "
      % (bc["interface"], bc["die"], bc["contested"], len(closed_rows)))
    w("")
    w("| verdict | shared thing | kind | braids | files | LOC | story |")
    w("| --- | --- | --- | --- | --- | --- | --- |")
    for b in sorted(open_rows, key=lambda x: (-sizes[x["id"]]["loc"], x["id"])):
        icon = {"interface": "🔌", "die": "☠️", "contested": "⚖️",
                "fine": "✅"}[b["disposition"]]
        owner = ("→ own in **%s**" % b["owner"]) if b["owner"] != "none" else ""
        sz = sizes[b["id"]]
        w("| %s | **%s**`%s`<br>%s | %s | %s | %d | %d | %s |" % (
            icon, b["name"], b["id"], owner, b["kind"],
            ", ".join(sorted(b["touched"])), sz["files"], sz["loc"], b["story"]))
    w("")
    if closed_rows:
        w("Closed — the wins (%d): " % len(closed_rows) + "; ".join(
            "~~%s~~ (%s)" % (b["name"], b["closed"]) for b in closed_rows) + ".")
        w("")
    mech_path = os.path.join(ARCH_DIR, "braid-mechanical.json")
    if os.path.exists(mech_path):
        with open(mech_path) as f:
            mech = json.load(f)
        hot = [r for r in mech["rows"] if r["fan_in"] >= 3]
        w("### Unreviewed mechanical candidates (%d rows, fan-in ≥ 3 shown; "
          "full list in `braid-mechanical.json`)" % len(mech["rows"]))
        w("")
        w("| fan-in | kind | thing | touched |")
        w("| --- | --- | --- | --- |")
        for r in hot:
            w("| %d | %s | `%s` | %s |" % (
                r["fan_in"], r["kind"], r["name"],
                ", ".join(sorted(r["touched_by"]))))
        w("")
    w("## Where things run")
    w("")
    w("| host | status | role |")
    w("| --- | --- | --- |")
    for h in d.HOSTS.values():
        w("| %s | %s | %s |" % (h["name"], h["status"], h["role"]))
    w("")
    w("| component | lane | host | store |")
    w("| --- | --- | --- | --- |")
    for comp in d.COMPONENTS.values():
        w("| %s | %s | %s | %s |" % (comp["name"], comp["lane"],
                                     comp["host"], comp["store"]))
    w("")
    for kind in KINDS:
        rows = [c for c in d.CONTRACTS if c["kind"] == kind]
        if not rows:
            continue
        w("## %s contracts (%d)" % (kind, len(rows)))
        w("")
        w("| | contract | parties | seam | story / fate |")
        w("| --- | --- | --- | --- | --- |")
        rows.sort(key=lambda c: (STATUSES.index(c["status"]), c["id"]))
        for c in rows:
            story = c["summary"]
            if c.get("death"):
                story += " — *%s*" % c["death"]
            w("| %s | **%s**`%s` | %s | %s | %s |" % (
                BADGE[c["status"]], c["name"], c["id"], parties_str(d, c),
                c.get("via", "—"), story))
        w("")
    w("## Campaigns")
    w("")
    w("| campaign | status | closes | point |")
    w("| --- | --- | --- | --- |")
    for cid, camp in d.CAMPAIGNS.items():
        closes = [c["id"] for c in d.CONTRACTS if cid in c.get("campaigns", [])]
        w("| **%s** | %s | %s | %s *(%s)* |" % (
            camp["name"], camp["status"], ", ".join(closes) or "—",
            camp["summary"], camp["source"]))
    w("")
    w("## Keeping this true")
    w("")
    w("- Edit `docs/architecture/contracts.py` in the same PR that changes a "
      "seam, then run `scripts/render-architecture` (or let `--check` catch "
      "the drift in CI).")
    w("- A PR that adds a `current` contract owes the reviewer a story about "
      "which contract it deletes. The count should trend down.")
    w("- `dying` and `proposed` entries must name their campaign.")
    return "\n".join(L) + "\n"


