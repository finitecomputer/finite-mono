#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)

declare -a sensitive_files=()
updates_pid=""

cleanup_sensitive_files() {
  if [[ -n "$updates_pid" ]]; then
    kill "$updates_pid" >/dev/null 2>&1 || true
    wait "$updates_pid" >/dev/null 2>&1 || true
  fi
  if (( ${#sensitive_files[@]} > 0 )); then
    rm -f -- "${sensitive_files[@]}"
  fi
}

track_sensitive_file() {
  sensitive_files+=("$1")
}

trap cleanup_sensitive_files EXIT

need() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "missing required command: $1" >&2
    exit 127
  fi
}

wait_http() {
  local name="$1"
  local url="$2"
  local timeout_secs="${3:-120}"
  local started
  started="$(date +%s)"
  until curl -fsS --max-time 3 "$url" >/dev/null 2>&1; do
    if (( "$(date +%s)" - started >= timeout_secs )); then
      echo "$name did not become ready at $url within ${timeout_secs}s" >&2
      return 1
    fi
    sleep 1
  done
}

read_core_me() {
  curl_customer "$core_url/api/core/v1/me" >"$me_json"
}

curl_customer() {
  local config_file="$state_dir/saas-smoke-curl-auth-$$-$RANDOM.conf"
  track_sensitive_file "$config_file"
  umask 077
  printf 'header = "authorization: Bearer %s"\n' \
    "$(tr -d '\n' <"$state_dir/workos-fixture/dashboard-customer.jwt")" >"$config_file"
  local status=0
  curl -fsS --config "$config_file" "$@" || status=$?
  if (( status != 0 )); then
    rm -f "$config_file"
    return "$status"
  fi
  rm -f "$config_file"
}

runtime_fields() {
  node - "$me_json" <<'JS'
const fs = require("node:fs");
const me = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const visible = (me.projects || []).find((entry) => entry.runtime);
if (!visible) process.exit(1);
const project = visible.project;
const runtime = visible.runtime;
const contact = new URL(runtime.contact_endpoint);
contact.pathname = contact.pathname.replace(/\/contact\/?$/, "");
process.stdout.write([
  project.id,
  runtime.id,
  contact.toString().replace(/\/$/, ""),
  project.agent_email || "",
].join("\t"));
JS
}

runtime_container_id() {
  if [[ "$runtime_driver" == docker ]]; then
    docker ps --format '{{json .}}' --filter "label=computer.finite.v2.project_id=$project_id" \
      | node -e '
        let body = "";
        process.stdin.on("data", (chunk) => body += chunk);
        process.stdin.on("end", () => {
          const rows = body.trim().split(/\n+/).filter(Boolean).map(JSON.parse);
          if (rows.length !== 1 || !rows[0].ID) process.exit(1);
          process.stdout.write(rows[0].ID);
        });
      '
    return
  fi
  container list --format json | node -e '
    const projectId = process.argv[1];
    let body = "";
    process.stdin.on("data", (chunk) => body += chunk);
    process.stdin.on("end", () => {
      const containers = JSON.parse(body);
      const runtime = containers.find((entry) =>
        entry?.configuration?.labels?.["computer.finite.v2.project_id"] === projectId
      );
      if (!runtime?.configuration?.id) process.exit(1);
      process.stdout.write(runtime.configuration.id);
    });
  ' "$project_id"
}

runtime_exec() {
  if [[ "$runtime_driver" == docker ]]; then
    docker exec "$@"
  else
    container exec "$@"
  fi
}

wait_for_runtime() {
  local started
  local fields
  started="$(date +%s)"
  while true; do
    read_core_me
    if fields="$(runtime_fields)"; then
      IFS=$'\t' read -r project_id machine_id runtime_url agent_email <<<"$fields"
      if [[ -n "$project_id" && -n "$machine_id" && -n "$runtime_url" && -n "$agent_email" ]]; then
        return 0
      fi
    fi
    if node - "$me_json" <<'JS'
const fs = require("node:fs");
const me = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const failed = (me.agent_creation_requests || []).find((request) => request.status === "failed");
if (failed) {
  console.error(`Agent launch failed: ${failed.failure_message || failed.id}`);
  process.exit(0);
}
process.exit(1);
JS
    then
      return 1
    fi
    if (( "$(date +%s)" - started >= 600 )); then
      echo "Core did not report a launched Apple Container runtime within 600s" >&2
      return 1
    fi
    sleep 2
  done
}

chat_state() {
  curl -fsS --max-time 30 \
    "$dashboard_origin/api/chat/machines/$machine_id/hosted-device/state" \
    >"$chat_state_json"
}

start_chat_updates() {
  if [[ -n "$updates_pid" ]]; then
    kill "$updates_pid" >/dev/null 2>&1 || true
    wait "$updates_pid" >/dev/null 2>&1 || true
  fi
  curl -fsS --no-buffer \
    "$dashboard_origin/api/chat/machines/$machine_id/hosted-device/updates" \
    >/dev/null 2>&1 &
  updates_pid=$!
}

wait_for_connected_chat() {
  local started
  started="$(date +%s)"
  while true; do
    if chat_state && node - "$chat_state_json" <<'JS'
const fs = require("node:fs");
const state = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
process.exit((state.rooms || []).some((room) => room.is_agent_chat && room.state === "Connected") ? 0 : 1);
JS
    then
      return 0
    fi
    if (( "$(date +%s)" - started >= 180 )); then
      echo "Hosted Web Device did not establish the agent chat within 180s" >&2
      return 1
    fi
    sleep 2
  done
}

max_remote_seq() {
  local room_id="$1"
  local topic_id="$2"
  local chat_id="$3"
  node - "$chat_state_json" "$room_id" "$topic_id" "$chat_id" <<'JS'
const fs = require("node:fs");
const state = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const [roomId, topicId, chatId] = process.argv.slice(3);
const seq = (state.messages || [])
  .filter((message) =>
    message.sender_account_id !== state.identity?.account_id
    && message.room_id === roomId
    && message.conversation_id === topicId
    && message.chat_id === chatId
  )
  .reduce((max, message) => Math.max(max, Number(message.seq) || 0), 0);
process.stdout.write(String(seq));
JS
}

selected_chat_route() {
  node - "$chat_state_json" <<'JS'
const fs = require("node:fs");
const state = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const roomId = state.hosted_agent_binding?.canonical_room_id;
const room = (state.rooms || []).find((candidate) =>
  candidate.room_id === roomId && candidate.state === "Connected"
);
const topics = (state.topics || []).filter((candidate) =>
  candidate.room_id === room?.room_id && !candidate.archived
);
const topic = topics.find((candidate) => candidate.topic_id === state.selected_topic_id)
  || topics.find((candidate) => candidate.topic_id === "home");
const chat = topic?.chats?.find((candidate) => candidate.chat_id === state.selected_chat_id)
  || topic?.chats?.find((candidate) => candidate.active)
  || topic?.chats?.[0];
if (!room || !topic || !chat) throw new Error("canonical Home chat is unavailable");
process.stdout.write([room.room_id, topic.topic_id, chat.chat_id].join("\t"));
JS
}

send_chat_message() {
  local text="$1"
  node - "$chat_state_json" "$text" >"$chat_action_json" <<'JS'
const fs = require("node:fs");
const state = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const text = process.argv[3];
const roomId = state.hosted_agent_binding?.canonical_room_id;
const room = (state.rooms || []).find((candidate) =>
  candidate.room_id === roomId && candidate.state === "Connected"
);
if (!room) throw new Error("no connected agent room");
const topics = (state.topics || []).filter((candidate) =>
  candidate.room_id === room.room_id && !candidate.archived
);
const topic = topics.find((candidate) => candidate.topic_id === state.selected_topic_id)
  || topics.find((candidate) => candidate.topic_id === "home");
const chat = topic?.chats?.find((candidate) => candidate.chat_id === state.selected_chat_id)
  || topic?.chats?.find((candidate) => candidate.active)
  || topic?.chats?.[0];
if (!topic || !chat) throw new Error("canonical Home chat is unavailable");
const action = {
  SendChatMessage: {
    room_id: room.room_id,
    topic_id: topic.topic_id,
    chat_id: chat.chat_id,
    text,
  },
};
process.stdout.write(JSON.stringify(action));
JS
  curl -fsS --max-time 30 \
    -H 'content-type: application/json' \
    --data-binary "@$chat_action_json" \
    "$dashboard_origin/api/chat/machines/$machine_id/hosted-device/actions" \
    >"$chat_state_json"
}

create_topic_and_require_first_chat() {
  local title="$1"
  local room_id
  chat_state
  room_id="$(node - "$chat_state_json" <<'JS'
const fs = require("node:fs");
const state = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const roomId = state.hosted_agent_binding?.canonical_room_id;
if (!roomId) throw new Error("canonical room is unavailable");
process.stdout.write(roomId);
JS
)"
  node - "$room_id" "$title" >"$chat_action_json" <<'JS'
const roomId = process.argv[2];
const title = process.argv[3];
if (!roomId || !title) throw new Error("canonical room or topic title is unavailable");
process.stdout.write(JSON.stringify({ CreateTopic: { room_id: roomId, title } }));
JS
  curl -fsS --max-time 30 \
    -H 'content-type: application/json' \
    --data-binary "@$chat_action_json" \
    "$dashboard_origin/api/chat/machines/$machine_id/hosted-device/actions" \
    >"$chat_state_json"
  node - "$chat_state_json" "$title" "$room_id" <<'JS'
const fs = require("node:fs");
const state = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const title = process.argv[3];
const roomId = process.argv[4];
const topic = (state.topics || []).find((candidate) =>
  candidate.room_id === roomId
  && candidate.topic_id === state.selected_topic_id
  && candidate.title === title
);
const chat = topic?.chats?.find((candidate) => candidate.chat_id === state.selected_chat_id);
if (!topic || !chat) {
  throw new Error("CreateTopic did not select its canonical first chat");
}
JS
}

scoped_working_present() {
  local room_id="$1"
  local topic_id="$2"
  local chat_id="$3"
  node - "$chat_state_json" "$room_id" "$topic_id" "$chat_id" <<'JS'
const fs = require("node:fs");
const state = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const [roomId, topicId, chatId] = process.argv.slice(3);
process.exit((state.typing_members || []).some((member) =>
  member.room_id === roomId
  && member.topic_id === topicId
  && member.chat_id === chatId
  && member.activity_kind === "working"
) ? 0 : 1);
JS
}

wait_for_scoped_working_clear() {
  local room_id="$1"
  local topic_id="$2"
  local chat_id="$3"
  local timeout_secs="${4:-5}"
  local started
  started="$(date +%s)"
  while true; do
    chat_state
    if ! scoped_working_present "$room_id" "$topic_id" "$chat_id"; then
      return 0
    fi
    if (( "$(date +%s)" - started >= timeout_secs )); then
      echo "scoped Working activity did not clear after Hermes completed" >&2
      return 1
    fi
    sleep 0.25
  done
}

wait_for_remote_reply_after() {
  local previous_seq="$1"
  local room_id="$2"
  local topic_id="$3"
  local chat_id="$4"
  local require_working="${5:-0}"
  local started
  local working_seen=0
  started="$(date +%s)"
  while true; do
    chat_state
    if scoped_working_present "$room_id" "$topic_id" "$chat_id"; then
      working_seen=1
    fi
    if node - "$chat_state_json" "$previous_seq" "$room_id" "$topic_id" "$chat_id" <<'JS'
const fs = require("node:fs");
const state = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const previous = Number(process.argv[3]);
const [roomId, topicId, chatId] = process.argv.slice(4);
process.exit((state.messages || []).some((message) =>
  message.sender_account_id !== state.identity?.account_id
  && Number(message.seq) > previous
  && message.room_id === roomId
  && message.conversation_id === topicId
  && message.chat_id === chatId
  && message.final_delivery === true
) ? 0 : 1);
JS
    then
      if [[ "$require_working" == "1" && "$working_seen" != "1" ]]; then
        echo "Hermes completed without observable scoped Working activity" >&2
        return 1
      fi
      wait_for_scoped_working_clear "$room_id" "$topic_id" "$chat_id"
      return 0
    fi
    # Finite Chat activity is ephemeral and may clear as soon as Hermes sends
    # its final response, before the Hosted Web Device has projected that
    # durable message. The dashboard keeps the submitted turn visibly Working
    # until final_delivery arrives, so require an observed activity handoff and
    # the durable final below without treating that transport race as failure.
    if (( "$(date +%s)" - started >= 240 )); then
      echo "Hermes did not answer the real Hosted Web Device message within 240s" >&2
      return 1
    fi
    sleep 0.25
  done
}

send_and_require_reply() {
  local text="$1"
  local before
  local room_id
  local topic_id
  local chat_id
  chat_state
  IFS=$'\t' read -r room_id topic_id chat_id <<<"$(selected_chat_route)"
  wait_for_scoped_working_clear "$room_id" "$topic_id" "$chat_id"
  before="$(max_remote_seq "$room_id" "$topic_id" "$chat_id")"
  send_chat_message "$text"
  wait_for_remote_reply_after "$before" "$room_id" "$topic_id" "$chat_id"
}

send_and_capture_reply() {
  local text="$1"
  local before
  local room_id
  local topic_id
  local chat_id
  chat_state
  IFS=$'\t' read -r room_id topic_id chat_id <<<"$(selected_chat_route)"
  wait_for_scoped_working_clear "$room_id" "$topic_id" "$chat_id"
  before="$(max_remote_seq "$room_id" "$topic_id" "$chat_id")"
  send_chat_message "$text"
  # Working activity is intentionally ephemeral and can be set and cleared
  # between two Hosted Device projections, especially for deterministic local
  # model replies. The durable scoped final delivery below is the product
  # contract; the matrix separately proves the real model and terminal seams.
  wait_for_remote_reply_after "$before" "$room_id" "$topic_id" "$chat_id"
  node - "$chat_state_json" "$before" "$room_id" "$topic_id" "$chat_id" <<'JS'
const fs = require("node:fs");
const state = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const previous = Number(process.argv[3]);
const [roomId, topicId, chatId] = process.argv.slice(4);
const final = (state.messages || []).findLast((message) =>
  message.sender_account_id !== state.identity?.account_id
  && Number(message.seq) > previous
  && message.room_id === roomId
  && message.conversation_id === topicId
  && message.chat_id === chatId
  && message.final_delivery === true
);
if (!final) throw new Error("Hermes turn has no scoped final delivery");
process.stdout.write(String(final.display_content || final.text || ""));
JS
}

last_site_final_timestamp=0
sites_acceptance_room_id=""
sites_acceptance_topic_id=""
sites_acceptance_chat_id=""

send_site_and_require_ordered_chat() {
  local marker="$1"
  local before
  local room_id
  local topic_id
  local chat_id
  local result
  local final_timestamp
  local site_url
  local site_body
  local result_file
  chat_state
  IFS=$'\t' read -r room_id topic_id chat_id <<<"$(selected_chat_route)"
  if [[ -z "$sites_acceptance_room_id" ]]; then
    sites_acceptance_room_id="$room_id"
    sites_acceptance_topic_id="$topic_id"
    sites_acceptance_chat_id="$chat_id"
  elif [[ "$room_id" != "$sites_acceptance_room_id" \
    || "$topic_id" != "$sites_acceptance_topic_id" \
    || "$chat_id" != "$sites_acceptance_chat_id" ]]; then
    echo "selected chat route changed between Sites turns" >&2
    return 1
  fi
  wait_for_scoped_working_clear "$room_id" "$topic_id" "$chat_id"
  before="$(max_remote_seq "$room_id" "$topic_id" "$chat_id")"
  send_chat_message \
    "Use the installed Finite Sites skill to publish a minimal public Finite Site whose rendered page visibly contains only the exact marker ${marker}. This marker contains no private data, and this request is explicit approval to make that output public with the skill's documented public-sharing command. Actually publish it, verify it, and return verbatim the exact outputs[].output_url reported by fsite project status --output json in your final response. In this local test that authoritative URL will be an http://*.sites.localhost:<port>/ URL; never translate or synthesize a production hostname."
  wait_for_remote_reply_after "$before" "$room_id" "$topic_id" "$chat_id" 1

  result_file="$state_dir/saas-smoke-site-turn-result-$$-$RANDOM.txt"
  track_sensitive_file "$result_file"
  node - "$chat_state_json" "$before" "$room_id" "$topic_id" "$chat_id" "$sites_api_url" >"$result_file" <<'JS'
const fs = require("node:fs");
const state = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const previous = Number(process.argv[3]);
const [roomId, topicId, chatId] = process.argv.slice(4, 7);
const sitesApi = new URL(process.argv[7]);
const remote = (state.messages || []).filter((message) =>
  message.sender_account_id !== state.identity?.account_id
  && Number(message.seq) > previous
  && message.room_id === roomId
  && message.conversation_id === topicId
  && message.chat_id === chatId
);
if (remote.length === 0) throw new Error("site turn produced no scoped Agent messages");
for (let index = 1; index < remote.length; index += 1) {
  if (Number(remote[index].seq) <= Number(remote[index - 1].seq)) {
    throw new Error("site turn messages are not in strictly increasing durable order");
  }
}
const tools = remote.filter((message) => message.kind === "tool");
if (tools.length < 2) throw new Error("site turn did not expose representative tool progress");
if (tools.some((message) => message.edit_of_message_id)) {
  throw new Error("site turn rewrote an earlier tool bubble instead of appending progress");
}
const final = remote.findLast((message) => message.final_delivery === true);
if (!final) throw new Error("site turn has no final delivery");
const content = String(final.display_content || final.text || "");
const match = content.match(/https?:\/\/[^\s<>)\]},"\x27\x60*]+/u);
if (!match) throw new Error("site turn final delivery has no public URL");
const candidate = match[0].replace(/[.,;:!?]+$/u, "");
const url = new URL(candidate);
const oneLabelUnder = (hostname, base) => {
  const suffix = `.${base}`;
  if (!hostname.endsWith(suffix)) return false;
  const label = hostname.slice(0, -suffix.length);
  return Boolean(label) && !label.includes(".") && !["api", "git"].includes(label);
};
const productionOutput = url.protocol === "https:"
  && !url.port
  && (oneLabelUnder(url.hostname, "finite.chat")
    || oneLabelUnder(url.hostname, "docs.finite.chat"));
const localOutput = url.protocol === "http:"
  && sitesApi.protocol === "http:"
  && Boolean(url.port)
  && url.port === sitesApi.port
  && (oneLabelUnder(url.hostname, "sites.localhost")
    || oneLabelUnder(url.hostname, "docs.sites.localhost"));
if (url.username || url.password || (!productionOutput && !localOutput)) {
  throw new Error("site turn final delivery URL is not a Finite Sites output");
}
process.stdout.write(`${Number(final.timestamp_unix_seconds) || 0}\t${url.href}`);
JS
  result="$(cat "$result_file")"
  IFS=$'\t' read -r final_timestamp site_url <<<"$result"
  if (( final_timestamp <= 0 )); then
    echo "site turn final delivery has no live timestamp" >&2
    return 1
  fi
  if (( last_site_final_timestamp > 0 && final_timestamp <= last_site_final_timestamp )); then
    echo "resident Hermes timestamps did not advance between site turns" >&2
    return 1
  fi
  last_site_final_timestamp="$final_timestamp"
  site_body="$state_dir/saas-smoke-agent-site-${marker}.html"
  track_sensitive_file "$site_body"
  if ! curl -fsS --max-time 30 "$site_url" >"$site_body" \
    || ! grep -Fq -- "$marker" "$site_body"; then
    echo "published Finite Site did not render marker $marker at $site_url" >&2
    return 1
  fi
}

stop_process() {
  local process="$1"
  process-compose \
    --use-uds \
    --unix-socket "${DEVFINITY_PROCESS_COMPOSE_SOCKET:?}" \
    process stop "$process" >/dev/null || true

  local stopped_at state
  stopped_at="$(date +%s)"
  while true; do
    state="$(
      process-compose \
        --use-uds \
        --unix-socket "${DEVFINITY_PROCESS_COMPOSE_SOCKET:?}" \
        process get "$process" --output json 2>/dev/null || true
    )"
    if node -e '
      const state = JSON.parse(process.argv[1] || "[]")[0];
      process.exit(state?.status !== "Running" ? 0 : 1);
    ' "$state"; then
      break
    fi
    if (( "$(date +%s)" - stopped_at >= 60 )); then
      echo "$process did not finish stopping within 60s" >&2
      return 1
    fi
    sleep 1
  done
}

restart_process() {
  local process="$1"
  # A dependency restart can leave dependants in process-compose's Skipped
  # state. `process restart` does not revive a skipped process, so model the
  # actual outage explicitly and always finish with a start transition.
  stop_process "$process"

  process-compose \
    --use-uds \
    --unix-socket "${DEVFINITY_PROCESS_COMPOSE_SOCKET:?}" \
    process start "$process" >/dev/null 2>&1 || true

  local started
  started="$(date +%s)"
  while true; do
    state="$(
      process-compose \
        --use-uds \
        --unix-socket "${DEVFINITY_PROCESS_COMPOSE_SOCKET:?}" \
        process get "$process" --output json 2>/dev/null || true
    )"
    if node -e '
      const state = JSON.parse(process.argv[1] || "[]")[0];
      process.exit(state?.status === "Running" && state?.is_ready === "Ready" ? 0 : 1);
    ' "$state"; then
      return 0
    fi
    # Starting a dependant before process-compose has observed its dependency
    # as Ready can leave it Skipped even though the CLI returned success.
    # Retry the idempotent start once readiness catches up.
    process-compose \
      --use-uds \
      --unix-socket "${DEVFINITY_PROCESS_COMPOSE_SOCKET:?}" \
      process start "$process" >/dev/null 2>&1 || true
    if (( "$(date +%s)" - started >= 120 )); then
      echo "$process did not return to Ready within 120s" >&2
      return 1
    fi
    sleep 1
  done
}

reset_brain_setup_matrix_state() {
  # Wait for SQLite's owning process to exit before unlinking the database.
  # Otherwise the still-open connection can recreate sidecars against an
  # unlinked main file and leave the next scenario with no schema.
  stop_process finite-brain
  rm -f -- \
    "$state_dir/finite-brain/finite-brain.sqlite3" \
    "$state_dir/finite-brain/finite-brain.sqlite3-shm" \
    "$state_dir/finite-brain/finite-brain.sqlite3-wal"
  # The runtime supervisor owns the stable config lock and may be writing a
  # Working Tree while this matrix advances to its next isolated server
  # scenario. Replace the tree root atomically instead of recursively deleting
  # live files. The old tree stays inside this disposable matrix volume and is
  # removed with the runtime container at teardown.
  runtime_exec "$container_machine_id" /bin/bash -lc '
    set -euo pipefail
    root=/data/workspace/finitebrain
    replaced="/data/workspace/finitebrain-matrix-reset-$(date +%s%N)-$$"
    if test -e "$root"; then
      mv "$root" "$replaced"
    fi
    mkdir -p "$root"
    chmod 700 "$root"

  '
  restart_process finite-brain
  wait_http "FiniteBrain matrix reset" "${FINITE_BRAIN_URL:?}/health" 120
}

assert_agent_brain_list() {
  local expected_kind="$1"
  local expected_role="$2"
  local expected_count="$3"
  runtime_exec "$container_machine_id" fbrain brain list --json >"$brains_json"
  node - "$brains_json" "$expected_kind" "$expected_role" "$expected_count" <<'JS'
const fs = require("node:fs");
const response = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const [kind, role, countText] = process.argv.slice(3);
const brains = response.brains || [];
const count = Number(countText);
if (brains.length !== count) {
  throw new Error(`expected ${count} agent-visible Brains, received ${JSON.stringify(brains)}`);
}
if (brains.some((brain) => brain.kind !== kind || brain.role !== role)) {
  throw new Error(`expected every Brain to be ${kind}/${role}, received ${JSON.stringify(brains)}`);
}
JS
}

agent_visible_brain_id() {
  local expected_kind="$1"
  local expected_role="$2"
  assert_agent_brain_list "$expected_kind" "$expected_role" 1
  node - "$brains_json" <<'JS'
const fs = require("node:fs");
const response = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
process.stdout.write(response.brains[0].brainId);
JS
}

assert_agent_brain_shape() {
  local brain_id="$1"
  local expected_folder_count="$2"
  local expected_admin_count="$3"
  local expected_name="${4:-}"
  local metadata_json="$state_dir/brain-matrix-metadata.json"
  runtime_exec "$container_machine_id" fbrain brain metadata "$brain_id" --json >"$metadata_json"
  node - "$metadata_json" "$brain_id" "$expected_folder_count" "$expected_admin_count" "$expected_name" <<'JS'
const fs = require("node:fs");
const value = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const [brainId, folderCountText, adminCountText, expectedName] = process.argv.slice(3);
const folderCount = Number(folderCountText);
const adminCount = Number(adminCountText);
if (value.brainId !== brainId) throw new Error(`expected ${brainId}, received ${value.brainId}`);
if (expectedName && value.name !== expectedName) throw new Error(`expected Brain name ${expectedName}, received ${value.name}`);
if (value.folders.length !== folderCount) throw new Error(`expected ${folderCount} Folders, received ${JSON.stringify(value.folders)}`);
if (value.admins.length !== adminCount || new Set(value.admins).size !== value.admins.length) {
  throw new Error(`expected ${adminCount} unique admins, received ${JSON.stringify(value.admins)}`);
}
if (folderCount === 0 && value.grantCount !== 0) throw new Error(`empty Brain has ${value.grantCount} grants`);
if ((value.identities || []).some((identity) => !identity.display)) throw new Error("identity display metadata is empty");
JS
}

browser_brain_id() {
  local action="$1"
  local expected_text="${2:-}"
  local target_brain_id="${3:-}"
  local output
  output="$(brain_browser_smoke "$action" "$expected_text" "$target_brain_id")"
  printf '%s\n' "$output" >&2
  sed -n 's/^BRAIN_ID=//p' <<<"$output" | tail -1
}

run_brain_setup_matrix() {
  local agent_id
  local browser_id
  local first_same_name_id
  local second_same_name_id
  local reply
  local personal_marker="Matrix agent Personal resumed task $(date +%s)-$$"
  local org_name="Matrix Agent Org $(date +%s)-$$"
  # Negative and unclear clarifications are real Product turns. Each case gets
  # a fresh chat so prior conversation state cannot answer the question for it.
  reset_brain_setup_matrix_state
  create_topic_and_require_first_chat "Brain Personal decline"
  reply="$(send_and_capture_reply \
    "Please put a note named Matrix declined setup in my Personal Brain. If it is not set up, ask me before creating it.")"
  grep -Eiq 'personal.*(set up|setup)|set up.*personal' <<<"$reply" || {
    echo "managed FiniteBrain skill did not ask the Personal setup question" >&2
    return 1
  }
  send_and_capture_reply "No. Do not set up a Personal Brain and do not create the note." >/dev/null
  assert_agent_brain_list personal personal_agent 0

  reset_brain_setup_matrix_state
  create_topic_and_require_first_chat "Brain Personal unclear"
  send_and_capture_reply \
    "Please put a note named Matrix unclear setup in my Personal Brain. If it is not set up, ask me before creating it." >/dev/null
  send_and_capture_reply "Maybe later; I have not decided." >/dev/null
  assert_agent_brain_list personal personal_agent 0

  # Agent-first Personal setup starts with natural language, receives one
  # affirmative clarification, and must resume the original durable task.
  reset_brain_setup_matrix_state
  create_topic_and_require_first_chat "Brain Personal affirmative"
  reply="$(send_and_capture_reply \
    "Please create a Markdown note whose exact text includes '${personal_marker}' in my Personal Brain. If my Personal Brain is not set up, ask me once and then continue this same task after setup.")"
  grep -Eiq 'personal.*(set up|setup)|set up.*personal' <<<"$reply" || {
    echo "managed FiniteBrain skill skipped the Personal setup clarification" >&2
    return 1
  }
  send_and_capture_reply \
    "Yes, set up my Personal Brain now and continue creating that exact note." >/dev/null
  agent_id="$(agent_visible_brain_id personal personal_agent)"
  assert_agent_brain_shape "$agent_id" 1 0
  runtime_exec \
    -e "DEVFINITY_PERSONAL_MARKER=$personal_marker" \
    "$container_machine_id" /bin/bash -lc '
      grep -R -F --include="*.md" --exclude="_index.md" \
        -- "$DEVFINITY_PERSONAL_MARKER" "/data/workspace/finitebrain/$1" >/dev/null
    ' _ "$agent_id"
  browser_id="$(browser_brain_id assert-existing-personal)"
  [[ "$browser_id" == "$agent_id" ]] || { echo "agent-first Personal Brain ids differ" >&2; return 1; }
  brain_browser_smoke assert-folder "$personal_marker" "$agent_id"

  # Agent-first Organization setup is likewise a real authenticated Finite
  # Chat request. The skill must derive the requester from event.source.user_id
  # and create both admins atomically through the built fbrain executable.
  reset_brain_setup_matrix_state
  create_topic_and_require_first_chat "Brain agent Organization"
  send_and_capture_reply \
    "Create an Organization Brain named '${org_name}'. Keep it empty; do not create example Folders or Pages." >/dev/null
  agent_id="$(agent_visible_brain_id organization admin)"
  assert_agent_brain_shape "$agent_id" 0 2
  browser_id="$(browser_brain_id assert-org-first "$agent_id")"
  [[ "$browser_id" == "$agent_id" ]] || { echo "agent-first Org Brain ids differ" >&2; return 1; }
  send_and_capture_reply \
    "Create an Organization Brain named '${org_name}' again. Do not create a duplicate if it already exists." >/dev/null
  assert_agent_brain_list organization admin 1
  assert_agent_brain_shape "$agent_id" 0 2

  # Exercise the missing-domain-skill policy through the real managed Hermes
  # Runtime, terminal tool, fbrain executable, Brain server, and Working Tree.
  runtime_exec "$container_machine_id" /bin/bash -lc '
    set -euo pipefail
    mkdir -p /tmp/finitebrain-authoritative
    printf "%s\n" \
      "# Orbit API" \
      "" \
      "Publisher: Orbit Project" \
      "Document class: primary product documentation" \
      "Canonical URL: https://docs.orbit.invalid/api" \
      "" \
      "Orbit API clients authenticate with a bearer token, send \`Orbit-Version: 2026-07-01\`, and retry HTTP 429 according to \`Retry-After\`." \
      > /tmp/finitebrain-authoritative/orbit-api.md
  '
  create_topic_and_require_first_chat "Brain missing skill sourced"
  reply="$(send_and_capture_reply \
    "Matrix missing skill sourced for Brain ${agent_id}: use the orbit-sdk skill to add authoritative Orbit API guidance. If that skill is absent, follow the FiniteBrain missing-skill policy.")"
  grep -Eiq 'skill.*absent|skill.*missing|not installed' <<<"$reply" || {
    echo "managed agent did not report the missing domain skill" >&2
    return 1
  }
  runtime_exec "$container_machine_id" /bin/bash -lc '
    set -euo pipefail
    root="/data/workspace/finitebrain/$1/Research"
    test -f "$root/raw/orbit-api.md"
    test -f "$root/wiki/orbit-api-client-behavior.md"
    grep -Fq "Publisher: Orbit Project" "$root/raw/orbit-api.md"
    grep -Fq "Orbit-Version: 2026-07-01" "$root/wiki/orbit-api-client-behavior.md"
    grep -Fq "[[raw/orbit-api.md|" "$root/wiki/orbit-api-client-behavior.md"
    grep -Fq "[[wiki/orbit-api-client-behavior.md|" "$root/index.md"
    grep -Fq "[[raw/orbit-api.md|" "$root/index.md"
    grep -Fq "[[wiki/orbit-api-client-behavior.md|" "$root/log.md"
    grep -Fq "No broader retry policy is asserted" "$root/wiki/orbit-api-client-behavior.md"
  ' _ "$agent_id"

  runtime_exec "$container_machine_id" rm -f /tmp/finitebrain-authoritative/orbit-api.md
  local before_no_source
  local after_no_source
  before_no_source="$(runtime_exec "$container_machine_id" /bin/bash -lc '
    set -euo pipefail
    find "/data/workspace/finitebrain/$1" -type f \
      ! -path '*/.finitebrain/*' -print0 \
      | sort -z | xargs -0 sha256sum
  ' _ "$agent_id")"
  create_topic_and_require_first_chat "Brain missing skill no source"
  reply="$(send_and_capture_reply \
    "Matrix missing skill no source for Brain ${agent_id}: use the orbit-sdk skill to add another Orbit guide, but no authoritative source is available.")"
  grep -Eiq 'blocked|no authoritative|wrote no' <<<"$reply" || {
    echo "managed agent did not explain the no-source blocker" >&2
    return 1
  }
  after_no_source="$(runtime_exec "$container_machine_id" /bin/bash -lc '
    set -euo pipefail
    find "/data/workspace/finitebrain/$1" -type f \
      ! -path '*/.finitebrain/*' -print0 \
      | sort -z | xargs -0 sha256sum
  ' _ "$agent_id")"
  [[ "$after_no_source" == "$before_no_source" ]] || {
    echo "missing-skill no-source scenario mutated Brain content" >&2
    return 1
  }

  # Same display names are deliberately non-identifying. Create both through
  # the Product Client, then prove its direct-target open selects each stable
  # Brain id rather than whichever same-name row happens to sort first.
  reset_brain_setup_matrix_state
  first_same_name_id="$(browser_brain_id create-org-agent "Matrix Same Name Org")"
  second_same_name_id="$(browser_brain_id create-org-agent "Matrix Same Name Org" "$first_same_name_id")"
  [[ -n "$first_same_name_id" && -n "$second_same_name_id" \
    && "$first_same_name_id" != "$second_same_name_id" ]] || {
    echo "same-name Organization Brains did not receive distinct stable identities" >&2
    return 1
  }
  assert_agent_brain_list organization admin 2
  assert_agent_brain_shape "$first_same_name_id" 0 2 "Matrix Same Name Org"
  assert_agent_brain_shape "$second_same_name_id" 0 2 "Matrix Same Name Org"
  browser_id="$(browser_brain_id assert-org-first "$first_same_name_id")"
  [[ "$browser_id" == "$first_same_name_id" ]] || {
    echo "targeted open selected the wrong first same-name Brain" >&2
    return 1
  }
  browser_id="$(browser_brain_id assert-org-first "$second_same_name_id")"
  [[ "$browser_id" == "$second_same_name_id" ]] || {
    echo "targeted open selected the wrong second same-name Brain" >&2
    return 1
  }

  reset_brain_setup_matrix_state
  browser_id="$(browser_brain_id bootstrap)"
  agent_id="$(agent_visible_brain_id personal personal_agent)"
  [[ "$browser_id" == "$agent_id" ]] || { echo "user-first Personal Brain ids differ" >&2; return 1; }
  assert_agent_brain_shape "$agent_id" 0 0
  brain_browser_smoke create-folder "Matrix User Personal Folder" "$browser_id"
  assert_agent_brain_shape "$agent_id" 1 0

  reset_brain_setup_matrix_state
  browser_id="$(browser_brain_id create-org-agent "Matrix User Agent Org")"
  agent_id="$(agent_visible_brain_id organization admin)"
  [[ "$browser_id" == "$agent_id" ]] || { echo "user-first paired Org Brain ids differ" >&2; return 1; }
  assert_agent_brain_shape "$agent_id" 0 2
  brain_browser_smoke create-folder "Matrix User Org Folder" "$browser_id"
  assert_agent_brain_shape "$agent_id" 1 2

  reset_brain_setup_matrix_state
  browser_id="$(browser_brain_id create-org-human "Matrix Human Only Org")"
  assert_agent_brain_list organization admin 0
  brain_browser_smoke create-folder "Matrix Human Only Folder" "$browser_id"
  assert_agent_brain_list organization admin 0

  echo "devfinity real Hermes/managed-skill Brain setup/reconciliation matrix passed"
}

container_started_at() {
  if [[ "$runtime_driver" == docker ]]; then
    docker inspect --format '{{.State.StartedAt}}' "$container_machine_id" 2>/dev/null || true
    return
  fi
  container inspect "$container_machine_id" 2>/dev/null | node -e '
    let body = "";
    process.stdin.on("data", (chunk) => body += chunk);
    process.stdin.on("end", () => {
      const value = JSON.parse(body);
      process.stdout.write(String(value?.[0]?.status?.startedDate || ""));
    });
  ' 2>/dev/null || true
}

restart_runtime_after_brain_matrix_resets() {
  local started_before started_after restart_started
  started_before="$(container_started_at)"
  curl_customer -H 'content-type: application/json' -X POST --data '{}' \
    "$core_url/api/core/v1/me/projects/$project_id/runtime/restart" >/dev/null
  restart_started="$(date +%s)"
  while true; do
    started_after="$(container_started_at)"
    if [[ -n "$started_after" && "$started_after" != "$started_before" ]]; then
      break
    fi
    if (( "$(date +%s)" - restart_started >= 180 )); then
      echo "Runner did not restart Runtime after destructive Brain matrix" >&2
      return 1
    fi
    sleep 2
  done
  wait_http "Agent Runtime after Brain matrix" "$runtime_url/healthz" 180
}

runtime_agent_npub() {
  curl -fsS --max-time 5 "$runtime_url/healthz" | node -e '
    let body = "";
    process.stdin.on("data", (chunk) => body += chunk);
    process.stdin.on("end", () => {
      const value = JSON.parse(body);
      const npub = String(value.agent_npub || value.npub || "");
      if (!value.ready || !npub.startsWith("npub1")) process.exit(1);
      process.stdout.write(npub);
    });
  '
}

brain_browser_smoke() {
  local action="$1"
  local expected_text="${2:-}"
  local target_brain_id="${3:-}"
  (
    cd "$dashboard_dir"
      DEVFINITY_BRAIN_MACHINE_ID="$machine_id" \
      DEVFINITY_BRAIN_CONTAINER_ID="$container_machine_id" \
      DEVFINITY_BRAIN_AGENT_EMAIL="$agent_email" \
      DEVFINITY_BRAIN_EXPECTED_TEXT="$expected_text" \
      DEVFINITY_BRAIN_TARGET_ID="$target_brain_id" \
      node --import tsx scripts/devfinity-brain-smoke.ts "$action"
  )
}

record_brain_matrix_check() {
  [[ "${DEVFINITY_BRAIN_PRODUCT_MATRIX:-0}" == "1" ]] || return 0
  mkdir -p "$state_dir/brain-matrix-checks"
  : >"$state_dir/brain-matrix-checks/$1"
}

personal_agent_brain_id() {
  runtime_exec "$container_machine_id" fbrain brain list --json >"$brains_json"
  node - "$brains_json" <<'JS'
const fs = require("node:fs");
const response = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const personal = (response.brains || []).find(
  (brain) => brain.kind === "personal" && brain.role === "personal_agent"
);
if (!personal?.brainId) {
  throw new Error("Agent Principal cannot discover its user-owned Personal Brain as Personal Agent");
}
process.stdout.write(personal.brainId);
JS
}

open_and_sync_personal_brain() {
  runtime_exec "$container_machine_id" fbrain folder create agent-notes \
    --brain "$brain_id" \
    --name "Agent notes" \
    --path agent-notes \
    --json >/dev/null
  runtime_exec "$container_machine_id" fbrain open "$brain_id" --json >"$brain_open_json"
  node - "$brain_open_json" "$brain_tree" <<'JS'
const fs = require("node:fs");
const response = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
if (response.path !== process.argv[3] || response.nextCommandWorkingDirectory !== process.argv[3]) {
  throw new Error(`fbrain opened ${response.path}, expected durable tree ${process.argv[3]}`);
}
JS
  # Exercise the exact post-open workflow documented by the managed skill.
  runtime_exec -w "$brain_tree" "$container_machine_id" fbrain status --json >/dev/null
  runtime_exec -w "$brain_tree" "$container_machine_id" fbrain conflicts --json >/dev/null
  runtime_exec -w "$brain_tree" "$container_machine_id" fbrain sync now --json \
    >"$brain_sync_json"
  assert_personal_agent_scope
  runtime_exec "$container_machine_id" /bin/bash -lc '
    test "$FINITE_HOME" = /data/agent
    test "$FBRAIN_CONFIG_DIR" = /data/agent/fbrain
    test "$FBRAIN_WORKING_TREE_ROOT" = /data/workspace/finitebrain
    test -f /data/agent/identity/identity.json
    test -d /data/agent/fbrain
    test ! -e /root/.finite/identity/identity.json
    test ! -e /root/.finitebrain
    test ! -e /root/finitebrain
  '
}

assert_personal_agent_scope() {
  runtime_exec "$container_machine_id" cat \
    "$brain_tree/.finitebrain/brain-directory.json" >"$brain_directory_json"
  runtime_exec "$container_machine_id" cat \
    "$brain_tree/.finitebrain/working-tree-state.json" >"$brain_tree_state_json"
  node - \
    "$brain_directory_json" \
    "$brain_tree_state_json" \
    "$brain_id" \
    "$agent_npub_before" <<'JS'
const fs = require("node:fs");
const directory = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const treeState = JSON.parse(fs.readFileSync(process.argv[3], "utf8"));
const expectedBrainId = process.argv[4];
const agentNpub = process.argv[5];
if (directory.brain?.id !== expectedBrainId || directory.brain?.kind !== "personal") {
  throw new Error("Agent Working Tree is not the user-owned Personal Brain");
}
if (!directory.brain.ownerNpub || directory.brain.ownerNpub === agentNpub) {
  throw new Error("Agent Working Tree must name the distinct user owner, never the Agent Principal");
}
const roots = treeState.folderRoots || [];
const notes = roots.find((root) => root.folderId === "agent-notes" && root.path === "agent-notes");
if (!notes || roots.some((root) => root.canRead !== true || root.metadataOnly !== false)) {
  throw new Error(
    `Personal Agent must read every Personal Brain Folder; unexpected roots: ${JSON.stringify(roots)}`
  );
}
JS
  runtime_exec -e "EXPECTED_BRAIN_ID=$brain_id" -e "EXPECTED_ACTOR=$agent_npub_before" \
    "$container_machine_id" /bin/bash -lc '
      set -euo pipefail
      context="/data/workspace/finitebrain/$EXPECTED_BRAIN_ID/AGENTS.md"
      grep -Fq "Personal Brain Working Tree" "$context"
      grep -Fq "Brain ID: \`$EXPECTED_BRAIN_ID\`" "$context"
      grep -Fq "Acting Member Identity: \`$EXPECTED_ACTOR\`" "$context"
      grep -Fq "Acting Brain role: \`personal_agent\`" "$context"
    '
  record_brain_matrix_check personal-context-and-open-workflow
}

write_personal_agent_note() {
  runtime_exec \
    -e "DEVFINITY_BRAIN_PROOF=$brain_proof" \
    -w "$brain_tree/agent-notes" \
    "$container_machine_id" \
    /bin/bash -lc '
      umask 077
      printf "# %s\n\nWritten by the paired Agent Principal through fbrain.\n" \
        "$DEVFINITY_BRAIN_PROOF" >devfinity-agent-proof.md
    '
  runtime_exec -w "$brain_tree" "$container_machine_id" fbrain sync now --json \
    >"$brain_sync_json"
}

exercise_brain_content_and_deletion_matrix() {
  local collaborator_npub
  local shared_brain_id
  local shared_brain_tree
  shared_brain_id="$(browser_brain_id create-org-agent "Matrix Shared Deletion Org" "$brain_id")"
  shared_brain_tree="/data/workspace/finitebrain/$shared_brain_id"
  local collaborator_tree="/data/matrix-collaborator/workspace/$shared_brain_id"
  local deletion_marker="Matrix nested deletion $shared_brain_id"
  local individual_marker="Matrix individual deletion $shared_brain_id"
  local signer_failure_log="$state_dir/brain-matrix-signer-failure.log"
  track_sensitive_file "$signer_failure_log"
  local shared_open_json="$state_dir/brain-matrix-shared-open.json"
  runtime_exec "$container_machine_id" fbrain open "$shared_brain_id" --json >"$shared_open_json"
  node - "$shared_open_json" "$shared_brain_tree" <<'JS'
const fs = require("node:fs");
const opened = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
if (opened.path !== process.argv[3] || opened.nextCommandWorkingDirectory !== process.argv[3]) {
  throw new Error("Organization Brain open did not return its required command directory");
}
JS
  runtime_exec -w "$shared_brain_tree" "$container_machine_id" fbrain status --json >/dev/null
  runtime_exec -w "$shared_brain_tree" "$container_machine_id" fbrain conflicts --json >/dev/null
  runtime_exec -e "EXPECTED_BRAIN_ID=$shared_brain_id" -e "EXPECTED_ACTOR=$agent_npub_before" \
    "$container_machine_id" /bin/bash -lc '
      set -euo pipefail
      context="/data/workspace/finitebrain/$EXPECTED_BRAIN_ID/AGENTS.md"
      grep -Fq "Organization Brain Working Tree" "$context"
      grep -Fq "Brain ID: \`$EXPECTED_BRAIN_ID\`" "$context"
      grep -Fq "Acting Member Identity: \`$EXPECTED_ACTOR\`" "$context"
      grep -Fq "Acting Brain role: \`admin\`" "$context"
    '
  record_brain_matrix_check organization-admin-context-and-open-workflow

  # A distinct valid signer has no relationship to this Brain. Its signed
  # request must fail without changing the authorized agent's durable state.
  if runtime_exec \
    -e FINITE_HOME=/data/matrix-unauthorized/finite \
    -e FBRAIN_CONFIG_DIR=/data/matrix-unauthorized/fbrain \
    -e FBRAIN_WORKING_TREE_ROOT=/data/matrix-unauthorized/workspace \
    "$container_machine_id" fbrain brain metadata "$shared_brain_id" --json \
    > /dev/null 2>"$signer_failure_log"; then
    echo "unrelated signed Brain request unexpectedly succeeded" >&2
    return 1
  fi
  test -s "$signer_failure_log"
  assert_agent_brain_shape "$shared_brain_id" 0 2

  runtime_exec "$container_machine_id" fbrain folder create matrix-delete-root \
    --brain "$shared_brain_id" --name "Matrix delete root" --path matrix-delete-root --json >/dev/null
  runtime_exec "$container_machine_id" fbrain folder create matrix-delete-child \
    --brain "$shared_brain_id" --parent matrix-delete-root --name "Matrix delete child" \
    --path matrix-delete-root/child --json >/dev/null
  runtime_exec -w "$shared_brain_tree" "$container_machine_id" fbrain sync now --json >/dev/null
  runtime_exec -e "DELETION_MARKER=$deletion_marker" -e "INDIVIDUAL_MARKER=$individual_marker" \
    "$container_machine_id" /bin/bash -lc '
      set -euo pipefail
      mkdir -p "/data/workspace/finitebrain/$1/matrix-delete-root/child"
      printf "# %s\n\nNested deletion proof\n" "$DELETION_MARKER" \
        >"/data/workspace/finitebrain/$1/matrix-delete-root/child/nested.md"
      printf "# %s\n\nIndividual deletion proof\n" "$INDIVIDUAL_MARKER" \
        >"/data/workspace/finitebrain/$1/matrix-delete-root/individual.md"
    ' _ "$shared_brain_id"
  runtime_exec -w "$shared_brain_tree" "$container_machine_id" fbrain sync now --json >/dev/null
  brain_browser_smoke assert-note "$deletion_marker" "$shared_brain_id"
  brain_browser_smoke assert-note "$individual_marker" "$shared_brain_id"

  collaborator_npub="$(runtime_exec \
    -e FINITE_HOME=/data/matrix-collaborator/finite \
    -e FBRAIN_CONFIG_DIR=/data/matrix-collaborator/fbrain \
    -e FBRAIN_WORKING_TREE_ROOT=/data/matrix-collaborator/workspace \
    "$container_machine_id" fbrain signer public-key)"
  [[ "$collaborator_npub" == npub1* ]] || {
    echo "matrix collaborator did not produce an npub" >&2
    return 1
  }
  runtime_exec -w "$shared_brain_tree" "$container_machine_id" fbrain admin member add \
    --brain "$shared_brain_id" --target "$collaborator_npub" --json >/dev/null
  runtime_exec -w "$shared_brain_tree" "$container_machine_id" fbrain admin folder-access grant \
    --brain "$shared_brain_id" --folder matrix-delete-root --target "$collaborator_npub" --json >/dev/null
  runtime_exec -w "$shared_brain_tree" "$container_machine_id" fbrain admin folder-access grant \
    --brain "$shared_brain_id" --folder matrix-delete-child --target "$collaborator_npub" --json >/dev/null
  runtime_exec \
    -e FINITE_HOME=/data/matrix-collaborator/finite \
    -e FBRAIN_CONFIG_DIR=/data/matrix-collaborator/fbrain \
    -e FBRAIN_WORKING_TREE_ROOT=/data/matrix-collaborator/workspace \
    "$container_machine_id" fbrain open "$shared_brain_id" --json >/dev/null
  runtime_exec \
    -e FINITE_HOME=/data/matrix-collaborator/finite \
    -e FBRAIN_CONFIG_DIR=/data/matrix-collaborator/fbrain \
    -e FBRAIN_WORKING_TREE_ROOT=/data/matrix-collaborator/workspace \
    -e "EXPECTED_BRAIN_ID=$shared_brain_id" -e "EXPECTED_ACTOR=$collaborator_npub" \
    -w "$collaborator_tree" "$container_machine_id" /bin/bash -lc '
      set -euo pipefail
      fbrain status --json >/dev/null
      fbrain conflicts --json >/dev/null
      grep -Fq "Organization Brain Working Tree" AGENTS.md
      grep -Fq "Brain ID: \`$EXPECTED_BRAIN_ID\`" AGENTS.md
      grep -Fq "Acting Member Identity: \`$EXPECTED_ACTOR\`" AGENTS.md
      grep -Fq "Acting Brain role: \`member\`" AGENTS.md
    '
  record_brain_matrix_check organization-member-context-and-open-workflow
  runtime_exec \
    -e FINITE_HOME=/data/matrix-collaborator/finite \
    -e FBRAIN_CONFIG_DIR=/data/matrix-collaborator/fbrain \
    -e FBRAIN_WORKING_TREE_ROOT=/data/matrix-collaborator/workspace \
    "$container_machine_id" /bin/bash -lc '
      fbrain daemon supervise >/tmp/fbrain-matrix-collaborator.log 2>&1 &
      echo $! >/tmp/fbrain-matrix-collaborator.pid
    '
  runtime_exec \
    -e FINITE_HOME=/data/matrix-collaborator/finite \
    -e FBRAIN_CONFIG_DIR=/data/matrix-collaborator/fbrain \
    -e FBRAIN_WORKING_TREE_ROOT=/data/matrix-collaborator/workspace \
    -w "$collaborator_tree" "$container_machine_id" /bin/bash -lc '
      for attempt in $(seq 1 100); do
        kill -0 "$(cat /tmp/fbrain-matrix-collaborator.pid)" 2>/dev/null && exit 0
        sleep 0.1
      done
      echo "collaborator Brain supervisor did not become live" >&2
      exit 1
    '
  runtime_exec "$container_machine_id" grep -Fq "$deletion_marker" \
    "$collaborator_tree/matrix-delete-root/child/nested.md"

  local agent_to_agent_marker="Matrix Agent notification $shared_brain_id"
  runtime_exec -e "AGENT_TO_AGENT_MARKER=$agent_to_agent_marker" \
    "$container_machine_id" /bin/bash -lc '
      printf "# %s\n\nNotification-driven two-Agent convergence.\n" "$AGENT_TO_AGENT_MARKER" \
        >"/data/workspace/finitebrain/$1/matrix-delete-root/agent-notification.md"
      for attempt in $(seq 1 300); do
        grep -Fq "$AGENT_TO_AGENT_MARKER" \
          "/data/matrix-collaborator/workspace/$1/matrix-delete-root/agent-notification.md" \
          2>/dev/null && exit 0
        sleep 0.1
      done
      echo "second Agent did not converge through Brain Update Notifications" >&2
      exit 1
    ' _ "$shared_brain_id"
  record_brain_matrix_check agent-to-agent-notification

  local personal_independent_marker="Matrix independent Personal $brain_id"
  local org_independent_marker="Matrix independent Organization $shared_brain_id"
  runtime_exec -e "PERSONAL_MARKER=$personal_independent_marker" \
    -e "ORG_MARKER=$org_independent_marker" "$container_machine_id" /bin/bash -lc '
      printf "# %s\n\nIndependent Brain scheduling proof.\n" "$PERSONAL_MARKER" \
        >"/data/workspace/finitebrain/$1/agent-notes/independent-brain.md"
      printf "# %s\n\nIndependent Brain scheduling proof.\n" "$ORG_MARKER" \
        >"/data/workspace/finitebrain/$2/matrix-delete-root/independent-brain.md"
      for attempt in $(seq 1 300); do
        grep -Fq "$ORG_MARKER" \
          "/data/matrix-collaborator/workspace/$2/matrix-delete-root/independent-brain.md" \
          2>/dev/null && exit 0
        sleep 0.1
      done
      echo "activity in the Personal Brain blocked Organization Brain scheduling" >&2
      exit 1
    ' _ "$brain_id" "$shared_brain_id"
  brain_browser_smoke reconnect-catchup "$personal_independent_marker" "$brain_id"
  record_brain_matrix_check independent-brain-scheduling

  runtime_exec "$container_machine_id" rm \
    "$shared_brain_tree/matrix-delete-root/individual.md"
  runtime_exec -w "$shared_brain_tree" "$container_machine_id" fbrain sync now --json >/dev/null
  brain_browser_smoke assert-absent "$individual_marker" "$shared_brain_id"

  # The collaborator is now offline. Direct deletion must clean the agent's
  # durable projection before returning, then converge the collaborator on its
  # first incremental reconnect without a reset.
  runtime_exec "$container_machine_id" cat \
    "$collaborator_tree/.finitebrain/working-tree-state.json" \
    >"$state_dir/brain-matrix-collaborator-before-delete.json"
  (
    for _attempt in 1 2 3 4 5 6 7 8; do
      runtime_exec \
        -e FINITE_HOME=/data/matrix-collaborator/finite \
        -e FBRAIN_CONFIG_DIR=/data/matrix-collaborator/fbrain \
        -e FBRAIN_WORKING_TREE_ROOT=/data/matrix-collaborator/workspace \
        -w "$collaborator_tree" "$container_machine_id" fbrain sync now --json >/dev/null
      sleep 0.1
    done
  ) &
  local collaborator_sync_pid=$!
  runtime_exec -w "$shared_brain_tree" "$container_machine_id" fbrain folder delete matrix-delete-root \
    --brain "$shared_brain_id" --json >/dev/null
  wait "$collaborator_sync_pid"
  if runtime_exec "$container_machine_id" test -e "$shared_brain_tree/matrix-delete-root"; then
    echo "direct folder deletion left the agent projection root on disk" >&2
    return 1
  fi
  if runtime_exec "$container_machine_id" test -e "$collaborator_tree/matrix-delete-root"; then
    echo "incremental tombstone sync left the collaborator projection root on disk" >&2
    return 1
  fi
  brain_browser_smoke assert-absent "$deletion_marker" "$shared_brain_id"

  # Access loss must be urgent and non-destructive. Stop the collaborator so
  # its edit is certainly unsynced, revoke it, then restart its supervisor and
  # prove authoritative catch-up pauses the Brain while preserving plaintext.
  local revocation_marker="Matrix browser revocation $shared_brain_id"
  runtime_exec "$container_machine_id" fbrain folder create matrix-revocation \
    --brain "$shared_brain_id" --name "Matrix revocation" --path matrix-revocation \
    --access all_members --json >/dev/null
  runtime_exec "$container_machine_id" /bin/bash -lc '
    for attempt in $(seq 1 300); do
      test -d "/data/matrix-collaborator/workspace/$1/matrix-revocation" && exit 0
      sleep 0.1
    done
    echo "collaborator did not receive the newly created all-members Folder" >&2
    exit 1
  ' _ "$shared_brain_id"
  runtime_exec -e "REVOCATION_MARKER=$revocation_marker" -w "$shared_brain_tree" \
    "$container_machine_id" /bin/bash -lc '
      printf "# %s\n\nVisible before browser access is revoked.\n" "$REVOCATION_MARKER" \
        >matrix-revocation/browser-revocation.md
      for attempt in $(seq 1 300); do
        test -f "/data/matrix-collaborator/workspace/$1/matrix-revocation/browser-revocation.md" && exit 0
        sleep 0.1
      done
      echo "collaborator did not converge before revocation" >&2
      exit 1
    ' _ "$shared_brain_id"
  runtime_exec "$container_machine_id" /bin/bash -lc '
    kill "$(cat /tmp/fbrain-matrix-collaborator.pid)"
    for attempt in $(seq 1 100); do
      kill -0 "$(cat /tmp/fbrain-matrix-collaborator.pid)" 2>/dev/null || exit 0
      sleep 0.1
    done
    exit 1
  '
  local local_conflict_marker="Matrix collaborator conflict $shared_brain_id"
  local remote_conflict_marker="$revocation_marker remote"
  local unrelated_marker="$revocation_marker unrelated"
  runtime_exec -e "LOCAL_CONFLICT_MARKER=$local_conflict_marker" "$container_machine_id" /bin/bash -lc '
    printf "# %s\n\nPreserve this local version.\n" "$LOCAL_CONFLICT_MARKER" \
      >"/data/matrix-collaborator/workspace/$1/matrix-revocation/browser-revocation.md"
  ' _ "$shared_brain_id"
  brain_browser_smoke live-browser-conflict "$revocation_marker" "$shared_brain_id"
  record_brain_matrix_check browser-conflict-and-unrelated-progress
  runtime_exec \
    -e FINITE_HOME=/data/matrix-collaborator/finite \
    -e FBRAIN_CONFIG_DIR=/data/matrix-collaborator/fbrain \
    -e FBRAIN_WORKING_TREE_ROOT=/data/matrix-collaborator/workspace \
    "$container_machine_id" /bin/bash -lc '
      fbrain daemon supervise >/tmp/fbrain-matrix-collaborator-conflict.log 2>&1 &
      echo $! >/tmp/fbrain-matrix-collaborator.pid
    '
  runtime_exec \
    -e FINITE_HOME=/data/matrix-collaborator/finite \
    -e FBRAIN_CONFIG_DIR=/data/matrix-collaborator/fbrain \
    -e FBRAIN_WORKING_TREE_ROOT=/data/matrix-collaborator/workspace \
    -e "LOCAL_CONFLICT_MARKER=$local_conflict_marker" -e "UNRELATED_MARKER=$unrelated_marker" \
    -w "$collaborator_tree" "$container_machine_id" /bin/bash -lc '
      for attempt in $(seq 1 300); do
        count="$(fbrain conflicts --json | python3 -c '\''import json,sys; print(len(json.load(sys.stdin)))'\'')"
        test "$count" -gt 0 && grep -Fq "$UNRELATED_MARKER" matrix-revocation/unrelated-progress.md 2>/dev/null && break
        sleep 0.1
      done
      test "$(fbrain conflicts --json | python3 -c '\''import json,sys; print(len(json.load(sys.stdin)))'\'')" -gt 0
      grep -Fq "$LOCAL_CONFLICT_MARKER" matrix-revocation/browser-revocation.md
      grep -Fq "$UNRELATED_MARKER" matrix-revocation/unrelated-progress.md
      kill "$(cat /tmp/fbrain-matrix-collaborator.pid)"
      for attempt in $(seq 1 100); do
        kill -0 "$(cat /tmp/fbrain-matrix-collaborator.pid)" 2>/dev/null || exit 0
        sleep 0.1
      done
      exit 1
    '
  record_brain_matrix_check agent-conflict-and-unrelated-progress
  record_brain_matrix_check agent-reconnect-sequence-catchup
  runtime_exec -e "REVOCATION_MARKER=$revocation_marker" "$container_machine_id" /bin/bash -lc '
    printf "# Unsynced after revocation\n\n%s\n" "$REVOCATION_MARKER" \
      >"/data/matrix-collaborator/workspace/$1/matrix-revocation/unsynced-preserved.md"
  ' _ "$shared_brain_id"
  runtime_exec -w "$shared_brain_tree" "$container_machine_id" fbrain admin member remove \
    --brain "$shared_brain_id" --target "$collaborator_npub" --json >/dev/null
  runtime_exec \
    -e FINITE_HOME=/data/matrix-collaborator/finite \
    -e FBRAIN_CONFIG_DIR=/data/matrix-collaborator/fbrain \
    -e FBRAIN_WORKING_TREE_ROOT=/data/matrix-collaborator/workspace \
    "$container_machine_id" /bin/bash -lc '
      fbrain daemon supervise >/tmp/fbrain-matrix-collaborator-revoked.log 2>&1 &
      echo $! >/tmp/fbrain-matrix-collaborator.pid
    '
  runtime_exec \
    -e FINITE_HOME=/data/matrix-collaborator/finite \
    -e FBRAIN_CONFIG_DIR=/data/matrix-collaborator/fbrain \
    -e FBRAIN_WORKING_TREE_ROOT=/data/matrix-collaborator/workspace \
    -w "$collaborator_tree" "$container_machine_id" /bin/bash -lc '
      for attempt in $(seq 1 300); do
        state="$(fbrain daemon status --json | python3 -c '\''import json,sys; print(json.load(sys.stdin)["state"])'\'')"
        test "$state" = paused && break
        sleep 0.1
      done
      test "$(fbrain daemon status --json | python3 -c '\''import json,sys; print(json.load(sys.stdin)["state"])'\'')" = paused
      test -f matrix-revocation/unsynced-preserved.md
    '
  record_brain_matrix_check agent-revocation-preserves-tree

  # Finally revoke the browser actor while the Org Brain is open and prove the
  # Product Client removes both visibility and decrypted projection state.
  brain_browser_smoke live-browser-revocation "$revocation_marker" "$shared_brain_id"
  record_brain_matrix_check browser-revocation-clears-projection
}

requesting_user_account_id() {
  node - "$chat_state_json" <<'JS'
const fs = require("node:fs");
const state = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const accountId = String(state.identity?.account_id || "");
if (!/^[0-9a-f]{64}$/u.test(accountId)) {
  throw new Error("Hosted Web Device did not expose the authenticated human account id");
}
process.stdout.write(accountId);
JS
}

publish_private_requesting_user_site() {
  local init_fields
  sites_run_id="$(date +%s)-$$"
  sites_slug="devfinity-private-${sites_run_id}"
  sites_marker="Devfinity private Sites ${sites_run_id}"
  sites_tree="/data/workspace/${sites_slug}"
  requesting_user_id="$(requesting_user_account_id)"

  runtime_exec \
    -e "DEVFINITY_SITES_SLUG=$sites_slug" \
    -e "DEVFINITY_SITES_MARKER=$sites_marker" \
    "$container_machine_id" \
    /bin/bash -lc '
      set -euo pipefail
      tree="/data/workspace/$DEVFINITY_SITES_SLUG"
      test ! -e "$tree"
      mkdir -p "$tree/site"
      printf "%s\n" \
        "[project]" \
        "slug = \"$DEVFINITY_SITES_SLUG\"" \
        "" \
        "[outputs.site]" \
        "kind = \"site\"" \
        "site_name = \"$DEVFINITY_SITES_SLUG\"" \
        "branch = \"main\"" \
        "path = \"site\"" \
        "spa = false" >"$tree/finite.toml"
      printf "<h1>%s</h1>\n" "$DEVFINITY_SITES_MARKER" >"$tree/site/index.html"
    '

  runtime_exec "$container_machine_id" fsite auth register --output json \
    >"$sites_auth_json"
  runtime_exec -w "$sites_tree" "$container_machine_id" \
    fsite project init \
      --config finite.toml \
      --requesting-user-npub "$requesting_user_id" \
      --dry-run \
      --output json \
    >"$sites_dry_run_json"
  runtime_exec -w "$sites_tree" "$container_machine_id" \
    fsite project init \
      --config finite.toml \
      --requesting-user-npub "$requesting_user_id" \
      --output json \
    >"$sites_init_json"

  init_fields="$(node - "$sites_init_json" "$sites_slug" <<'JS'
const fs = require("node:fs");
const response = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const expectedSlug = process.argv[3];
const output = response.outputs?.[0];
if (
  response.slug !== expectedSlug ||
  !response.requesting_user_npub?.startsWith("npub1") ||
  !output?.requesting_user_shared ||
  output.visibility !== "private" ||
  typeof output.output_id !== "string" ||
  typeof output.output_url !== "string" ||
  typeof response.git_remote_url !== "string"
) {
  throw new Error(`Project Init did not create the private requesting-user Share: ${JSON.stringify(response)}`);
}
process.stdout.write([
  output.output_id,
  output.output_url,
  response.git_remote_url,
].join("\t"));
JS
)"
  IFS=$'\t' read -r sites_output_id sites_url sites_git_remote <<<"$init_fields"

  runtime_exec \
    -e GIT_CONFIG_GLOBAL=/data/agent/gitconfig \
    "$container_machine_id" \
    fsite auth git "$sites_slug" --store --output json \
    >"$sites_git_auth_json"
  runtime_exec \
    -e GIT_CONFIG_GLOBAL=/data/agent/gitconfig \
    -e "DEVFINITY_SITES_GIT_REMOTE=$sites_git_remote" \
    -w "$sites_tree" \
    "$container_machine_id" \
    /bin/bash -lc '
      set -euo pipefail
      git init -b main
      git config user.name "Devfinity Sites Smoke"
      git config user.email "devfinity-sites-smoke@finite.invalid"
      git add finite.toml site
      git commit -m "Publish private requesting-user smoke site"
      git remote add finite "$DEVFINITY_SITES_GIT_REMOTE"
      git push finite main
    '

  local started status
  started="$(date +%s)"
  while true; do
    status="$(curl -sS --max-time 5 -o /dev/null -w '%{http_code}' "$sites_url" || true)"
    if [[ "$status" == "401" ]]; then
      break
    fi
    if (( "$(date +%s)" - started >= 90 )); then
      echo "Private Sites Output did not publish at $sites_url within 90s; last status $status" >&2
      return 1
    fi
    sleep 1
  done
  assert_site_unauthorized
  issue_and_redeem_site_preview "$sites_cookie_jar_before"
  echo "agent publish -> requesting user private preview ok: $sites_url"
}

issue_and_redeem_site_preview() {
  local cookie_jar="$1"
  local redeem_url status
  node -e 'process.stdout.write(JSON.stringify({ url: process.argv[1] }))' \
    "$sites_url" >"$sites_preview_request_json"
  curl -fsS --max-time 30 \
    -H 'content-type: application/json' \
    --data-binary "@$sites_preview_request_json" \
    "$dashboard_origin/api/site-previews/machines/$machine_id/session" \
    >"$sites_preview_response_json"
  redeem_url="$(node - "$sites_preview_response_json" "$sites_url" <<'JS'
const fs = require("node:fs");
const response = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const original = new URL(process.argv[3]).toString();
const redeem = new URL(String(response.url || ""));
if (
  redeem.origin !== new URL(original).origin ||
  redeem.pathname !== "/_finite/auth" ||
  !/^[0-9a-f]{64}$/u.test(redeem.searchParams.get("native_token") || "")
) {
  throw new Error(`Dashboard did not return a native Sites redemption URL: ${JSON.stringify(response)}`);
}
process.stdout.write(redeem.toString());
JS
)"
  status="$(curl -sS --max-time 15 \
    -D "$sites_redeem_headers" \
    -o /dev/null \
    -c "$cookie_jar" \
    -w '%{http_code}' \
    "$redeem_url")"
  if [[ "$status" != "303" ]]; then
    echo "Sites redemption returned HTTP $status instead of 303" >&2
    return 1
  fi
  assert_site_cookie_works "$cookie_jar"
}

assert_site_cookie_works() {
  local cookie_jar="$1"
  local body
  body="$(curl -fsS --max-time 15 -b "$cookie_jar" "$sites_url")"
  if [[ "$body" != *"$sites_marker"* ]]; then
    echo "Authenticated Sites response did not contain the smoke marker" >&2
    return 1
  fi
}

assert_site_unauthorized() {
  local status
  status="$(curl -sS --max-time 15 -o /dev/null -w '%{http_code}' "$sites_url")"
  if [[ "$status" != "401" ]]; then
    echo "Private Sites Output returned HTTP $status without a Viewer Cookie" >&2
    return 1
  fi
}

revoke_requesting_user_site() {
  runtime_exec -w "$sites_tree" "$container_machine_id" \
    fsite project share "$sites_slug" "$sites_output_id" \
      --remove-npub "$requesting_user_id" \
      --output json \
    >"$sites_revoke_json"
  node - "$sites_revoke_json" <<'JS'
const fs = require("node:fs");
const response = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
if ((response.shared_npubs || []).length !== 0) {
  throw new Error(`Requesting-user Share was not revoked: ${JSON.stringify(response)}`);
}
JS

  local status
  for cookie_jar in "$sites_cookie_jar_before" "$sites_cookie_jar_after"; do
    status="$(curl -sS --max-time 15 -o /dev/null -b "$cookie_jar" -w '%{http_code}' "$sites_url")"
    if [[ "$status" != "401" ]]; then
      echo "Revoked Sites Viewer Cookie returned HTTP $status instead of 401" >&2
      return 1
    fi
  done
  assert_site_unauthorized

  node -e 'process.stdout.write(JSON.stringify({ url: process.argv[1] }))' \
    "$sites_url" >"$sites_preview_request_json"
  curl -fsS --max-time 30 \
    -H 'content-type: application/json' \
    --data-binary "@$sites_preview_request_json" \
    "$dashboard_origin/api/site-previews/machines/$machine_id/session" \
    >"$sites_preview_response_json"
  node - "$sites_preview_response_json" "$sites_url" <<'JS'
const fs = require("node:fs");
const response = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
if (new URL(String(response.url || "")).toString() !== new URL(process.argv[3]).toString()) {
  throw new Error(`Dashboard unexpectedly minted a Sites viewer session after revocation: ${JSON.stringify(response)}`);
}
JS
  echo "requesting-user Share revocation invalidated live and future Sites sessions"
}

need curl
need node
need process-compose

case "${DEVFINITY_PROFILE:-}" in
  apple-saas)
    runtime_driver=apple
    need container
    ;;
  docker-saas)
    runtime_driver=docker
    need docker
    ;;
  *)
    echo "devfinity SaaS smoke requires the apple-saas or docker-saas profile" >&2
    exit 64
    ;;
esac
if [[ "${DEVFINITY_BRAIN_ONLY_SMOKE:-0}" != "0" && "${DEVFINITY_BRAIN_ONLY_SMOKE:-0}" != "1" ]]; then
  echo "DEVFINITY_BRAIN_ONLY_SMOKE must be 0 or 1" >&2
  exit 64
fi
if [[ "${DEVFINITY_SITES_ONLY_SMOKE:-0}" != "0" && "${DEVFINITY_SITES_ONLY_SMOKE:-0}" != "1" ]]; then
  echo "DEVFINITY_SITES_ONLY_SMOKE must be 0 or 1" >&2
  exit 64
fi
if [[ "${DEVFINITY_CHAT_SITES_ACCEPTANCE:-0}" != "0" \
  && "${DEVFINITY_CHAT_SITES_ACCEPTANCE:-0}" != "1" ]]; then
  echo "DEVFINITY_CHAT_SITES_ACCEPTANCE must be 0 or 1" >&2
  exit 64
fi
if [[ "${DEVFINITY_BRAIN_PRODUCT_MATRIX:-0}" != "0" \
  && "${DEVFINITY_BRAIN_PRODUCT_MATRIX:-0}" != "1" ]]; then
  echo "DEVFINITY_BRAIN_PRODUCT_MATRIX must be 0 or 1" >&2
  exit 64
fi

core_url="${FC_CORE_URL:?}"
dashboard_url="${FC_DASHBOARD_URL:?}"
dashboard_origin="${dashboard_url%/dashboard}"
chat_url="${FINITECHAT_SERVER_URL:?}"
hosted_device_url="${FC_HOSTED_WEB_DEVICE_URL:?}"
sites_api_url="${FC_SITES_UPSTREAM_URL:?}"
state_dir="${DEVFINITY_STATE_DIR:?}"
if [[ "${DEVFINITY_BRAIN_PRODUCT_MATRIX:-0}" == "1" \
  && "${DEVFINITY_BRAIN_PRODUCT_MATRIX_DISPOSABLE_STATE:-}" != "$state_dir" ]]; then
  echo "Brain product matrix reset requires its exact disposable state boundary" >&2
  exit 64
fi
dashboard_dir="$(pwd)/finitecomputer-v2/apps/dashboard"
me_json="$state_dir/saas-smoke-core-me.json"
chat_state_json="$state_dir/saas-smoke-chat-state.json"
chat_action_json="$state_dir/saas-smoke-chat-action.json"
brains_json="$state_dir/saas-smoke-brains.json"
brain_open_json="$state_dir/saas-smoke-brain-open.json"
brain_sync_json="$state_dir/saas-smoke-brain-sync.json"
brain_directory_json="$state_dir/saas-smoke-brain-directory.json"
brain_tree_state_json="$state_dir/saas-smoke-brain-tree-state.json"
sites_auth_json="$state_dir/saas-smoke-sites-auth.json"
sites_dry_run_json="$state_dir/saas-smoke-sites-dry-run.json"
sites_init_json="$state_dir/saas-smoke-sites-init.json"
sites_git_auth_json="$state_dir/saas-smoke-sites-git-auth.json"
sites_preview_request_json="$state_dir/saas-smoke-sites-preview-request.json"
sites_preview_response_json="$state_dir/saas-smoke-sites-preview-response.json"
sites_redeem_headers="$state_dir/saas-smoke-sites-redeem.headers"
sites_cookie_jar_before="$state_dir/saas-smoke-sites-before.cookies"
sites_cookie_jar_after="$state_dir/saas-smoke-sites-after.cookies"
sites_revoke_json="$state_dir/saas-smoke-sites-revoke.json"
track_sensitive_file "$sites_git_auth_json"
track_sensitive_file "$sites_preview_response_json"
track_sensitive_file "$sites_redeem_headers"
track_sensitive_file "$sites_cookie_jar_before"
track_sensitive_file "$sites_cookie_jar_after"

read_core_me
if ! runtime_fields >/dev/null 2>&1; then
  if node - "$me_json" <<'JS'
const fs = require("node:fs");
const me = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
process.exit((me.agent_creation_requests || []).some((request) => ["requested", "launching"].includes(request.status)) ? 0 : 1);
JS
  then
    echo "waiting for the existing real agent launch"
  else
    run_id="$(date +%s)-$$"
    issue_json="$state_dir/saas-smoke-issued-launch-code.json"
    launch_code_file="$state_dir/saas-smoke-launch-code.txt"
    track_sensitive_file "$issue_json"
    track_sensitive_file "$launch_code_file"
    umask 077
    operator_config="$state_dir/saas-smoke-operator-auth-$$-$RANDOM.conf"
    track_sensitive_file "$operator_config"
    printf 'header = "authorization: Bearer %s"\n' \
      "$(tr -d '\n' <"$state_dir/workos-fixture/operator.jwt")" >"$operator_config"
    curl -fsS --config "$operator_config" \
      -H 'content-type: application/json' \
      --data '{"name":"Devfinity Apple smoke","codeCount":1,"expiresInHours":24}' \
      "$core_url/api/core/v1/admin/launch-code-batches" >"$issue_json"
    rm -f "$operator_config"
    node - "$issue_json" "$launch_code_file" <<'JS'
const fs = require("node:fs");
const code = JSON.parse(fs.readFileSync(process.argv[2], "utf8"))?.codes?.[0]?.code;
if (typeof code !== "string" || !code) throw new Error("Core did not return a smoke Launch Code");
fs.writeFileSync(process.argv[3], code, { mode: 0o600 });
JS
    rm -f "$issue_json"
    curl -fsS \
      -o /dev/null \
      -X POST \
      --data-urlencode "displayName=Devfinity Apple Agent $run_id" \
      --data-urlencode "hostingTier=standard" \
      --data-urlencode "access=launch-code" \
      --data-urlencode "launchCode@$launch_code_file" \
      --data-urlencode "idempotencyKey=devfinity-apple-$run_id" \
      "$dashboard_url/agent-creation-requests"
    rm -f "$launch_code_file"
    echo "submitted the dashboard agent form"
  fi
fi

wait_for_runtime
container_machine_id="$(runtime_container_id)"
wait_http "Agent Runtime" "$runtime_url/healthz" 180
wait_http "Agent contact" "$runtime_url/contact" 180
start_chat_updates
wait_for_connected_chat
if [[ "${DEVFINITY_BRAIN_ONLY_SMOKE:-0}" == "0" && "${DEVFINITY_SITES_ONLY_SMOKE:-0}" == "0" ]]; then
  if [[ "${DEVFINITY_CHAT_SITES_ACCEPTANCE:-0}" == "1" ]]; then
    send_site_and_require_ordered_chat "finite-chat-site-round-1-${run_id:-$$}"
  else
    send_and_require_reply "Reply briefly with: devfinity apple chat works"
  fi
else
  echo "focused smoke: Hosted Web Device connected; real inference reply skipped"
fi

agent_npub_before="$(runtime_agent_npub)"
if [[ "${DEVFINITY_CHAT_SITES_ACCEPTANCE:-0}" != "1" ]]; then
  if [[ "${DEVFINITY_BRAIN_PRODUCT_MATRIX:-0}" == "1" ]]; then
    run_brain_setup_matrix
  fi
  brain_browser_smoke bootstrap
  brain_id="$(personal_agent_brain_id)"
  brain_tree="/data/workspace/finitebrain/$brain_id"
  brain_proof="Devfinity Agent Brain Proof $(date +%s)-$$"
  open_and_sync_personal_brain
  if [[ "${DEVFINITY_BRAIN_PRODUCT_MATRIX:-0}" == "1" ]]; then
    brain_browser_smoke live-agent-note "$brain_proof" "$brain_id"
    record_brain_matrix_check agent-to-browser-notification
    brain_browser_smoke live-browser-folder "Matrix Browser Notification Folder" "$brain_id"
    record_brain_matrix_check browser-to-agent-notification
    brain_browser_smoke live-agent-asset "matrix-notification-asset.bin" "$brain_id"
    record_brain_matrix_check asset-exact-download
    # No browser is connected between smoke actions. Commit a local Agent edit,
    # wait until the supervisor has advanced its authoritative cursor, then
    # reconnect the Product Client and prove sequence catch-up without replay or
    # an explicit refresh.
    reconnect_marker="Matrix missed notification recovery $brain_id"
    runtime_exec -e "RECONNECT_MARKER=$reconnect_marker" \
      "$container_machine_id" /bin/bash -lc '
        tree="$1"
        read_sequence() {
          (cd "$tree" && fbrain sync status --json) \
            | python3 -c '\''import json,sys; print(json.load(sys.stdin)["latestSequence"])'\''
        }
        before="$(read_sequence)"
        printf "# %s\n\nWritten while the browser notification stream was disconnected.\n" \
          "$RECONNECT_MARKER" >"$tree/agent-notes/matrix-reconnect-catchup.md"
        for attempt in $(seq 1 300); do
          after="$(read_sequence)"
          test "$after" -gt "$before" && exit 0
          sleep 0.1
        done
        echo "Agent supervisor did not upload the disconnected-browser change" >&2
        exit 1
      ' _ "$brain_tree"
    brain_browser_smoke reconnect-catchup "$reconnect_marker" "$brain_id"
    record_brain_matrix_check browser-reconnect-sequence-catchup
    brain_browser_smoke live-notification-hints "$reconnect_marker" "$brain_id"
    record_brain_matrix_check same-brain-coalescing-and-duplicate-hints
    exercise_brain_content_and_deletion_matrix
  else
    write_personal_agent_note
    brain_browser_smoke assert-note "$brain_proof"
  fi
  if [[ "${DEVFINITY_BRAIN_ONLY_SMOKE:-0}" == "0" ]]; then
    publish_private_requesting_user_site
  fi
fi

restart_process finitechat
wait_http "Finite Chat after restart" "$chat_url/health" 120
restart_process hosted-web-device
wait_http "Hosted Web Device after restart" "$hosted_device_url/healthz" 120
if [[ "${DEVFINITY_BRAIN_ONLY_SMOKE:-0}" == "0" ]]; then
  restart_process finitesites
  wait_http "Finite Sites after restart" "$sites_api_url/api/v1/healthz" 120
fi
if [[ "${DEVFINITY_CHAT_SITES_ACCEPTANCE:-0}" != "1" && "${DEVFINITY_BRAIN_ONLY_SMOKE:-0}" == "0" ]]; then
  assert_site_cookie_works "$sites_cookie_jar_before"
  issue_and_redeem_site_preview "$sites_cookie_jar_after"
fi
start_chat_updates
wait_for_connected_chat
if [[ "${DEVFINITY_BRAIN_ONLY_SMOKE:-0}" == "0" && "${DEVFINITY_SITES_ONLY_SMOKE:-0}" == "0" ]]; then
  if [[ "${DEVFINITY_CHAT_SITES_ACCEPTANCE:-0}" == "1" ]]; then
    send_site_and_require_ordered_chat "finite-chat-site-round-2-${run_id:-$$}"
    create_topic_and_require_first_chat "Sites acceptance ${run_id:-$$}"
  else
    send_and_require_reply "Reply briefly with: chat services healed"
  fi
fi

runtime_started_before="$(container_started_at)"
curl_customer \
  -H 'content-type: application/json' \
  -X POST \
  --data '{}' \
  "$core_url/api/core/v1/me/projects/$project_id/runtime/restart" \
  >/dev/null
restart_started="$(date +%s)"
while true; do
  runtime_started_after="$(container_started_at)"
  if [[ -n "$runtime_started_after" && "$runtime_started_after" != "$runtime_started_before" ]]; then
    break
  fi
  if (( "$(date +%s)" - restart_started >= 180 )); then
    echo "Runner did not restart Apple Container $container_machine_id within 180s" >&2
    exit 1
  fi
  sleep 2
done
wait_http "Agent Runtime after restart" "$runtime_url/healthz" 180
agent_npub_after="$(runtime_agent_npub)"
if [[ "$agent_npub_after" != "$agent_npub_before" ]]; then
  echo "Agent Principal changed across Apple Container restart" >&2
  exit 1
fi
if [[ "${DEVFINITY_CHAT_SITES_ACCEPTANCE:-0}" != "1" ]]; then
  runtime_exec "$container_machine_id" test -f \
    "$brain_tree/agent-notes/devfinity-agent-proof.md"
  if [[ "$(personal_agent_brain_id)" != "$brain_id" ]]; then
    echo "Personal Agent lost its Personal Brain across Apple Container restart" >&2
    exit 1
  fi
  if [[ "${DEVFINITY_BRAIN_PRODUCT_MATRIX:-0}" == "1" ]]; then
    # The runtime entrypoint must have restored one live identity supervisor.
    # A second writer must be rejected by the durable single-writer lock.
    runtime_exec -w "$brain_tree" "$container_machine_id" /bin/bash -lc '
      for attempt in $(seq 1 300); do
        test "$(fbrain daemon status --json | python3 -c '\''import json,sys; print(json.load(sys.stdin)["state"])'\'')" = running && break
        sleep 0.1
      done
      test "$(fbrain daemon status --json | python3 -c '\''import json,sys; print(json.load(sys.stdin)["state"])'\'')" = running
      set +e
      timeout 5 fbrain daemon supervise >/tmp/fbrain-duplicate-supervisor.log 2>&1
      duplicate_status=$?
      set -e
      if test "$duplicate_status" -eq 0 || test "$duplicate_status" -eq 124; then
        echo "a duplicate Brain supervisor unexpectedly acquired the writer lock" >&2
        exit 1
      fi
      grep -Fq "a Brain sync supervisor is already running" /tmp/fbrain-duplicate-supervisor.log
    '
    brain_browser_smoke live-browser-folder "Matrix Restart Notification Folder" "$brain_id"
    record_brain_matrix_check runtime-restart-single-supervisor
    runtime_exec -w "$brain_tree" "$container_machine_id" fbrain sync status --json \
      >"$brain_sync_json"
  else
    runtime_exec -w "$brain_tree" "$container_machine_id" fbrain sync now --json \
      >"$brain_sync_json"
  fi
  assert_personal_agent_scope
  brain_browser_smoke assert-note "$brain_proof"
  if [[ "${DEVFINITY_BRAIN_ONLY_SMOKE:-0}" == "0" ]]; then
    assert_site_cookie_works "$sites_cookie_jar_before"
    assert_site_cookie_works "$sites_cookie_jar_after"
    revoke_requesting_user_site
  fi
fi
wait_for_connected_chat
if [[ "${DEVFINITY_BRAIN_ONLY_SMOKE:-0}" == "0" && "${DEVFINITY_SITES_ONLY_SMOKE:-0}" == "0" ]]; then
  send_and_require_reply "Reply briefly with: runtime restart healed"
fi

if [[ "${DEVFINITY_BRAIN_PRODUCT_MATRIX:-0}" == "1" && -n "${DEVFINITY_BRAIN_MATRIX_EVIDENCE:-}" ]]; then
  node - "$brain_sync_json" "$DEVFINITY_BRAIN_MATRIX_EVIDENCE" "$brain_id" "$agent_npub_before" "$agent_npub_after" "$state_dir/brain-matrix-checks" <<'JS'
const fs = require("node:fs");
const path = require("node:path");
const [syncPath, evidencePath, brainId, actorBefore, actorAfter, checksPath] = process.argv.slice(2);
const sync = JSON.parse(fs.readFileSync(syncPath, "utf8"));
const requiredChecks = [
  "agent-to-agent-notification",
  "agent-to-browser-notification",
  "browser-to-agent-notification",
  "browser-reconnect-sequence-catchup",
  "agent-reconnect-sequence-catchup",
  "same-brain-coalescing-and-duplicate-hints",
  "independent-brain-scheduling",
  "runtime-restart-single-supervisor",
  "browser-conflict-and-unrelated-progress",
  "agent-conflict-and-unrelated-progress",
  "browser-revocation-clears-projection",
  "agent-revocation-preserves-tree",
  "personal-context-and-open-workflow",
  "organization-admin-context-and-open-workflow",
  "organization-member-context-and-open-workflow",
  "asset-exact-download",
];
const checks = Object.fromEntries(
  requiredChecks.map((name) => [name, fs.existsSync(path.join(checksPath, name))]),
);
const missing = Object.entries(checks).filter(([, passed]) => !passed).map(([name]) => name);
if (missing.length) throw new Error(`Brain matrix evidence missing asserted checks: ${missing.join(", ")}`);
fs.writeFileSync(evidencePath, JSON.stringify({
  format: "finite.brain.product-matrix.evidence.v1",
  brainId,
  authoritativeLatestSequence: sync.latestSequence,
  actorNpub: actorAfter,
  actorIdentityStableAcrossRestart: actorBefore === actorAfter,
  checks,
  explicitRefreshUsedForNotificationProof: false,
}, null, 2) + "\n");
JS
fi

echo "devfinity real SaaS smoke passed"
echo "project_id=$project_id"
echo "runtime_id=$machine_id"
echo "source_machine_id=$container_machine_id"
