#!/usr/bin/env bash
# Hands-on demo of the chat Brain cards (#554) against a real devfinity
# services-only stack: no Agent Runtime container is required, so the
# aarch64-linux runtime image never builds.
#
# The script stages the scene, then waits for you to drive the dashboard:
#
#   1. An approval card appears in the fixture user's chat: a member (a
#      host-side fbrain) asked to invite bob@finite.vip into the demo Brain
#      and lacks admin standing, so the CLI filed an approval request.
#      Click Approve — your hosted account key signs the artifact.
#   2. An invitation card appears for the reverse direction: Bob's own Brain
#      invited the fixture account. Click Join Brain.
#
# After approving, Bob's side converges: run the printed bob_fbrain command
# in a second terminal to watch his invitation appear and accept it.
#
# Run through the wrapper: scripts/with-dev-env scripts/devfinity-brain-card-hands-on-up
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
scratch="${DEVFINITY_STATE_DIR:?}/card-hands-on"
# The freshly built CLI from this checkout — never a PATH-shadowed older pin.
fbrain_bin="$repo_root/target/debug/fbrain"
[[ -x "$fbrain_bin" ]] || fail "built fbrain not found at $fbrain_bin"
mkdir -p "$scratch"

state_dir="${DEVFINITY_STATE_DIR:?}"

# Service tokens live in devfinity's secret files (0600, same-user readable).
# shellcheck disable=SC1090
source "$state_dir/secrets/core.sh"
# shellcheck disable=SC1090
source "$state_dir/secrets/identity-authority.sh"

brain_url="${FINITE_BRAIN_URL:?}"
identity_url="${FINITE_IDENTITY_AUTHORITY:?}"
hosted_device_url="${FC_HOSTED_WEB_DEVICE_URL:?}"
hosted_api_token="${FINITECHAT_HOSTED_API_TOKEN:?}"
core_url="${FC_CORE_URL:?}"
core_api_token="${FC_CORE_API_TOKEN:?}"
core_database_url="${FC_CORE_DATABASE_URL:?}"
identity_operator_token="${FINITE_IDENTITY_OPERATOR_TOKEN:?}"
dashboard_url="${FC_DASHBOARD_URL:?}"
dashboard_origin="${dashboard_url%/dashboard}"
ALICE_SUBJECT="user_devfinity"
ALICE_EMAIL="devfinity@finite.computer"
BOB_SUBJECT="user_devfinity_bob"
BOB_EMAIL="bob@finite.vip"
BOB_AGENT_DISPLAY="Bob Sidekick"

alice_jwt_file="$state_dir/workos-fixture/dashboard-customer.jwt"
bob_jwt_file="$state_dir/workos-fixture/bob.jwt"

say() { printf '\n\033[1;36m== %s\033[0m\n' "$*"; }
note() { printf '   %s\n' "$*"; }
fail() { printf '\033[1;31m   FAIL: %s\033[0m\n' "$*" >&2; exit 1; }

# Bob's agent is a host-side fbrain identity inside this disposable state dir.
bob_fbrain_home="$state_dir/bob-agent"
bob_fbrain_tree_root="$state_dir/bob-agent-tree"
mkdir -p "$bob_fbrain_home" "$bob_fbrain_tree_root"
bob_fbrain() {
  env \
    FINITE_HOME="$bob_fbrain_home" \
    FBRAIN_WORKING_TREE_ROOT="$bob_fbrain_tree_root" \
    FINITE_BRAIN_SERVER_URL="$brain_url" \
    FINITE_BRAIN_PUBLIC_BASE_URL="$dashboard_origin" \
    FINITE_IDENTITY_AUTHORITY="$identity_url" \
    "$fbrain_bin" "$@"
}
# The member (the filer) is a second host-side identity.
member_fbrain_home="$state_dir/member-agent"
mkdir -p "$member_fbrain_home"
member_fbrain() {
  env \
    FINITE_HOME="$member_fbrain_home" \
    FBRAIN_WORKING_TREE_ROOT="$state_dir/member-tree" \
    FINITE_BRAIN_SERVER_URL="$brain_url" \
    FINITE_BRAIN_PUBLIC_BASE_URL="$dashboard_origin" \
    FINITE_IDENTITY_AUTHORITY="$identity_url" \
    "$fbrain_bin" "$@"
}

# Hosted identity-provider operation as a specific WorkOS user.
hosted_op() {
  local user_id="$1"
  local operation="$2"
  local input_json="$3"
  local body
  body="$(node -e '
    const [operation, input] = process.argv.slice(1);
    process.stdout.write(JSON.stringify({
      version: "finite-brain-identity-provider-v1",
      operation,
      input: JSON.parse(input),
    }));
  ' "$operation" "$input_json")"
  local response status text
  response="$(curl -sS --max-time 30 \
    -H "authorization: Bearer $hosted_api_token" \
    -H "x-finite-workos-user-id: $user_id" \
    -H "x-finite-brain-public-origin: $dashboard_origin" \
    -H 'content-type: application/json' \
    --data "$body" \
    -w $'\n%{http_code}' \
    "$hosted_device_url/v1/brain/identity-provider")" || {
    echo "hosted identity-provider transport failed for $operation as $user_id" >&2
    return 1
  }
  status="${response##*$'\n'}"
  text="${response%$'\n'*}"
  if [[ "$status" != 2?? ]]; then
    echo "hosted identity-provider $operation as $user_id returned HTTP $status: $text" >&2
    return 1
  fi
  printf '%s' "$text"
}

# NIP-98-sign a Brain HTTP request with the user's hosted key and perform it.
hosted_signed_request() {
  local user_id="$1"
  local method="$2"
  local path="$3"
  local body_text="${4:-}"
  local url="$dashboard_origin$path"
  local input signed auth_header
  input="$(node -e '
    const crypto = require("node:crypto");
    const [method, url, bodyText] = process.argv.slice(1);
    const tags = [
      ["u", url],
      ["method", method.toUpperCase()],
      ["nonce", crypto.randomBytes(16).toString("hex")],
    ];
    if (bodyText) tags.push(["payload", crypto.createHash("sha256").update(bodyText).digest("hex")]);
    process.stdout.write(JSON.stringify({
      method: method.toUpperCase(),
      url,
      bodyText,
      eventTemplate: {
        kind: 27235,
        created_at: Math.floor(Date.now() / 1000),
        tags,
        content: "",
      },
    }));
  ' "$method" "$url" "$body_text")"
  signed="$(hosted_op "$user_id" authorizeHttpRequest "$input")" || return 1
  auth_header="Nostr $(node -e '
    const signed = JSON.parse(process.argv[1]);
    process.stdout.write(Buffer.from(JSON.stringify(signed), "utf8").toString("base64"));
  ' "$signed")"
  curl_brain_json "$method" "$path" "$auth_header" "$body_text"
}

curl_brain_json() {
  local method="$1"
  local path="$2"
  local auth_header="$3"
  local body_text="${4:-}"
  local -a args=(-sS --max-time 30 -X "$method" -H "authorization: $auth_header")
  if [[ -n "$body_text" ]]; then
    args+=(-H 'content-type: application/json' --data "$body_text")
  fi
  local response status body
  response="$(curl "${args[@]}" -w $'\n%{http_code}' "$brain_url$path")" || {
    echo "curl transport failed for $method $path" >&2
    return 1
  }
  status="${response##*$'\n'}"
  body="${response%$'\n'*}"
  if [[ "$status" != 2?? ]]; then
    echo "Brain $method $path returned HTTP $status: $body" >&2
    return 1
  fi
  printf '%s' "$body"
}

say "waiting for the devfinity services stack"
stack_started="$(date +%s)"
until curl -fsS --max-time 5 \
    -H "authorization: Bearer $(cat "$alice_jwt_file")" \
    "$core_url/api/core/v1/me" >/dev/null 2>&1; do
  if (( "$(date +%s)" - stack_started >= 300 )); then
    fail "Core did not answer /api/core/v1/me within 300s"
  fi
  sleep 2
done
note "stack is up"
# The fixture user's hosted identity materializes on first app-state read.
curl -fsS --max-time 30 \
  -H "authorization: Bearer $hosted_api_token" \
  -H "x-finite-workos-user-id: $ALICE_SUBJECT" \
  "$hosted_device_url/v1/app/state" >/dev/null \
  || fail "the fixture user's hosted app state did not materialize"

say "provisioning Bob's account, identity, and agent roster (slice Act 2 recipe)"
bob_agent_npub="$(bob_fbrain signer public-key)"
[[ "$bob_agent_npub" == npub1* ]] || fail "Bob's agent identity did not mint an npub"
# Bob's Core account (and customer org) materialize on his first
# authenticated request.
curl -fsS --max-time 30 \
  -H "authorization: Bearer $(cat "$bob_jwt_file")" \
  "$core_url/api/core/v1/me" >/dev/null \
  || fail "Bob's Core account did not materialize"
# The hosted device materializes Bob's identity on first app-state read.
curl -fsS --max-time 30 \
  -H "authorization: Bearer $hosted_api_token" \
  -H "x-finite-workos-user-id: $BOB_SUBJECT" \
  "$hosted_device_url/v1/app/state" >/dev/null \
  || fail "Bob's hosted app state did not materialize"
bob_npub="$(hosted_op "$BOB_SUBJECT" identifyMember 'null' | node -e '
  let body = "";
  process.stdin.on("data", (chunk) => body += chunk);
  process.stdin.on("end", () => {
    const npub = String(JSON.parse(body).npub || "");
    if (!npub.startsWith("npub1")) process.exit(1);
    process.stdout.write(npub);
  });
')"
note "Bob human npub: $bob_npub; BobAgent npub: $bob_agent_npub"
rand_suffix="$(node -e 'process.stdout.write(require("node:crypto").randomBytes(6).toString("hex"))')"
bob_project_id="project_cardbob${rand_suffix}"
bob_runtime_id="runtime_cardbob${rand_suffix}"
bob_request_id="acreq_cardbob${rand_suffix}"
bob_link_id="link_cardbob${rand_suffix}"
bob_agent_email="bob-sidekick-${rand_suffix}@finite.vip"
psql "$core_database_url" -v ON_ERROR_STOP=1 -qAt <<SQL
INSERT INTO projects (id, customer_org_id, owner_user_id, display_name, agent_email, created_at, updated_at)
SELECT
  '$bob_project_id', orgs.id, users.id, '$BOB_AGENT_DISPLAY', '$bob_agent_email', now(), now()
FROM users users
JOIN customer_orgs orgs ON orgs.owner_user_id = users.id
WHERE users.workos_user_id = '$BOB_SUBJECT';
INSERT INTO agent_runtimes
  (id, project_id, source_host_id, source_machine_id, source_import_key, host_facts, created_at, updated_at)
VALUES
  ('$bob_runtime_id', '$bob_project_id', 'devfinity-card-demo', 'devfinity-card-demo',
   'devfinity-card-demo-$rand_suffix', '{}'::jsonb, now(), now());
INSERT INTO agent_creation_requests
  (id, customer_org_id, owner_user_id, project_id, idempotency_key, display_name,
   runner_class, status, agent_runtime_id, created_at, updated_at)
SELECT
  '$bob_request_id', orgs.id, users.id, '$bob_project_id', 'devfinity-card-$rand_suffix',
  '$BOB_AGENT_DISPLAY', 'local_docker', 'running', '$bob_runtime_id', now(), now()
FROM users users
JOIN customer_orgs orgs ON orgs.owner_user_id = users.id
WHERE users.workos_user_id = '$BOB_SUBJECT';
INSERT INTO project_runtime_links (id, project_id, agent_runtime_id, active, created_at)
VALUES ('$bob_link_id', '$bob_project_id', '$bob_runtime_id', true, now());
INSERT INTO brain_account_roster_revisions (account_id, roster_revision, updated_at)
VALUES ('$BOB_SUBJECT', 1, now())
ON CONFLICT (account_id) DO NOTHING;
SQL
curl -fsS --max-time 15 \
  -H "x-finite-operator-token: $identity_operator_token" \
  -H 'content-type: application/json' \
  --data "$(node -e '
    process.stdout.write(JSON.stringify({
      email: process.argv[1],
      agent_npub: process.argv[2],
    }));
  ' "$bob_agent_email" "$bob_agent_npub")" \
  "$identity_url/api/v1/operator/agent-email-bindings" >/dev/null
note "roster + identity seeded for $BOB_EMAIL"

say "staging the demo Brain (fixture user is the admin)"
demo_brain="card-demo-$(node -e 'process.stdout.write(require("node:crypto").randomBytes(4).toString("hex"))')"
hosted_signed_request "$ALICE_SUBJECT" POST /v1/brains \
  "$(node -e 'process.stdout.write(JSON.stringify({ brainId: process.argv[1], kind: "organization", name: "Card Demo" }))' "$demo_brain")" \
  >/dev/null || fail "demo Brain creation failed"
note "Brain $demo_brain created (owner: $ALICE_EMAIL)"

member_npub="$(member_fbrain signer public-key)"
[[ "$member_npub" == npub1* ]] || fail "member identity did not mint an npub"
expires_at="$(node -e 'process.stdout.write(new Date(Date.now() + 24*60*60*1000).toISOString().replace(/\.\d{3}Z$/u, "Z"))')"
hosted_signed_request "$ALICE_SUBJECT" POST "/v1/brains/$demo_brain/invitations" \
  "$(node -e 'process.stdout.write(JSON.stringify({ targetNpub: process.argv[1], initialFolderAccess: [], expiresAt: process.argv[2] }))' "$member_npub" "$expires_at")" \
  >"$scratch/member-invitation.json" || fail "member invitation create failed"
member_invitation_id="$(node -e 'const v=JSON.parse(require("node:fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.id||"")' "$scratch/member-invitation.json")"
[[ -n "$member_invitation_id" ]] || fail "member invitation has no id"
member_fbrain invite brain accept --id "$member_invitation_id" --json >/dev/null \
  || fail "member could not accept the invitation"
note "member joined ($member_npub)"

say "the member asks the CLI to invite Bob (this files the approval request)"
set +e
member_fbrain invite brain create --brain "$demo_brain" --target "$BOB_EMAIL" --json \
  >"$scratch/approval-request.json" 2>"$scratch/approval-request.stderr"
member_invite_status=$?
set -e
if (( member_invite_status != 0 )); then
  note "member brain list for debugging:"
  member_fbrain brain list --json 2>&1 | head -20 || true
  note "member invite stderr:"
  cat "$scratch/approval-request.stderr" || true
  fail "member invite create failed"
fi
request_id="$(node -e 'const v=JSON.parse(require("node:fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(v.id||"")' "$scratch/approval-request.json")"
[[ -n "$request_id" ]] || fail "no approval request id in CLI output"
note "approval request filed: $request_id (status pending)"

say "reverse direction: Bob's own Brain invites the fixture account (invitation card)"
bob_fbrain brain bootstrap-personal --json >"$scratch/bob-brain.json" || fail "Bob's bootstrap failed"
bob_brain_id="$(node -e 'const v=JSON.parse(require("node:fs").readFileSync(process.argv[1],"utf8"));process.stdout.write((v.brain&&v.brain.brainId)||v.brainId||"")' "$scratch/bob-brain.json")"
[[ -n "$bob_brain_id" ]] || fail "Bob's brain id missing"
preflight="$(bob_fbrain signer sign --kind 27235 --tag "u,$dashboard_origin/v1/brains/$bob_brain_id/invitations/preflight" --tag "method,POST")"
# Bob drives the plan with his own key via the CLI's blessed path where
# possible; preflight+commit need raw signed calls here because Bob's CLI
# holds admin standing but the demo keeps the flow explicit.
bob_signed_request() {
  local method="$1" path="$2" body_text="${3:-}"
  local -a sign_args=(signer sign --kind 27235 --tag "u,$dashboard_origin$path" --tag "method,$method")
  if [[ -n "$body_text" ]]; then
    local sha
    sha="$(printf '%s' "$body_text" | shasum -a 256 | cut -d' ' -f1)"
    sign_args+=(--tag "payload,$sha")
  fi
  local event_json auth_header
  event_json="$(bob_fbrain "${sign_args[@]}")" || return 1
  auth_header="Nostr $(printf '%s' "$event_json" | base64 | tr -d '\n')"
  local -a args=(-sS --max-time 30 -X "$method" -H "authorization: $auth_header")
  if [[ -n "$body_text" ]]; then
    args+=(-H 'content-type: application/json' --data "$body_text")
  fi
  local response status body
  response="$(curl "${args[@]}" -w $'\n%{http_code}' "$brain_url$path")" || return 1
  status="${response##*$'\n'}"
  body="${response%$'\n'*}"
  if [[ "$status" != 2?? ]]; then
    echo "Brain $method $path returned HTTP $status: $body" >&2
    return 1
  fi
  printf '%s' "$body"
}
bob_preflight="$(bob_signed_request POST "/v1/brains/$bob_brain_id/invitations/preflight" '{"target":"'"$ALICE_EMAIL"'"}')" \
  || fail "Bob's preflight failed"
bob_plan_id="$(node -e 'const v=JSON.parse(process.argv[1]);process.stdout.write(v.planId||"")' "$bob_preflight")"
bob_plan_hash="$(node -e 'const v=JSON.parse(process.argv[1]);process.stdout.write(v.planHash||"")' "$bob_preflight")"
[[ -n "$bob_plan_id" && -n "$bob_plan_hash" ]] || fail "Bob's preflight missed plan fields"
bob_signed_request POST "/v1/brains/$bob_brain_id/invitations/commit" \
  "{\"planId\":\"$bob_plan_id\",\"planHash\":\"$bob_plan_hash\"}" >/dev/null \
  || fail "Bob's commit failed"
note "Bob invited $ALICE_EMAIL to $bob_brain_id"

cat <<EOF

\033[1mEverything is staged. Your turn:\033[0m

  1. Open the dashboard:  $dashboard_url
     (the fixture stack signs you in as $ALICE_EMAIL)

  2. Open the machine's chat. At the top you should see:
       - an approval card: "$BOB_EMAIL was requested for Brain $demo_brain"
         -> click \033[1mApprove\033[0m (your hosted account key signs it)
       - an invitation card: Bob invited you to his Brain
         -> click \033[1mJoin Brain\033[0m

  3. After approving, watch Bob's side converge (second terminal):

       export FINITE_HOME="$bob_fbrain_home"
       export FBRAIN_WORKING_TREE_ROOT="$bob_fbrain_tree_root"
       export FINITE_BRAIN_SERVER_URL="$brain_url"
       export FINITE_BRAIN_PUBLIC_BASE_URL="$dashboard_origin"
       export FINITE_IDENTITY_AUTHORITY="$identity_url"
       "$fbrain_bin" invite brain list --json     # the invitation appeared
       "$fbrain_bin" invite brain accept --id <id> --json

  Ctrl-C here tears the stack down. State: $state_dir
EOF

sleep infinity
