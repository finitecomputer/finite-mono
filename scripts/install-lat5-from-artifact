#!/usr/bin/env bash
# Bare-metal install driver for finite-lat-5 (Gate C of
# infra/runbooks/lat5-nixos-runner-install.md). Consumes a downloaded
# `lat5-nixos-closure-REV` artifact:
#
#   1. validates the artifact manifest (schema finite.lat5.nixos-closure.v2;
#      system + disko + kexec store paths) and its file binary cache;
#   2. proves the rev is on origin/main;
#   3. realizes the SYSTEM, DISKO, and KEXEC store paths from the file cache
#      into the local store (pure substitution — nothing is built);
#   4. invokes the flake-pinned nixos-anywhere with those exact store paths
#      against the rescue-mode host.
#
# Run on a Linux driver. All executables come from the CI file cache;
# no local flake evaluation, installer override, or build fallback is used.
# Bootstrap files must contain root-owned 0600 monitoring credentials.
# usage: install-lat5-from-artifact <artifact-dir> <target-host> --extra-files <root>
set -euo pipefail

mode_driver="run"
artifact_dir=""
target_host=""
extra_files=""
extra_args=()

usage() {
  echo "usage: $0 <artifact-dir> <target-host> [--validate-only | --extra-files <root>]" >&2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --validate-only)
      mode_driver="validate"
      ;;
    --extra-files)
      [[ $# -ge 2 ]] || { usage; exit 64; }
      extra_files="$2"
      shift
      ;;
    -*) usage; exit 64 ;;
    *)
      if [[ -z "$artifact_dir" ]]; then
        artifact_dir="$1"
      elif [[ -z "$target_host" ]]; then
        target_host="$1"
      else
        extra_args+=("$1")
      fi
      ;;
  esac
  shift
done

if [[ -z "$artifact_dir" || -z "$target_host" ]]; then
  usage
  exit 64
fi

case "$target_host" in
  root@64.34.93.213|ubuntu@64.34.93.213) ;;
  *) echo "refusing unexpected lat5 install target: $target_host" >&2; exit 64 ;;
esac

if [[ ! -d "$artifact_dir" ]]; then
  echo "artifact directory does not exist: $artifact_dir" >&2
  exit 66
fi
artifact_dir="$(cd "$artifact_dir" && pwd -P)"
manifest="$artifact_dir/manifest.json"
if [[ ! -f "$manifest" ]]; then
  echo "artifact manifest is missing: $manifest" >&2
  exit 66
fi

manifest_values_file="$(mktemp "${TMPDIR:-/tmp}/lat5-install-manifest.XXXXXX")"
trap 'rm -f "$manifest_values_file"' EXIT
python3 - "$manifest" > "$manifest_values_file" <<'PY'
import json
import re
import sys

with open(sys.argv[1], encoding="utf-8") as fh:
    data = json.load(fh)

if data.get("schema") != "finite.lat5.nixos-closure.v2":
    raise SystemExit(f"unexpected manifest schema: {data.get('schema')!r}")
if data.get("host") != "finite-lat-5":
    raise SystemExit(f"unexpected manifest host: {data.get('host')!r}")
if data.get("repository") != "finitecomputer/finite-mono":
    raise SystemExit(f"unexpected repository: {data.get('repository')!r}")

for key, pattern in (
    ("rev", r"[0-9a-f]{40}"),
    ("system", r"/nix/store/[0-9a-z]{32}-nixos-system-finite-lat-5-[^/\s]+"),
    ("disko", r"/nix/store/[0-9a-z]{32}-disko"),
    ("kexec", r"/nix/store/[0-9a-z]{32}-kexec-tarball"),
    ("installer", r"/nix/store/[0-9a-z]{32}-nixos-anywhere-[^/\s]+"),
    ("qualification", r"/nix/store/[0-9a-z]{32}-vm-test-run-disko-lat5-storage-boot"),
):
    value = data.get(key)
    if not isinstance(value, str) or not re.fullmatch(pattern, value):
        raise SystemExit(f"invalid {key}: {value!r}")
if data.get("cache") != "nix-cache":
    raise SystemExit(f"invalid cache directory: {data.get('cache')!r}")

for key in ("rev", "system", "disko", "kexec", "cache", "installer", "qualification"):
    print(data[key])
PY

REV="$(sed -n '1p' "$manifest_values_file")"
SYSTEM="$(sed -n '2p' "$manifest_values_file")"
DISKO="$(sed -n '3p' "$manifest_values_file")"
KEXEC="$(sed -n '4p' "$manifest_values_file")"
CACHE_REL="$(sed -n '5p' "$manifest_values_file")"
INSTALLER="$(sed -n '6p' "$manifest_values_file")"
QUALIFICATION="$(sed -n '7p' "$manifest_values_file")"
CACHE_DIR="$artifact_dir/$CACHE_REL"

if [[ ! -d "$CACHE_DIR" || ! -f "$CACHE_DIR/nix-cache-info" ]]; then
  echo "artifact cache is missing or incomplete: $CACHE_DIR" >&2
  exit 66
fi

git fetch origin --prune
git merge-base --is-ancestor "$REV" origin/main || {
  echo "refusing: $REV is not on origin/main" >&2
  exit 65
}

echo "==> validated finite-lat-5 install artifact"
echo "    rev=$REV"
echo "    system=$SYSTEM"
echo "    disko=$DISKO"
echo "    kexec=$KEXEC"
if [[ "$mode_driver" == "validate" ]]; then
  exit 0
fi

# Realize the three install inputs from the artifact's file cache. This is
# substitution from the CI-published cache, not a build.
echo "==> realizing SYSTEM/DISKO/KEXEC from the artifact cache"
# The artifact cache is unsigned (plain `nix copy --to file://` at build
# time); read it with the same explicit --no-check-sigs path as every
# deploy-cache consumer.
nix copy --no-check-sigs --option builders '' \
  --from "file://$CACHE_DIR" \
  "$SYSTEM" "$DISKO" "$KEXEC" "$INSTALLER" "$QUALIFICATION"
for path in "$SYSTEM" "$DISKO" "$KEXEC" "$INSTALLER" "$QUALIFICATION"; do
  [[ -e "$path" ]] || {
    echo "store path did not realize from the artifact cache: $path" >&2
    exit 67
  }
done
test -x "$SYSTEM/bin/switch-to-configuration"

# No local flake evaluation or command override is part of an install.
test -x "$INSTALLER/bin/nixos-anywhere"
test -d "$QUALIFICATION"
[[ -n "$extra_files" && -d "$extra_files" ]] || {
  echo "--extra-files must name the root-only bootstrap directory" >&2; exit 64;
}
extra_files="$(cd "$extra_files" && pwd -P)"
python3 - "$extra_files" <<'BOOTSTRAP'
from pathlib import Path
import stat
import sys
root = Path(sys.argv[1])
files = {
    "etc/finite/metrics-remote-write.env", "etc/finite/logs-write.env",
    "etc/ssh/ssh_host_ed25519_key", "etc/ssh/ssh_host_ed25519_key.pub",
}
directories = {"etc", "etc/finite", "etc/ssh"}
if root == Path("/") or root.is_symlink():
    raise SystemExit("refusing a broad or symlink bootstrap root")
seen = set()
for path in [root, *root.rglob("*")]:
    info = path.lstat()
    rel = str(path.relative_to(root))
    if info.st_uid != 0 or info.st_gid != 0 or stat.S_ISLNK(info.st_mode):
        raise SystemExit("bootstrap paths must be root-owned and not symlinks")
    if path == root or rel in directories:
        valid = stat.S_ISDIR(info.st_mode) and stat.S_IMODE(info.st_mode) == 0o700
    else:
        valid = rel in files and stat.S_ISREG(info.st_mode) and stat.S_IMODE(info.st_mode) == 0o600
        seen.add(rel)
    if not valid:
        raise SystemExit("bootstrap contains an unexpected path or mode")
if seen != files:
    raise SystemExit("bootstrap must contain exactly monitoring credentials and a fresh SSH host keypair")
BOOTSTRAP
"$(dirname "$0")/../infra/nixos/scripts/check-lat-monitoring-secrets" --root "$extra_files"
[[ ! -e "$extra_files/etc/finite/runner.env" ]] || {
  echo "initial OS install must not stage Runner admission credentials" >&2; exit 65;
}
[[ ${#extra_args[@]} -eq 0 ]] || { usage; exit 64; }

echo "==> driving the bare-metal install on $target_host"
# Pinned nixos-anywhere 7239104 expects DISKO before SYSTEM and a tarball
# file for --kexec, not the derivation output directory.
shopt -s nullglob
kexec_tarballs=("$KEXEC"/*.tar.gz "$KEXEC"/*.tar.xz "$KEXEC"/*.tar.zst "$KEXEC"/*.tar)
[[ ${#kexec_tarballs[@]} -eq 1 ]] || {
  echo "expected exactly one kexec tarball in $KEXEC" >&2; exit 67;
}
"$INSTALLER/bin/nixos-anywhere" \
  --kexec "${kexec_tarballs[0]}" \
  --store-paths "$DISKO" "$SYSTEM" \
  --build-on local \
  --extra-files "$extra_files" \
  "$target_host" \
  "${extra_args[@]+"${extra_args[@]}"}"

echo "==> install driven; reboot the host and verify per the runbook"
