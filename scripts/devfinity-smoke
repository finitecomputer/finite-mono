#!/usr/bin/env bash
set -euo pipefail

declare -a sensitive_files=()
declare -a sensitive_dirs=()

cleanup_sensitive_files() {
  if (( ${#sensitive_files[@]} > 0 )); then
    rm -f -- "${sensitive_files[@]}"
  fi
  if (( ${#sensitive_dirs[@]} > 0 )); then
    rm -rf -- "${sensitive_dirs[@]}"
  fi
}

track_sensitive_file() {
  sensitive_files+=("$1")
}

track_sensitive_dir() {
  sensitive_dirs+=("$1")
}

trap cleanup_sensitive_files EXIT

need() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "missing required command: $1" >&2
    exit 127
  fi
}

check_http() {
  local name="$1"
  local url="$2"
  local expected="$3"
  local body
  body="$(curl -fsS "$url")"
  if [[ "$body" != *"$expected"* ]]; then
    echo "$name smoke failed: $url did not contain '$expected'" >&2
    echo "$body" >&2
    exit 1
  fi
  echo "$name ok: $url"
}

check_tcp() {
  local name="$1"
  local host="$2"
  local port="$3"
  if ! bash -c "exec 3<>/dev/tcp/$host/$port"; then
    echo "$name smoke failed: tcp $host:$port did not accept a connection" >&2
    exit 1
  fi
  echo "$name ok: tcp $host:$port"
}

curl_bearer_file() {
  local token_file="$1"
  shift
  local config_file="${DEVFINITY_STATE_DIR:?}/curl-auth-$$-$RANDOM.conf"
  track_sensitive_file "$config_file"
  umask 077
  printf 'header = "authorization: Bearer %s"\n' "$(tr -d '\n' <"$token_file")" >"$config_file"
  local status=0
  curl -fsS --config "$config_file" "$@" || status=$?
  if (( status != 0 )); then
    rm -f "$config_file"
    return "$status"
  fi
  rm -f "$config_file"
}

check_dashboard_agent_creation() {
  local run_id
  local display_name
  local issue_json
  local launch_code_file
  local idempotency_key
  local response_headers
  local response_body
  local me_json

  run_id="${DEVFINITY_SMOKE_RUN_ID:-$(date +%s)-$$}"
  display_name="Devfinity Smoke Agent $run_id"
  idempotency_key="devfinity-smoke-$run_id"
  response_headers="${DEVFINITY_STATE_DIR:?}/dashboard-create-agent.headers"
  response_body="${DEVFINITY_STATE_DIR:?}/dashboard-create-agent.html"
  me_json="${DEVFINITY_STATE_DIR:?}/core-me-after-dashboard-create.json"
  issue_json="${DEVFINITY_STATE_DIR:?}/issued-launch-code.json"
  launch_code_file="${DEVFINITY_STATE_DIR:?}/issued-launch-code.txt"
  track_sensitive_file "$issue_json"
  track_sensitive_file "$launch_code_file"

  umask 077
  curl_bearer_file "${DEVFINITY_STATE_DIR:?}/workos-fixture/operator.jwt" \
    -H 'content-type: application/json' \
    --data '{"name":"Devfinity services smoke","codeCount":1,"expiresInHours":24}' \
    "$core_url/api/core/v1/admin/launch-code-batches" >"$issue_json"
  node - "$issue_json" "$launch_code_file" <<'JS'
const fs = require("node:fs");
const [issuePath, codePath] = process.argv.slice(2);
const code = JSON.parse(fs.readFileSync(issuePath, "utf8"))?.codes?.[0]?.code;
if (typeof code !== "string" || !code) throw new Error("Core did not return one Launch Code");
fs.writeFileSync(codePath, code, { mode: 0o600 });
JS
  rm -f "$issue_json"

  curl -fsS \
    -D "$response_headers" \
    -o "$response_body" \
    -X POST \
    --data-urlencode "displayName=$display_name" \
    --data-urlencode "hostingTier=standard" \
    --data-urlencode "access=launch-code" \
    --data-urlencode "launchCode@$launch_code_file" \
    --data-urlencode "idempotencyKey=$idempotency_key" \
    "$dashboard_url/agent-creation-requests"

  if tr -d '\r' <"$response_headers" | grep -Eiq '^location: .*agentCreationError='; then
    echo "dashboard agent creation redirected with an error" >&2
    tr -d '\r' <"$response_headers" | grep -Ei '^location:' >&2 || true
    exit 1
  fi

  rm -f "$launch_code_file"

  curl_bearer_file "${DEVFINITY_STATE_DIR:?}/workos-fixture/dashboard-customer.jwt" \
    "$core_url/api/core/v1/me" \
    >"$me_json"

  node - "$me_json" "$display_name" <<'JS'
const fs = require("node:fs");

const [mePath, displayName] = process.argv.slice(2);
const me = JSON.parse(fs.readFileSync(mePath, "utf8"));
const requests = Array.isArray(me.agent_creation_requests) ? me.agent_creation_requests : [];
const projects = Array.isArray(me.projects) ? me.projects : [];
const request = requests.find((candidate) =>
  candidate.display_name === displayName &&
  (candidate.status === "requested" || candidate.status === "launching")
);

if (!request) {
  throw new Error(`Core did not report a pending dashboard-created agent request for ${displayName}`);
}

const project = projects.find((candidate) => candidate.project?.id === request.project_id);
if (!project) {
  throw new Error(`Core reported request ${request.id} without its project ${request.project_id}`);
}

console.log(`dashboard->core ok: request ${request.id} created project ${request.project_id}`);
JS
}

check_requesting_user_site() {
  local run_id
  local slug
  local marker
  local smoke_root
  local agent_home
  local agent_finite_home
  local project_dir
  local hosted_config
  local sites_config
  local user_state_json
  local requesting_user_id
  local requesting_user_npub
  local owner_email
  local agent_identity_json
  local agent_npub
  local assertion_request_json
  local assertion_response_json
  local session_key
  local init_json
  local init_fields
  local site_id
  local output_url
  local git_remote
  local redemption_headers
  local viewer_cookie
  local status
  local body
  local revoke_json

  run_id="${DEVFINITY_SMOKE_RUN_ID:-$(date +%s)-$$}"
  slug="devfinity-private-${run_id}"
  marker="Devfinity private Sites ${run_id}"
  smoke_root="${DEVFINITY_STATE_DIR:?}/sites-requester-${run_id}"
  agent_home="$smoke_root/home"
  agent_finite_home="$smoke_root/finite-home"
  project_dir="$smoke_root/project"
  hosted_config="$smoke_root/hosted-device.curl"
  sites_config="$smoke_root/sites-service.curl"
  user_state_json="$smoke_root/user-state.json"
  agent_identity_json="$smoke_root/agent-identity.json"
  assertion_request_json="$smoke_root/hosted-requester-assertion-request.json"
  assertion_response_json="$smoke_root/hosted-requester-assertion-response.json"
  init_json="$smoke_root/init.json"
  redemption_headers="$smoke_root/redemption.headers"
  revoke_json="$smoke_root/revoke.json"
  track_sensitive_dir "$smoke_root"
  owner_email="devfinity@finite.computer"
  session_key="finitechat:devfinity-sites-smoke:$run_id"
  umask 077
  mkdir -p "$agent_home" "$agent_finite_home" "$project_dir/site"

  printf 'header = "authorization: Bearer %s"\nheader = "x-finite-workos-user-id: %s"\n' \
    "${FINITECHAT_HOSTED_API_TOKEN:?}" \
    "${FC_DASHBOARD_DEV_WORKOS_USER_ID:?}" \
    >"$hosted_config"
  printf 'header = "authorization: Bearer %s"\n' \
    "${FINITE_SITES_VIEWER_SESSION_TOKEN:?}" \
    >"$sites_config"

  # The HTTP listener can become healthy just before its first authenticated
  # app-state projection is ready. Retry only this startup read; curl's
  # default retry policy remains limited to transient transport and 5xx errors.
  curl -fsS --retry 10 --retry-connrefused --retry-delay 1 \
    --config "$hosted_config" \
    "$hosted_device_url/v1/app/state" >"$user_state_json"
  requesting_user_id="$(node - "$user_state_json" <<'JS'
const fs = require("node:fs");
const state = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const accountId = String(state.identity?.account_id || "");
if (!/^[0-9a-f]{64}$/u.test(accountId)) {
  throw new Error("Hosted Device did not expose a Native Principal account id");
}
process.stdout.write(accountId);
JS
)"

  printf '%s\n' \
    '[project]' \
    "slug = \"$slug\"" \
    '' \
    '[site]' \
    "name = \"$slug\"" \
    'branch = "main"' \
    'path = "site"' \
    'spa = false' >"$project_dir/finite.toml"
  printf '<h1>%s</h1>\n' "$marker" >"$project_dir/site/index.html"

  env \
    HOME="$agent_home" \
    FINITE_HOME="$agent_finite_home" \
    FINITE_SITES_API="$sites_url" \
    GIT_CONFIG_GLOBAL="$agent_home/gitconfig" \
    fsite auth register --output json >/dev/null
  env \
    HOME="$agent_home" \
    FINITE_HOME="$agent_finite_home" \
    fsite auth status --output json >"$agent_identity_json"
  agent_npub="$(node - "$agent_identity_json" <<'JS'
const fs = require("node:fs");
const identity = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
if (typeof identity.npub !== "string" || !identity.npub.startsWith("npub1")) {
  throw new Error("fsite did not report its Agent npub");
}
process.stdout.write(identity.npub);
JS
)"
  node - "$owner_email" "$requesting_user_id" "$agent_npub" >"$assertion_request_json" <<'JS'
const [email, requesterNpub, agentNpub] = process.argv.slice(2);
process.stdout.write(JSON.stringify({
  email,
  requester_npub: requesterNpub,
  agent_npub: agentNpub,
}));
JS
  curl -fsS --config "$sites_config" \
    -H 'content-type: application/json' \
    --data-binary "@$assertion_request_json" \
    "$sites_url/internal/v1/hosted-requester-assertions" >"$assertion_response_json"
  node - "$assertion_response_json" "$agent_finite_home" "$session_key" \
    "$requesting_user_id" "$owner_email" <<'JS'
const crypto = require("node:crypto");
const fs = require("node:fs");
const path = require("node:path");
const [responsePath, finiteHome, sessionKey, requesterId, ownerEmail] =
  process.argv.slice(2);
const response = JSON.parse(fs.readFileSync(responsePath, "utf8"));
if (
  response.email !== ownerEmail ||
  typeof response.requester_npub !== "string" ||
  !response.requester_npub.startsWith("npub1") ||
  typeof response.assertion !== "string" ||
  response.assertion.length === 0 ||
  !Number.isSafeInteger(response.expires_at)
) {
  throw new Error("Sites did not mint the exact hosted requester assertion");
}
const digest = crypto.createHash("sha256").update(sessionKey).digest("hex");
const contextDir = path.join(finiteHome, "requester-context-v2");
fs.mkdirSync(contextDir, { recursive: true, mode: 0o700 });
fs.writeFileSync(
  path.join(contextDir, `${digest}.json`),
  JSON.stringify({
    version: 2,
    session_key: sessionKey,
    platform: "finitechat",
    requesting_user_id: requesterId,
    owner_email: ownerEmail,
    hosted_requester_assertion: response.assertion,
    expires_at_unix: response.expires_at,
  }),
  { mode: 0o600 },
);
JS
  (
    cd "$project_dir"
    env \
      HOME="$agent_home" \
      FINITE_HOME="$agent_finite_home" \
      FINITE_SITES_API="$sites_url" \
      GIT_CONFIG_GLOBAL="$agent_home/gitconfig" \
      HERMES_SESSION_PLATFORM=finitechat \
      HERMES_SESSION_KEY="$session_key" \
      HERMES_SESSION_USER_ID="$requesting_user_id" \
      fsite project init \
        --config finite.toml \
        --dry-run \
        --output json >/dev/null
    env \
      HOME="$agent_home" \
      FINITE_HOME="$agent_finite_home" \
      FINITE_SITES_API="$sites_url" \
      GIT_CONFIG_GLOBAL="$agent_home/gitconfig" \
      HERMES_SESSION_PLATFORM=finitechat \
      HERMES_SESSION_KEY="$session_key" \
      HERMES_SESSION_USER_ID="$requesting_user_id" \
      fsite project init \
        --config finite.toml \
        --output json >"$init_json"
  )
  init_fields="$(node - "$init_json" "$slug" <<'JS'
const fs = require("node:fs");
const response = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const site = response.site;
if (
  response.slug !== process.argv[3] ||
  !response.requesting_user_npub?.startsWith("npub1") ||
  response.owner_email !== "devfinity@finite.computer" ||
  !site?.requesting_user_shared ||
  site.visibility !== "private"
) {
  throw new Error(`Project Init did not create a private requesting-user Share: ${JSON.stringify(response)}`);
}
process.stdout.write([
  site.site_id,
  site.url,
  response.git_remote_url,
  response.requesting_user_npub,
].join("\t"));
JS
)"
  IFS=$'\t' read -r site_id output_url git_remote requesting_user_npub <<<"$init_fields"
  if [[ ! "$site_id" =~ ^site_[0-9a-f]{32}$ ]]; then
    echo "Sites smoke Project Init returned an invalid Site id" >&2
    return 1
  fi
  echo "Sites smoke Project and requesting-user Share initialized"

  env \
    HOME="$agent_home" \
    FINITE_HOME="$agent_finite_home" \
    FINITE_SITES_API="$sites_url" \
    GIT_CONFIG_GLOBAL="$agent_home/gitconfig" \
    fsite auth git "$slug" --store --output json >/dev/null
  (
    cd "$project_dir"
    export GIT_CONFIG_GLOBAL="$agent_home/gitconfig"
    git init -q -b main
    git config user.name "Devfinity Sites Smoke"
    git config user.email "devfinity-sites-smoke@finite.invalid"
    git add finite.toml site
    git commit -q -m "Publish private requesting-user smoke site"
    git remote add finite "$git_remote"
    git push -q finite main
  )
  echo "Sites smoke private Site published"

  local started
  started="$(date +%s)"
  while true; do
    status="$(curl -sS --max-time 5 -o /dev/null -w '%{http_code}' "$output_url" || true)"
    if [[ "$status" == "303" ]]; then
      break
    fi
    if (( "$(date +%s)" - started >= 60 )); then
      echo "Sites smoke Site did not publish within 60s; last status $status" >&2
      return 1
    fi
    sleep 1
  done

  local notification_key="sites:first-publication:$site_id"
  local notification_count
  started="$(date +%s)"
  while true; do
    notification_count="$(sqlite3 "${DEVFINITY_STATE_DIR:?}/finitesites/registry.db" \
      "SELECT count(*) FROM site_notification_outbox WHERE idempotency_key = '$notification_key' AND delivered_at IS NOT NULL;")"
    if [[ "$notification_count" == "1" ]]; then
      break
    fi
    if (( "$(date +%s)" - started >= 30 )); then
      echo "Sites first-publication notification was not delivered through the Sites outbox within 30s" >&2
      return 1
    fi
    sleep 1
  done

  printf '<h1>%s</h1><p>Second publication</p>\n' "$marker" >"$project_dir/site/index.html"
  (
    cd "$project_dir"
    export GIT_CONFIG_GLOBAL="$agent_home/gitconfig"
    git add site/index.html
    git commit -q -m "Publish second private requesting-user smoke version"
    git push -q finite main
  )
  started="$(date +%s)"
  while true; do
    if [[ "$(sqlite3 "${DEVFINITY_STATE_DIR:?}/finitesites/registry.db" \
      "SELECT coalesce(max(version_number), 0) FROM versions WHERE site_id = '$site_id';")" == "2" ]]; then
      break
    fi
    if (( "$(date +%s)" - started >= 60 )); then
      echo "Sites smoke second Site version did not publish within 60s" >&2
      return 1
    fi
    sleep 1
  done
  notification_count="$(sqlite3 "${DEVFINITY_STATE_DIR:?}/finitesites/registry.db" \
    "SELECT count(*) FROM site_notification_outbox WHERE idempotency_key = '$notification_key' AND delivered_at IS NOT NULL;")"
  if [[ "$notification_count" != "1" ]]; then
    echo "Sites first-publication notification was not exactly-once after a second publish" >&2
    return 1
  fi
  echo "Sites first-publication outbox notification delivered exactly once"

  # The services-only dashboard already has the fixture's verified account.
  # Start with no Sites cookie and follow the real browser path: Sites -> gate
  # -> dashboard /site-auth -> signed vouch redemption -> protected content.
  # The smoke never signs a native viewer proof or calls the gate with a token.
  # curl does not treat *.localhost HTTP as a secure cookie context. Stop at
  # redemption and send the cookie explicitly below; Chrome's separate browser
  # acceptance owns actual cookie-policy coverage.
  local redirect_exit=0
  status="$(curl -s --max-time 30 --location --max-redirs 3 \
    -D "$redemption_headers" -o /dev/null -w '%{http_code}' "$output_url")" || redirect_exit=$?
  if [[ "$redirect_exit" != "47" || "$status" != "303" ]]; then
    echo "Sites smoke expected the redemption redirect; got curl $redirect_exit, HTTP $status" >&2
    return 1
  fi
  node - "$redemption_headers" "$dashboard_url" <<'JS'
const fs = require("node:fs");
const headers = fs.readFileSync(process.argv[2], "utf8").split(/\r?\n/u);
const dashboard = new URL(process.argv[3]);
const visitedAccount = headers.some((line) => {
  if (!/^location:/iu.test(line)) return false;
  const target = new URL(line.replace(/^location:\s*/iu, ""), dashboard);
  return target.origin === dashboard.origin && target.pathname === "/site-auth";
});
if (!visitedAccount) {
  throw new Error("Sites viewing did not pass through the dashboard account adapter");
}
JS
  viewer_cookie="$(node - "$redemption_headers" <<'JS'
const fs = require("node:fs");
const headers = fs.readFileSync(process.argv[2], "utf8").split(/\r?\n/u);
const setCookie = headers.find((line) => /^set-cookie:\s*finite_site_auth=/iu.test(line));
if (!setCookie) {
  throw new Error("Sites redemption did not set the host-scoped Viewer Cookie");
}
process.stdout.write(setCookie.replace(/^set-cookie:\s*/iu, "").split(";", 1)[0]);
JS
)"
  echo "Sites smoke Viewer Session redeemed"
  body="$(curl -fsS --max-time 15 -H "Cookie: $viewer_cookie" "$output_url")"
  if [[ "$body" != *"$marker"* || "$body" != *"Second publication"* ]]; then
    echo "Sites smoke Viewer Cookie did not open the private Site" >&2
    return 1
  fi

  env \
    HOME="$agent_home" \
    FINITE_HOME="$agent_finite_home" \
    FINITE_SITES_API="$sites_url" \
    GIT_CONFIG_GLOBAL="$agent_home/gitconfig" \
    fsite project share "$slug" \
      --remove-npub "$requesting_user_npub" \
      --output json >"$revoke_json"
  status="$(curl -sS --max-time 15 -o /dev/null -H "Cookie: $viewer_cookie" -w '%{http_code}' "$output_url")"
  if [[ "$status" != "200" ]]; then
    echo "Mailbox-authorized Sites smoke Viewer Cookie returned HTTP $status instead of 200 after its redundant native Share was removed" >&2
    return 1
  fi
  echo "agent -> publisher email -> account/gate viewer access ok: $output_url"
}

need bash
need cargo
need curl
need finitesitesd
need fsite
need node
need sqlite3

if [[ "${DEVFINITY_PROFILE:-}" != "services-only" ]]; then
  echo "devfinity service smoke requires the explicit services-only profile" >&2
  exit 64
fi

core_url="${FC_CORE_URL:-http://127.0.0.1:14200}"
chat_url="${FINITECHAT_SERVER_URL:-http://127.0.0.1:18787}"
hosted_device_url="${FC_HOSTED_WEB_DEVICE_URL:-http://127.0.0.1:38918}"
sites_url="${FINITE_SITES_API:-http://127.0.0.1:18789}"
brain_url="${FINITE_BRAIN_SERVER_URL:-http://127.0.0.1:18790}"
dashboard_url="${FC_DASHBOARD_URL:-http://127.0.0.1:13002/dashboard}"
postgres_port="${DEVFINITY_POSTGRES_PORT:-15432}"

check_tcp "postgres" "127.0.0.1" "$postgres_port"
check_http "core" "$core_url/healthz" '"ok":true'
check_http "finitechat" "$chat_url/health" '"status":"ok"'
check_http "hosted-web-device" "$hosted_device_url/healthz" '"status":"ok"'
check_http "finite-gate" "${FINITE_SITES_AUTH_GATE_URL:?}/healthz" "ok"
check_http "finitesites" "$sites_url/api/v2/healthz" '"ok":true'
check_http "finitebrain" "$brain_url/health" '"status":"ok"'
check_http "dashboard" "$dashboard_url" '<html'
check_requesting_user_site
check_dashboard_agent_creation
cargo test -p finitechat-client --locked --lib \
  tests::sqlite_client_store_loads_metadata_written_before_paired_agent_field \
  -- --exact
cargo test -p devfinity --locked --test stack_smoke \
  native_device_pairing_crosses_dashboard_hosted_and_authority \
  -- --ignored --exact --nocapture

echo "devfinity smoke passed"
