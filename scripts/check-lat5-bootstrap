#!/usr/bin/env python3
"""Validate the exact lat5 OS bootstrap set without printing credential values."""

from pathlib import Path
import base64
import binascii
import stat
import subprocess
import sys


def validate(root: Path, *, expected_uid: int = 0, expected_gid: int = 0) -> None:
    files = {
        "etc/finite/metrics-remote-write.env", "etc/finite/logs-write.env",
        "etc/finite/wireguard-private-key",
        "etc/ssh/ssh_host_ed25519_key", "etc/ssh/ssh_host_ed25519_key.pub",
    }
    directories = {"etc", "etc/finite", "etc/ssh"}
    if root.resolve() == Path("/") or root.is_symlink():
        raise SystemExit("refusing a broad or symlink bootstrap root")
    seen = set()
    for path in [root, *root.rglob("*")]:
        info = path.lstat()
        rel = str(path.relative_to(root))
        if info.st_uid != expected_uid or info.st_gid != expected_gid or stat.S_ISLNK(info.st_mode):
            raise SystemExit("bootstrap paths must be root-owned and not symlinks")
        if path == root or rel in directories:
            valid = stat.S_ISDIR(info.st_mode) and stat.S_IMODE(info.st_mode) == 0o700
        else:
            valid = rel in files and stat.S_ISREG(info.st_mode) and stat.S_IMODE(info.st_mode) == 0o600
            seen.add(rel)
        if not valid:
            raise SystemExit("bootstrap contains an unexpected path or mode")
    if seen != files:
        raise SystemExit("bootstrap must contain monitoring credentials, a unique WireGuard key and a fresh SSH host keypair")
    key = (root / "etc/finite/wireguard-private-key").read_bytes()
    try:
        decoded = base64.b64decode(key.strip(), validate=True)
    except (ValueError, binascii.Error):
        raise SystemExit("invalid WireGuard private key encoding") from None
    if len(decoded) != 32 or not any(decoded) or key not in (base64.b64encode(decoded), base64.b64encode(decoded) + b"\n"):
        raise SystemExit("invalid WireGuard private key")

    private = root / "etc/ssh/ssh_host_ed25519_key"
    public = root / "etc/ssh/ssh_host_ed25519_key.pub"
    try:
        derived = subprocess.run(
            ["ssh-keygen", "-y", "-P", "", "-f", str(private)],
            stdin=subprocess.DEVNULL, capture_output=True, check=True,
        ).stdout.split()
        staged = public.read_bytes().split()
        if len(derived) < 2 or derived[0] != b"ssh-ed25519" or staged[:2] != derived[:2]:
            raise ValueError("host key mismatch")
        subprocess.run(
            ["ssh-keygen", "-l", "-f", str(public)],
            stdin=subprocess.DEVNULL, capture_output=True, check=True,
        )
    except (OSError, ValueError, subprocess.CalledProcessError):
        raise SystemExit("invalid or mismatched Ed25519 SSH host keypair") from None


if __name__ == "__main__":
    if len(sys.argv) != 2:
        raise SystemExit("usage: check-lat5-bootstrap ROOT")
    validate(Path(sys.argv[1]))
