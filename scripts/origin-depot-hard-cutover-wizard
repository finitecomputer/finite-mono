#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser; visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# ──────────────────────────────────────────────────────────────────────────

TOTAL_STAGES=11

DEPOT_ORG="scthc5h66g"
DEPOT_REPO="finite-co/finite-mono"
GITHUB_REPO="finitecomputer/finite-mono"
ORIGIN_REPO="finite-co/finite-mono"
ORIGIN_CLONE_URL="https://origin.cursor.com/finite-co/finite-mono.git"
GITHUB_CLONE_URL="git@github.com:finitecomputer/finite-mono.git"
RELEASE_CANARY_ARMED=false

set_depot_secret() {
  local name="$1" value="$2" description="$3"
  if [[ -z "$value" ]]; then
    warn "$name is required for its cutover lane; no configuration was changed for that secret"
    exit 2
  fi
  printf '%s' "$value" | depot ci secrets set "$name" \
    --from-stdin \
    --org "$DEPOT_ORG" \
    --repo "$DEPOT_REPO" \
    --description "$description" >/dev/null
  printf '  %s✓ set%s Depot secret %s\n' "$GREEN" "$RESET" "$name"
}

set_depot_var() {
  local name="$1" value="$2" description="$3"
  depot ci vars set "$name" \
    --org "$DEPOT_ORG" \
    --repo "$DEPOT_REPO" \
    --value "$value" \
    --description "$description" >/dev/null
  printf '  %s✓ set%s Depot variable %s=%s\n' "$GREEN" "$RESET" "$name" "$value"
}

verify_depot_var() {
  local name="$1" expected="$2" output
  output="$scratch_dir/depot-var-$name.json"
  depot ci vars list "$name" \
    --org "$DEPOT_ORG" \
    --repo "$DEPOT_REPO" \
    --output json > "$output"
  if ! python3 - "$output" "$name" "$expected" "$DEPOT_REPO" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    document = json.load(stream)
name, expected, repository = sys.argv[2:]
variables = document.get("variables") if isinstance(document, dict) else None
if not isinstance(variables, list):
    raise SystemExit(2)
matches = []
for variable in variables:
    if not isinstance(variable, dict) or variable.get("name") != name:
        continue
    for variant in variable.get("variants", []):
        if not isinstance(variant, dict):
            continue
        if (
            variant.get("name") == "default"
            and variant.get("value") == expected
            and variant.get("attributes")
            == [{"key": "repository", "value": repository}]
        ):
            matches.append(variant)
raise SystemExit(0 if len(matches) == 1 else 2)
PY
  then
    warn "Depot did not report $name=$expected for $DEPOT_REPO."
    exit 2
  fi
  printf '  %s✓ verified%s Depot variable %s=%s\n' "$GREEN" "$RESET" "$name" "$expected"
}

remove_depot_var() {
  local name="$1"
  depot ci vars remove "$name" \
    --org "$DEPOT_ORG" \
    --repo "$DEPOT_REPO" \
    --force >/dev/null
  printf '  %s✓ removed%s Depot variable %s\n' "$GREEN" "$RESET" "$name"
}

disable_github_workflow() {
  local workflow="$1" state
  gh workflow disable "$workflow" --repo "$GITHUB_REPO"
  state=$(gh api "repos/$GITHUB_REPO/actions/workflows/$workflow" --jq '.state')
  if [[ "$state" != "disabled_manually" ]]; then
    warn "GitHub workflow $workflow is still $state."
    exit 2
  fi
  printf '  %s✓ disabled%s legacy GitHub workflow %s\n' "$GREEN" "$RESET" "$workflow"
}

cleanup_cutover() {
  exit_status=$?
  if [[ "$RELEASE_CANARY_ARMED" == true ]]; then
    if depot ci vars remove "FINITE_RELEASE_CANARY_PUBLISH_ENABLED" \
      --org "$DEPOT_ORG" \
      --repo "$DEPOT_REPO" \
      --force >/dev/null; then
      warn "Removed the temporary Release canary gate before exiting."
    else
      warn "Could not remove FINITE_RELEASE_CANARY_PUBLISH_ENABLED; remove it manually before leaving the cutover window."
    fi
  fi
  rm -rf "$scratch_dir"
  trap - EXIT
  exit "$exit_status"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || {
    warn "$1 is required before this wizard can continue"
    exit 2
  }
}

banner "Origin and Depot Hard Cutover setup"

stage "Parent merge and ref parity"
say "The authority transfer starts only after migration PR #674 is merged."
for command in git gh origin depot; do require_command "$command"; done
if [[ "$(gh pr view 674 --repo "$GITHUB_REPO" --json mergedAt --jq '.mergedAt // ""')" == "" ]]; then
  warn "PR #674 is not merged; stop here and merge it before the Hard Cutover."
  exit 2
fi
scratch_dir=$(mktemp -d)
trap cleanup_cutover EXIT
git ls-remote --refs --heads --tags "$GITHUB_CLONE_URL" | LC_ALL=C sort -k2 > "$scratch_dir/github-refs"
git ls-remote --refs --heads --tags "$ORIGIN_CLONE_URL" | LC_ALL=C sort -k2 > "$scratch_dir/origin-refs"
if ! diff -u "$scratch_dir/github-refs" "$scratch_dir/origin-refs"; then
  warn "GitHub and Origin branch/tag object IDs differ; do not detach."
  exit 2
fi
git clone --bare --quiet "$GITHUB_CLONE_URL" "$scratch_dir/source.git"
say "All GitHub and Origin branch/tag refs match."
pause "Press Enter to continue to the authority transfer."

stage "Detach Origin and make it private"
say "This is the Source Authority change. It must not run while ref parity is unresolved."
open_url "https://cursor.com/codebase/finite-co/finite-mono/settings"
step "Open General → Danger Zone and choose Detach from GitHub."
step "Confirm that Sync Status disappears; do not enable an outbound mirror."
step "Open Permissions and set repository visibility to Private."
if ! confirm "Have you detached the mirror, disabled ongoing sync, and made the repository Private?"; then
  warn "Origin remains non-authoritative until all three actions are complete."
  exit 2
fi
mirror_status=$(origin repo view "$ORIGIN_REPO" --json mirrorStatus | python3 -c 'import json,sys; print(json.load(sys.stdin).get("mirrorStatus") or "")')
if [[ "$mirror_status" == "inbound" ]]; then
  warn "Origin still reports an inbound GitHub mirror; stop before installing CI."
  exit 2
fi
git --git-dir="$scratch_dir/source.git" fetch --quiet "$GITHUB_CLONE_URL" \
  '+refs/heads/*:refs/heads/*' \
  '+refs/tags/*:refs/tags/*'
git --git-dir="$scratch_dir/source.git" push "$ORIGIN_CLONE_URL" --all
git --git-dir="$scratch_dir/source.git" push "$ORIGIN_CLONE_URL" --tags
git ls-remote --refs --heads --tags "$GITHUB_CLONE_URL" | LC_ALL=C sort -k2 > "$scratch_dir/github-refs-after"
if ! diff -u "$scratch_dir/github-refs" "$scratch_dir/github-refs-after"; then
  warn "GitHub changed during the transfer window. Stop and reconcile the new refs explicitly."
  exit 2
fi
git ls-remote --refs --heads --tags "$ORIGIN_CLONE_URL" | LC_ALL=C sort -k2 > "$scratch_dir/origin-refs-after"
if ! diff -u "$scratch_dir/github-refs" "$scratch_dir/origin-refs-after"; then
  warn "The detached Origin repository does not match the captured GitHub refs. Stop before installing CI."
  exit 2
fi
git clone --quiet "$ORIGIN_CLONE_URL" "$scratch_dir/origin-checkout"
if [[ -n "$(git -C "$scratch_dir/origin-checkout" status --porcelain)" ]]; then
  warn "A clean checkout from the detached Origin repository is not clean."
  exit 2
fi
say "The detached Origin repository matches every captured branch and tag object ID and clones cleanly."

stage "Install Depot on Origin"
open_url "https://cursor.com/codebase/finite-co/finite-mono/settings"
step "Open Apps → Manage Apps."
step "Install Depot for finite-co/finite-mono with repository contents, checks, and event access."
if ! confirm "Does Cursor report Depot installed for this Origin-hosted repository?"; then
  warn "The Depot app installation is a stop gate. Fix it before migrating credentials."
  exit 2
fi
note "The first disposable Origin event is the authoritative installation check; a configuration-only check is insufficient."

stage "Depot project and trusted cache"
say "The shared Depot project is non-secret. The Cachix value is hidden and sent directly to Depot."
set_depot_var "DEPOT_PROJECT_ID" "6d9vqbnzvh" "Finite shared container-build project"
ask_secret CACHIX_AUTH_TOKEN "Paste the finite Cachix write token:"
set_depot_secret "CACHIX_AUTH_TOKEN" "$CACHIX_AUTH_TOKEN" "Finite cache write token for trusted Depot CI"
unset CACHIX_AUTH_TOKEN

stage "Runtime smoke and Phala preflight"
say "Migrate the existing smoke credentials; values are never written to this checkout."
ask_secret OPENROUTER_API_KEY "Paste OPENROUTER_API_KEY:"
set_depot_secret "OPENROUTER_API_KEY" "$OPENROUTER_API_KEY" "Hermes runtime smoke fallback"
unset OPENROUTER_API_KEY
ask_secret FINITE_PRIVATE_SMOKE_API_KEY "Paste FINITE_PRIVATE_SMOKE_API_KEY:"
set_depot_secret "FINITE_PRIVATE_SMOKE_API_KEY" "$FINITE_PRIVATE_SMOKE_API_KEY" "Hermes Finite Private smoke"
unset FINITE_PRIVATE_SMOKE_API_KEY
ask_secret PHALA_CLOUD_API_KEY "Paste PHALA_CLOUD_API_KEY:"
set_depot_secret "PHALA_CLOUD_API_KEY" "$PHALA_CLOUD_API_KEY" "Read-only Phala inventory preflight"
unset PHALA_CLOUD_API_KEY
set_depot_var "PHALA_EXPECTED_WORKSPACE_ID" "wks_YKRQqRea" "Expected Finite Phala workspace ID"
set_depot_var "PHALA_EXPECTED_WORKSPACE_SLUG" "finite" "Expected Finite Phala workspace slug"

stage "Bounded Release Repository publisher"
open_url "https://github.com/settings/personal-access-tokens/new"
step "Create a fine-grained token owned by finitecomputer."
step "Select only finitecomputer/finite-releases."
step "Grant Repository permissions → Contents: Read and write; grant no source-repository access."
step "Use a short expiry if this is not the dedicated publisher identity."
ask_secret FINITE_RELEASES_GITHUB_TOKEN "Paste the fine-grained Release Repository token:"
set_depot_secret "FINITE_RELEASES_GITHUB_TOKEN" "$FINITE_RELEASES_GITHUB_TOKEN" "Contents write on finitecomputer/finite-releases only"
unset FINITE_RELEASES_GITHUB_TOKEN
set_depot_var "FINITE_RELEASE_CANARY_PUBLISH_ENABLED" "true" "Temporary manual-dispatch-only Release cutover canary"
RELEASE_CANARY_ARMED=true
verify_depot_var "FINITE_RELEASE_CANARY_PUBLISH_ENABLED" "true"
say "Only manual dispatches with canary_publish=true can use this temporary gate; tag publication remains closed."

stage "Bounded GHCR publisher"
open_url "https://github.com/settings/tokens/new"
step "Create a classic token for the dedicated publisher identity."
step "Select write:packages only; do not grant repo or delete:packages."
ask FINITE_GHCR_USERNAME "Enter the publisher GitHub username:"
ask_secret FINITE_GHCR_TOKEN "Paste the GHCR package-write token:"
set_depot_secret "FINITE_GHCR_USERNAME" "$FINITE_GHCR_USERNAME" "GHCR publisher account name"
set_depot_secret "FINITE_GHCR_TOKEN" "$FINITE_GHCR_TOKEN" "GHCR write:packages token without repo/delete scope"
unset FINITE_GHCR_USERNAME FINITE_GHCR_TOKEN
say "Publication enablement remains closed. Run the canary and rollback gates before setting either enablement variable."

stage "Origin rules and external acceptance"
say "Complete Phases 3–7 in docs/origin-depot-migration-plan.md before removing the legacy authority."
step "Prove Origin PR success, intentional failure, cancellation, retry, concurrency cancellation, outputs, matrices, artifacts, branch push, and manual dispatch."
step "Prove the component-tag event or record the explicit Depot tag-ref dispatch fallback."
step "Create Origin rules for main and production with their native Depot checks, and record the first trusted main cache-write run."
step "After those CI/event gates pass, merge #675 through an Origin pull request—not GitHub—so Origin main contains the bounded canary workflow and no GitHub Actions workflows."
git --git-dir="$scratch_dir/source.git" fetch --quiet "$ORIGIN_CLONE_URL" \
  '+refs/heads/main:refs/heads/origin-accepted-main'
if git --git-dir="$scratch_dir/source.git" ls-tree -r --name-only \
  refs/heads/origin-accepted-main -- .github/workflows | grep -q .; then
  warn "Origin main still contains GitHub Actions workflows; merge #675 through Origin before publication canaries."
  exit 2
fi
for workflow in release-finitechat.yml release-fsite.yml release-fbrain.yml; do
  if ! git --git-dir="$scratch_dir/source.git" show \
    "refs/heads/origin-accepted-main:.depot/workflows/$workflow" | \
    grep -q 'FINITE_RELEASE_CANARY_PUBLISH_ENABLED'; then
    warn "Origin main $workflow does not contain the bounded Release canary path."
    exit 2
  fi
done
step "From accepted Origin main, pass the manual-only Release publisher, idempotent retry, checksum/install, and alias-only rollback canaries."
step "Pass all six GHCR canaries with rev=<40-character accepted Origin main revision>, digest equality, platform, provenance, and anonymous pulls."
if ! depot ci workflow list --org "$DEPOT_ORG" --repo "$DEPOT_REPO" -n 200 --output json > "$scratch_dir/depot-workflows.json"; then
  warn "Depot could not list Origin-backed workflow evidence."
  exit 2
fi
if ! python3 -c 'import json,sys; raise SystemExit(0 if json.load(open(sys.argv[1])) else 2)' "$scratch_dir/depot-workflows.json"; then
  warn "No Origin-backed Depot workflow runs are recorded."
  exit 2
fi
origin ruleset list -R "$ORIGIN_REPO" --json > "$scratch_dir/origin-rulesets.json"
if ! python3 -c 'import json,sys; value=json.load(open(sys.argv[1])); items=value if isinstance(value,list) else value.get("rulesets",[]); raise SystemExit(0 if len(items) >= 2 else 2)' "$scratch_dir/origin-rulesets.json"; then
  warn "Origin does not report both required branch rulesets."
  exit 2
fi
if ! confirm "Does the evidence bundle record every required positive, negative, rollback, and closed-mutation gate for the exact Origin revisions?"; then
  warn "External evidence is the stop gate; do not remove the legacy authority."
  exit 2
fi
if ! confirm "Did the Release publisher canary, checksum/install proof, idempotent retry, and alias-only rollback rehearsal pass?"; then
  warn "Release publication stays disabled until its canary and rollback evidence pass."
  exit 2
fi
if ! confirm "Did all six GHCR canaries pass digest equality, platform, provenance, and anonymous-pull checks?"; then
  warn "Production image publication stays disabled until every GHCR canary passes."
  exit 2
fi

stage "Hard-cut execution lanes"
say "Each legacy trigger is disabled before its accepted Depot publisher is enabled. Record one authoritative Origin/Depot event immediately after every lane cut."
step "Repoint this operator checkout's origin remote to the accepted Cursor Origin repository."
git remote set-url origin "$ORIGIN_CLONE_URL"
git fetch origin --prune
if [[ "$(git remote get-url origin)" != "$ORIGIN_CLONE_URL" ]]; then
  warn "The operator checkout does not use Cursor Origin as its origin remote."
  exit 2
fi
for workflow in release-finitechat.yml release-fsite.yml release-fbrain.yml; do
  disable_github_workflow "$workflow"
done
set_depot_var "FINITE_RELEASE_PUBLISH_ENABLED" "true" "Enable the accepted Depot Release publisher"
verify_depot_var "FINITE_RELEASE_PUBLISH_ENABLED" "true"
remove_depot_var "FINITE_RELEASE_CANARY_PUBLISH_ENABLED"
RELEASE_CANARY_ARMED=false
step "Run an ordinary Origin/Depot Release event with canary_publish=false and record the exact revision, run, assets, and public checksum/install result."
if ! confirm "Did the post-disable authoritative Release event pass and get appended to the evidence bundle?"; then
  warn "The Release lane cut is incomplete; GitHub Release workflows remain disabled. Use the recorded Release rollback boundary."
  exit 2
fi
for workflow in service-images.yml runtime-image.yml deepseek-v4-vllm-image.yml; do
  disable_github_workflow "$workflow"
done
set_depot_var "FINITE_GHCR_PRODUCTION_PUBLISH_ENABLED" "true" "Enable the accepted Depot GHCR production publisher"
verify_depot_var "FINITE_GHCR_PRODUCTION_PUBLISH_ENABLED" "true"
step "Run the authoritative Origin/Depot image event for each disabled image workflow with rev=<40-character accepted Origin main revision>, then repeat digest, platform, provenance, and anonymous-pull checks."
if ! confirm "Did every post-disable authoritative image event pass and get appended to the evidence bundle?"; then
  warn "The image lane cut is incomplete; GitHub image workflows remain disabled. Use the recorded image rollback boundary."
  exit 2
fi
for workflow in \
  ci.yml \
  hermes-runtime-smoke.yml \
  lat1-nixos-closure.yml \
  lat3-nixos-closure.yml \
  phala-readonly-preflight.yml \
  production-deploy-plan.yml \
  production-deploy.yml; do
  disable_github_workflow "$workflow"
done
step "Run the matching authoritative Origin/Depot PR, branch, and manual events for the disabled CI and validation workflows."
step "For the exact accepted Origin main revision, run scripts/fetch_depot_nixos_closure.py for both lat1 and lat3; retain each Depot run/artifact ID and successful non-mutating validation."
if ! confirm "Did every post-disable authoritative CI/validation event and both closure-artifact fetches pass and get appended to the evidence bundle?"; then
  warn "The CI lane cut is incomplete; its GitHub workflows remain disabled. Use the recorded lane rollback boundary."
  exit 2
fi
gh api -X PUT "repos/$GITHUB_REPO/actions/permissions" -F enabled=false >/dev/null
if [[ "$(gh api "repos/$GITHUB_REPO/actions/permissions" --jq '.enabled')" != "false" ]]; then
  warn "GitHub Actions is still enabled after every legacy workflow was disabled."
  exit 2
fi

stage "Freeze and clean the legacy GitHub source"
say "This is the irreversible-looking Hard Cut. It performs one final fast-forward copy of Origin main, then makes GitHub private and read-only."
if ! confirm "Is Origin now the accepted Source Authority, with Release and GHCR canaries passed and rollback boundaries recorded?"; then
  warn "The legacy GitHub authority remains intact."
  exit 2
fi
git --git-dir="$scratch_dir/source.git" fetch --quiet "$ORIGIN_CLONE_URL" \
  '+refs/heads/main:refs/heads/origin-final-main'
if git --git-dir="$scratch_dir/source.git" ls-tree -r --name-only \
  refs/heads/origin-final-main -- .github/workflows | grep -q .; then
  warn "Origin main still contains GitHub Actions workflows; merge the cleanup PR in Origin first."
  exit 2
fi
while IFS= read -r ruleset_id; do
  [[ -z "$ruleset_id" ]] || gh api -X DELETE "repos/$GITHUB_REPO/rulesets/$ruleset_id" >/dev/null
done < <(gh api "repos/$GITHUB_REPO/rulesets" --jq '.[].id')
git --git-dir="$scratch_dir/source.git" push "$GITHUB_CLONE_URL" \
  refs/heads/origin-final-main:refs/heads/main
origin_main=$(git ls-remote "$ORIGIN_CLONE_URL" refs/heads/main | cut -f1)
github_main=$(git ls-remote "$GITHUB_CLONE_URL" refs/heads/main | cut -f1)
if [[ -z "$origin_main" || "$origin_main" != "$github_main" ]]; then
  warn "The final frozen GitHub main does not match Origin main."
  exit 2
fi
while IFS= read -r name; do
  [[ -z "$name" ]] || gh secret delete "$name" --repo "$GITHUB_REPO"
done < <(gh secret list --repo "$GITHUB_REPO" --json name --jq '.[].name')
while IFS= read -r name; do
  [[ -z "$name" ]] || gh variable delete "$name" --repo "$GITHUB_REPO"
done < <(gh variable list --repo "$GITHUB_REPO" --json name --jq '.[].name')
while IFS= read -r environment; do
  [[ -z "$environment" ]] && continue
  encoded_environment=$(python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$environment")
  gh api -X DELETE "repos/$GITHUB_REPO/environments/$encoded_environment" >/dev/null
done < <(gh api "repos/$GITHUB_REPO/environments" --jq '.environments[].name')
open_url "https://github.com/finitecomputer/finite-mono/settings/installations"
step "Remove finite-mono access from Cursor mirror, Depot GitHub, Xcode Cloud, and any other obsolete source/Actions app grants without changing grants used by other repositories."
if ! confirm "Have all obsolete GitHub source and Actions app grants been removed from finite-mono?"; then
  warn "Obsolete app authority remains; finish that cleanup before changing visibility."
  exit 2
fi
gh repo edit "$GITHUB_REPO" \
  --visibility private \
  --accept-visibility-change-consequences
gh repo archive "$GITHUB_REPO" --yes

stage "Post-privacy consumer and authority proof"
step "From a clean unauthenticated client, repeat every six-package GHCR digest pull recorded in the evidence bundle."
step "Repeat clean versioned and rolling-alias installs from finitecomputer/finite-releases for all retained CLI/architecture contracts."
step "Confirm Origin main and production rules still require their native Depot checks and production mutation remains disabled."
if ! confirm "Did every post-privacy public-consumer and Origin-authority check pass and get appended to the evidence bundle?"; then
  warn "The Hard Cutover is not complete; use the recorded rollback boundary for the affected lane."
  exit 2
fi
if [[ "$(gh repo view "$GITHUB_REPO" --json visibility,isArchived --jq '.visibility + ":" + (.isArchived|tostring)')" != "PRIVATE:true" ]]; then
  warn "The legacy GitHub source is not both private and archived."
  exit 2
fi
if [[ "$(gh api "repos/$GITHUB_REPO/actions/permissions" --jq '.enabled')" != "false" ]]; then
  warn "GitHub Actions is still enabled."
  exit 2
fi
if [[ "$(gh api "repos/$GITHUB_REPO/actions/workflows" --jq '[.workflows[] | select(.state == "active")] | length')" != "0" ]]; then
  warn "GitHub still reports an active workflow."
  exit 2
fi
say "Origin is authoritative, GitHub execution authority is gone, and public consumers passed after source privacy."

finish
