#!/usr/bin/env bash
# ADR-0046 principal-grants slice: Alice invites Bob's account to her Personal
# Brain (invite-by-email plan preview -> direct commit under Alice's hosted
# chat signature, Tier 2 — the commit is the approval), Bob's principals
# accept, and content flows with provenance. Then the reverse: Bob bootstraps
# his own Brain from the CLI, preflights and directly commits the plan for
# Alice's account, Alice accepts with her hosted chat signature, and Alice's
# agent reads Bob's seeded note. The Approval Card path (agent-initiated
# requests) is covered by the server tests.
#
# Run it through the devfinity stack wrapper:
#   scripts/with-dev-env scripts/devfinity-adr46-slice-up
# (or boot the stack yourself and exec this script as the wrapped command of
# `cargo run -p devfinity -- up --docker-runtime --headless -- <this script>`,
# exactly like scripts/devfinity-saas-smoke).
#
# Cast:
#   Alice      - the primary devfinity fixture customer (devfinity@finite.computer)
#   AliceAgent - Alice's real managed Hermes runtime container (holds folder keys)
#   Bob        - second fixture user (user_devfinity_bob / bob@finite.vip)
#   BobAgent   - Bob's managed agent. DEVIATION (documented): devfinity's runner
#                supports exactly one sandbox container (FC_RUNNER_MAX_SANDBOXES=1
#                and one fixed host port), so Bob's agent is provisioned as a
#                host-side fbrain identity plus seeded Core roster rows
#                (projects/agent_creation_requests/agent_runtimes/
#                project_runtime_links/brain_account_roster_revisions) instead of
#                a second real runtime container. Everything the Brain server
#                sees is real: the Core roster endpoint genuinely returns Bob's
#                human+agent, the identity authority genuinely resolves both
#                npubs, and Bob's agent accepts/syncs/writes with its own key.
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)

need() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "missing required command: $1" >&2
    exit 127
  fi
}

say() {
  echo ""
  echo "=== $* ==="
}

note() {
  echo "  -> $*"
}

fail() {
  echo "ADR-0046 slice failed: $*" >&2
  exit 1
}

wait_http() {
  local name="$1"
  local url="$2"
  local timeout_secs="${3:-120}"
  local started
  started="$(date +%s)"
  until curl -fsS --max-time 3 "$url" >/dev/null 2>&1; do
    if (( "$(date +%s)" - started >= timeout_secs )); then
      echo "$name did not become ready at $url within ${timeout_secs}s" >&2
      return 1
    fi
    sleep 1
  done
}

need curl
need node
need psql
need sqlite3

case "${DEVFINITY_PROFILE:-}" in
  apple-saas)
    runtime_driver=apple
    need container
    ;;
  docker-saas)
    runtime_driver=docker
    need docker
    ;;
  *)
    echo "devfinity ADR-0046 slice requires the apple-saas or docker-saas profile" >&2
    exit 64
    ;;
esac

core_url="${FC_CORE_URL:?}"
dashboard_url="${FC_DASHBOARD_URL:?}"
dashboard_origin="${dashboard_url%/dashboard}"
hosted_device_url="${FC_HOSTED_WEB_DEVICE_URL:?}"
brain_url="${FINITE_BRAIN_URL:?}"
identity_url="${FINITE_IDENTITY_AUTHORITY:?}"
hosted_api_token="${FINITECHAT_HOSTED_API_TOKEN:?}"
state_dir="${DEVFINITY_STATE_DIR:?}"
core_database_url="${FC_CORE_DATABASE_URL:?}"

ALICE_SUBJECT="user_devfinity"
ALICE_EMAIL="devfinity@finite.computer"
BOB_SUBJECT="user_devfinity_bob"
BOB_EMAIL="bob@finite.vip"
BOB_AGENT_DISPLAY="Bob Sidekick"

alice_jwt_file="$state_dir/workos-fixture/dashboard-customer.jwt"
bob_jwt_file="$state_dir/workos-fixture/bob.jwt"
operator_jwt_file="$state_dir/workos-fixture/operator.jwt"
brain_db="$state_dir/finite-brain/finite-brain.sqlite3"
scratch="$state_dir/adr46-slice"
mkdir -p "$scratch"

# Service tokens live in devfinity's secret files (0600, same-user readable).
# shellcheck disable=SC1090
source "$state_dir/secrets/core.sh"
# shellcheck disable=SC1090
source "$state_dir/secrets/identity-authority.sh"
core_api_token="${FC_CORE_API_TOKEN:?}"
identity_operator_token="${FINITE_IDENTITY_OPERATOR_TOKEN:?}"

declare -a sensitive_files=()
cleanup_sensitive_files() {
  if (( ${#sensitive_files[@]} > 0 )); then
    rm -f -- "${sensitive_files[@]}"
  fi
}
track_sensitive_file() {
  sensitive_files+=("$1")
}
trap cleanup_sensitive_files EXIT

curl_bearer_file() {
  local token_file="$1"
  shift
  local config_file="$scratch/curl-auth-$$-$RANDOM.conf"
  track_sensitive_file "$config_file"
  umask 077
  printf 'header = "authorization: Bearer %s"\n' \
    "$(tr -d '\n' <"$token_file")" >"$config_file"
  local status=0
  curl -fsS --config "$config_file" "$@" || status=$?
  rm -f "$config_file"
  return "$status"
}

runtime_container_id_for() {
  local project="$1"
  if [[ "$runtime_driver" == docker ]]; then
    docker ps --format '{{json .}}' --filter "label=computer.finite.v2.project_id=$project" \
      | node -e '
        let body = "";
        process.stdin.on("data", (chunk) => body += chunk);
        process.stdin.on("end", () => {
          const rows = body.trim().split(/\n+/).filter(Boolean).map(JSON.parse);
          if (rows.length !== 1 || !rows[0].ID) process.exit(1);
          process.stdout.write(rows[0].ID);
        });
      '
    return
  fi
  container list --format json | node -e '
    const projectId = process.argv[1];
    let body = "";
    process.stdin.on("data", (chunk) => body += chunk);
    process.stdin.on("end", () => {
      const containers = JSON.parse(body);
      const runtime = containers.find((entry) =>
        entry?.configuration?.labels?.["computer.finite.v2.project_id"] === projectId
      );
      if (!runtime?.configuration?.id) process.exit(1);
      process.stdout.write(runtime.configuration.id);
    });
  ' "$project"
}

runtime_exec() {
  if [[ "$runtime_driver" == docker ]]; then
    docker exec "$@"
  else
    container exec "$@"
  fi
}

# Bob's agent is a host-side fbrain identity inside this disposable state dir.
bob_fbrain_home="$state_dir/bob-agent"
bob_fbrain_tree_root="$state_dir/bob-agent-tree"
mkdir -p "$bob_fbrain_home" "$bob_fbrain_tree_root"
bob_fbrain() {
  env \
    FINITE_HOME="$bob_fbrain_home" \
    FBRAIN_WORKING_TREE_ROOT="$bob_fbrain_tree_root" \
    FINITE_BRAIN_SERVER_URL="$brain_url" \
    FINITE_BRAIN_PUBLIC_BASE_URL="$dashboard_origin" \
    FINITE_IDENTITY_AUTHORITY="$identity_url" \
    cargo run -q --manifest-path "$repo_root/Cargo.toml" -p finite-brain-cli --bin fbrain -- "$@"
}

# Hosted identity-provider operation as a specific WorkOS user.
hosted_op() {
  local user_id="$1"
  local operation="$2"
  local input_json="$3"
  local body
  body="$(node -e '
    const [operation, input] = process.argv.slice(1);
    process.stdout.write(JSON.stringify({
      version: "finite-brain-identity-provider-v1",
      operation,
      input: JSON.parse(input),
    }));
  ' "$operation" "$input_json")"
  local response status text
  response="$(curl -sS --max-time 30 \
    -H "authorization: Bearer $hosted_api_token" \
    -H "x-finite-workos-user-id: $user_id" \
    -H "x-finite-brain-public-origin: $dashboard_origin" \
    -H 'content-type: application/json' \
    --data "$body" \
    -w $'\n%{http_code}' \
    "$hosted_device_url/v1/brain/identity-provider")" || {
    echo "hosted identity-provider transport failed for $operation as $user_id" >&2
    return 1
  }
  status="${response##*$'\n'}"
  text="${response%$'\n'*}"
  if [[ "$status" != 2?? ]]; then
    echo "hosted identity-provider $operation as $user_id returned HTTP $status: $text" >&2
    return 1
  fi
  printf '%s' "$text"
}

# Ask a user's hosted chat device to NIP-98-sign a Brain HTTP request, then
# perform it against the Brain server (the same round-trip the Product Client
# drives through the dashboard proxy).
hosted_signed_request() {
  local user_id="$1"
  local method="$2"
  local path="$3"
  local body_text="${4:-}"
  local url="$dashboard_origin$path"
  local input signed auth_header
  input="$(node -e '
    const crypto = require("node:crypto");
    const [method, url, bodyText] = process.argv.slice(1);
    const tags = [
      ["u", url],
      ["method", method.toUpperCase()],
      ["nonce", crypto.randomBytes(16).toString("hex")],
    ];
    if (bodyText) tags.push(["payload", crypto.createHash("sha256").update(bodyText).digest("hex")]);
    process.stdout.write(JSON.stringify({
      method: method.toUpperCase(),
      url,
      bodyText,
      eventTemplate: {
        kind: 27235,
        created_at: Math.floor(Date.now() / 1000),
        tags,
        content: "",
      },
    }));
  ' "$method" "$url" "$body_text")"
  signed="$(hosted_op "$user_id" authorizeHttpRequest "$input")" || return 1
  auth_header="Nostr $(node -e '
    const signed = JSON.parse(process.argv[1]);
    process.stdout.write(Buffer.from(JSON.stringify(signed), "utf8").toString("base64"));
  ' "$signed")"
  curl_brain_json "$method" "$path" "$auth_header" "$body_text"
}

# NIP-98-sign with Bob's host-side fbrain identity (fbrain signer sign prints
# the signed kind-27235 event JSON), then curl from here.
bob_signed_request() {
  local method="$1"
  local path="$2"
  local body_text="${3:-}"
  local -a sign_args=(
    signer sign --kind 27235
    --tag "u,$dashboard_origin$path"
    --tag "method,$method"
  )
  if [[ -n "$body_text" ]]; then
    local sha
    sha="$(printf '%s' "$body_text" | shasum -a 256 | cut -d' ' -f1)"
    sign_args+=(--tag "payload,$sha")
  fi
  local event_json auth_header
  event_json="$(bob_fbrain "${sign_args[@]}")" || {
    echo "Bob-side event signing failed for $method $path" >&2
    return 1
  }
  auth_header="Nostr $(printf '%s' "$event_json" | base64 | tr -d '\n')"
  curl_brain_json "$method" "$path" "$auth_header" "$body_text"
}

# curl a Brain JSON endpoint with a prepared Nostr authorization header;
# print the body on stdout, or the status+body on stderr and fail.
curl_brain_json() {
  local method="$1"
  local path="$2"
  local auth_header="$3"
  local body_text="${4:-}"
  local -a args=(-sS --max-time 30 -X "$method" -H "authorization: $auth_header")
  if [[ -n "$body_text" ]]; then
    args+=(-H 'content-type: application/json' --data "$body_text")
  fi
  local response status body
  response="$(curl "${args[@]}" -w $'\n%{http_code}' "$brain_url$path")" || {
    echo "curl transport failed for $method $path" >&2
    return 1
  }
  status="${response##*$'\n'}"
  body="${response%$'\n'*}"
  if [[ "$status" != 2?? ]]; then
    echo "Brain $method $path returned HTTP $status: $body" >&2
    return 1
  fi
  printf '%s' "$body"
}

say "ADR-0046 slice: waiting for the devfinity stack"
me_json="$scratch/me-alice.json"
stack_started="$(date +%s)"
until curl_bearer_file "$alice_jwt_file" "$core_url/api/core/v1/me" >"$me_json" 2>/dev/null; do
  if (( "$(date +%s)" - stack_started >= 300 )); then
    fail "Core did not answer /api/core/v1/me within 300s"
  fi
  sleep 1
done
wait_http "FiniteBrain" "$brain_url/health" 300
wait_http "Hosted Web Device" "$hosted_device_url/healthz" 300
wait_http "Finite Identity" "$identity_url/health" 300
psql "$core_database_url" -v ON_ERROR_STOP=1 -qAt -c 'SELECT 1' >/dev/null
note "core, brain, hosted device, identity authority, and postgres are up"

say "Act 0: Alice's managed agent runtime"
me_json="$scratch/me-alice.json"
curl_bearer_file "$alice_jwt_file" "$core_url/api/core/v1/me" >"$me_json"
if ! node - "$me_json" <<'JS' >/dev/null 2>&1
const fs = require("node:fs");
const me = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
process.exit((me.projects || []).some((entry) => entry.runtime) ? 0 : 1);
JS
then
  if node - "$me_json" <<'JS'
const fs = require("node:fs");
const me = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
process.exit((me.agent_creation_requests || []).some((request) => ["requested", "launching"].includes(request.status)) ? 0 : 1);
JS
  then
    note "an agent launch is already in flight; waiting for it"
  else
    note "no runtime yet; issuing a launch code and submitting the agent form as Alice"
    run_id="$(date +%s)-$$"
    curl_bearer_file "$operator_jwt_file" \
      -H 'content-type: application/json' \
      --data '{"name":"Devfinity ADR-0046 slice","codeCount":1,"expiresInHours":24}' \
      "$core_url/api/core/v1/admin/launch-code-batches" >"$scratch/launch-codes.json"
    launch_code="$(node -e '
      const fs = require("node:fs");
      const code = JSON.parse(fs.readFileSync(process.argv[1], "utf8"))?.codes?.[0]?.code;
      if (typeof code !== "string" || !code) process.exit(1);
      process.stdout.write(code);
    ' "$scratch/launch-codes.json")"
    rm -f "$scratch/launch-codes.json"
    launch_code_file="$scratch/launch-code.txt"
    track_sensitive_file "$launch_code_file"
    umask 077
    printf '%s' "$launch_code" >"$launch_code_file"
    curl -fsS \
      -o /dev/null \
      -X POST \
      --data-urlencode "displayName=Alice ADR-0046 Agent $run_id" \
      --data-urlencode "hostingTier=standard" \
      --data-urlencode "access=launch-code" \
      --data-urlencode "launchCode@$launch_code_file" \
      --data-urlencode "idempotencyKey=devfinity-adr46-$run_id" \
      "$dashboard_url/agent-creation-requests"
    rm -f "$launch_code_file"
    note "submitted the dashboard agent form; the runner is launching Alice's container"
  fi
fi

runtime_started="$(date +%s)"
while true; do
  curl_bearer_file "$alice_jwt_file" "$core_url/api/core/v1/me" >"$me_json"
  if fields="$(node - "$me_json" <<'JS'
const fs = require("node:fs");
const me = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const visible = (me.projects || []).find((entry) => entry.runtime);
if (!visible) process.exit(1);
const project = visible.project;
const runtime = visible.runtime;
const contact = new URL(runtime.contact_endpoint);
contact.pathname = contact.pathname.replace(/\/contact\/?$/, "");
process.stdout.write([
  project.id,
  runtime.id,
  contact.toString().replace(/\/$/, ""),
  project.agent_email || "",
].join("\t"));
JS
  )"; then
    IFS=$'\t' read -r project_id machine_id runtime_url agent_email <<<"$fields"
    if [[ -n "$project_id" && -n "$machine_id" && -n "$runtime_url" && -n "$agent_email" ]]; then
      break
    fi
  fi
  if node - "$me_json" <<'JS'
const fs = require("node:fs");
const me = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const failed = (me.agent_creation_requests || []).find((request) => request.status === "failed");
if (failed) {
  console.error(`Agent launch failed: ${failed.failure_message || failed.id}`);
  process.exit(0);
}
process.exit(1);
JS
  then
    fail "Alice's agent launch failed"
  fi
  if (( "$(date +%s)" - runtime_started >= 900 )); then
    fail "Core did not report a launched runtime within 900s"
  fi
  sleep 2
done
alice_container_id="$(runtime_container_id_for "$project_id")"
wait_http "Alice Agent Runtime" "$runtime_url/healthz" 300
alice_agent_npub="$(curl -fsS --max-time 5 "$runtime_url/healthz" | node -e '
  let body = "";
  process.stdin.on("data", (chunk) => body += chunk);
  process.stdin.on("end", () => {
    const value = JSON.parse(body);
    const npub = String(value.agent_npub || value.npub || "");
    if (!value.ready || !npub.startsWith("npub1")) process.exit(1);
    process.stdout.write(npub);
  });
')"
note "Alice's agent runtime is live: project=$project_id agent=$agent_email"
note "AliceAgent npub: $alice_agent_npub"

say "Act 1: Alice creates her Personal Brain (user-first, hosted-device signed)"
alice_pubkey_hex="$(node -e '
  const charset = "qpzry9x8gf2tvdcw0s3jn54khce6mua7l";
  const npub = process.argv[1];
  const data = [];
  for (const character of npub.slice(5)) {
    const value = charset.indexOf(character);
    if (value < 0) throw new Error("invalid npub character");
    data.push(value);
  }
  const bytes = [];
  let bits = 0;
  let accumulator = 0;
  for (const value of data.slice(0, -6)) {
    accumulator = (accumulator << 5) | value;
    bits += 5;
    if (bits >= 8) {
      bits -= 8;
      bytes.push((accumulator >> bits) & 0xff);
    }
  }
  if (bytes.length !== 32) throw new Error(`unexpected pubkey length ${bytes.length}`);
  process.stdout.write(bytes.map((byte) => byte.toString(16).padStart(2, "0")).join(""));
' "$alice_npub")" || fail "could not decode Alice's npub"
personal_brain_id="personal-${alice_pubkey_hex:0:16}"
personal_create_body="$(node -e '
  const [brainId, agentEmail] = process.argv.slice(1);
  process.stdout.write(JSON.stringify({
    brainId,
    kind: "personal",
    name: "Personal Brain",
    bootstrapGrants: [],
    personalAgentEmail: agentEmail,
  }));
' "$personal_brain_id" "$agent_email")"
hosted_signed_request "$ALICE_SUBJECT" POST /v1/brains "$personal_create_body" >"$scratch/alice-brain.json" \
  || fail "user-first Personal Brain creation failed"
brain_id="$(node -e '
  const fs = require("node:fs");
  const metadata = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
  if (metadata.brainId !== process.argv[2]) throw new Error(JSON.stringify(metadata));
  process.stdout.write(metadata.brainId);
' "$scratch/alice-brain.json" "$personal_brain_id")"
note "Alice's Personal Brain (user-first, Personal Agent $agent_email): $brain_id"

# The runtime supervisor must discover Alice's membership before her agent can
# administer the Brain.
agent_list_started="$(date +%s)"
while true; do
  if runtime_exec "$alice_container_id" fbrain brain list --json >"$scratch/alice-brains.json" 2>/dev/null \
    && node - "$scratch/alice-brains.json" "$brain_id" <<'JS' >/dev/null 2>&1
const fs = require("node:fs");
const response = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const brains = response.brains || [];
process.exit(brains.some((brain) =>
  brain.brainId === process.argv[3] && brain.kind === "personal" && brain.role === "personal_agent"
) ? 0 : 1);
JS
  then
    break
  fi
  if (( "$(date +%s)" - agent_list_started >= 180 )); then
    fail "Alice's agent did not discover her Personal Brain within 180s"
  fi
  sleep 2
done
note "AliceAgent sees the Brain as personal_agent"

say "Act 1b: AliceAgent creates a shared Folder and seeds a note"
runtime_exec "$alice_container_id" fbrain folder create shared-with-bob \
  --brain "$brain_id" \
  --name "Shared with Bob" \
  --path shared-with-bob \
  --json >/dev/null
alice_tree="/data/workspace/finitebrain/$brain_id"
runtime_exec "$alice_container_id" fbrain open "$brain_id" --json >/dev/null
runtime_exec -w "$alice_tree" "$alice_container_id" fbrain sync now --json >/dev/null
seed_note="Alice seed note $(date +%s)-$$: this page existed before Bob joined."
runtime_exec -e "SEED_NOTE=$seed_note" "$alice_container_id" /bin/bash -lc '
  printf "# Alice seed\n\n%s\n" "$SEED_NOTE" >"$1/shared-with-bob/alice-seed.md"
' _ "$alice_tree"
runtime_exec -w "$alice_tree" "$alice_container_id" fbrain sync now --json >/dev/null
note "Folder shared-with-bob created; AliceAgent seeded alice-seed.md"

# Alice's hosted chat identity (her human Principal / card signer).
curl -fsS --max-time 30 \
  -H "authorization: Bearer $hosted_api_token" \
  -H "x-finite-workos-user-id: $ALICE_SUBJECT" \
  "$hosted_device_url/v1/app/state" >"$scratch/alice-hosted-state.json"
alice_npub="$(hosted_op "$ALICE_SUBJECT" identifyMember 'null' | node -e '
  let body = "";
  process.stdin.on("data", (chunk) => body += chunk);
  process.stdin.on("end", () => {
    const npub = String(JSON.parse(body).npub || "");
    if (!npub.startsWith("npub1")) process.exit(1);
    process.stdout.write(npub);
  });
')"
note "Alice (human, hosted chat signer) npub: $alice_npub"

say "Act 2: provisioning Bob's account, identity, and agent roster"
curl_bearer_file "$bob_jwt_file" "$core_url/api/core/v1/me" >"$scratch/me-bob.json"
node - "$scratch/me-bob.json" <<'JS' || fail "Bob's Core account did not materialize"
const fs = require("node:fs");
const me = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const subject = me.workosUserId || me.workos_user_id;
if (subject !== "user_devfinity_bob") throw new Error(`expected Bob, received ${subject}`);
if (me.email !== "bob@finite.vip") throw new Error(`expected Bob's mailbox, received ${me.email}`);
JS
note "Bob's Core account exists (subject $BOB_SUBJECT, mailbox $BOB_EMAIL)"

curl -fsS --max-time 30 \
  -H "authorization: Bearer $hosted_api_token" \
  -H "x-finite-workos-user-id: $BOB_SUBJECT" \
  "$hosted_device_url/v1/app/state" >"$scratch/bob-hosted-state.json"
bob_npub="$(hosted_op "$BOB_SUBJECT" identifyMember 'null' | node -e '
  let body = "";
  process.stdin.on("data", (chunk) => body += chunk);
  process.stdin.on("end", () => {
    const npub = String(JSON.parse(body).npub || "");
    if (!npub.startsWith("npub1")) process.exit(1);
    process.stdout.write(npub);
  });
')"
note "Bob (human, hosted chat signer) npub: $bob_npub"
note "Bob's npub <-> account binding was registered with the identity authority by his hosted device"

bob_agent_npub="$(bob_fbrain signer public-key)"
[[ "$bob_agent_npub" == npub1* ]] || fail "Bob's agent identity did not mint an npub"
note "BobAgent npub: $bob_agent_npub (host-side fbrain identity; see header deviation note)"

# Seed the roster rows the real launch pipeline would have written for Bob's
# agent (devfinity's runner runs exactly one sandbox container; see header).
rand_suffix="$(node -e 'process.stdout.write(require("node:crypto").randomBytes(6).toString("hex"))')"
bob_project_id="project_adr46bob${rand_suffix}"
bob_runtime_id="runtime_adr46bob${rand_suffix}"
bob_request_id="acreq_adr46bob${rand_suffix}"
bob_link_id="link_adr46bob${rand_suffix}"
bob_agent_email="bob-sidekick-${rand_suffix}@finite.vip"
psql "$core_database_url" -v ON_ERROR_STOP=1 -qAt <<SQL
INSERT INTO projects (id, customer_org_id, owner_user_id, display_name, agent_email, created_at, updated_at)
SELECT
  '$bob_project_id', orgs.id, users.id, '$BOB_AGENT_DISPLAY', '$bob_agent_email', now(), now()
FROM users users
JOIN customer_orgs orgs ON orgs.owner_user_id = users.id
WHERE users.workos_user_id = '$BOB_SUBJECT';
INSERT INTO agent_runtimes
  (id, project_id, source_host_id, source_machine_id, source_import_key, host_facts, created_at, updated_at)
VALUES
  ('$bob_runtime_id', '$bob_project_id', 'devfinity-adr46-seed', 'devfinity-adr46-seed',
   'devfinity-adr46-seed-$rand_suffix', '{}'::jsonb, now(), now());
INSERT INTO agent_creation_requests
  (id, customer_org_id, owner_user_id, project_id, idempotency_key, display_name,
   runner_class, status, agent_runtime_id, created_at, updated_at)
SELECT
  '$bob_request_id', orgs.id, users.id, '$bob_project_id', 'devfinity-adr46-$rand_suffix',
  '$BOB_AGENT_DISPLAY', 'local_docker', 'running', '$bob_runtime_id', now(), now()
FROM users users
JOIN customer_orgs orgs ON orgs.owner_user_id = users.id
WHERE users.workos_user_id = '$BOB_SUBJECT';
INSERT INTO project_runtime_links (id, project_id, agent_runtime_id, active, created_at)
VALUES ('$bob_link_id', '$bob_project_id', '$bob_runtime_id', true, now());
INSERT INTO brain_account_roster_revisions (account_id, roster_revision, updated_at)
VALUES ('$BOB_SUBJECT', 1, now())
ON CONFLICT (account_id) DO NOTHING;
SQL
[[ "$(psql "$core_database_url" -qAt -c \
  "SELECT count(*) FROM projects WHERE id = '$bob_project_id'")" == "1" ]] \
  || fail "Bob's roster seed did not land"
note "seeded Bob's roster rows (project $bob_project_id, agent $bob_agent_email)"

curl -fsS --max-time 15 \
  -H "x-finite-operator-token: $identity_operator_token" \
  -H 'content-type: application/json' \
  --data "$(node -e '
    process.stdout.write(JSON.stringify({
      email: process.argv[1],
      agent_npub: process.argv[2],
    }));
  ' "$bob_agent_email" "$bob_agent_npub")" \
  "$identity_url/api/v1/operator/agent-email-bindings" >"$scratch/bob-agent-binding.json"
note "bound $bob_agent_email -> BobAgent npub in the identity authority"

curl -fsS --max-time 15 \
  -H "authorization: Bearer $core_api_token" \
  -H 'content-type: application/json' \
  --data "{\"email\":\"$BOB_EMAIL\"}" \
  "$core_url/api/core/v1/brain/account-agent-roster" >"$scratch/bob-roster.json"
node - "$scratch/bob-roster.json" "$BOB_EMAIL" "$bob_agent_email" <<'JS' || fail "Core roster for Bob is not human+agent"
const fs = require("node:fs");
const roster = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const [email, agentEmail] = process.argv.slice(3);
if (roster.humanMailbox !== email) throw new Error(`humanMailbox: ${JSON.stringify(roster)}`);
if (Number(roster.rosterRevision) < 1) throw new Error(`rosterRevision: ${JSON.stringify(roster)}`);
const agents = roster.agents || [];
if (!agents.some((agent) => agent.managedAgentEmail === agentEmail)) {
  throw new Error(`agents: ${JSON.stringify(roster)}`);
}
JS
note "Core account-agent-roster for $BOB_EMAIL: human + 1 agent ($bob_agent_email), rosterRevision=1"

if [[ "${ADR46_HANDS_ON:-}" == "1" ]]; then
