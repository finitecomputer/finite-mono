say "Act 3: Alice invites Bob by email (plan preview -> direct commit, hosted-device signed)"
preflight_body="$(node -e '
  process.stdout.write(JSON.stringify({ target: process.argv[1] }));
' "$BOB_EMAIL")"
hosted_signed_request "$ALICE_SUBJECT" POST "/v1/brains/$brain_id/invitations/preflight" "$preflight_body" \
  >"$scratch/alice-plan.json" || fail "invitation plan preflight failed"
node - "$scratch/alice-plan.json" <<'JS' || fail "preflight did not resolve Bob's account into a plan"
const fs = require("node:fs");
const plan = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
if (!plan.planId || !plan.planHash) throw new Error(JSON.stringify(plan));
JS
commit_body="$(node -e '
  const fs = require("node:fs");
  const plan = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
  process.stdout.write(JSON.stringify({ planId: plan.planId, planHash: plan.planHash }));
' "$scratch/alice-plan.json")"
hosted_signed_request "$ALICE_SUBJECT" POST "/v1/brains/$brain_id/invitations/commit" "$commit_body" \
  >"$scratch/alice-commit.json" || fail "invitation plan commit failed"
note "Alice previewed the resolved plan and committed it directly (Tier 2: the commit is the approval)"

say "Act 4: the direct commit landed with provenance (Brain DB)"
approval_request_count="$(sqlite3 -readonly "$brain_db" \
  "SELECT COUNT(*) FROM brain_approval_requests WHERE brain_id = '$brain_id' AND action = 'invite-commit'")"
[[ "$approval_request_count" == "0" ]] || fail "the direct commit wrongly filed an invite-commit Approval request"
note "no Approval request was created — Alice committed directly with her hosted signature"

alice_plan_id="$(sqlite3 -readonly "$brain_db" \
  "SELECT id FROM brain_invitation_plans WHERE brain_id = '$brain_id' AND human_email = '$BOB_EMAIL' AND status = 'committed' ORDER BY created_at DESC LIMIT 1")"
[[ -n "$alice_plan_id" ]] || fail "no committed invitation plan for Bob in the Brain DB"
note "the direct commit resolved to invitation plan $alice_plan_id"

sqlite3 -readonly "$brain_db" \
  "SELECT user_id, origin_kind, origin_ref, roster_revision, status, invite_code, id FROM brain_invitations WHERE brain_id = '$brain_id' ORDER BY user_id" \
  >"$scratch/invitation-provenance.txt"
cat "$scratch/invitation-provenance.txt"
node - "$scratch/invitation-provenance.txt" "$bob_npub" "$bob_agent_npub" "$alice_plan_id" <<'JS' || fail "invitation provenance is wrong"
const fs = require("node:fs");
const rows = fs.readFileSync(process.argv[2], "utf8").trim().split("\n").filter(Boolean)
  .map((line) => line.split("|"));
const [bobNpub, bobAgentNpub, planId] = process.argv.slice(3);
const principals = rows.map((row) => row[0]).sort();
if (JSON.stringify(principals) !== JSON.stringify([bobNpub, bobAgentNpub].sort())) {
  throw new Error(`principals: ${JSON.stringify(rows)}`);
}
for (const row of rows) {
  if (row[1] !== "invitation") throw new Error(`origin_kind: ${row}`);
  if (row[2] !== planId) throw new Error(`origin_ref: ${row}`);
  if (Number(row[3]) < 1) throw new Error(`roster_revision: ${row}`);
  if (row[4] !== "pending") throw new Error(`status: ${row}`);
  if (!row[5].startsWith("invite-") || !row[6].startsWith("invitation-")) {
    throw new Error(`accept-ready identifiers: ${row}`);
  }
}
JS
note "both invitations carry origin_kind=invitation, origin_ref=$alice_plan_id, roster_revision=1"

bob_human_invite_code="$(node - "$scratch/invitation-provenance.txt" "$bob_npub" <<'JS'
const fs = require("node:fs");
const row = fs.readFileSync(process.argv[2], "utf8").trim().split("\n").filter(Boolean)
  .map((line) => line.split("|"))
  .find((candidate) => candidate[0] === process.argv[3]);
if (!row) process.exit(1);
process.stdout.write(row[5]);
JS
)"
bob_agent_invitation_id="$(node - "$scratch/invitation-provenance.txt" "$bob_agent_npub" <<'JS'
const fs = require("node:fs");
const row = fs.readFileSync(process.argv[2], "utf8").trim().split("\n").filter(Boolean)
  .map((line) => line.split("|"))
  .find((candidate) => candidate[0] === process.argv[3]);
if (!row) process.exit(1);
process.stdout.write(row[6]);
JS
)"
note "Bob's inviteCode: $bob_human_invite_code; BobAgent's invitation id: $bob_agent_invitation_id"

say "Act 5: Bob's principals accept their invitations"
hosted_signed_request "$BOB_SUBJECT" POST "/v1/brain-invitation-links/$bob_human_invite_code/accept" \
  >"$scratch/bob-accept.json" || fail "Bob's acceptance failed"
node - "$scratch/bob-accept.json" <<'JS' || fail "Bob's invitation did not flip to accepted"
const fs = require("node:fs");
const invitation = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
if (invitation.status !== "accepted" || !invitation.acceptedAt) throw new Error(JSON.stringify(invitation));
JS
note "Bob accepted with his hosted chat signature (human Principal joined the Brain)"

bob_fbrain invite brain accept --id "$bob_agent_invitation_id" --json \
  >"$scratch/bob-agent-accept.json" || fail "BobAgent's acceptance failed"
node - "$scratch/bob-agent-accept.json" <<'JS' || fail "BobAgent's invitation did not flip to accepted"
const fs = require("node:fs");
const invitation = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
if (invitation.status !== "accepted") throw new Error(JSON.stringify(invitation));
JS
note "BobAgent accepted its per-principal invitation with its own key"

