say "Act 7: BobAgent syncs, reads Alice's note, and writes back"
bob_fbrain brain list --json >"$scratch/bob-agent-brains.json"
node - "$scratch/bob-agent-brains.json" "$brain_id" <<'JS' || fail "BobAgent cannot see Alice's Brain"
const fs = require("node:fs");
const response = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const brain = (response.brains || []).find((entry) => entry.brainId === process.argv[3]);
if (!brain) throw new Error(JSON.stringify(response.brains));
JS
bob_fbrain open "$brain_id" --json >"$scratch/bob-agent-open.json" \
  || fail "BobAgent could not open the Brain"
bob_tree="$bob_fbrain_tree_root/$brain_id"
bob_sync_started="$(date +%s)"
while true; do
  (
    cd "$bob_tree"
    bob_fbrain sync now --json >/dev/null 2>&1
  ) || true
  if [[ -f "$bob_tree/shared-with-bob/alice-seed.md" ]]; then
    break
  fi
  if (( "$(date +%s)" - bob_sync_started >= 120 )); then
    fail "BobAgent did not receive alice-seed.md within 120s"
  fi
  sleep 3
done
grep -Fq "this page existed before Bob joined" "$bob_tree/shared-with-bob/alice-seed.md" \
  || fail "BobAgent decrypted the wrong seed content"
note "BobAgent decrypted alice-seed.md from before it joined"

bob_note="Bob was here $(date +%s)-$$: written through BobAgent's own key after accepting the plan-committed invitation."
printf '# Bob was here\n\n%s\n' "$bob_note" >"$bob_tree/shared-with-bob/bob-reply.md"
(
  cd "$bob_tree"
  bob_fbrain sync now --json >/dev/null
)
note "BobAgent wrote bob-reply.md and pushed it"

say "Act 8: Alice's side reads Bob's note back"
alice_read_started="$(date +%s)"
while true; do
  runtime_exec -w "$alice_tree" "$alice_container_id" fbrain sync now --json >/dev/null 2>&1 || true
  if runtime_exec "$alice_container_id" /bin/bash -lc '
      grep -Fq "Bob was here" "$1/shared-with-bob/bob-reply.md" 2>/dev/null
    ' _ "$alice_tree"; then
    break
  fi
  if (( "$(date +%s)" - alice_read_started >= 120 )); then
    fail "AliceAgent did not receive bob-reply.md within 120s"
  fi
  sleep 3
done
note "AliceAgent synced and reads bob-reply.md in its own Working Tree"

say "Act 9: provenance finale (Brain DB)"
note "brain_members rows for Bob's principals:"
sqlite3 -readonly "$brain_db" \
  "SELECT user_id, delegated_by_npub, origin_kind, origin_ref FROM brain_members WHERE brain_id = '$brain_id' ORDER BY user_id" \
  | tee "$scratch/member-provenance.txt"
sqlite3 -readonly "$brain_db" \
  "SELECT recipient_npub, issuer_npub, delegated_by_npub, origin_kind FROM folder_key_grants WHERE brain_id = '$brain_id' AND recipient_npub = '$bob_agent_npub'" \
  | tee "$scratch/grant-provenance.txt"
node - \
  "$scratch/member-provenance.txt" \
  "$scratch/grant-provenance.txt" \
  "$bob_npub" "$bob_agent_npub" "$alice_npub" "$alice_agent_npub" "$alice_plan_id" <<'JS' \
  || fail "member/grant provenance is wrong"
const fs = require("node:fs");
const [membersPath, grantsPath, bobNpub, bobAgentNpub, aliceNpub, aliceAgentNpub, planId] =
  process.argv.slice(2);
const memberRows = fs.readFileSync(membersPath, "utf8").trim().split("\n").filter(Boolean)
  .map((line) => line.split("|"));
for (const principal of [bobNpub, bobAgentNpub]) {
  const row = memberRows.find((candidate) => candidate[0] === principal);
  if (!row) throw new Error(`no brain_members row for ${principal}`);
  if (row[1] !== aliceNpub) throw new Error(`delegated_by for ${principal}: ${row}`);
  if (row[2] !== "invitation") throw new Error(`origin_kind for ${principal}: ${row}`);
  if (row[3] !== planId) throw new Error(`origin_ref for ${principal}: ${row}`);
}
const grantRows = fs.readFileSync(grantsPath, "utf8").trim().split("\n").filter(Boolean)
  .map((line) => line.split("|"));
if (grantRows.length !== 1) throw new Error(`folder_key_grants rows: ${JSON.stringify(grantRows)}`);
const grant = grantRows[0];
if (grant[1] !== aliceAgentNpub) throw new Error(`grant issuer_npub: ${grant}`);
// A direct admin grant is not delegated: delegated_by/origin_ref stay NULL.
if (grant[2] !== "") throw new Error(`grant delegated_by should be empty: ${grant}`);
if (grant[3] !== "direct") throw new Error(`grant origin_kind: ${grant}`);
JS
note "members: delegated_by=Alice's hosted signature, origin_kind=invitation, origin_ref=invitation plan"
note "folder_key_grants: issuer=AliceAgent, origin_kind=direct"

say "Act 10: Bob bootstraps his own Brain from the CLI and seeds a note"
bob_fbrain brain bootstrap-personal --json >"$scratch/bob-brain.json" || fail "Bob's Brain bootstrap failed"
bob_brain_id="$(node - "$scratch/bob-brain.json" <<'JS'
const fs = require("node:fs");
const response = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const brainId = response.brain?.brainId || response.brainId || response.brain_id || "";
if (!brainId) process.exit(1);
process.stdout.write(brainId);
JS
)" || fail "Bob's Brain bootstrap response had no Brain id"
[[ -n "$bob_brain_id" ]] || fail "Bob's Brain bootstrap did not return a Brain id"
note "Bob's Brain: $bob_brain_id"

bob_fbrain folder create shared-with-alice \
  --brain "$bob_brain_id" \
  --name "Shared with Alice" \
  --path shared-with-alice \
  --json >/dev/null
bob_fbrain open "$bob_brain_id" --json >/dev/null
bob_own_tree="$bob_fbrain_tree_root/$bob_brain_id"
(
  cd "$bob_own_tree"
  bob_fbrain sync now --json >/dev/null
)
bob_seed="Bob seed note $(date +%s)-$$: this page existed before Alice joined."
printf '# Bob seed\n\n%s\n' "$bob_seed" >"$bob_own_tree/shared-with-alice/bob-seed.md"
(
  cd "$bob_own_tree"
  bob_fbrain sync now --json >/dev/null
)
note "Folder shared-with-alice created; Bob seeded bob-seed.md"

say "Act 11: Bob preflights and commits the invitation plan for Alice (CLI direct commit)"
bob_preflight_body="$(node -e 'process.stdout.write(JSON.stringify({ target: process.argv[1] }))' "$ALICE_EMAIL")"
bob_signed_request POST "/v1/brains/$bob_brain_id/invitations/preflight" "$bob_preflight_body" \
  >"$scratch/bob-preflight.json" || fail "Bob's invitation preflight for Alice failed"
node - "$scratch/bob-preflight.json" "$alice_npub" "$alice_agent_npub" <<'JS' || fail "Bob's preflight plan is missing Alice's principals"
const fs = require("node:fs");
const plan = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const [aliceNpub, aliceAgentNpub] = process.argv.slice(3);
if (!plan.planId || !/^sha256:[0-9a-f]{64}$/.test(plan.planHash || "")) {
  throw new Error(`plan identity missing: ${JSON.stringify(plan)}`);
}
if (plan.human?.npub !== aliceNpub) throw new Error(`human: ${JSON.stringify(plan.human)}`);
const agents = plan.agents || [];
if (!agents.some((agent) => agent.agentNpub === aliceAgentNpub && agent.status === "active")) {
  throw new Error(`agents: ${JSON.stringify(agents)} exclusions: ${JSON.stringify(plan.exclusions)}`);
}
JS
bob_plan_id="$(node -e 'process.stdout.write(JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8")).planId)' "$scratch/bob-preflight.json")"
bob_plan_hash="$(node -e 'process.stdout.write(JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8")).planHash)' "$scratch/bob-preflight.json")"
note "plan $bob_plan_id resolves Alice + AliceAgent (roster from Core, bindings from the identity authority)"

bob_commit_body="$(node -e '
  process.stdout.write(JSON.stringify({ planId: process.argv[1], planHash: process.argv[2] }));
' "$bob_plan_id" "$bob_plan_hash")"
bob_signed_request POST "/v1/brains/$bob_brain_id/invitations/commit" "$bob_commit_body" \
  >"$scratch/bob-commit.json" || fail "Bob's direct plan commit failed"
node - "$scratch/bob-commit.json" "$ALICE_EMAIL" "$agent_email" <<'JS' || fail "Bob's commit did not write per-principal invitations for Alice"
const fs = require("node:fs");
const result = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const [email, agentEmail] = process.argv.slice(3);
if (result.status !== "committed") throw new Error(JSON.stringify(result));
const invitations = result.invitations || [];
const refs = invitations.map((entry) => entry.ref).sort();
if (JSON.stringify(refs) !== JSON.stringify([email, agentEmail].sort())) {
  throw new Error(`invitations: ${JSON.stringify(invitations)} skipped: ${JSON.stringify(result.skipped)}`);
}
for (const entry of invitations) {
  if (entry.invitation?.status !== "pending" || !entry.invitation?.id || !entry.invitation?.inviteCode) {
    throw new Error(`invitation not accept-ready: ${JSON.stringify(entry)}`);
  }
}
JS
alice_human_invite_code="$(node - "$scratch/bob-commit.json" "$ALICE_EMAIL" <<'JS'
const fs = require("node:fs");
const result = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const entry = result.invitations.find((item) => item.ref === process.argv[3]);
process.stdout.write(entry.invitation.inviteCode);
JS
)"
alice_agent_invitation_id="$(node - "$scratch/bob-commit.json" "$agent_email" <<'JS'
const fs = require("node:fs");
const result = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const entry = result.invitations.find((item) => item.ref === process.argv[3]);
process.stdout.write(entry.invitation.id);
JS
)"
note "Alice's inviteCode: $alice_human_invite_code; AliceAgent's invitation id: $alice_agent_invitation_id"

say "Act 12: Alice accepts Bob's invitation with her hosted chat signature"
hosted_signed_request "$ALICE_SUBJECT" POST "/v1/brain-invitation-links/$alice_human_invite_code/accept" \
  >"$scratch/alice-accept.json" || fail "Alice's acceptance failed"
node - "$scratch/alice-accept.json" <<'JS' || fail "Alice's invitation did not flip to accepted"
const fs = require("node:fs");
const invitation = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
if (invitation.status !== "accepted" || !invitation.acceptedAt) throw new Error(JSON.stringify(invitation));
JS
note "Alice joined Bob's Brain as the human Principal"

say "Act 13: AliceAgent accepts, Bob wraps the Folder key, Alice's side reads Bob's note"
runtime_exec "$alice_container_id" fbrain invite brain accept --id "$alice_agent_invitation_id" --json \
  >"$scratch/alice-agent-accept.json" || fail "AliceAgent's acceptance failed"
node - "$scratch/alice-agent-accept.json" <<'JS' || fail "AliceAgent's invitation did not flip to accepted"
const fs = require("node:fs");
const invitation = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
if (invitation.status !== "accepted") throw new Error(JSON.stringify(invitation));
JS
note "AliceAgent accepted its per-principal invitation with its own key"

bob_fbrain admin folder-access grant \
  --brain "$bob_brain_id" \
  --folder shared-with-alice \
  --target "$alice_agent_npub" \
  --json >"$scratch/alice-agent-grant.json" || fail "Bob's folder-access grant failed"
note "Bob issued a signed Folder Key Grant to AliceAgent (issuer=Bob, origin_kind=direct)"

runtime_exec "$alice_container_id" fbrain open "$bob_brain_id" --json >"$scratch/alice-agent-open-bob-brain.json" \
  || fail "AliceAgent could not open Bob's Brain"
alice_tree_on_bob_brain="/data/workspace/finitebrain/$bob_brain_id"
alice_bob_sync_started="$(date +%s)"
while true; do
  runtime_exec -w "$alice_tree_on_bob_brain" "$alice_container_id" fbrain sync now --json >/dev/null 2>&1 || true
  if runtime_exec "$alice_container_id" /bin/bash -lc '
      grep -Fq "this page existed before Alice joined" "$1/shared-with-alice/bob-seed.md" 2>/dev/null
    ' _ "$alice_tree_on_bob_brain"; then
    break
  fi
  if (( "$(date +%s)" - alice_bob_sync_started >= 120 )); then
    fail "AliceAgent did not receive bob-seed.md within 120s"
  fi
  sleep 3
done
note "AliceAgent synced Bob's Brain and reads bob-seed.md from before it joined"

say "Act 14: reverse-direction provenance (Brain DB)"
note "brain_members rows for Alice's principals in Bob's Brain:"
sqlite3 -readonly "$brain_db" \
  "SELECT user_id, delegated_by_npub, origin_kind, origin_ref FROM brain_members WHERE brain_id = '$bob_brain_id' ORDER BY user_id" \
  | tee "$scratch/reverse-member-provenance.txt"
sqlite3 -readonly "$brain_db" \
  "SELECT recipient_npub, issuer_npub, delegated_by_npub, origin_kind FROM folder_key_grants WHERE brain_id = '$bob_brain_id' AND recipient_npub = '$alice_agent_npub'" \
  | tee "$scratch/reverse-grant-provenance.txt"
node - \
  "$scratch/reverse-member-provenance.txt" \
  "$scratch/reverse-grant-provenance.txt" \
  "$alice_npub" "$alice_agent_npub" "$bob_agent_npub" "$bob_plan_id" <<'JS' \
  || fail "reverse-direction member/grant provenance is wrong"
const fs = require("node:fs");
const [membersPath, grantsPath, aliceNpub, aliceAgentNpub, bobAgentNpub, bobPlanId] =
  process.argv.slice(2);
const memberRows = fs.readFileSync(membersPath, "utf8").trim().split("\n").filter(Boolean)
  .map((line) => line.split("|"));
for (const principal of [aliceNpub, aliceAgentNpub]) {
  const row = memberRows.find((candidate) => candidate[0] === principal);
  if (!row) throw new Error(`no brain_members row for ${principal}`);
  if (row[1] !== bobAgentNpub) throw new Error(`delegated_by for ${principal}: ${row}`);
  if (row[2] !== "invitation") throw new Error(`origin_kind for ${principal}: ${row}`);
  if (row[3] !== bobPlanId) throw new Error(`origin_ref for ${principal}: ${row}`);
}
const grantRows = fs.readFileSync(grantsPath, "utf8").trim().split("\n").filter(Boolean)
  .map((line) => line.split("|"));
if (grantRows.length !== 1) throw new Error(`folder_key_grants rows: ${JSON.stringify(grantRows)}`);
const grant = grantRows[0];
if (grant[1] !== bobAgentNpub) throw new Error(`grant issuer_npub: ${grant}`);
if (grant[2] !== "") throw new Error(`grant delegated_by should be empty: ${grant}`);
if (grant[3] !== "direct") throw new Error(`grant origin_kind: ${grant}`);
JS
note "members: delegated_by=Bob's CLI principal, origin_kind=invitation, origin_ref=Bob's plan"
note "folder_key_grants: issuer=Bob, origin_kind=direct"

say "Act 15: departure — BobAgent is removed from Alice's Brain, everything else continues"
# Alice's agent (admin of her Personal Brain through her delegation) removes
# exactly BobAgent's principal. Bob's human membership, Bob's own Brain, and
# Alice's other flows must be untouched — the #459 departure leg.
runtime_exec -w "$alice_tree" "$alice_container_id" fbrain admin member remove \
  --brain "$brain_id" --target "$bob_agent_npub" --json >"$scratch/departure.json" \
  || fail "BobAgent removal failed"
sqlite3 -readonly "$brain_db" \
  "SELECT user_id FROM brain_members WHERE brain_id = '$brain_id' ORDER BY user_id" \
  >"$scratch/post-departure-members.txt"
node - "$scratch/post-departure-members.txt" "$bob_agent_npub" "$bob_npub" <<'JS' || fail "departure did not remove exactly BobAgent"
const fs = require("node:fs");
const members = fs.readFileSync(process.argv[2], "utf8").trim().split("\n").filter(Boolean);
const [bobAgentNpub, bobNpub] = process.argv.slice(3);
if (members.includes(bobAgentNpub)) throw new Error("BobAgent is still a member");
if (!members.includes(bobNpub)) throw new Error("Bob's human principal was removed too");
JS
note "BobAgent departed; Bob's human membership and his own Brain are untouched"

# Bob's agent tree is preserved (unsynced local state survives revocation).
bob_fbrain status --json >/dev/null 2>&1 || true
test -d "$bob_fbrain_tree_root/$brain_id" || fail "BobAgent's working tree vanished on departure"
note "BobAgent's working tree survives departure (local state preserved)"

# Unrelated work continues: Alice's agent still syncs her Brain.
runtime_exec -w "$alice_tree" "$alice_container_id" fbrain sync now --json >"$brain_sync_json" \
  || fail "Alice's unrelated sync broke after the departure"
note "Alice's Brain keeps syncing after the departure"

say "ADR-0046 slice PASSED"
echo "brain_id=$brain_id"
echo "bob_brain_id=$bob_brain_id"
echo "bob_plan_id=$bob_plan_id"
echo "alice_plan_id=$alice_plan_id"
echo "alice_npub=$alice_npub"
echo "alice_agent_npub=$alice_agent_npub"
echo "bob_npub=$bob_npub"
echo "bob_agent_npub=$bob_agent_npub"
echo "bob_agent_email=$bob_agent_email"
