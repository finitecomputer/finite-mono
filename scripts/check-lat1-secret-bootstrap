#!/usr/bin/env python3
"""Validate the public, names-only lat1 secret bootstrap contract."""

from __future__ import annotations

import argparse
import grp
import json
import os
from pathlib import Path
import pwd
import re
import stat
import sys


ENV_NAME = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")


def parse_args() -> argparse.Namespace:
    repo_root = Path(__file__).resolve().parent.parent
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--contract",
        type=Path,
        default=repo_root
        / "infra/nixos/hosts/finite-lat-1/secret-bootstrap-contract.json",
    )
    parser.add_argument(
        "--root",
        type=Path,
        default=Path("/"),
        help="alternate filesystem root for an isolated fixture",
    )
    parser.add_argument(
        "--check-env-names",
        action="store_true",
        help="read env files and validate required variable names; values are discarded",
    )
    return parser.parse_args()


def env_names(path: Path) -> set[str]:
    names: set[str] = set()
    with path.open("r", encoding="utf-8") as handle:
        for line_number, raw_line in enumerate(handle, start=1):
            line = raw_line.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("export "):
                line = line.removeprefix("export ").lstrip()
            if "=" not in line:
                raise ValueError(f"{path}:{line_number}: malformed environment entry")
            name, _discarded_value = line.split("=", 1)
            if not ENV_NAME.fullmatch(name):
                raise ValueError(
                    f"{path}:{line_number}: malformed environment variable name"
                )
            names.add(name)
    return names


def target_path(root: Path, contract_path: str) -> Path:
    relative = Path(contract_path).relative_to("/")
    return root / relative


def main() -> int:
    args = parse_args()
    contract = json.loads(args.contract.read_text(encoding="utf-8"))
    if contract.get("version") != 1 or not isinstance(contract.get("files"), list):
        print("secret bootstrap contract has an unsupported shape", file=sys.stderr)
        return 2

    failures: list[str] = []
    for item in contract["files"]:
        displayed_path = item["path"]
        path = target_path(args.root, displayed_path)
        try:
            metadata = path.lstat()
        except FileNotFoundError:
            failures.append(f"missing required file: {displayed_path}")
            continue
        if not stat.S_ISREG(metadata.st_mode):
            failures.append(f"required path is not a regular file: {displayed_path}")
            continue

        actual_mode = f"{stat.S_IMODE(metadata.st_mode):04o}"
        if actual_mode != item["mode"]:
            failures.append(
                f"wrong mode for {displayed_path}: expected {item['mode']}, got {actual_mode}"
            )
        actual_owner = pwd.getpwuid(metadata.st_uid).pw_name
        actual_group = grp.getgrgid(metadata.st_gid).gr_name
        if actual_owner != item["owner"] or actual_group != item["group"]:
            failures.append(
                f"wrong ownership for {displayed_path}: expected "
                f"{item['owner']}:{item['group']}, got {actual_owner}:{actual_group}"
            )

        if args.check_env_names and item["kind"] == "env":
            try:
                present_names = env_names(path)
            except (OSError, UnicodeError, ValueError) as error:
                failures.append(str(error))
                continue
            for required_name in item["required_names"]:
                if required_name not in present_names:
                    failures.append(
                        f"missing required variable {required_name} in {displayed_path}"
                    )

    if failures:
        for failure in failures:
            print(failure, file=sys.stderr)
        return 1

    depth = "metadata and variable names" if args.check_env_names else "metadata only"
    print(f"lat1 secret bootstrap contract passed ({depth}; no values emitted)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
