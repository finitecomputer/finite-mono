{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "alex/sites-vercel-experiment": true
    }
  },
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index"
    }
  ]
}
