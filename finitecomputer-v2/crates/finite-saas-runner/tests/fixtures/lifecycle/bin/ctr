#!/bin/sh
# Read-only fake ctr for lifecycle-probe fixtures. The ONLY supported
# invocations are the probe's read paths:
#   ctr --namespace <ns> tasks list      (containerd metadata; never the shim)
#   ctr --namespace <ns> tasks ps <id>   (no-op read answered by the shim)
# Anything else (kill, delete, ...) is recorded in fake-state/mutations.log
# and rejected with exit 42.
#
# Behavior knobs under ./fake-state next to this script:
#   tasks           full task table printed verbatim (TASK/PID/STATUS columns)
#   tasks-error     printed to stderr with exit 1 for `tasks list`
#   tasks-ps        pid list printed verbatim for `tasks ps`
#   tasks-ps-error  printed to stderr with exit 1 for `tasks ps`, e.g. the
#                   incident's "ttrpc: closed" control-channel failure
set -eu
state="$(dirname "$0")/fake-state"
mkdir -p "$state"
if [ "${1:-}" = "--namespace" ]; then shift 2; fi
cmd="${1:-} ${2:-}"
printf '%s\n' "$cmd" >>"$state/commands.log"
case "$cmd" in
  "tasks list")
    if [ -f "$state/tasks-error" ]; then
      cat "$state/tasks-error" >&2
      exit 1
    fi
    if [ -f "$state/tasks" ]; then
      cat "$state/tasks"
    fi
    ;;
  "tasks ps")
    if [ -f "$state/tasks-ps-error" ]; then
      cat "$state/tasks-ps-error" >&2
      exit 1
    fi
    if [ -f "$state/tasks-ps" ]; then
      cat "$state/tasks-ps"
    else
      printf 'PID\n4242\n'
    fi
    ;;
  *)
    printf '%s\n' "$cmd" >>"$state/mutations.log"
    echo "fixture ctr rejects non-read verb: $cmd" >&2
    exit 42
    ;;
esac
