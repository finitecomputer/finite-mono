#!/bin/sh
# Read-only fake ctr for lifecycle-probe fixtures, modelling containerd 2.3.
# The ONLY supported invocations are the probe's read paths:
#   ctr --namespace <ns> tasks list      (List: calls each shim's State and
#                                         omits tasks whose State fails)
#   ctr --namespace <ns> tasks ps <id>   (Get, then the shim answers Pids)
# Anything else (kill, delete, ...) is recorded in fake-state/mutations.log
# and rejected with exit 42.
#
# Behavior knobs under ./fake-state next to this script:
#   tasks             task table printed verbatim by `tasks list` (the tasks
#                     whose State answered; TASK/PID/STATUS columns)
#   tasks-unlisted    ids the task manager holds but `tasks list` omits
#                     because their State call failed, one per line
#   tasks-error       printed to stderr with exit 1 for `tasks list`
#   tasks-ps          pid list printed verbatim for `tasks ps`
#   tasks-ps-error    printed to stderr with exit 1 for `tasks ps`, e.g. a
#                     State timeout or a closed shim's bare NotFound
#   tasks-ps-sleep    seconds `tasks ps` blocks before answering (exec, so
#                     a killed read leaves no process holding its pipes)
#   tasks-ps-replaces "<name> <new-id>": after `tasks ps`, the named
#                     container is replaced (a race with the probe)
#   tasks-ps-removes  "<name>": after `tasks ps`, the named container is
#                     removed
#   tasks-ps-stops    "<name>": after `tasks ps`, the named container's task
#                     is gone and nerdctl shows its empty no-task status
#   tasks-ps-starts   "<name>": after `tasks ps`, a new task runs under the
#                     same container id (row added, nerdctl status running)
# A `tasks ps` for an id the task manager does not hold prints containerd's
# own `ctr: no running task found: task <id> not found` and exits 1.
set -eu
state="$(dirname "$0")/fake-state"
mkdir -p "$state"
if [ "${1:-}" = "--namespace" ]; then shift 2; fi
cmd="${1:-} ${2:-}"
printf '%s\n' "$cmd" >>"$state/commands.log"
held() {
  if [ -f "$state/tasks" ] && awk -v id="$1" '$1 == id { found = 1 } END { exit !found }' "$state/tasks"; then
    return 0
  fi
  [ -f "$state/tasks-unlisted" ] && grep -qxF "$1" "$state/tasks-unlisted"
}
case "$cmd" in
  "tasks list")
    if [ -f "$state/tasks-error" ]; then
      cat "$state/tasks-error" >&2
      exit 1
    fi
    if [ -f "$state/tasks" ]; then
      cat "$state/tasks"
    fi
    ;;
  "tasks ps")
    id="${3:-}"
    if [ -f "$state/tasks-ps-sleep" ]; then
      exec sleep "$(cat "$state/tasks-ps-sleep")"
    fi
    status=0
    if [ -f "$state/tasks-ps-error" ]; then
      cat "$state/tasks-ps-error" >&2
      status=1
    elif ! held "$id"; then
      printf 'ctr: no running task found: task %s not found\n' "$id" >&2
      status=1
    elif [ -f "$state/tasks-ps" ]; then
      cat "$state/tasks-ps"
    else
      printf 'PID     INFO\n4242    -\n'
    fi
    if [ -f "$state/tasks-ps-replaces" ]; then
      read -r name replacement <"$state/tasks-ps-replaces"
      printf '%s' "$replacement" >"$state/$name.id"
    fi
    if [ -f "$state/tasks-ps-removes" ]; then
      rm -f "$state/$(cat "$state/tasks-ps-removes").image"
    fi
    if [ -f "$state/tasks-ps-stops" ]; then
      : >"$state/$(cat "$state/tasks-ps-stops").status"
    fi
    if [ -f "$state/tasks-ps-starts" ]; then
      printf '%s  5252      RUNNING\n' "$id" >>"$state/tasks"
      printf 'running' >"$state/$(cat "$state/tasks-ps-starts").status"
    fi
    exit "$status"
    ;;
  *)
    printf '%s\n' "$cmd" >>"$state/mutations.log"
    echo "fixture ctr rejects non-read verb: $cmd" >&2
    exit 42
    ;;
esac
