set shell := ["../scripts/dev-shell", "-cu"]

# Lists just commands
default:
    just --list-submodules --list

# Runs the real web dashboard against a durable, deterministic local chat fixture.

# No provider credentials, Apple Container, or Agent Runtime are required.
web-design:
    cd ../finitecomputer-v2/apps/dashboard && pnpm run design

# Selects the live design fixture state: healthy, unavailable, or recovering.
web-design-state scenario:
    cd ../finitecomputer-v2/apps/dashboard && pnpm run design:state {{ quote(scenario) }}

# Explicitly removes only the durable local web design conversation.
web-design-reset:
    cd ../finitecomputer-v2/apps/dashboard && pnpm run design:reset

# Starts devfinity harness. `just dev up` or `just dev up --headless`
up *args:
    cd .. && nix run .#devfinity -- up {{ args }}

# Securely caches one of your existing Finite Private keys for local chat.
inference-key:
    #!/usr/bin/env bash
    set -euo pipefail
    printf 'Paste an existing Finite Private key: ' >&2
    IFS= read -r -s finite_private_key
    printf '\n' >&2
    printf '%s\n' "${finite_private_key}" | (cd .. && nix run .#devfinity-unwrapped -- inference-key)

# Starts an isolated, fresh services-only stack, runs its smoke test, and tears it down.

# This portable profile is the Linux CI gate; it does not claim to launch an Agent Runtime.
smoke:
    cd .. && nix run .#devfinity -- --state-dir .local-state/dfs up --services-only --fresh --headless -- scripts/devfinity-smoke

# Starts the real Apple Container SaaS stack and proves dashboard -> Core -> Runner -> Runtime.
saas-smoke:
    cd .. && nix run .#devfinity -- up --headless -- scripts/devfinity-saas-smoke

# Starts the local encrypted-chat stack, pairs the iOS app, and launches Simulator.

# The pinned dev shell provides Rust's Apple targets; Xcode remains a host dependency.
ios-local-agent:
    cd .. && finitechat/scripts/ios-local-agent.sh

# Same authority-free pairing stack, preloaded beyond the old sync window.
ios-local-agent-stress:
    cd .. && FINITECHAT_IOS_LOCAL_STRESS_MESSAGE_COUNT=5200 FINITECHAT_IOS_LOCAL_STRESS_CHAT_COUNT=81 finitechat/scripts/ios-local-agent.sh

# Launches a clean Electron Device against either local-agent profile.
electron-local-agent:
    cd .. && finitechat/scripts/electron-local-agent.sh

# Starts the headless stack, runs the ignored Rust smoke test, and tears the stack down
rust-smoke:
    cd .. && nix run .#devfinity -- --state-dir .local-state/dfs up --services-only --fresh --headless -- cargo test -p devfinity --locked --test stack_smoke -- --ignored --nocapture

# Prints running devfinity infra status
status:
    cd .. && nix run .#devfinity-unwrapped -- status

# Restarts one running devfinity process through the default process-compose socket
restart process:
    cd .. && scripts/devfinity-restart-process {{ quote(process) }}

# Kills running devfinity processes
cleanup:
    cd .. && nix run .#devfinity-unwrapped -- cleanup
