+// Hermes copies read-only skill directories into its durable home. The node
+// service drops every capability, so plain root cannot RemoveAll these dirs.
+func TestResetActorDirsReadOnlyDurableHome(t *testing.T) {
+	useTempNodeDirs(t)
+	const actorUID = "readonly-home"
+	dir := filepath.Join(ateompath.DurableDirVolumeMountsDir(actorUID), "home", ".hermes", "skills", "example")
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "SKILL.md"), []byte("fixture"), 0o444); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(dir, 0o555); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.Chmod(dir, 0o755) })
+	if err := resetActorDirs(actorUID); err != nil {
+		t.Fatal(err)
+	}
+	entries, err := os.ReadDir(ateompath.DurableDirVolumeMountsDir(actorUID))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(entries) != 0 {
+		t.Fatalf("durable home was not reset: %v", entries)
+	}
+}
