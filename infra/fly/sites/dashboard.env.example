# At the authorized cutover, merge this assignment into /etc/finite/dashboard.env.
# Preserve the file's other settings and root:root 0600 ownership/mode.
# The NixOS dashboard keeps FC_SITES_UPSTREAM_URL=http://127.0.0.1:8787 for
# legacy previews and Hosted Chat; do not change that upstream with this rollout.
FC_SITES_V2_UPSTREAM_URL=https://finite.site
# FINITE_SITES_VIEWER_SESSION_TOKEN remains in /etc/finite/sites-viewer-session.env;
# the Fly app must receive the same value through secret custody.
