diff --git a/cmd/atenet/internal/router/egress/egress_test.go b/cmd/atenet/internal/router/egress/egress_test.go
index ab3f516..e57b459 100644
--- a/cmd/atenet/internal/router/egress/egress_test.go
+++ b/cmd/atenet/internal/router/egress/egress_test.go
@@ -788,3 +788,24 @@ func TestParseXFCCChainIncludesIntermediates(t *testing.T) {
 		t.Error("parseXFCCChain() did not return the leaf first")
 	}
 }
+
+func TestStartingActorEgressAuthorization(t *testing.T) {
+	ca := newTestCA(t, "actor-identity-ca")
+	leaf := ca.issueActorCert(t, actorCertOptions{})
+	for _, state := range []ateapipb.ActorState{ateapipb.ActorState_ACTOR_STATE_RESUMING, ateapipb.ActorState_ACTOR_STATE_SUSPENDED, ateapipb.ActorState_ACTOR_STATE_CRASHED} {
+		t.Run(state.String(), func(t *testing.T) {
+			actor := runningActor()
+			actor.Status.State = state
+			h := egressHandler(ca.roots(), actor, nil)
+			_, err := h.HandleRequestHeaders(context.Background(), egressMetadata(xfccHeader(leaf)))
+			if state == ateapipb.ActorState_ACTOR_STATE_RESUMING {
+				if err != nil {
+					t.Fatalf("authenticated boot egress denied: %v", err)
+				}
+				actor.Metadata.Uid = "different-actor"
+				_, err = h.HandleRequestHeaders(context.Background(), egressMetadata(xfccHeader(leaf)))
+			}
+			wantStatus(t, err, envoy_type.StatusCode_Forbidden)
+		})
+	}
+}
