index 0000000..83213cd
--- /dev/null
+++ b/pkg/state/strings_test.go
@@ -0,0 +1,27 @@
+package state
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestPublicationPathsRemainASetAcrossRepublish(t *testing.T) {
+	var paths Strings
+	paths.Add("/actor/data")
+	paths.Add("/actor/data") // same actor after worker loss
+	if !reflect.DeepEqual(paths, Strings{"/actor/data"}) {
+		t.Fatalf("duplicate publication: %v", paths)
+	}
+}
+
+func TestUnpublishRemovesPersistedDuplicatePaths(t *testing.T) {
+	paths := Strings{"/other", "/actor/data", "/actor/data", "/last"}
+	paths.Remove("/actor/data")
+	if !reflect.DeepEqual(paths, Strings{"/other", "/last"}) {
+		t.Fatalf("stale publication remains: %v", paths)
+	}
+	paths.Remove("/actor/data") // retry is idempotent
+	if !reflect.DeepEqual(paths, Strings{"/other", "/last"}) {
+		t.Fatalf("unpublish changed unrelated paths: %v", paths)
+	}
+}
