+type unavailableDrain struct{ ateapipb.ControlClient }
+
+func (unavailableDrain) DrainWorker(context.Context, *ateapipb.DrainWorkerRequest, ...grpc.CallOption) (*ateapipb.Worker, error) {
+	return nil, status.Error(codes.Unavailable, "control unavailable")
+}
+
+func TestSyncer_IPChangeDoesNotDeleteBeforeDrain(t *testing.T) {
+	ctx := context.Background()
+	api := newFakeControl()
+	s, pods, _ := setupReconcileTest(t, api, workerPool("ns", "pool", "gvisor", nil))
+	pod := workerPod("ns", "worker", "pool", testPodUID, "10.0.0.1")
+	key := seedPod(t, pods, pod)
+	mustReconcile(t, ctx, s, key)
+	pod = pod.DeepCopy()
+	pod.Status.PodIP = "10.0.0.2"
+	if err := pods.Update(pod); err != nil {
+		t.Fatal(err)
+	}
+	s.client = unavailableDrain{api}
+	if err := s.reconcile(ctx, key); status.Code(err) != codes.Unavailable {
+		t.Fatalf("drain error: %v", err)
+	}
+	if len(s.kube.(*fake.Clientset).Actions()) != 0 {
+		t.Fatal("pod mutated before drain succeeded")
+	}
+	if w := api.get(testPodUID); w == nil || w.GetStatus().GetState() != ateapipb.WorkerState_WORKER_STATE_ACTIVE {
+		t.Fatal("failed drain changed worker")
+	}
+}
