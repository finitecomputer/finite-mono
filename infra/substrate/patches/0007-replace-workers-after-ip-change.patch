+func TestSyncer_IPChangeReplacesPod(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	api := newFakeControl()
+	kube := setupSyncerTest(t, ctx, api, workerPool("ns", "pool", "gvisor", nil))
+	pod := workerPod("ns", "worker", "pool", testPodUID, "10.0.0.1")
+	if _, err := kube.CoreV1().Pods("ns").Create(ctx, pod, metav1.CreateOptions{}); err != nil {
+		t.Fatal(err)
+	}
+	waitForWorker(t, ctx, api, testPodUID, func(w *ateapipb.Worker) bool { return w != nil })
+	pod.Status.PodIP = "10.0.0.2"
+	if _, err := kube.CoreV1().Pods("ns").UpdateStatus(ctx, pod, metav1.UpdateOptions{}); err != nil {
+		t.Fatal(err)
+	}
+	waitForWorker(t, ctx, api, testPodUID, func(w *ateapipb.Worker) bool { return w == nil })
+	if _, err := kube.CoreV1().Pods("ns").Get(ctx, "worker", metav1.GetOptions{}); !apierrors.IsNotFound(err) {
+		t.Fatalf("stale pod still present: %v", err)
+	}
+	replacement := workerPod("ns", "worker", "pool", otherPodUID, "10.0.0.3")
+	if _, err := kube.CoreV1().Pods("ns").Create(ctx, replacement, metav1.CreateOptions{}); err != nil {
+		t.Fatal(err)
+	}
+	got := waitForWorker(t, ctx, api, otherPodUID, func(w *ateapipb.Worker) bool { return w != nil })
+	if got.GetIp() != "10.0.0.3" {
+		t.Fatalf("replacement IP: %s", got.GetIp())
+	}
+}
