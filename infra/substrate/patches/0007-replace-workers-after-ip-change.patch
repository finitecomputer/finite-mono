+// A successful delete request is not proof that the old writer has exited.
+// Keep its registry and actor assignment until the informer observes removal.
+func TestSyncer_IPChangeWaitsForPodDeletion(t *testing.T) {
+	for _, failDelete := range []bool{false, true} {
+		t.Run(map[bool]string{false: "terminating", true: "delete-rejected"}[failDelete], func(t *testing.T) {
+			ctx := context.Background()
+			api := newFakeControl()
+			s, pods, _ := setupReconcileTest(t, api, workerPool("ns", "pool", "gvisor", nil))
+			pod := workerPod("ns", "worker", "pool", testPodUID, "10.0.0.1")
+			pod.ResourceVersion = "7"
+			key := seedPod(t, pods, pod)
+			mustReconcile(t, ctx, s, key)
+			pod = pod.DeepCopy()
+			pod.Status.PodIP = "10.0.0.2"
+			if err := pods.Update(pod); err != nil {
+				t.Fatal(err)
+			}
+			rejected := errors.New("deletion rejected")
+			calls := 0
+			s.kube.(*fake.Clientset).PrependReactor("delete", "pods", func(action ktesting.Action) (bool, runtime.Object, error) {
+				calls++
+				w := api.get(testPodUID)
+				if w == nil || w.GetStatus().GetState() != ateapipb.WorkerState_WORKER_STATE_DRAINING {
+					t.Fatal("worker must be drained before pod deletion")
+				}
+				deletion := action.(ktesting.DeleteAction)
+				opts := deletion.GetDeleteOptions()
+				if deletion.GetName() != pod.Name || action.GetNamespace() != pod.Namespace || opts.Preconditions == nil || opts.Preconditions.UID == nil || string(*opts.Preconditions.UID) != testPodUID || opts.Preconditions.ResourceVersion == nil || *opts.Preconditions.ResourceVersion != "7" {
+					t.Fatalf("delete lacks observed pod identity: %+v", opts)
+				}
+				if opts.GracePeriodSeconds != nil {
+					t.Fatal("must retain graceful termination")
+				}
+				if failDelete {
+					return true, nil, rejected
+				}
+				return true, nil, nil
+			})
+			err := s.reconcile(ctx, key)
+			if failDelete && !errors.Is(err, rejected) {
+				t.Fatalf("delete error lost: %v", err)
+			}
+			if !failDelete && err != nil {
+				t.Fatal(err)
+			}
+			if calls != 1 {
+				t.Fatalf("delete calls: %d", calls)
+			}
+			if w := api.get(testPodUID); w == nil || w.GetIp() != "10.0.0.1" {
+				t.Fatal("live worker was released or retargeted")
+			}
+			if !failDelete {
+				if err := pods.Delete(pod); err != nil {
+					t.Fatal(err)
+				}
+				mustReconcile(t, ctx, s, key)
+				if api.get(testPodUID) != nil {
+					t.Fatal("deleted pod retained registry")
+				}
+			}
+		})
+	}
+}
