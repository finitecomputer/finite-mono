#!/usr/bin/env bash
set -euo pipefail

if (($# != 3)); then
  printf 'usage: %s OWNER/REPO RUNNER_NAME SYSTEMD_UNIT\n' "$0" >&2
  exit 64
fi

repo="$1"
runner_name="$2"
unit="$3"
if [[ ! "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] ||
   [[ ! "$runner_name" =~ ^[A-Za-z0-9_.-]+$ ]] ||
   [[ ! "$unit" =~ ^actions\.runner\.[A-Za-z0-9_.-]+\.service$ ]]; then
  printf 'invalid repository, runner name, or runner unit\n' >&2
  exit 64
fi
if [[ "$unit" != *."${runner_name}".service ]]; then
  printf 'runner name does not match systemd unit: %s\n' "$unit" >&2
  exit 64
fi

for command in gh python3 pgrep systemctl timeout sudo; do
  command -v "$command" >/dev/null 2>&1 || {
    printf 'required command is unavailable: %s\n' "$command" >&2
    exit 69
  }
done

runner_worker_active() {
  pgrep -x Runner.Worker >/dev/null 2>&1 ||
    pgrep -f '[/]bin/Runner.Worker' >/dev/null 2>&1
}

runner_state() {
  local response
  response="$(gh api "repos/${repo}/actions/runners?per_page=100")"
  printf '%s' "$response" | python3 -c '
import json, sys
payload = json.load(sys.stdin)
name = sys.argv[1]
matches = [r for r in payload.get("runners", []) if r.get("name") == name]
if len(matches) != 1:
    raise SystemExit(f"expected exactly one runner named {name!r}, found {len(matches)}")
runner = matches[0]
print("{}\t{}".format(runner.get("status"), str(runner.get("busy")).lower()))
' "$runner_name"
}

assigned_jobs() {
  local run_status runs_response parsed_run_ids run_id jobs_response
  local -a run_ids=()
  for run_status in queued in_progress requested waiting pending; do
    runs_response="$(gh api "repos/${repo}/actions/runs?status=${run_status}&per_page=100")"
    parsed_run_ids="$(printf '%s' "$runs_response" | python3 -c '
import json, sys
payload = json.load(sys.stdin)
runs = payload.get("workflow_runs", [])
if payload.get("total_count", len(runs)) > len(runs):
    raise SystemExit("more than 100 active workflow runs; refusing an incomplete lease check")
for run in runs:
    print(run["id"])
')"
    while IFS= read -r run_id; do
      [[ -n "$run_id" ]] && run_ids+=("$run_id")
    done <<<"$parsed_run_ids"
  done

  if ((${#run_ids[@]} == 0)); then
    return 0
  fi
  while IFS= read -r run_id; do
    jobs_response="$(gh api "repos/${repo}/actions/runs/${run_id}/jobs?per_page=100")"
    printf '%s' "$jobs_response" | python3 -c '
import json, sys
payload = json.load(sys.stdin)
jobs = payload.get("jobs", [])
if payload.get("total_count", len(jobs)) > len(jobs):
    raise SystemExit("more than 100 jobs in an active run; refusing an incomplete lease check")
name = sys.argv[1]
for job in jobs:
    if job.get("runner_name") == name and job.get("status") != "completed":
        print("{}\t{}\t{}".format(job.get("id"), job.get("status"), job.get("html_url")))
' "$runner_name"
  done < <(printf '%s\n' "${run_ids[@]}" | sort -u)
}

# GitHub's runner `busy` bit can itself be the stale lease being repaired, so
# it is diagnostic rather than the guard. The hard guards are no active job
# assigned to this exact runner plus no local Worker process.
guard_idle() {
  local state status busy assignments
  state="$(runner_state)"
  IFS=$'\t' read -r status busy <<<"$state"
  if [[ "$status" != "online" ]]; then
    printf 'refusing restart: GitHub reports %s status for %s\n' "$status" "$runner_name" >&2
    return 1
  fi
  if runner_worker_active; then
    printf 'refusing restart: a local Runner.Worker process is active\n' >&2
    return 1
  fi
  assignments="$(assigned_jobs)"
  if [[ -n "$assignments" ]]; then
    printf 'refusing restart: active job(s) are assigned to %s:\n%s\n' \
      "$runner_name" "$assignments" >&2
    return 1
  fi
  if [[ "$busy" == "true" ]]; then
    printf 'GitHub busy lease is stale: no assigned job and no local worker for %s\n' "$runner_name"
  elif [[ "$busy" != "false" ]]; then
    printf 'refusing restart: unrecognized GitHub busy state %s\n' "$busy" >&2
    return 1
  fi
}

guard_idle
systemctl is-active --quiet "$unit" || {
  printf 'refusing restart: %s is not active\n' "$unit" >&2
  exit 1
}
# Query twice to narrow the assignment race, immediately before the bounded
# service operation. Operators must also leave matching workflow queues empty.
guard_idle
if ! timeout --signal=TERM 30s sudo systemctl restart "$unit"; then
  printf 'bounded restart failed or exceeded 30 seconds: %s\n' "$unit" >&2
  exit 1
fi
if ! systemctl is-active --quiet "$unit"; then
  printf 'runner unit is not active after restart: %s\n' "$unit" >&2
  exit 1
fi
printf 'restarted idle runner listener: %s\n' "$unit"
