#!/usr/bin/env bash
set -euo pipefail

# Conservative host maintenance for finite-lat-2's self-hosted CI runners.
# The systemd unit fixes these defaults; environment overrides exist so the
# destructive policy can be exercised against synthetic directories in tests.
runner_root="${FINITE_LAT2_RUNNER_ROOT:-/srv/github-runner}"
disk_path="${FINITE_LAT2_DISK_PATH:-/}"
scratch_minutes="${FINITE_LAT2_SCRATCH_MINUTES:-1440}"
warn_percent="${FINITE_LAT2_DISK_WARN_PERCENT:-80}"
critical_percent="${FINITE_LAT2_DISK_CRITICAL_PERCENT:-90}"

case "$runner_root" in
  /*) ;;
  *) printf 'runner root must be an absolute path: %s\n' "$runner_root" >&2; exit 64 ;;
esac
if [[ "$runner_root" == "/" ]]; then
  printf 'refusing to use / as the runner root\n' >&2
  exit 64
fi
for value in "$scratch_minutes" "$warn_percent" "$critical_percent"; do
  if [[ ! "$value" =~ ^[0-9]+$ ]]; then
    printf 'maintenance policy values must be non-negative integers: %s\n' "$value" >&2
    exit 64
  fi
done
if ((warn_percent >= critical_percent || critical_percent > 100)); then
  printf 'invalid disk watermarks: warn=%s critical=%s\n' "$warn_percent" "$critical_percent" >&2
  exit 64
fi

log() {
  printf 'finite-lat2-runner-maintenance: %s\n' "$*"
}

runner_worker_active() {
  pgrep -x Runner.Worker >/dev/null 2>&1 ||
    pgrep -f '[/]bin/Runner.Worker' >/dev/null 2>&1
}

disk_percent() {
  local percent
  percent="$(df -P "$disk_path" | awk 'NR == 2 { value=$5; gsub(/%/, "", value); print value }')"
  if [[ ! "$percent" =~ ^[0-9]+$ ]] || ((percent > 100)); then
    printf 'could not parse disk utilization for %s: %s\n' "$disk_path" "$percent" >&2
    return 1
  fi
  printf '%s\n' "$percent"
}

critical_seen=0
check_watermark() {
  local phase="$1"
  local percent
  percent="$(disk_percent)"
  if ((percent >= critical_percent)); then
    log "CRITICAL ${phase}: ${disk_path} is ${percent}% full (critical ${critical_percent}%)" >&2
    critical_seen=1
  elif ((percent >= warn_percent)); then
    log "WARNING ${phase}: ${disk_path} is ${percent}% full (warning ${warn_percent}%)" >&2
  else
    log "${phase}: ${disk_path} is ${percent}% full"
  fi
}

check_watermark before-cleanup

# Runner.Worker is present only while a listener owns a job. When any job is
# active, keep every checkout and Docker cache: a future step in that job may
# still need an apparently unused file or image.
if runner_worker_active; then
  log "runner worker active; skipped all destructive cleanup"
  check_watermark after-skipped-cleanup
  if ((critical_seen)); then
    exit 2
  fi
  exit 0
fi

cleanup_failed=0
if [[ -d "$runner_root" ]]; then
  while IFS= read -r -d '' scratch; do
    # A directory qualifies only when nothing anywhere below it has changed
    # inside the retention window. This is stricter than checking the parent
    # directory mtime and protects recently written root-owned diagnostics.
    if find "$scratch" -xdev -mmin "-${scratch_minutes}" -print -quit | grep -q .; then
      log "kept recently modified scratch ${scratch}"
      continue
    fi
    if runner_worker_active; then
      log "runner worker appeared; stopped destructive cleanup"
      break
    fi
    log "removing aged scratch ${scratch}"
    if ! find "$scratch" -xdev -depth -delete; then
      log "ERROR could not remove ${scratch}" >&2
      cleanup_failed=1
    fi
  done < <(
    find "$runner_root" -xdev -type d \
      \( -name 'brain-matrix-*' -o -name 'nix-packages-*' \) \
      -path '*/_work/*' -prune -print0
  )
else
  log "runner root ${runner_root} does not exist; skipped scratch cleanup"
fi

if runner_worker_active; then
  log "runner worker appeared; skipped Docker cleanup"
elif ! command -v docker >/dev/null 2>&1; then
  log "ERROR docker is unavailable; container and cache cleanup did not run" >&2
  cleanup_failed=1
elif ! docker info >/dev/null 2>&1; then
  log "ERROR Docker daemon is unavailable; container and cache cleanup did not run" >&2
  cleanup_failed=1
else
  # Running containers are never eligible. Young stopped containers retain
  # their images; old unused images retain a seven-day pull/build cushion.
  if runner_worker_active; then
    log "runner worker appeared; skipped Docker cleanup"
  else
    docker container prune --force --filter 'until=24h' || cleanup_failed=1
  fi
  if runner_worker_active; then
    log "runner worker appeared; kept images and build cache"
  else
    docker image prune --all --force --filter 'until=168h' || cleanup_failed=1
    if runner_worker_active; then
      log "runner worker appeared; kept build cache"
    else
      docker builder prune --force --filter 'until=24h' --keep-storage '32GB' || cleanup_failed=1
    fi
  fi
  docker system df || cleanup_failed=1
fi

check_watermark after-cleanup
if ((critical_seen)); then
  exit 2
fi
if ((cleanup_failed)); then
  log "ERROR one or more cleanup operations failed" >&2
  exit 1
fi
log "maintenance completed"
