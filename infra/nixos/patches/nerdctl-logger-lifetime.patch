+// stdio is a container's output pipes. The test holds the write ends, so the
+// logger sees EOF only when the test closes them, as with a runtime that
+// keeps its writers open while the container runs.
+type stdio struct {
+	t                *testing.T
+	outR, outW       *os.File
+	errR, errW       *os.File
+	closeWritersOnce sync.Once
+}
+
+func newStdio(t *testing.T) *stdio {
+	t.Helper()
+	outR, outW, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	errR, errW, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := &stdio{t: t, outR: outR, outW: outW, errR: errR, errW: errW}
+	t.Cleanup(func() {
+		for _, f := range []*os.File{outR, outW, errR, errW} {
+			f.Close()
+		}
+	})
+	return s
+}
+
+func (s *stdio) write(line string) {
+	s.t.Helper()
+	if _, err := s.outW.WriteString(line); err != nil {
+		s.t.Fatal(err)
+	}
+}
+
+func (s *stdio) closeWriters() {
+	s.closeWritersOnce.Do(func() {
+		s.outW.Close()
+		s.errW.Close()
+	})
+}
