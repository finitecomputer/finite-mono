+// A containerd restart fails the logger's wait RPC while the container keeps
+// running. The logger must keep collecting through and after the outage until
+// the output ends.
+func TestLoggingProcessAdapterKeepsCollectingAfterContainerdLoss(t *testing.T) {
+	d := newFakeContainerd(t)
+	d.start(t)
+	c := startLoggedContainer(t, d, "")
+	c.emit("before\n")
+	waitEstablished(t, d)
+
+	d.stop()
+	c.requireCollecting("when containerd stopped")
+	c.emit("during outage\n")
+	d.start(t)
+	c.emit("after restart\n")
+	c.requireCollecting("after containerd restarted")
+
+	c.write("tail")
+	c.closeWriters()
+	c.requireStops("at EOF")
+	if got, want := c.collected(), "before\nduring outage\nafter restart\ntail"; got != want {
+		t.Fatalf("collected %q, want %q", got, want)
+	}
+	c.requireReleased()
+}
