+// collectAfterLogOwner runs a logger whose container log is owned by another
+// logger: one started for an earlier task of this container whose output is
+// still open, for example after containerd lost that task.
+//
+// The runtime finishes starting a task only once its logger is ready. Kata
+// waits for readiness without a deadline while it holds its task service lock,
+// and it takes a readiness pipe closed without a byte as ready. Waiting for the
+// owner before readiness would hold the start for as long as the owner's output
+// stays open; exiting before readiness would let the task run with nothing
+// collecting its output. This logger therefore signals readiness at once and
+// takes ownership when the owner finishes; the task's output waits in its pipe
+// until then. A SIGTERM before that stops the logger without reading, as
+// SIGTERM always stops reading at once.
+//
+// By then containerd may hold another task under the same container ID, so the
+// logger does not watch for the exit: it collects until EOF or SIGTERM.
+func collectAfterLogOwner(ctx context.Context, driver Driver, dataStore, address, loggerLock string, config *logging.Config, ready func() error) error {
+	log.G(ctx).Warn("another logger owns this container's log; collecting once it finishes")
+	if err := ready(); err != nil {
+		return err
+	}
+	lock, err := lockUnlessCancelled(ctx, loggerLock)
+	if err != nil {
+		if ctx.Err() != nil {
+			return nil
+		}
+		return err
+	}
+	return withLockFile(lock, func() error {
+		return loggingProcessAdapter(ctx, driver, dataStore, address, nil, config)
+	})
+}
+
+// lockUnlessCancelled waits for the lock at path, or for ctx to be done.
+func lockUnlessCancelled(ctx context.Context, path string) (*os.File, error) {
+	type result struct {
+		file *os.File
+		err  error
+	}
+	locked := make(chan result, 1)
+	go func() {
+		file, err := filesystem.Lock(path)
+		locked <- result{file, err}
+	}()
+	select {
+	case r := <-locked:
+		return r.file, r.err
+	case <-ctx.Done():
+		// flock cannot be interrupted. Release the lock if it is granted after
+		// all; a stopping logger usually exits first, which releases it too.
+		go func() {
+			if r := <-locked; r.err == nil {
+				filesystem.Unlock(r.file)
+			}
+		}()
+		return nil, ctx.Err()
+	}
+}
+
+// withLockFile runs fn and then releases the lock held through file.
+func withLockFile(file *os.File, fn func() error) (err error) {
+	defer func() {
+		err = errors.Join(filesystem.Unlock(file), err)
+	}()
+	return fn()
+}
