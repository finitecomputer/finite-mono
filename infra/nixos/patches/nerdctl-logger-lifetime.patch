+// loggedContainer runs the logging adapter for fakeContainerID with a mock
+// driver that records the collected stdout.
+type loggedContainer struct {
+	*stdio
+	t      *testing.T
+	d      *fakeContainerd
+	driver *SyncMockDriver
+	cancel context.CancelFunc
+	done   chan error
+}
+
+func startLoggedContainer(t *testing.T, d *fakeContainerd, backlog string) *loggedContainer {
+	t.Helper()
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	c := &loggedContainer{stdio: newStdio(t), t: t, d: d, driver: &SyncMockDriver{}, cancel: cancel, done: make(chan error, 1)}
+	if backlog != "" {
+		c.write(backlog)
+	}
+	config := &logging.Config{ID: fakeContainerID, Namespace: fakeNamespace, Stdout: c.outR, Stderr: c.errR}
+	go func() {
+		c.done <- loggingProcessAdapter(ctx, c.driver, "", "unix://"+d.socket, getContainerWait, config)
+	}()
+	return c
+}
+
+func (c *loggedContainer) collected() string {
+	c.driver.mu.Lock()
+	defer c.driver.mu.Unlock()
+	return strings.Join(c.driver.receivedStdout, "")
+}
+
+// emit writes line and waits until the logger has collected it.
+func (c *loggedContainer) emit(line string) {
+	c.t.Helper()
+	c.write(line)
+	waitFor(c.t, "the logger to collect "+strings.TrimSpace(line), func() bool { return strings.HasSuffix(c.collected(), line) })
+}
+
+func (c *loggedContainer) requireCollecting(why string) {
+	c.t.Helper()
+	requireRunning(c.t, c.done, why)
+}
+
+func (c *loggedContainer) requireStops(why string) {
+	c.t.Helper()
+	requireDone(c.t, c.done, why)
+}
+
+// requireReleased checks that no Wait RPC or client connection outlives the
+// adapter.
+func (c *loggedContainer) requireReleased() {
+	c.t.Helper()
+	waitFor(c.t, "wait RPCs and client connections to be released", func() bool {
+		waits, conns := c.d.counts()
+		return waits == 0 && conns == 0
+	})
+}
+
+// requireRunning fails if done delivers within a short grace period. It is
+// the negative half of a lifetime check; the positive half always follows.
+func requireRunning(t *testing.T, done chan error, why string) {
+	t.Helper()
+	select {
+	case err := <-done:
+		done <- err
+		t.Fatalf("logger stopped %s (returned %v)", why, err)
+	case <-time.After(400 * time.Millisecond):
+	}
+}
+
+func requireDone(t *testing.T, done chan error, why string) {
+	t.Helper()
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatalf("logger returned %v", err)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatalf("logger did not stop %s", why)
+	}
+}
+
+func waitFor(t *testing.T, what string, ok func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(10 * time.Second)
+	for !ok() {
+		if time.Now().After(deadline) {
+			t.Fatalf("timed out waiting for %s", what)
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+}
+
+func waitEstablished(t *testing.T, d *fakeContainerd) {
+	t.Helper()
+	waitFor(t, "an established wait", func() bool { waits, _ := d.counts(); return waits == 1 })
+}
+
+// The task's reported exit still ends collection while the wait is intact.
+func TestLoggingProcessAdapterStopsOnTaskExit(t *testing.T) {
+	d := newFakeContainerd(t)
+	d.start(t)
+	c := startLoggedContainer(t, d, "")
+	c.emit("running\n")
+	waitEstablished(t, d)
+	d.exit(0)
+	c.requireStops("on the task's exit")
+	if got, want := c.collected(), "running\n"; got != want {
+		t.Fatalf("collected %q, want %q", got, want)
+	}
+}
