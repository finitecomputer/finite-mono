+// logStore is a nerdctl data store holding one container's json-file log
+// configuration, pointed at the synthetic containerd.
+type logStore struct {
+	t   *testing.T
+	dir string
+}
+
+func newLogStore(t *testing.T, d *fakeContainerd) *logStore {
+	t.Helper()
+	s := &logStore{t: t, dir: t.TempDir()}
+	cfg, err := json.Marshal(LogConfig{Driver: "json-file", Address: "unix://" + d.socket})
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := LogConfigFilePath(s.dir, fakeNamespace, fakeContainerID)
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, cfg, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return s
+}
+
+// logged returns the stdout entries of the container's json-file log.
+func (s *logStore) logged() string {
+	s.t.Helper()
+	f, err := os.Open(jsonfile.Path(s.dir, fakeNamespace, fakeContainerID))
+	if errors.Is(err, os.ErrNotExist) {
+		return ""
+	}
+	if err != nil {
+		s.t.Fatal(err)
+	}
+	defer f.Close()
+	var out strings.Builder
+	scanner := bufio.NewScanner(f)
+	for scanner.Scan() {
+		var entry struct {
+			Log    string `json:"log"`
+			Stream string `json:"stream"`
+		}
+		if err := json.Unmarshal(scanner.Bytes(), &entry); err != nil {
+			s.t.Fatalf("log entry %q: %v", scanner.Text(), err)
+		}
+		if entry.Stream == "stdout" {
+			out.WriteString(entry.Log)
+		}
+	}
+	if err := scanner.Err(); err != nil {
+		s.t.Fatal(err)
+	}
+	return out.String()
+}
+
+func (s *logStore) waitLogged(want string) {
+	s.t.Helper()
+	waitFor(s.t, fmt.Sprintf("the log to read %q", want), func() bool { return s.logged() == want })
+}
+
+// lockFree reports whether no logger holds the container's logger-lock.
+func (s *logStore) lockFree() bool {
+	s.t.Helper()
+	f, err := os.Open(getLockPath(s.dir, fakeNamespace, fakeContainerID))
+	if err != nil {
+		s.t.Fatal(err)
+	}
+	defer f.Close()
+	err = syscall.Flock(int(f.Fd()), syscall.LOCK_EX|syscall.LOCK_NB)
+	if errors.Is(err, syscall.EWOULDBLOCK) {
+		return false
+	}
+	if err != nil {
+		s.t.Fatal(err)
+	}
+	return true
+}
+
+// runningLogger is the logger entrypoint's LoggerFunc running in this process,
+// as logging.Run runs it: ready signals the runtime and ctx is cancelled on
+// SIGTERM.
+type runningLogger struct {
+	*stdio
+	cancel context.CancelFunc
+	ready  chan struct{}
+	done   chan error
+}
+
+func startLogger(t *testing.T, s *logStore, backlog string) *runningLogger {
+	t.Helper()
+	fn, err := loggerFunc(s.dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	l := &runningLogger{stdio: newStdio(t), cancel: cancel, ready: make(chan struct{}), done: make(chan error, 1)}
+	if backlog != "" {
+		l.write(backlog)
+	}
+	config := &logging.Config{ID: fakeContainerID, Namespace: fakeNamespace, Stdout: l.outR, Stderr: l.errR}
+	var once sync.Once
+	go func() {
+		l.done <- fn(ctx, config, func() error { once.Do(func() { close(l.ready) }); return nil })
+	}()
+	return l
+}
+
+func (l *runningLogger) requireReady(t *testing.T, why string) {
+	t.Helper()
+	select {
+	case <-l.ready:
+	case err := <-l.done:
+		t.Fatalf("logger returned %v before it was ready %s", err, why)
+	case <-time.After(10 * time.Second):
+		t.Fatalf("logger was not ready %s", why)
+	}
+}
+
+// startOrphanedLogOwner starts a logger, establishes its wait and then loses
+// the task in a containerd restart while the task's output stays open: the
+// logger keeps collecting and keeps the container's log.
+func startOrphanedLogOwner(t *testing.T, d *fakeContainerd, s *logStore) *runningLogger {
+	t.Helper()
+	first := startLogger(t, s, "")
+	first.requireReady(t, "with the log free")
+	first.write("first task\n")
+	s.waitLogged("first task\n")
+	waitEstablished(t, d)
+	d.restartWithoutTask(t)
+	requireRunning(t, first.done, "when containerd lost its task")
+	return first
+}
+
+// A logger started for a new task while an earlier task's logger still owns
+// the log must not hold the runtime's start: it signals readiness, leaves the
+// owner collecting, and collects its own task's output once the owner
+// finishes.
+func TestLoggerReadyWhileAnotherLoggerOwnsTheLog(t *testing.T) {
+	d := newFakeContainerd(t)
+	d.start(t)
+	s := newLogStore(t, d)
+	first := startOrphanedLogOwner(t, d, s)
+
+	second := startLogger(t, s, "second task\n")
+	second.requireReady(t, "while another logger owns the log")
+	first.write("first task still writing\n")
+	s.waitLogged("first task\nfirst task still writing\n")
+	requireRunning(t, second.done, "while another logger owns the log")
+
+	first.closeWriters()
+	requireDone(t, first.done, "at its task's EOF")
+	s.waitLogged("first task\nfirst task still writing\nsecond task\n")
+	second.write("second task again\n")
+	s.waitLogged("first task\nfirst task still writing\nsecond task\nsecond task again\n")
+
+	second.closeWriters()
+	requireDone(t, second.done, "at its task's EOF")
+	if !s.lockFree() {
+		t.Fatal("logger-lock still held after both loggers finished")
+	}
+}
+
+// SIGTERM ends a logger that is waiting for the log owner; the owner keeps
+// collecting and the waiting logger never takes the lock.
+func TestLoggerWaitingForTheLogOwnerStopsOnSIGTERM(t *testing.T) {
+	d := newFakeContainerd(t)
+	d.start(t)
+	s := newLogStore(t, d)
+	first := startOrphanedLogOwner(t, d, s)
+
+	second := startLogger(t, s, "second task\n")
+	second.requireReady(t, "while another logger owns the log")
+	second.cancel()
+	requireDone(t, second.done, "on SIGTERM while waiting for the log owner")
+
+	first.write("first task after the other logger stopped\n")
+	s.waitLogged("first task\nfirst task after the other logger stopped\n")
+	first.closeWriters()
+	requireDone(t, first.done, "at its task's EOF")
+	waitFor(t, "the logger-lock to be released", s.lockFree)
+	if got, want := s.logged(), "first task\nfirst task after the other logger stopped\n"; got != want {
+		t.Fatalf("log reads %q, want %q", got, want)
+	}
+}
+
+// A logger that waited for the log owner cannot tell its task from a later
+// one with the same container ID, so a reported exit must not end it.
+func TestLoggerAfterTheLogOwnerIgnoresTaskExit(t *testing.T) {
+	d := newFakeContainerd(t)
+	d.start(t)
+	s := newLogStore(t, d)
+	first := startOrphanedLogOwner(t, d, s)
+	second := startLogger(t, s, "second task\n")
+	second.requireReady(t, "while another logger owns the log")
+	first.closeWriters()
+	requireDone(t, first.done, "at its task's EOF")
+	s.waitLogged("first task\nsecond task\n")
+
+	d.startTaskAndExit(0)
+	requireRunning(t, second.done, "on a reported exit after waiting for the log owner")
+	second.write("second task still writing\n")
+	s.waitLogged("first task\nsecond task\nsecond task still writing\n")
+	second.closeWriters()
+	requireDone(t, second.done, "at its task's EOF")
+}
+
+// entrypointLogger is this test binary running as the logger, started the way
+// Kata 3.29 newBinaryIO starts it (containerd-shim-v2/shim_io_binary.go): fd 3
+// and 4 are the read ends of the output pipes, fd 5 is the readiness pipe.
+type entrypointLogger struct {
+	*stdio
+	cmd    *exec.Cmd
+	exited chan error
+	// readied reports whether the logger wrote a readiness byte. Kata 3.29
+	// also takes a readiness pipe closed without a byte (EOF) as ready.
+	readied chan bool
+}
+
+func startEntrypointLogger(t *testing.T, s *logStore) *entrypointLogger {
+	t.Helper()
+	l := &entrypointLogger{stdio: newStdio(t), exited: make(chan error, 1), readied: make(chan bool, 1)}
+	readyR, readyW, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer readyR.Close()
+	l.cmd = exec.Command(os.Args[0], "-test.run=^$")
+	l.cmd.Env = append(os.Environ(),
+		entrypointDataStoreEnv+"="+s.dir,
+		"CONTAINER_ID="+fakeContainerID,
+		"CONTAINER_NAMESPACE="+fakeNamespace,
+	)
+	l.cmd.ExtraFiles = []*os.File{l.outR, l.errR, readyW}
+	l.cmd.Stderr = os.Stderr
+	if err := l.cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	readyW.Close()
+	t.Cleanup(func() {
+		l.cmd.Process.Kill()
+		<-l.exited
+	})
+	go func() { l.exited <- l.cmd.Wait() }()
+	readResult := make(chan bool, 1)
+	go func() {
+		b := make([]byte, 1)
+		n, err := readyR.Read(b)
+		readResult <- n == 1 && (err == nil || errors.Is(err, io.EOF))
+	}()
+	select {
+	case byteRead := <-readResult:
+		l.readied <- byteRead
+	case <-time.After(10 * time.Second):
+		t.Fatal("the runtime's readiness read is still blocked")
+	}
+	return l
+}
+
+func (l *entrypointLogger) requireReadyByte(t *testing.T, why string) {
+	t.Helper()
+	if !<-l.readied {
+		t.Fatalf("logger closed its readiness pipe without a byte %s", why)
+	}
+}
+
+func (l *entrypointLogger) sigterm(t *testing.T) {
+	t.Helper()
+	if err := l.cmd.Process.Signal(syscall.SIGTERM); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func (l *entrypointLogger) requireExit0(t *testing.T, why string) {
+	t.Helper()
+	select {
+	case err := <-l.exited:
+		l.exited <- err
+		if err != nil {
+			t.Fatalf("logger exited with %v %s", err, why)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatalf("logger did not exit %s", why)
+	}
+}
+
+func (l *entrypointLogger) requireAlive(t *testing.T, why string) {
+	t.Helper()
+	select {
+	case err := <-l.exited:
+		l.exited <- err
+		t.Fatalf("logger exited (%v) %s", err, why)
+	case <-time.After(400 * time.Millisecond):
+	}
+}
+
+// The real entrypoint: a second task's logger answers the runtime's readiness
+// read with a byte while an orphaned task's logger owns the log, SIGTERM ends
+// it, and the owner keeps collecting throughout.
+func TestLoggerEntrypointReadyWhileAnotherLoggerOwnsTheLog(t *testing.T) {
+	d := newFakeContainerd(t)
+	d.start(t)
+	s := newLogStore(t, d)
+	first := startEntrypointLogger(t, s)
+	first.requireReadyByte(t, "with the log free")
+	first.write("first task\n")
+	s.waitLogged("first task\n")
+	waitEstablished(t, d)
+	d.restartWithoutTask(t)
+	first.requireAlive(t, "when containerd lost its task")
+
+	second := startEntrypointLogger(t, s)
+	second.requireReadyByte(t, "while another logger owns the log")
+	first.write("first task still writing\n")
+	s.waitLogged("first task\nfirst task still writing\n")
+	second.requireAlive(t, "while waiting for the log owner")
+
+	second.sigterm(t)
+	second.requireExit0(t, "on SIGTERM while waiting for the log owner")
+	first.write("first task after the other logger stopped\n")
+	s.waitLogged("first task\nfirst task still writing\nfirst task after the other logger stopped\n")
+
+	first.closeWriters()
+	first.requireExit0(t, "at its task's EOF")
+	waitFor(t, "the logger-lock to be released", s.lockFree)
+}
+
+// The real entrypoint stops promptly on SIGTERM while output is still being
+// written after a lost wait. What it logged is an unbroken prefix of the
+// output; SIGTERM stops reading at once, so the rest is not collected.
+func TestLoggerEntrypointStopsOnSIGTERMDuringActiveOutput(t *testing.T) {
+	d := newFakeContainerd(t)
+	d.start(t)
+	s := newLogStore(t, d)
+	l := startEntrypointLogger(t, s)
+	l.requireReadyByte(t, "with the log free")
+	l.write("line 0\n")
+	s.waitLogged("line 0\n")
+	waitEstablished(t, d)
+	d.restartWithoutTask(t)
+	l.requireAlive(t, "when containerd lost its task")
+
+	var written atomic.Int64
+	written.Store(1)
+	writerDone := make(chan struct{})
+	go func() {
+		defer close(writerDone)
+		for i := 1; ; i++ {
+			if _, err := fmt.Fprintf(l.outW, "line %d\n", i); err != nil {
+				return
+			}
+			written.Store(int64(i + 1))
+		}
+	}()
+	waitFor(t, "active output", func() bool { return written.Load() > 1000 })
+	l.sigterm(t)
+	l.requireExit0(t, "on SIGTERM during active output")
+	l.closeWriters()
+	<-writerDone
+
+	lines := strings.SplitAfter(s.logged(), "\n")
+	// The output may end in a fragment of the next line: the logger writes
+	// what it has read when it stops.
+	fragment := lines[len(lines)-1]
+	lines = lines[:len(lines)-1]
+	if !strings.HasPrefix(fmt.Sprintf("line %d\n", len(lines)), fragment) {
+		t.Fatalf("log ends with %q after %d lines", fragment, len(lines))
+	}
+	for i, line := range lines {
+		if want := fmt.Sprintf("line %d\n", i); line != want {
+			t.Fatalf("log line %d is %q, want %q", i, line, want)
+		}
+	}
+	t.Logf("logged %d of at least %d written lines before SIGTERM", len(lines), written.Load())
+}
