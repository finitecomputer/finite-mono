+// After a lost wait, containerd may report a task under the same container ID
+// that is not the one this logger collects for, and that task may exit while
+// this container's output is still open. That exit must not end collection.
+func TestLoggingProcessAdapterIgnoresExitsAfterLostWait(t *testing.T) {
+	d := newFakeContainerd(t)
+	d.start(t)
+	c := startLoggedContainer(t, d, "")
+	c.emit("before\n")
+	waitEstablished(t, d)
+
+	d.restartWithoutTask(t)
+	c.emit("while the task is missing\n")
+	d.startTaskAndExit(0)
+	c.requireCollecting("on another task's exit under the same container ID")
+	c.emit("still writing\n")
+
+	c.closeWriters()
+	c.requireStops("at EOF")
+	if got, want := c.collected(), "before\nwhile the task is missing\nstill writing\n"; got != want {
+		t.Fatalf("collected %q, want %q", got, want)
+	}
+	c.requireReleased()
