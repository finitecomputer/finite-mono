+func platformSpecificTryLock(file *os.File, lockType lockType) error {
+	err := windows.LockFileEx(
+		windows.Handle(file.Fd()),
+		uint32(lockType)|windows.LOCKFILE_FAIL_IMMEDIATELY,
+		reserved,
+		allBytes,
+		allBytes,
