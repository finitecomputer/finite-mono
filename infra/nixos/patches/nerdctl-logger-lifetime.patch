+package logging
+
+// These tests cover how long a logger collects and who owns a container's log.
+// They use the real getContainerWait and containerd client against a synthetic
+// containerd that serves the three RPCs the logger uses (Containers.Get,
+// Tasks.Get, Tasks.Wait) and can be stopped and restarted like the daemon. The
+// ownership tests use the real logger-lock and json-file driver, and the
+// entrypoint tests run this test binary as the logger with the runtime's
+// argv, fds 3/4/5 and signals.
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+
+	containersapi "github.com/containerd/containerd/api/services/containers/v1"
+	tasksapi "github.com/containerd/containerd/api/services/tasks/v1"
+	tasktypes "github.com/containerd/containerd/api/types/task"
+	"github.com/containerd/containerd/v2/core/runtime/v2/logging"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/types/known/timestamppb"
+
+	"github.com/containerd/nerdctl/v2/pkg/logging/jsonfile"
+)
+
+const (
+	fakeContainerID = "logged"
+	fakeNamespace   = "finite"
+
+	// entrypointDataStoreEnv makes this test binary run as the logger.
+	entrypointDataStoreEnv = "NERDCTL_LOGGING_TEST_ENTRYPOINT_DATASTORE"
+)
+
+func TestMain(m *testing.M) {
+	if dataStore := os.Getenv(entrypointDataStoreEnv); dataStore != "" {
+		// Main runs logging.Run, which exits the process.
+		if err := Main(dataStore); err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(1)
+		}
+		os.Exit(0)
+	}
+	os.Exit(m.Run())
+}
+
+// fakeContainerd is a restartable containerd stand-in. Stop drops every
+// connection, so an in-flight Wait fails on the client exactly as it does
+// when containerd stops.
+type fakeContainerd struct {
+	socket string
+
+	mu          sync.Mutex
+	srv         *grpc.Server
+	taskGone    bool
+	exited      chan struct{}
+	exitCode    uint32
+	activeWaits int
+	openConns   int
+}
+
+func newFakeContainerd(t *testing.T) *fakeContainerd {
+	t.Helper()
+	// Keep the socket path short: t.TempDir() can exceed sun_path on macOS.
+	dir, err := os.MkdirTemp("", "ctrd")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.RemoveAll(dir) })
+	d := &fakeContainerd{socket: filepath.Join(dir, "c.sock"), exited: make(chan struct{})}
+	t.Cleanup(d.stop)
+	return d
+}
+
+func (d *fakeContainerd) start(t *testing.T) {
+	t.Helper()
+	_ = os.Remove(d.socket)
+	l, err := net.Listen("unix", d.socket)
+	if err != nil {
+		t.Fatal(err)
+	}
+	srv := grpc.NewServer()
+	containersapi.RegisterContainersServer(srv, &fakeContainers{d: d})
+	tasksapi.RegisterTasksServer(srv, &fakeTasks{d: d})
+	d.mu.Lock()
+	d.srv = srv
+	d.mu.Unlock()
+	go srv.Serve(&countingListener{Listener: l, d: d})
+}
+
+func (d *fakeContainerd) stop() {
+	d.mu.Lock()
+	srv := d.srv
+	d.srv = nil
+	d.mu.Unlock()
+	if srv != nil {
+		srv.Stop()
+	}
+}
+
+// restartWithoutTask restarts containerd without the task, as when it could
+// not reload the task's shim while the task's output stays open.
+func (d *fakeContainerd) restartWithoutTask(t *testing.T) {
+	t.Helper()
+	d.stop()
+	d.mu.Lock()
+	d.taskGone = true
+	d.mu.Unlock()
+	d.start(t)
+}
+
+// startTaskAndExit puts a task under the container ID again and reports its
+// exit to every Wait on the ID: another task that took the container ID.
+func (d *fakeContainerd) startTaskAndExit(code uint32) {
+	d.mu.Lock()
+	d.taskGone = false
+	d.mu.Unlock()
+	d.exit(code)
+}
+
+// exit reports the task's exit to every current and future Wait.
+func (d *fakeContainerd) exit(code uint32) {
+	d.mu.Lock()
+	d.exitCode = code
+	d.mu.Unlock()
+	close(d.exited)
+}
+
+func (d *fakeContainerd) counts() (waits, conns int) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	return d.activeWaits, d.openConns
+}
+
+type countingListener struct {
+	net.Listener
+	d *fakeContainerd
+}
+
+func (l *countingListener) Accept() (net.Conn, error) {
+	c, err := l.Listener.Accept()
+	if err != nil {
+		return nil, err
+	}
+	l.d.mu.Lock()
+	l.d.openConns++
+	l.d.mu.Unlock()
+	return &countingConn{Conn: c, d: l.d}, nil
+}
+
+type countingConn struct {
+	net.Conn
+	d    *fakeContainerd
+	once sync.Once
+}
+
+func (c *countingConn) Close() error {
+	c.once.Do(func() { c.d.mu.Lock(); c.d.openConns--; c.d.mu.Unlock() })
+	return c.Conn.Close()
+}
+
+type fakeContainers struct {
+	containersapi.UnimplementedContainersServer
+	d *fakeContainerd
+}
+
+func (c *fakeContainers) Get(ctx context.Context, r *containersapi.GetContainerRequest) (*containersapi.GetContainerResponse, error) {
+	if r.ID != fakeContainerID {
+		return nil, status.Errorf(codes.NotFound, "container %q: not found", r.ID)
+	}
+	return &containersapi.GetContainerResponse{Container: &containersapi.Container{
+		ID:        r.ID,
+		Runtime:   &containersapi.Container_Runtime{Name: "io.containerd.kata.v2"},
+		CreatedAt: timestamppb.New(time.Unix(0, 0)),
+		UpdatedAt: timestamppb.New(time.Unix(0, 0)),
+	}}, nil
+}
+
+type fakeTasks struct {
+	tasksapi.UnimplementedTasksServer
+	d *fakeContainerd
+}
+
+func (t *fakeTasks) Get(ctx context.Context, r *tasksapi.GetRequest) (*tasksapi.GetResponse, error) {
+	t.d.mu.Lock()
+	gone := t.d.taskGone
+	t.d.mu.Unlock()
+	if r.ContainerID != fakeContainerID || gone {
+		return nil, status.Errorf(codes.NotFound, "no running task found: task %s not found", r.ContainerID)
+	}
+	return &tasksapi.GetResponse{Process: &tasktypes.Process{
+		ContainerID: r.ContainerID,
+		ID:          r.ContainerID,
+		Pid:         4242,
+		Status:      tasktypes.Status_RUNNING,
+	}}, nil
+}
+
+func (t *fakeTasks) Wait(ctx context.Context, r *tasksapi.WaitRequest) (*tasksapi.WaitResponse, error) {
+	t.d.mu.Lock()
+	t.d.activeWaits++
+	exited := t.d.exited
+	t.d.mu.Unlock()
+	defer func() { t.d.mu.Lock(); t.d.activeWaits--; t.d.mu.Unlock() }()
+	select {
+	case <-exited:
+		t.d.mu.Lock()
+		code := t.d.exitCode
+		t.d.mu.Unlock()
+		return &tasksapi.WaitResponse{ExitStatus: code, ExitedAt: timestamppb.Now()}, nil
+	case <-ctx.Done():
+		return nil, status.FromContextError(ctx.Err()).Err()
+	}
+}
