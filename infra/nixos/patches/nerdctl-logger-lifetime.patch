+func platformSpecificTryLock(file *os.File, lockType lockType) error {
+	err := syscall.Flock(int(file.Fd()), int(lockType)|syscall.LOCK_NB)
+	if errors.Is(err, syscall.EWOULDBLOCK) {
+		return ErrLockHeld
+	}
+	return err
