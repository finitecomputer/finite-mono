+// The task's exit, EOF and SIGTERM end collection whether the wait is in
+// flight or lost, and none leaves a wait RPC or client connection behind.
+func TestLoggingProcessAdapterReleasesWatch(t *testing.T) {
+	t.Run("task exit", func(t *testing.T) {
