+// watchContainerExit calls cancelReaders once containerd reports that the
+// container's task has exited.
+//
+// Only a wait response without an error is evidence of an exit. The containerd
+// client also delivers a status when the wait RPC fails, for example because
+// containerd stopped or restarted; cancelling the readers on that status ended
+// collection while the container kept running and writing.
+//
+// The watch is not re-established after such a failure. containerd looks up
+// and waits on a task by container ID alone, so a later wait could follow
+// another task that has taken the ID while this container's output is still
+// open, and that task's exit would end this collection. The readers instead
+// collect until the output ends (EOF) or the logger is stopped (SIGTERM), as
+// they do when the first lookup fails. Kata closes the output pipes and stops
+// the logger before it reports the task's exit.
+func watchContainerExit(ctx context.Context, address string, config *logging.Config, getContainerWait ContainerWaitFunc, outputSeen func() bool, cancelReaders func()) {
+	exitCh, err := getContainerWait(ctx, address, config, outputSeen)
+	if err != nil {
+		if ctx.Err() == nil {
+			// We could not determine when the container exits. Do not cancel the
+			// readers: they will finish on their own when the FIFO reaches EOF.
+			// Cancelling here could truncate a still-running container.
+			log.G(ctx).Errorf("failed to get container task wait channel: %v", err)
+		}
+		return
+	}
+	select {
+	case <-ctx.Done():
+	case status, ok := <-exitCh:
+		if ok && status.Error() == nil {
+			cancelReaders()
+			return
+		}
+		if ctx.Err() != nil {
+			return
+		}
+		err := errors.New("wait channel closed")
+		if ok {
+			err = status.Error()
+		}
+		log.G(ctx).WithError(err).Warn("lost the container task wait; collecting until the container's output ends or the logger is stopped")
+	}
+}
 
