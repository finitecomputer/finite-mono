# Host-only template for /etc/finite/runner.env (root:root 0600).
# Secret values are transferred directly from their owning host and never
# enter this repository.
#
# The shared non-secret keys below are Nix-rendered to
# /etc/finite/runner-shared.env by infra/nixos/modules/kata-runner-host.nix,
# which systemd loads BEFORE this file. Keep only credentials, drain state,
# and bounded incident overrides here; runner-role changes go in the shared
# module. The full key list is retained below as the env-shape reference.
FC_CORE_URL=http://10.254.3.1:14200
FC_CORE_RUNNER_API_TOKEN=replace-with-finite-lat-4-runner-token
FC_RUNNER_ID=finite-kata-runner-4
FC_RUNNER_SOURCE_HOST_ID=finite-lat-4

# The production Identity Authority URL is supplied declaratively. Install the
# shared replaceable operator token separately at
# /etc/finite/identity-operator.env as root:root 0600.

FC_RUNNER_CLASS=kata
# Operator-managed promotion pin; this file is its only source. Set it per
# infra/runbooks/runtime-image.md on every Kata host. The shared Nix-rendered
# env carries no default and the runner refuses to start without it.
FC_RUNNER_RUNTIME_ARTIFACT_ID=replace-with-current-promoted-artifact-id
FC_RUNNER_WORK_ROOT=/data/finite-saas-runner
FC_RUNNER_RUNTIME_ENV_JSON={"FINITE_SITES_API":"https://api.finite.chat","FINITE_BRAIN_SERVER_URL":"https://brain.finite.computer","FINITE_BRAIN_PUBLIC_BASE_URL":"https://brain.finite.computer"}
FC_RUNNER_RUNTIME_SECRET_ENV_FILE=/etc/finite/runtime-secrets.env

FC_RUNNER_KATA_NAMESPACE=finite
FC_RUNNER_KATA_OCI_RUNTIME=io.containerd.kata.v2
FC_RUNNER_KATA_NAME_PREFIX=finite-kata
FC_RUNNER_KATA_HOST_ADDRESS=10.254.3.4
FC_RUNNER_KATA_CONTAINER_PORT=8080
FC_RUNNER_KATA_CPUS=4
FC_RUNNER_KATA_MEMORY=8G
FC_RUNNER_KATA_PULL_POLICY=missing
# Shared default owned by kata-runner-host.nix (raised from the stock 30s
# after false upgrade failures); do not hand-edit on the host.
# Graceful-stop grace for `nerdctl stop --time`. Loaded 8GB Kata guests take
# 60-90s to shut down; a grace below that escalates to a force-kill of the
# shim mid-shutdown (ttrpc: closed) and falsely fails the control request
# even though the stop completes. Keep at 180 unless measured fleet stops
# exceed it.
FC_RUNNER_KATA_STOP_TIMEOUT_SECS=180

FC_RUNNER_FINITE_PRIVATE_BASE_URL=https://finite-private.finite.containers.tinfoil.dev/v1
FC_RUNNER_FINITE_PRIVATE_MODEL=glm-5-3-flash
FC_RUNNER_FINITE_PRIVATE_SPECIALIZATION_WORKER_API_KEY=replace-if-currently-configured

# finite-lat-4 is admitted DRAINED and stays drained until its separate
# admission decision (ADR 0007's one-creator rule). The 42 ceiling mirrors
# lat3's owner-authorized value: same chassis class, same 4-vCPU/8-GiB
# Standard shape, same deliberate memory overcommit; swap is not counted as
# capacity. FC_RUNNER_DRAIN is availability state, not configuration.
FC_RUNNER_DRAIN=true
FC_RUNNER_MAX_SANDBOXES=42
FC_RUNNER_RUNTIME_READY_TIMEOUT_SECS=300
FC_RUNNER_RUNTIME_READY_INTERVAL_MS=2000
FC_RUNNER_LAUNCH_TIMEOUT_SECS=900
FC_RUNNER_COMMAND_TIMEOUT_SECS=30
