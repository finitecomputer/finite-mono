        "POSTGRES_USER",
        "POSTGRES_PASSWORD",
        "POSTGRES_DB",
        "MAX_CPU",
        "MAX_RAM"
      ],
      "custody": "off-host escrow or coordinated regeneration"
    },
    {
      "path": "/etc/finite/wireguard-private-key",
      "mode": "0600",
      "owner": "root",
      "group": "root",
      "kind": "opaque",
      "required_names": [],
      "custody": "off-host escrow or coordinated peer rotation"
    },
    {
      "path": "/etc/finite-saas/certs/finite-chat-origin.pem",
      "mode": "0644",
      "owner": "root",
      "group": "root",
      "kind": "opaque",
      "required_names": [],
      "custody": "off-host provider custody or reissue"
    },
    {
      "path": "/etc/finite-saas/certs/finite-chat-origin.key",
      "mode": "0640",
      "owner": "root",
      "group": "caddy",
      "kind": "opaque",
      "required_names": [],
      "custody": "off-host escrow or reissue"
    },
    {
      "path": "/var/lib/finitecomputer/backups/rsync-net/id_ed25519",
      "mode": "0600",
      "owner": "root",
      "group": "root",
      "kind": "opaque",
      "required_names": [],
      "custody": "existing finitecomputer off-host recovery bundle"
    },
    {
      "path": "/var/lib/finitecomputer/backups/rsync-net/known_hosts",
      "mode": "0600",
      "owner": "root",
      "group": "root",
      "kind": "opaque",
      "required_names": [],
      "custody": "existing finitecomputer off-host recovery bundle"
    },
    {
      "path": "/var/lib/finitecomputer/backups/rsync-net/borg-passphrase",
      "mode": "0600",
      "owner": "root",
      "group": "root",
      "kind": "opaque",
      "required_names": [],
      "custody": "existing finitecomputer off-host recovery bundle"
    },
    {
      "path": "/etc/finite/litestream-latitude.env",
      "mode": "0600",
      "owner": "root",
      "group": "root",
      "kind": "env",
      "required_names": [
        "LITESTREAM_ACCESS_KEY_ID",
        "LITESTREAM_SECRET_ACCESS_KEY"
      ],
      "custody": "regenerate the scoped Latitude.sh object-storage credential; copy in team password manager"
    }
  ]
}
