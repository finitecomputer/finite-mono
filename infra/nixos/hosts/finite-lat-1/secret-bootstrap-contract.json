{
  "version": 1,
  "dynamic_requirements": [
    "one FC_CORE_RUNNER_CREDENTIAL_TOKEN_* variable for every active entry in FC_CORE_RUNNER_CREDENTIALS_JSON",
    "the finite Postgres role password must authenticate and match FC_CORE_DATABASE_URL",
    "the encrypted Borg repository key export and passphrase must both exist off-host"
  ],
  "files": [
    {
      "path": "/etc/finite/core.env",
      "mode": "0600",
      "owner": "root",
      "group": "root",
      "kind": "env",
      "required_names": [
        "FC_CORE_DATABASE_URL",
        "FC_CORE_API_TOKEN",
        "FC_CORE_RUNNER_CREDENTIALS_JSON",
        "FC_FINITE_PRIVATE_USAGE_API_TOKEN",
        "WORKOS_API_KEY",
        "WORKOS_CLIENT_ID",
        "FC_WORKOS_OPERATOR_ORG_ID"
      ],
      "custody": "off-host escrow or coordinated regeneration"
    },
    {
      "path": "/etc/finite/metrics-remote-write.env",
      "mode": "0600",
      "owner": "root",
      "group": "root",
      "kind": "env",
      "required_names": [
        "FINITE_METRICS_REMOTE_WRITE_USERNAME",
        "FINITE_METRICS_REMOTE_WRITE_PASSWORD"
      ],
      "custody": "NixOS monitoring receiver metrics-write credential and off-host escrow"
    },
    {
      "path": "/etc/finite/logs-write.env",
      "mode": "0600",
      "owner": "root",
      "group": "root",
      "kind": "env",
      "required_names": [
        "FINITE_LOGS_WRITE_USERNAME",
        "FINITE_LOGS_WRITE_PASSWORD"
      ],
