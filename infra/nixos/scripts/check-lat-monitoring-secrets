#!/usr/bin/env bash
# Validate the host-local Alloy credential files without printing values.
set -euo pipefail

usage() {
  echo "usage: $0 [--root ROOT] [--owner OWNER] [--group GROUP]" >&2
}

root="/"
expected_owner="root"
expected_group="root"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --root)
      [[ $# -ge 2 ]] || { usage; exit 64; }
      root="$2"
      shift 2
      ;;
    --owner)
      [[ $# -ge 2 ]] || { usage; exit 64; }
      expected_owner="$2"
      shift 2
      ;;
    --group)
      [[ $# -ge 2 ]] || { usage; exit 64; }
      expected_group="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 64
      ;;
  esac
done

failures=()

target_path() {
  local path="$1"
  if [[ "$root" == "/" ]]; then
    printf '%s\n' "$path"
  else
    printf '%s/%s\n' "${root%/}" "${path#/}"
  fi
}

file_metadata() {
  local path="$1" output mode owner group
  if output="$(stat -c '%a %U %G' "$path" 2>/dev/null)"; then
    read -r mode owner group <<<"$output"
  elif output="$(stat -f '%Lp %Su %Sg' "$path" 2>/dev/null)"; then
    read -r mode owner group <<<"$output"
  else
    return 1
  fi
  printf '%04d %s %s\n' "$((10#$mode))" "$owner" "$group"
}

env_names() {
  local path="$1"
  awk '
    /^[[:space:]]*($|#)/ { next }
    {
      line = $0
      sub(/^[[:space:]]*/, "", line)
      sub(/[[:space:]]*$/, "", line)
      sub(/^export[[:space:]]+/, "", line)
      if (line !~ /^[A-Za-z_][A-Za-z0-9_]*=/) {
        printf "%s:%d: malformed environment entry\n", FILENAME, FNR > "/dev/stderr"
        exit 2
      }
      sub(/=.*/, "", line)
      print line
    }
  ' "$path"
}

require_env_file() {
  local displayed_path="$1"
  shift
  local path metadata mode owner group names
  path="$(target_path "$displayed_path")"

  if [[ ! -e "$path" ]]; then
    failures+=("missing required file: $displayed_path")
    return
  fi
  if [[ ! -f "$path" ]]; then
    failures+=("required path is not a regular file: $displayed_path")
    return
  fi

  if ! metadata="$(file_metadata "$path")"; then
    failures+=("could not stat required file: $displayed_path")
    return
  fi
  read -r mode owner group <<<"$metadata"
  if [[ "$mode" != "0600" ]]; then
    failures+=("wrong mode for $displayed_path: expected 0600, got $mode")
  fi
  if [[ "$owner" != "$expected_owner" || "$group" != "$expected_group" ]]; then
    failures+=("wrong ownership for $displayed_path: expected $expected_owner:$expected_group, got $owner:$group")
  fi

  if ! names="$(env_names "$path")"; then
    failures+=("malformed environment file: $displayed_path")
    return
  fi

  local required
  for required in "$@"; do
    if ! grep -qxF "$required" <<<"$names"; then
      failures+=("missing required variable $required in $displayed_path")
    fi
  done
}

require_env_file \
  /etc/finite/metrics-remote-write.env \
  FINITE_METRICS_REMOTE_WRITE_USERNAME \
  FINITE_METRICS_REMOTE_WRITE_PASSWORD
require_env_file \
  /etc/finite/logs-write.env \
  FINITE_LOGS_WRITE_USERNAME \
  FINITE_LOGS_WRITE_PASSWORD

if [[ ${#failures[@]} -gt 0 ]]; then
  printf '%s\n' "${failures[@]}" >&2
  exit 1
fi

echo "LAT monitoring secret preflight passed (metadata and variable names; no values emitted)"
