#!/usr/bin/env bash
set -euo pipefail
prototype_dir="$(cd "$(dirname "$0")" && pwd)"
repo_root="$(git -C "$prototype_dir" rev-parse --show-toplevel)"
engine="${1:?Specify crane or crate2nix}"
case "$engine" in
  crane) suffix= ;;
  crate2nix) suffix=-crate2nix ;;
  *) exit 64 ;;
esac
mkdir "${2:?Specify a new output directory}"
output="$(cd "$2" && pwd -P)"
# Ignore saved approvals of the flake's production cache during timing.
export XDG_DATA_HOME="$output/nix-data"
cd "$repo_root"
# The benchmark edits this checkout; refuse to overwrite anyone's work.
git diff --quiet
git diff --cached --quiet
edited=(Cargo.lock Cargo.nix crate-hashes.json
  finite-sites/crates/finitesites-engine/Cargo.toml
  finite-sites/crates/finitesites-engine/src/lib.rs)
trap 'git restore --source=HEAD -- "${edited[@]}"' EXIT
summary="$output/summary.md"
{
  printf '## %s packaging benchmark\n\n' "$engine"
  printf 'Source: %s\n\n' "$(git -C "$repo_root" rev-parse HEAD)"
  printf 'Services: finitesitesd and finite-saas-core. Public Nix cache only.\n'
  printf 'Rebuilds reuse the local store; this is not a fresh-runner cache test.\n\n'
  printf '| Case | Preparation (s) | Build (s) | Exit code |\n| --- | ---: | ---: | ---: |\n'
} > "$summary"
TIMEFORMAT=%R

for scenario in baseline identical sites-source sites-dependency; do
  echo "Preparing $engine: $scenario"
  git restore --source=HEAD -- "${edited[@]}"
  started=$SECONDS
  if [[ "$scenario" == sites-source ]]; then
    printf '\n// Benchmark source edit.\n' >> finite-sites/crates/finitesites-engine/src/lib.rs
  elif [[ "$scenario" == sites-dependency ]]; then
    printf '\n[dependencies.hex]\nworkspace = true\n' >> finite-sites/crates/finitesites-engine/Cargo.toml
    cargo metadata --format-version 1 --all-features > "$output/$scenario.metadata.log" 2>&1
    if [[ "$engine" == crate2nix ]]; then
      crate2nix generate > "$output/$scenario.generate.log" 2>&1
    fi
  fi
  preparation=$((SECONDS - started))
  echo "Building $engine: $scenario"
  status=0
  { time nix build ".#finitesitesd$suffix" ".#finite-saas-core$suffix" \
      --no-link --print-out-paths --print-build-logs --no-accept-flake-config \
      --option builders '' --option substituters https://cache.nixos.org \
      --option extra-substituters '' \
      --cores 8 --max-jobs 8 > "$output/$scenario.paths" 2> "$output/$scenario.build.log";
  } 2> "$output/$scenario.seconds" || status=$?
  printf '| %s | %s | %s | %s |\n' "$scenario" "$preparation" "$(cat "$output/$scenario.seconds")" "$status" | tee -a "$summary"
  if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
    cp "$summary" "$GITHUB_STEP_SUMMARY"
  fi
  if [[ "$status" != 0 ]]; then
    tail -100 "$output/$scenario.build.log"
    exit "$status"
  fi
done
