set shell := ["../../scripts/dev-shell", "-cu"]

# Lists infra secret commands
default:
    just --list

# Values-free NixOS secret contract shape.
contract:
    cd ../.. && python3 scripts/check_nixos_secrets_contract.py
    cd ../.. && python3 -m unittest scripts.tests.test_nixos_secrets_contract
    cd ../.. && python3 -m unittest scripts.tests.test_nixos_sops_ingest
    cd ../.. && python3 -m unittest scripts.tests.test_nixos_sops_operator_key
    cd ../.. && python3 -m unittest scripts.tests.test_nixos_sops_test_decrypt
    cd ../.. && python3 -m unittest scripts.tests.test_nixos_sops_updatekeys

# Prints only the public age recipient; the private key stays in
# SOPS_AGE_KEY_FILE or ~/.config/sops/age/keys.txt.
# Create or inspect the local SOPS operator age recipient.
[positional-arguments]
operator-key *args:
    #!/usr/bin/env bash
    set -euo pipefail
    repo_root="$(cd ../.. && pwd)"
    cd "$repo_root"
    exec python3 scripts/nixos_sops_operator_key.py "$@"

# Check whether the current operator can decrypt existing NixOS SOPS files.
[positional-arguments]
test-decrypt *args:
    #!/usr/bin/env bash
    set -euo pipefail
    repo_root="$(cd ../.. && pwd)"
    cd "$repo_root"
    exec python3 scripts/nixos_sops_test_decrypt.py "$@"

# Pipe plaintext from a source command into this recipe; see
# infra/secret/OPERATIONS.md for examples.
# Encrypt one NixOS SOPS secret from stdin into infra/nixos/secrets.
[positional-arguments]
ingest *args:
    #!/usr/bin/env bash
    set -euo pipefail
    repo_root="$(cd ../.. && pwd)"
    cd "$repo_root"
    exec python3 scripts/nixos_sops_ingest.py "$@"

# Update SOPS file recipient metadata after .sops.yaml recipient changes.
[positional-arguments]
updatekeys *args:
    #!/usr/bin/env bash
    set -euo pipefail
    repo_root="$(cd ../.. && pwd)"
    cd "$repo_root"
    exec python3 scripts/nixos_sops_updatekeys.py "$@"
