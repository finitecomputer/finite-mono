+    def _resolve_credentialless_session_override(
+        self, session_key: Optional[str], override: dict, override_model: str
+    ) -> tuple:
+        """Resolve a session /model route whose credentials are not cached.
+
+        The override stays the conversation's primary identity. Its own
+        provider is re-resolved every turn; when that fails, the configured
+        fallback chain is used exactly as for a failing default primary, and
+        with no usable fallback the turn fails with the resolution error.
+        """
+        provider = str(override.get("provider") or "").strip()
+        try:
+            if not provider:
+                raise RuntimeError(
+                    "session model override names an endpoint but no provider"
+                )
+            runtime = _resolve_session_override_credentials(
+                provider, override.get("base_url")
+            )
+        except Exception as exc:
+            logger.warning(
+                "Session model override provider=%s has no usable credentials "
+                "(%s) — trying fallback",
+                provider, exc,
+            )
+            fb_config = _try_resolve_fallback_provider()
+            if fb_config is not None:
+                fb_model = fb_config.pop("model", None) or override_model
+                return fb_model, fb_config
+            raise
+        override["api_key"] = runtime.get("api_key")
+        override["api_mode"] = runtime.get("api_mode")
+        override["credential_pool"] = runtime.get("credential_pool")
+        override["request_overrides"] = dict(runtime.get("request_overrides") or {})
+        override["requested_provider"] = runtime.get("requested_provider")
+        override["capabilities"] = dict(runtime.get("capabilities") or {})
+        override["max_tokens"] = runtime.get("max_tokens")
+        if not override.get("base_url"):
+            override["base_url"] = runtime.get("base_url")
+        return override_model, {
+            "provider": override.get("provider"),
+            "requested_provider": override.get("requested_provider"),
+            "api_key": override.get("api_key"),
+            "base_url": override.get("base_url"),
+            "api_mode": override.get("api_mode"),
+            "max_tokens": override.get("max_tokens"),
+            "credential_pool": override.get("credential_pool"),
+            "request_overrides": override.get("request_overrides"),
+            "capabilities": dict(override.get("capabilities") or {}),
+        }
 
