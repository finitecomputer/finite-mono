+def _openrouter_credential_missing(runtime: dict) -> bool:
+    """True when a resolved OpenRouter runtime carries no usable API key."""
+    if str(runtime.get("provider") or "").strip().lower() != "openrouter":
+        return False
+    key = str(runtime.get("api_key") or "").strip()
+    return not key or key.startswith("${")
+
+
+def _endpoint_identity(url: Optional[str]) -> Optional[tuple]:
+    """Comparable endpoint identity: scheme and host case-insensitive, the rest exact.
+
+    Only a trailing slash on the path is normalized. Returns None for an empty
+    URL and ("uncertain",) for a URL that cannot be bound to an endpoint.
+    """
+    raw = str(url or "").strip()
+    if not raw:
+        return None
+    from urllib.parse import urlsplit
+
+    try:
+        parts = urlsplit(raw)
+        port = parts.port
+    except ValueError:
+        return ("uncertain",)
+    if not parts.scheme or not parts.hostname:
+        return ("uncertain",)
+    return (
+        parts.scheme.lower(),
+        parts.hostname.lower(),
+        port,
+        parts.username,
+        parts.password,
+        parts.path.rstrip("/"),
+        parts.query,
+        parts.fragment,
+    )
+
+
+def _resolve_session_override_credentials(
+    provider: str, persisted_base_url: Optional[str]
+) -> dict:
+    """Resolve credentials for a session override's own route.
+
+    Raises when the provider cannot be resolved, when an OpenRouter route has
+    no key, or when the credentials cannot be proven to belong to the endpoint
+    the override names, so a caller can never pair one route's endpoint with
+    another route's key.
+    """
+    runtime = _resolve_runtime_agent_kwargs_for_provider(provider)
+    if _openrouter_credential_missing(runtime):
+        raise RuntimeError(f"credentials for provider {provider!r} are not configured")
+    wanted = _endpoint_identity(persisted_base_url)
+    if wanted is None:
+        return runtime
+    resolved = _endpoint_identity(runtime.get("base_url"))
+    if wanted == ("uncertain",) or resolved == ("uncertain",):
+        raise RuntimeError(
+            f"credentials for provider {provider!r} have an uncertain endpoint binding"
+        )
+    if resolved is None:
+        if runtime.get("api_key"):
+            raise RuntimeError(
+                f"credentials for provider {provider!r} have no verified endpoint binding"
+            )
+        return runtime
+    if wanted != resolved:
+        raise RuntimeError(
+            f"credentials for provider {provider!r} are bound to a different endpoint"
+        )
+    return runtime
 
 
