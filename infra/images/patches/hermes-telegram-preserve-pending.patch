         self._polling_error_task = loop.create_task(self._handle_polling_network_error(error))
         self._background_tasks.add(self._polling_error_task)
         self._polling_error_task.add_done_callback(self._background_tasks.discard)
+
+    def _preserve_pending_updates_on_start(self) -> bool:
+        """Finite: keep the Bot API queue when opted in.
+
+        ``extra.preserve_pending_updates: true`` is set when a bot moves to a
+        new host, so messages sent while it was offline are still answered.
+        Without the key, a cold start drops the stale queue as upstream does.
+        """
+        value = (self.config.extra or {}).get("preserve_pending_updates")
+        return value is True or str(value).strip().lower() in {"1", "true", "yes", "on"}
 
+    def _finite_drop_pending_updates(self, site: str, upstream_drop: bool) -> bool:
+        """Finite: the drop decision for one patched call site, recorded."""
+        seen = getattr(self, "_finite_preserve_pending_sites", None)
+        if seen is None:
+            seen = {}
+            self._finite_preserve_pending_sites = seen
+        drop = bool(upstream_drop) and not self._preserve_pending_updates_on_start()
+        seen[site] = drop
+        return drop
+
