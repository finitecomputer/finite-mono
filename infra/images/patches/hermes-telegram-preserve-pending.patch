+# Finite: versioned capability of the opt-in pending-update preservation
+# (extra.preserve_pending_updates). Version 2 covers the cold start, the
+# webhook start and the 409 conflict retry. Each patched call site records
+# itself in TelegramAdapter._finite_preserve_pending_sites when it runs, so a
+# qualification probe can prove the call sites, not just this marker.
+FINITE_TELEGRAM_PRESERVE_PENDING = "finite.telegram.preserve-pending/2"
+FINITE_TELEGRAM_PRESERVE_PENDING_SITES = ("cold-start", "conflict-retry", "webhook-start")
