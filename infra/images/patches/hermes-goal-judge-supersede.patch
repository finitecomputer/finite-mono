+def _commit_goal_if_unchanged(session_id: str, expected: Optional[str], latest: str) -> bool:
+    """Write ``latest`` only while the stored goal is still ``expected``."""
+    db = _get_session_db()
+    if db is None:
+        _warn_dropped_write("GoalManager", "goal", session_id)
+        return False
+    with _GOAL_WRITE_LOCK:
+        if _goal_json(load_goal(session_id)) != expected:
+            return False
+        try:
+            db.set_meta(_meta_key(session_id), latest)
+        except Exception as exc:
+            logger.debug("GoalManager: set_meta failed: %s", exc)
+    return True
