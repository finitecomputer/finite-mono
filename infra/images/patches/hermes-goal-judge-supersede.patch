+# Finite: the gateway judges a goal off the event loop while /goal controls
+# stay live on it. The judge's writes are held per thread and committed once,
+# under the lock every goal write takes, only if the stored goal is unchanged.
+_GOAL_WRITE_LOCK = threading.Lock()
+_DEFERRED_GOAL_WRITES = threading.local()
+# The verdict of the decision that stops the loop when the goal store fails.
+_STORE_FAILED = "store_failed"
+_NO_WAIT: Tuple[Any, Any, float] = (None, None, 0.0)
+
+
+def _goal_json(state: Optional[GoalState]) -> Optional[str]:
+    """``state`` as stored, normalized so loaded and stored forms compare."""
+    return GoalState.from_json(state.to_json()).to_json() if state is not None else None
+
+
+def _wait_of(state: Optional[GoalState]) -> Tuple[Any, Any, float]:
+    """``state``'s wait barrier: pid, session and deadline."""
+    if state is None:
+        return _NO_WAIT
+    return (state.waiting_on_pid, state.waiting_on_session, state.waiting_until or 0.0)
+
