+def _commit_goal_if_unchanged(session_id: str, expected: Optional[str], latest: str) -> Optional[bool]:
+    """Write ``latest`` only while the stored goal is still ``expected``.
+
+    True once written, False if the goal changed. None if the store failed:
+    nothing is written over a goal that could not be read back (a goal row
+    is never deleted), and a write that raised saved nothing. With no
+    session DB at all there is nothing to write over; the decision stands,
+    as before this patch.
+    """
+    db = _get_session_db()
+    if db is None:
+        _warn_dropped_write("GoalManager", "goal", session_id)
+        return True
+    with _GOAL_WRITE_LOCK:
+        stored = load_goal(session_id)
+        if stored is None:
+            return None
+        if _goal_json(stored) != expected:
+            return False
+        try:
+            db.set_meta(_meta_key(session_id), latest)
+        except Exception as exc:
+            logger.debug("GoalManager: set_meta failed: %s", exc)
+            return None
+    return True
