     # --- the main entry point called after every turn -----------------
 
+    def _still_running(self, stored: Optional[GoalState]) -> bool:
+        """Finite: ``stored`` is this manager's goal, still active and not parked."""
+        state = self._state
+        return (
+            stored is not None
+            and state is not None
+            and (stored.goal, stored.created_at) == (state.goal, state.created_at)
+            and stored.status == "active"
+            and stored.waiting_on_pid is None
+            and stored.waiting_on_session is None
+            and not stored.waiting_until
+        )
+
+    def keeps_decision(self, decision: Dict[str, Any]) -> bool:
+        """Finite: whether to act on ``decision`` once a /goal control may have landed.
+
+        A pause, clear, wait or new goal makes it stale. A gate or subgoal
+        change keeps a continuing decision, as it does once the continuation
+        is queued.
+        """
+        stored = load_goal(self.session_id)
+        if _goal_json(stored) == _goal_json(self._state):
+            return True
+        return bool(decision.get("should_continue")) and self._still_running(stored)
+
+    def still_reports(self, decision: Dict[str, Any]) -> bool:
+        """Finite: whether the stored goal is still this one, in ``decision``'s status.
+
+        Later turns of the same goal may have moved it on; a control that
+        paused, cleared or replaced it makes the decision's notice stale.
+        """
+        stored, state = load_goal(self.session_id), self._state
+        return (
+            stored is not None
+            and state is not None
+            and (stored.goal, stored.created_at) == (state.goal, state.created_at)
+            and stored.status == decision.get("status")
+        )
+
