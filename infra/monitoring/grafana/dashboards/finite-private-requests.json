{
  "uid": "finite-private-requests",
  "title": "Finite Private Requests & Usage",
  "description": "Internal operator request, token and timing diagnostics. Seven-day Core-reserved detail; bounded all-traffic aggregates.",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "tags": [
    "finite",
    "private",
    "operators"
  ],
  "timezone": "utc",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ],
    "time_options": [
      "5m",
      "15m",
      "1h",
      "6h",
      "24h",
      "2d",
      "7d",
      "15d"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "finite-prometheus"
        },
        "query": "label_values(finite_private_limiter_route_requests_total, model)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "endpoint",
        "label": "Endpoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "finite-prometheus"
        },
        "query": "label_values(finite_private_limiter_route_requests_total, endpoint)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "admission_mode",
        "label": "Admission mode",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "finite-prometheus"
        },
        "query": "label_values(finite_private_limiter_admission_mode, mode)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "project",
        "label": "Project (details)",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "description": "Regular expression over trusted opaque IDs; .* means all."
      },
      {
        "name": "runtime",
        "label": "Agent Runtime (details)",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "description": "Regular expression over trusted opaque IDs; .* means all."
      },
      {
        "name": "key",
        "label": "Key (details)",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "description": "Regular expression over trusted opaque IDs; .* means all."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Internal Operators · source and coverage",
      "type": "text",
      "description": "",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable"
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**All-traffic aggregates** count inference arrivals, refused admission, degraded admission and terminal outcomes at the limiter. Project / Agent Runtime / key filters apply **only to Core-reserved reporting** below. Shared keys cannot identify an individual caller. Model filters apply to panels marked “model”; arrivals, refusals, active and health remain all-model totals.\n\n**Request detail and attributed usage: last 7 days only.** Low-cardinality Prometheus aggregates: up to 15 days, subject to 20 GB storage. Unknown tokens/timings are unavailable, not zero. Final usage and completion measurements appear after termination. Timings are limiter-observed, not client receipt or engine decode speed. Core accounting remains the Runaway Guard authority. Historical data is available only after collection began."
      }
    },
    {
      "id": 2,
      "title": "Inference arrivals / minute · all traffic",
      "type": "stat",
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 6
