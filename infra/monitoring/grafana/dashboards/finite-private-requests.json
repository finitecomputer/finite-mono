    {
      "id": 17,
      "title": "Usage settlement quality · all traffic",
      "type": "timeseries",
      "description": "Estimate means upstream actual token totals unavailable. Diagnostic persistence is best-effort and bounded; failures never block inference.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable"
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "finite-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(kind)(rate(finite_private_limiter_settlements_total[5m]))",
          "legendFormat": "{{kind}} / sec",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
