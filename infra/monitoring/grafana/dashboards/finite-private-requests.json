      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "noValue": "Unavailable",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "finite-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(finite_private_limiter_requests_started_total[5m])) * 60",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
