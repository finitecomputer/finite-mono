  "description": "Operator dashboard for Agent Runtime slot usage on the Kata Runner hosts finite-lat-3 and finite-lat-4.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Draft data contract",
      "description": "This panel prevents the draft from looking production-ready before provisioning is approved.",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "This dashboard is a draft. It is not yet provisioned to production Grafana. Slot usage comes from the live `finite_runtime_artifact_active_agents` metric (exported from Core by `finite-runtime-metrics`). The 42-slot ceiling per host is the operator-pinned `FC_RUNNER_MAX_SANDBOXES` value guarded by `scripts/check_runner_host_contract.py`, not a live metric. A host with zero active runtimes and a stalled exporter both render `No data`; use the MVP dashboard's host scrape health to distinguish them. Runner drain (currently lat4) is operator env state and is not visible here."
      },
      "pluginVersion": "13.0.2"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "finite-prometheus"
      },
      "description": "Active Agent Runtimes on finite-lat-3. Red means the host is at its slot ceiling.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 42
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name_and_value",
        "wideLayout": true
      },
      "pluginVersion": "13.0.2",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(finite_runtime_artifact_active_agents{source_host_id=\"finite-lat-3\"})",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "lat3 Slots Used",
      "type": "stat"
    },
