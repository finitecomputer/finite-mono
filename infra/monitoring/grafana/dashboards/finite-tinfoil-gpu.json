  "description": "Draft operator dashboard for the Finite Private Tinfoil allocation. No production metrics source is wired yet. Tinfoil reports allocation-wide values, not individual-GPU series.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 9,
      "type": "text",
      "title": "Draft data contract",
      "description": "This panel prevents the draft from looking production-ready before ingestion is approved.",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "This dashboard is a draft. It is not yet provisioned to production Grafana and no production Tinfoil metrics source is wired yet. Target: `finite-private`. Capacity and served-model identity remain collector-owned follow-up data. Credential handling and deployment belong in separate follow-ups."
      },
      "pluginVersion": "13.0.2"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "finite-prometheus"
      },
      "description": "FRESH below five minutes, AGING from five to ten minutes, and STALE after ten minutes or when the collector series is absent. This signal does not assume direct Prometheus access to the enclave.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "green",
                  "text": "FRESH"
                },
                "1": {
                  "color": "orange",
                  "text": "AGING"
                },
                "2": {
                  "color": "red",
                  "text": "STALE"
                }
              },
              "type": "value"
            }
          ],
          "max": 2,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 3
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name_and_value",
        "wideLayout": true
      },
      "pluginVersion": "13.0.2",
      "targets": [
        {
          "editorMode": "code",
          "expr": "clamp(floor((time() - finite_tinfoil_source_sample_timestamp_seconds{container=\"finite-private\"}) / 300), 0, 2) or on() vector(2)",
          "instant": true,
          "legendFormat": "collector",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Data Freshness",
      "type": "stat"
    },
