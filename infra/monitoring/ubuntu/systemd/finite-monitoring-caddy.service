[Unit]
Description=Finite monitoring Caddy edge
After=network-online.target finite-monitoring-grafana.service finite-monitoring-prometheus.service finite-monitoring-loki.service
Wants=network-online.target finite-monitoring-grafana.service finite-monitoring-prometheus.service finite-monitoring-loki.service

[Service]
User=finite-monitoring
Group=finite-monitoring
Environment=HOME=/var/lib/finite-monitoring/caddy
Environment=XDG_DATA_HOME=/var/lib/finite-monitoring/caddy/data
Environment=XDG_CONFIG_HOME=/var/lib/finite-monitoring/caddy/config
EnvironmentFile=/etc/finite/monitoring/caddy.env
ExecStart=/opt/finite-monitoring/bin/caddy run --config /etc/finite/monitoring/Caddyfile --adapter caddyfile
ExecReload=/opt/finite-monitoring/bin/caddy reload --config /etc/finite/monitoring/Caddyfile --adapter caddyfile --address unix//run/finite-monitoring-caddy/admin.sock --force
Restart=on-failure
RestartSec=5s
RuntimeDirectory=finite-monitoring-caddy
RuntimeDirectoryMode=0750
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/var/lib/finite-monitoring/caddy /var/log/finite-monitoring/caddy

[Install]
WantedBy=multi-user.target
