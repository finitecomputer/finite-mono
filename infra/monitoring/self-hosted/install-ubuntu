#!/usr/bin/env bash
set -euo pipefail

INSTALL_DIR="/opt/finite-monitoring"
SECRETS_DIR="/etc/finite/monitoring"
ENV_FILE="${SECRETS_DIR}/stack.env"
CADDY_ENV_FILE="${SECRETS_DIR}/caddy.env"
GRAFANA_PASSWORD_FILE="${SECRETS_DIR}/grafana-admin-password"
METRICS_PASSWORD_FILE="${SECRETS_DIR}/metrics-write-password"
SOURCE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CADDY_IMAGE="caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648"

if [[ "${EUID}" -ne 0 ]]; then
  echo "run this installer as root (for example, with sudo)" >&2
  exit 1
fi

if [[ ! -r /etc/os-release ]]; then
  echo "cannot identify the operating system" >&2
  exit 1
fi

# shellcheck disable=SC1091
source /etc/os-release
if [[ "${ID:-}" != "ubuntu" || "${VERSION_ID:-}" != "24.04" ]]; then
  echo "this installer supports Ubuntu 24.04; found ${PRETTY_NAME:-unknown}" >&2
  exit 1
fi

env_value() {
  local key="$1"
  [[ -r "${ENV_FILE}" ]] || return 0
  sed -n "s/^${key}=//p" "${ENV_FILE}" | tail -n 1
}

MONITORING_MODE="${MONITORING_MODE:-$(env_value MONITORING_MODE)}"
MONITORING_MODE="${MONITORING_MODE:-dns}"
MONITORING_IP="${MONITORING_IP:-$(env_value MONITORING_IP)}"
GRAFANA_DOMAIN="${GRAFANA_DOMAIN:-$(env_value GRAFANA_DOMAIN)}"
METRICS_DOMAIN="${METRICS_DOMAIN:-$(env_value METRICS_DOMAIN)}"
ACME_EMAIL="${ACME_EMAIL:-$(env_value ACME_EMAIL)}"
METRICS_USERNAME="${METRICS_USERNAME:-$(env_value METRICS_USERNAME)}"
METRICS_USERNAME="${METRICS_USERNAME:-finite-lat}"

if [[ ! "${METRICS_USERNAME}" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "invalid METRICS_USERNAME: ${METRICS_USERNAME}" >&2
  exit 1
fi

validate_ipv4() {
  local address="$1"
  local -a octets
  local octet
  IFS=. read -r -a octets <<<"${address}"
  [[ "${#octets[@]}" -eq 4 ]] || return 1
  for octet in "${octets[@]}"; do
    [[ "${octet}" =~ ^[0-9]{1,3}$ ]] || return 1
    ((10#${octet} <= 255)) || return 1
  done
}

case "${MONITORING_MODE}" in
  ip)
    if [[ -z "${MONITORING_IP}" ]] || ! validate_ipv4 "${MONITORING_IP}"; then
      echo "set MONITORING_IP to the VPS public IPv4 address" >&2
      exit 1
    fi
    GRAFANA_HOST="${MONITORING_IP}"
    GRAFANA_ROOT_URL="http://${MONITORING_IP}"
    GRAFANA_COOKIE_SECURE="false"
    CADDY_CONFIG_FILE="Caddyfile.ip"
    METRICS_WRITE_URL="http://${MONITORING_IP}/api/v1/write"
    REMOTE_WRITE_UNAUTHENTICATED_STATUS="426"
    ;;
  dns)
    for variable in GRAFANA_DOMAIN METRICS_DOMAIN ACME_EMAIL; do
      if [[ -z "${!variable:-}" ]]; then
        echo "set ${variable} for DNS mode" >&2
        exit 1
      fi
    done
    if [[ ! "${GRAFANA_DOMAIN}" =~ ^[A-Za-z0-9.-]+$ || "${GRAFANA_DOMAIN}" != *.* ]]; then
      echo "invalid GRAFANA_DOMAIN: ${GRAFANA_DOMAIN}" >&2
      exit 1
    fi
    if [[ ! "${METRICS_DOMAIN}" =~ ^[A-Za-z0-9.-]+$ || "${METRICS_DOMAIN}" != *.* ]]; then
      echo "invalid METRICS_DOMAIN: ${METRICS_DOMAIN}" >&2
      exit 1
    fi
    if [[ ! "${ACME_EMAIL}" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]]; then
      echo "invalid ACME_EMAIL" >&2
      exit 1
    fi
    GRAFANA_HOST="${GRAFANA_DOMAIN}"
    GRAFANA_ROOT_URL="https://${GRAFANA_DOMAIN}"
    GRAFANA_COOKIE_SECURE="true"
    CADDY_CONFIG_FILE="Caddyfile"
    METRICS_WRITE_URL="https://${METRICS_DOMAIN}/api/v1/write"
    REMOTE_WRITE_UNAUTHENTICATED_STATUS="401"
    ;;
  *)
    echo "MONITORING_MODE must be 'ip' or 'dns'" >&2
    exit 1
    ;;
esac

install_docker() {
  local -a conflicts=()
  local package

  for package in docker.io docker-compose docker-compose-v2 docker-doc docker-buildx podman-docker containerd runc; do
    if dpkg-query -W -f='${db:Status-Status}' "${package}" 2>/dev/null | grep -q '^installed$'; then
      conflicts+=("${package}")
    fi
  done
  if ((${#conflicts[@]})); then
    apt-get remove -y "${conflicts[@]}"
  fi

  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y ca-certificates curl
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  chmod a+r /etc/apt/keyrings/docker.asc

  cat >/etc/apt/sources.list.d/docker.sources <<EOF
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: ${UBUNTU_CODENAME:-${VERSION_CODENAME}}
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF

  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y \
    docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
}

if ! command -v docker >/dev/null 2>&1; then
  install_docker
fi

if ! docker compose version >/dev/null 2>&1; then
  echo "Docker is installed but the Compose plugin is unavailable" >&2
  exit 1
fi

systemctl enable --now docker
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y openssl

install -d -m 0755 "${INSTALL_DIR}"
install -d -m 0700 "${SECRETS_DIR}"
if [[ "$(realpath "${SOURCE_DIR}")" != "$(realpath "${INSTALL_DIR}")" ]]; then
  cp -a "${SOURCE_DIR}/." "${INSTALL_DIR}/"
fi

generate_secret() {
  local destination="$1"
  local temporary
  [[ -s "${destination}" ]] && return 0
  temporary="$(mktemp "${SECRETS_DIR}/.secret.XXXXXX")"
  openssl rand -hex 32 >"${temporary}"
  chmod 0600 "${temporary}"
  mv "${temporary}" "${destination}"
}

generate_secret "${GRAFANA_PASSWORD_FILE}"
generate_secret "${METRICS_PASSWORD_FILE}"
chown root:472 "${GRAFANA_PASSWORD_FILE}"
chmod 0640 "${GRAFANA_PASSWORD_FILE}"

docker pull "${CADDY_IMAGE}"
metrics_hash="$(docker run --rm -i "${CADDY_IMAGE}" \
  caddy hash-password --algorithm argon2id <"${METRICS_PASSWORD_FILE}")"

temporary_caddy_env="$(mktemp "${SECRETS_DIR}/.caddy.env.XXXXXX")"
temporary_env="$(mktemp "${SECRETS_DIR}/.stack.env.XXXXXX")"
trap 'rm -f "${temporary_caddy_env:-}" "${temporary_env:-}"' EXIT
{
  printf 'MONITORING_IP=%s\n' "${MONITORING_IP}"
  printf 'GRAFANA_DOMAIN=%s\n' "${GRAFANA_DOMAIN}"
  printf 'METRICS_DOMAIN=%s\n' "${METRICS_DOMAIN}"
  printf 'ACME_EMAIL=%s\n' "${ACME_EMAIL}"
  printf 'METRICS_USERNAME=%s\n' "${METRICS_USERNAME}"
  printf 'METRICS_PASSWORD_HASH=%s\n' "${metrics_hash}"
} >"${temporary_caddy_env}"
chmod 0600 "${temporary_caddy_env}"
mv "${temporary_caddy_env}" "${CADDY_ENV_FILE}"
{
  printf 'MONITORING_MODE=%s\n' "${MONITORING_MODE}"
  printf 'MONITORING_IP=%s\n' "${MONITORING_IP}"
  printf 'GRAFANA_DOMAIN=%s\n' "${GRAFANA_DOMAIN}"
  printf 'METRICS_DOMAIN=%s\n' "${METRICS_DOMAIN}"
  printf 'ACME_EMAIL=%s\n' "${ACME_EMAIL}"
  printf 'METRICS_USERNAME=%s\n' "${METRICS_USERNAME}"
  printf 'GRAFANA_HOST=%s\n' "${GRAFANA_HOST}"
  printf 'GRAFANA_ROOT_URL=%s\n' "${GRAFANA_ROOT_URL}"
  printf 'GRAFANA_COOKIE_SECURE=%s\n' "${GRAFANA_COOKIE_SECURE}"
  printf 'CADDY_CONFIG_FILE=%s\n' "${CADDY_CONFIG_FILE}"
  printf 'METRICS_WRITE_URL=%s\n' "${METRICS_WRITE_URL}"
  printf 'REMOTE_WRITE_UNAUTHENTICATED_STATUS=%s\n' "${REMOTE_WRITE_UNAUTHENTICATED_STATUS}"
  printf 'GRAFANA_ADMIN_PASSWORD_FILE=%s\n' "${GRAFANA_PASSWORD_FILE}"
  printf 'CADDY_ENV_FILE=%s\n' "${CADDY_ENV_FILE}"
} >"${temporary_env}"
chmod 0600 "${temporary_env}"
mv "${temporary_env}" "${ENV_FILE}"
trap - EXIT

cd "${INSTALL_DIR}"
docker compose --env-file "${ENV_FILE}" config --quiet
docker compose --env-file "${ENV_FILE}" pull
docker run --rm --network none \
  --mount "type=bind,src=${INSTALL_DIR}/${CADDY_CONFIG_FILE},dst=/etc/caddy/active.Caddyfile,readonly" \
  --mount "type=bind,src=${CADDY_ENV_FILE},dst=/run/secrets/caddy_env,readonly" \
  "${CADDY_IMAGE}" caddy validate \
  --config /etc/caddy/active.Caddyfile --adapter caddyfile --envfile /run/secrets/caddy_env
docker compose --env-file "${ENV_FILE}" up -d --remove-orphans

grafana_password="$(<"${GRAFANA_PASSWORD_FILE}")"
grafana_reset_complete=0
grafana_reset_output=""
for _ in {1..30}; do
  if grafana_reset_output="$(docker compose --env-file "${ENV_FILE}" exec -T grafana \
    grafana cli --homepath /usr/share/grafana --config /etc/grafana/grafana.ini \
    admin reset-admin-password "${grafana_password}" 2>&1)"; then
    grafana_reset_complete=1
    break
  fi
  sleep 2
done
unset grafana_password
if [[ "${grafana_reset_complete}" -ne 1 ]]; then
  echo "failed to synchronize the Grafana admin password:" >&2
  echo "${grafana_reset_output}" >&2
  exit 1
fi

docker compose --env-file "${ENV_FILE}" ps

cat <<EOF

Monitoring containers are started.

Grafana:       ${GRAFANA_ROOT_URL}
Metrics write: ${METRICS_WRITE_URL}

Run:
  sudo ${INSTALL_DIR}/verify

Read the initial Grafana password only when you are ready to log in:
  sudo cat ${GRAFANA_PASSWORD_FILE}
EOF
