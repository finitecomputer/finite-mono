#!/usr/bin/env bash
set -euo pipefail

INSTALL_DIR="/opt/finite-monitoring"
SECRETS_DIR="/etc/finite/monitoring"
ENV_FILE="${SECRETS_DIR}/stack.env"
GRAFANA_PASSWORD_FILE="${SECRETS_DIR}/grafana-admin-password"

if [[ "${EUID}" -ne 0 ]]; then
  echo "run verification as root (for example, with sudo)" >&2
  exit 1
fi
if [[ ! -r "${ENV_FILE}" || ! -r "${GRAFANA_PASSWORD_FILE}" ]]; then
  echo "monitoring secrets are missing; run install-ubuntu first" >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
source "${ENV_FILE}"
set +a

cd "${INSTALL_DIR}"
compose=(docker compose --env-file "${ENV_FILE}")

for service in grafana prometheus blackbox-exporter caddy; do
  container_id="$("${compose[@]}" ps -q "${service}")"
  if [[ -z "${container_id}" || "$(docker inspect -f '{{.State.Status}}' "${container_id}")" != "running" ]]; then
    echo "${service} is not running" >&2
    "${compose[@]}" ps >&2
    exit 1
  fi
done

for _ in {1..30}; do
  if "${compose[@]}" exec -T prometheus wget -qO- http://127.0.0.1:9090/-/ready >/dev/null 2>&1; then
    break
  fi
  sleep 2
done
"${compose[@]}" exec -T prometheus wget -qO- http://127.0.0.1:9090/-/ready >/dev/null

probe_json="$("${compose[@]}" exec -T prometheus wget -qO- 'http://127.0.0.1:9090/api/v1/query?query=probe_success')"
PROBE_JSON="${probe_json}" python3 - <<'PY'
import json
import os

expected = {
    "finite.computer",
    "chat.finite.computer",
    "brain.finite.computer",
    "finitechat-native-mockup.finite.chat",
    "uptime-probe.docs.finite.chat",
}
payload = json.loads(os.environ["PROBE_JSON"])
results = payload["data"]["result"]
actual = {item["metric"].get("job") for item in results}
failed = {
    item["metric"].get("job")
    for item in results
    if item["value"][1] != "1"
}
if actual != expected:
    raise SystemExit(f"public probe jobs differ: expected={sorted(expected)} actual={sorted(actual)}")
if failed:
    raise SystemExit(f"public probes are failing: {sorted(failed)}")
PY

curl -fsS "${GRAFANA_ROOT_URL}/api/health" | python3 -c \
  'import json,sys; data=json.load(sys.stdin); assert data["database"] == "ok", data'

write_status="$(curl -sS -o /dev/null -w '%{http_code}' -X POST "${METRICS_WRITE_URL}")"
if [[ "${write_status}" != "${REMOTE_WRITE_UNAUTHENTICATED_STATUS}" ]]; then
  echo "unauthenticated remote write returned ${write_status}, expected ${REMOTE_WRITE_UNAUTHENTICATED_STATUS}" >&2
  exit 1
fi

netrc="$(mktemp)"
trap 'rm -f "${netrc}"' EXIT
chmod 0600 "${netrc}"
printf 'machine %s login admin password %s\n' \
  "${GRAFANA_HOST}" "$(<"${GRAFANA_PASSWORD_FILE}")" >"${netrc}"
curl -fsS --netrc-file "${netrc}" \
  "${GRAFANA_ROOT_URL}/api/dashboards/uid/finite-production-mvp" |
  python3 -c 'import json,sys; data=json.load(sys.stdin); assert data["dashboard"]["title"] == "Finite Production MVP", data'

echo "self-hosted monitoring verification: ok"
