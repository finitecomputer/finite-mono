set shell := ["../../scripts/dev-shell", "-cu"]

# Lists monitoring commands
default:
    just --list

# Values-free service contract for the dedicated NixOS monitoring receiver.
monitoring-nixos-contract:
    cd ../.. && sh -n infra/monitoring/ci_dispatch
    cd ../.. && python3 infra/monitoring/deploy_dashboards.py validate
    cd ../.. && python3 -m unittest discover -s infra/monitoring/tests -p 'test_deploy_dashboards.py'
    cd ../.. && python3 -m unittest discover -s infra/monitoring/tests -p 'test_install_ci_access.py'
    cd ../.. && python3 scripts/check_monitoring_nixos_contract.py
    cd ../.. && python3 -m unittest discover -s infra/nixos/tests -p 'test_finite_runtime_metrics.py'
    cd ../.. && nix shell --inputs-from . nixpkgs#prometheus.cli --command python3 infra/monitoring/tests/test_runtime_slots_promql.py
    cd ../.. && nix shell --inputs-from . nixpkgs#prometheus.cli --command python3 infra/monitoring/tests/test_sites_metrics_promql.py
    cd ../.. && bash -n infra/monitoring/tinfoil/tinfoil-usage-collector
    cd ../.. && infra/monitoring/tinfoil/tinfoil-usage-collector selftest
