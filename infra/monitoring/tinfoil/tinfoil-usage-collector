#!/usr/bin/env bash
# One read-only cycle: Tinfoil control plane + limiter health -> node_exporter.
# Credentials: TINFOIL_API_KEY in /etc/finite/monitoring/tinfoil.env.
# Utilization uses the newest source bucket, never the time we fetched it.
set -euo pipefail

CONTAINER="${FINITE_TINFOIL_CONTAINER:-finite-private}"
CLI="${FINITE_TINFOIL_CLI:-tinfoil}"
JQ="${FINITE_TINFOIL_JQ:-jq}"
STATE_DIR="${FINITE_TINFOIL_STATE_DIR:-/var/lib/finite-monitoring/tinfoil}"
TEXTFILE="${STATE_DIR}/textfile/tinfoil.prom"
HEALTH_URL="${FINITE_TINFOIL_HEALTH_URL:-https://finite-private.finite.containers.tinfoil.dev/health}"
COMPONENT_NAMES=(upstream usage_api)
USAGE_KEYS=(gpu_utilization_percent gpu_memory_utilization_percent cpu_utilization_percent host_memory_utilization_percent)

# Strict labels and a mandatory hard timeout also bound a stuck child process.
[[ "$CONTAINER" =~ ^[a-z0-9][a-z0-9-]*$ ]] || exit 64
run_bounded() { timeout -s TERM -k 2 20 "$@"; }
value_or_nan() { printf '%s' "${1:-NaN}"; }

parse_status() {
  "$JQ" -er --arg name "$CONTAINER" '
    if type == "object" and .name == $name and .debug == false
      and (.id | type == "string" and test("^[a-zA-Z0-9-]+$"))
      and (.status | type == "string" and length > 0)
      and (.gpus | type == "number" and . >= 0 and . == floor)
    then [.id, (if .status == "ready" then 1 else 0 end), .gpus] | @tsv
    else error("invalid container status") end'
}

# Live 2026-09-17 response to `container metrics <id> --time 1h`:
# interval=2m0s, data_points[].time (UTC), avg_* percentages. Select by time,
# reject duplicate newest buckets and malformed values rather than guessing.
parse_usage() {
  "$JQ" -ec --argjson now "$1" '
    def percent: type == "number" and . >= 0 and . <= 100;
    if .interval != "2m0s" or (.data_points | type != "array" or length == 0)
    then error("invalid usage envelope") else .data_points end
    | map(. + {timestamp: (.time | fromdateiso8601)})
    | sort_by(.timestamp) | .[-1] as $latest
    | if ([.[] | select(.timestamp == $latest.timestamp)] | length) != 1
      then error("ambiguous latest sample") else $latest end
    | if .timestamp <= 0 or .timestamp > $now
      or ([.avg_gpu_util, .avg_gpu_mem_util, .avg_cpu_util, .avg_cpu_mem_util]
          | all(percent) | not)
      then error("invalid usage sample")
      else {timestamp, values: [.avg_gpu_util, .avg_gpu_mem_util, .avg_cpu_util, .avg_cpu_mem_util]} end'
}

parse_health() {
  "$JQ" -er --argjson now "$1" '
    if .service != "finite-private-limiter" or .kind != "ready"
      or (.checkedAtUnixMs | type != "number")
      or .checkedAtUnixMs >= (($now + 1) * 1000) or .checkedAtUnixMs < (($now - 60) * 1000)
    then error("invalid health snapshot") else .components end
    | [.upstream, .usageApi]
    | if .[0].name != "upstream" or .[1].name != "usage_api"
      or (all(.ok | type == "boolean") | not)
      or (all(.latencyMs | type == "number" and . >= 0) | not)
      then error("invalid components") else . end
    | .[] | [(if .ok == true and (.status | type == "number" and . >= 200 and . < 300)
                    and (.name != "usage_api" or .authenticated == true)
              then 1 else 0 end), (.latencyMs / 1000)] | @tsv'
}

emit() {
  local metric="$1" labels="$2" value="$3"
  printf '%s{container="%s"%s} %s\n' "$metric" "$CONTAINER" "$labels" "$(value_or_nan "$value")"
}

main() {
  local now status id="" ready=0 gpus=0 status_ts="" source_ts="" usage sample
  local health http_code components tmp i old_ts=0 cache
  local values=("" "" "" "") component_ready=(0 0) component_duration=("" "")
  mkdir -p "${STATE_DIR}/textfile"
  tmp="$(mktemp -d "${STATE_DIR}/cycle.XXXXXX")"
  trap 'rm -rf "$tmp"' EXIT
  now="$(date +%s)"
  if status="$(run_bounded "$CLI" container get "$CONTAINER" --output json 2>/dev/null | parse_status)"; then
    IFS=$'\t' read -r id ready gpus <<<"$status"
    status_ts="$(date +%s)"
    # Cache is scoped to immutable container identity, never the display name.
    cache="${STATE_DIR}/usage-${id}.json"
    if [[ -f "$cache" ]] && old_ts="$("$JQ" -er --argjson now "$status_ts" '.timestamp | select(type == "number" and . > 0 and . <= $now)' "$cache" 2>/dev/null)"; then
      source_ts="$old_ts"
    else
      old_ts=0
    fi
    if usage="$(run_bounded "$CLI" container metrics "$id" --time 1h --output json 2>/dev/null)" \
      && sample="$(parse_usage "$(date +%s)" <<<"$usage")" \
      && "$JQ" -e --argjson previous "$old_ts" '.timestamp >= $previous' <<<"$sample" >/dev/null; then
      source_ts="$("$JQ" -r .timestamp <<<"$sample")"
      printf '%s\n' "$sample" > "$tmp/usage.json"
      mv "$tmp/usage.json" "$cache"
      # Expired source buckets remain visibly old but never draw fresh values.
      if (( $(date +%s) - source_ts < 600 )); then
        IFS=$'\t' read -r -a values <<<"$("$JQ" -r '.values | @tsv' <<<"$sample")"
      fi
    fi
  fi
  # 503 is a valid dependency report; transport errors, redirects and HTML are not.
  if http_code="$(curl -sS --max-time 10 -o "$tmp/health.json" -w '%{http_code}' -- "$HEALTH_URL" 2>/dev/null)" \
    && [[ "$http_code" == 200 || "$http_code" == 503 ]] \
    && components="$(parse_health "$(date +%s)" < "$tmp/health.json")"; then
    i=0
    while IFS=$'\t' read -r component_ready[i] component_duration[i]; do i=$((i + 1)); done <<<"$components"
  fi
  {
    emit finite_tinfoil_source_sample_timestamp_seconds '' "$source_ts"
    emit finite_tinfoil_status_sample_timestamp_seconds '' "$status_ts"
    emit finite_tinfoil_container_ready '' "$ready"
    emit finite_tinfoil_container_gpus '' "$gpus"
    for i in "${!COMPONENT_NAMES[@]}"; do
      emit finite_tinfoil_component_ready ",component=\"${COMPONENT_NAMES[$i]}\"" "${component_ready[$i]}"
      emit finite_tinfoil_component_probe_duration_seconds ",component=\"${COMPONENT_NAMES[$i]}\"" "${component_duration[$i]}"
    done
    for i in "${!USAGE_KEYS[@]}"; do
      emit "finite_tinfoil_${USAGE_KEYS[$i]}" ',aggregation="mean"' "${values[$i]}"
    done
  } > "$tmp/tinfoil.prom"
  chmod 0644 "$tmp/tinfoil.prom"
  mv "$tmp/tinfoil.prom" "$TEXTFILE"
  rm -rf "$tmp"
  trap - EXIT
}
main "$@"
