{
  "schema_version": 1,
  "provider": "grafana-cloud-synthetic-monitoring",
  "checks": [
    {
      "job": "finite.computer",
      "target": "https://finite.computer",
      "type": "http",
      "method": "GET",
      "probe": "NorthVirginia",
      "frequency_ms": 300000,
      "timeout_ms": 3000,
      "valid_status_codes": [
        200
      ],
      "follow_redirects": true,
      "ip_version": "V4",
      "compression": "none",
      "publish_full_metrics": false,
      "alerts_enabled": false
