#!/usr/bin/env python3
"""Render a private, exact-host content redirect map for the app-host Caddy edge."""
import argparse
import json
import re

LABEL = r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?"
RESERVED = {"api", "git", "auth", "www", "v2"}


def render(rows):
    if not isinstance(rows, list) or not rows or len(rows) > 10000:
        raise ValueError("expected 1–10000 reviewed redirects")
    hosts = set()
    rules = []
    for row in rows:
        source, target = row["from_host"], row["to_host"]
        if not isinstance(source, str) or not isinstance(target, str):
            raise ValueError("hosts must be strings")
        if not re.fullmatch(rf"({LABEL})\.(?:docs\.)?finite\.chat", source):
            raise ValueError("source must be a one-label finite.chat or docs.finite.chat content host")
        if not re.fullmatch(rf"({LABEL})\.finite\.site", target):
            raise ValueError("destination must be a Finite Site")
        if source.split('.')[0] in RESERVED or target.split('.')[0] in RESERVED or source in hosts:
            raise ValueError("reserved or duplicate host")
        hosts.add(source)
        rules.append((source, target))
    lines = ["# Private reviewed content mapping. Generated by infra/scripts/sites-redirects."]
    for i, (source, target) in enumerate(sorted(rules)):
        lines += [f"@siteRedirect{i} {{", f"  host {source}", "  method GET HEAD",
                  "  not path /_finite /_finite/*", "}", f"handle @siteRedirect{i} {{",
                  '  header Cache-Control "no-store"', '  header Referrer-Policy "no-referrer"', f"  redir https://{target}{{uri}} 302", "}"]
    return "\n".join(lines) + "\n"


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("mapping", help="private JSON array containing from_host/to_host")
    args = parser.parse_args()
    with open(args.mapping, encoding="utf-8") as stream:
        print(render(json.load(stream)), end="")
