set shell := ["../scripts/dev-shell", "-cu"]

# Lists finite-identity commands
default:
    just --list

# Compositional proof that one managed Agent Principal is bound once, consumed
# consistently by Chat/Sites/Brain, and never turns identity equivalence into a
# cross-product permission grant.
identity-conformance:
    cd .. && cargo test --locked -p finite-identity --test authority
    cd .. && cargo test --locked -p finite-saas-runner run_once_binds_canonical_agent_email_before_completion
    cd .. && cargo test --locked -p finitechat-hosted-device --test http new_agent_binding_stays_unchanged_across_duplicate_selection_and_restart
    cd .. && cargo test --locked -p finitesites-store sites_email_principal_supports_multiple_revocable_authorized_keys
    cd .. && cargo test --locked -p finitesites-store sites_identity_reconciliation_is_additive_and_idempotent
    cd .. && cargo test --locked -p finitesites-engine authorized_sites_key_can_manage_same_mailbox_owned_project_without_identity_link
    cd .. && cargo test --locked -p devfinity generated_yaml_contains_core_services
    cd .. && nix eval --raw .#nixosConfigurations.finite-lat-1.config.system.build.toplevel.drvPath

# Static contract: the Directory's public surface (public_router) is exactly
# the checked-in manifest, and the fsite CLI calls no retired route; the edge
# proxies, never filters. Live probe: finite-identity/scripts/identity-edge-contract-gate.py [--target URL].
identity-edge-contract:
    cd .. && python3 finite-identity/scripts/identity-edge-contract-gate.py --static
    cd .. && python3 -m unittest discover -s finite-identity/scripts/tests -p 'test_identity_edge_contract_gate.py'
