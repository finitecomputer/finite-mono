+def build_raw(paths, env, options):
+    """The raw-folder zip for the new Finite (FIN-463, "The raw-folder
+    export"): the agent's own folder in the `finite-computer` layout, minus
+    secrets, caches and the runtime, read there by `fragment home` and the
+    `import-agent-home` skill. raw_export.py, beside this file, decides what
+    goes in, exactly as the mover's host reader does; this function adds
+    what only the agent's own tools know: owned brains and sites, and the
+    small fact files. Every file is also put through this file's own
+    `secret_reason` and credential scan."""
+    import importlib.util
+
+    spec = importlib.util.spec_from_file_location(
+        "raw_export", Path(__file__).resolve().with_name("raw_export.py")
+    )
+    raw_export = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(raw_export)
+
+    root = Path(os.path.commonpath([paths.finite_home, paths.workspace]))
+    out_dir = Path(options.out) if options.out else paths.finite_home / "exports"
+    profile = agent_profile(paths, env)
+    stamp = datetime.datetime.now(datetime.UTC).strftime("%Y%m%d-%H%M")
+    target = out_dir / f"finite-raw-{slug(profile.get('name') or 'agent')}-{stamp}.zip"
+    brains, brain_error = list_brains()
+    owned = {b["brainId"]: b for b in brains if b.get("role") == "owner"}
+    chosen = [brain for brain in options.brain if brain in owned]
+    facts = {
+        "agent/profile.json": json.dumps(
+            {
+                "name": profile.get("name"),
+                "picture_url": None if profile["picture_is_default"] else profile["picture_url"],
+            }
+        ).encode()
+    }
+    for brain in chosen:
+        facts[f"workspace/finitebrain/{brain}.json"] = json.dumps(
+            {"name": owned[brain].get("name")}
+        ).encode()
+    scratch = Path(tempfile.mkdtemp(prefix="finite-raw-"))
+    problems = [f"brains: {brain_error}"] if brain_error else []
+    try:
+        projects, site_error = list_projects()
+        if site_error:
+            problems.append(f"sites: {site_error}")
+        sites = {}
+        for project in sorted(projects, key=lambda p: p["slug"]):
+            wanted = site_decision(project) == "yes" or (
+                site_decision(project) == "ask" and project["slug"] in options.site
+            )
+            if not wanted or project["slug"] in options.leave_out_site:
+                continue
+            source, why = clone_site(project, scratch)
+            if source is None:
+                problems.append(f"site {project['slug']}: could not get its files: {why}")
+                continue
+            name = safe_name(project["slug"])
+            sites[name] = source
+            facts[f"sites/{name}.json"] = json.dumps(site_meta(project)).encode()
+        summary = raw_export.export_raw(
+            root,
+            target,
+            chosen,
+            sites,
+            facts,
+            summary_id=env.get("FINITECHAT_HERMES_AGENT_NAME") or "raw",
+            extra_name_check=secret_reason,
+            extra_text_check=lambda text: secret_in_string(text.decode("utf-8", "ignore")),
+        )
+    finally:
+        shutil.rmtree(scratch, ignore_errors=True)
+    return {
+        "format": "finite-raw-export/1",
+        "zip": str(target),
+        "bytes": target.stat().st_size,
+        "files": summary["staged"]["files"],
+        "staged_bytes": summary["staged"]["bytes"],
+        "brains": chosen,
+        "sites": sorted(sites),
+        "left": summary["left"][:20],
+        "left_more": len(summary["left"]) - min(len(summary["left"]), 20),
+        "problems": problems,
+    }
+
