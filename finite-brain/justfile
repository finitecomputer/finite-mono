# Lists finite-brain commands
default:
    just --list

# Static contract: first-party Brain surfaces use only the Greenfield Brain vocabulary.
brain-language-check:
    cd .. && python3 scripts/check-brain-product-language.py

# Static contract: active first-party callers use /v1, not the legacy /_admin API.
brain-api-route-check:
    cd .. && python3 scripts/check-brain-api-routes.py

# Disposable Docker-backed real Hermes/managed-skill/fbrain/Brain acceptance matrix.
brain-product-matrix:
    cd .. && bash scripts/tests/test_devfinity_brain_readiness.sh
    cd .. && cargo test --locked -p finite-brain-server brain_update_notification_carries_the_authoritative_cursor
    cd .. && cargo test --locked -p finite-brain-cli supervisor_discovers_every_opened_brain_working_tree
    cd .. && FINITE_BRAIN_COLLABORATION_SMOKE_REPORT="$PWD/target/brain-product-matrix/organization-collaboration.json" cargo test --locked -p finite-brain-cli --test fbrain_process_acceptance built_fbrain_process_two_independent_homes_open_restricted_collaboration -- --nocapture
    cd .. && scripts/check-brain-collaboration-smoke-report.py "$PWD/target/brain-product-matrix/organization-collaboration.json"
