set shell := ["../scripts/dev-shell", "-cu"]

default: check

bootstrap:
    corepack yarn install --immutable

check: bootstrap
    corepack yarn typecheck
    corepack yarn app:build

test: bootstrap
    corepack yarn test

app-build: bootstrap
    corepack yarn app:build

app-plan: bootstrap
    corepack yarn twenty plan

app-apply: bootstrap
    corepack yarn twenty apply

[positional-arguments]
agent *args: bootstrap
    corepack yarn build:agent
    node dist/agent/cli.js "$@"
