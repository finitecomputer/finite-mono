rgence with Hermes Cloud's Fly primitive.", "source": "audit 06"}], ["stale-prune", {"name": "stale docs & scripts prune", "status": "done", "summary": "\u221217.8k lines of confusing docs/scripts that coupled readers to dead architecture.", "source": "#792 (merged 2026-08-31)"}], ["store-consolidation", {"name": "finish the chat store swap", "status": "proposed", "summary": "legacy_store.rs is authoritative; the normalized rewrite is unwired. Finish the swap, don't delete the legacy file.", "source": "audit 13"}], ["tanstack-query", {"name": "dashboard data layer", "status": "proposed", "summary": "24 hand-rolled fetch mechanisms \u2192 SSE\u2192QueryCache.", "source": "audit 05b; spike/tanstack-query @ f35fa1a2"}]], "kinds": ["edge", "convention", "data", "deploy", "duplication"], "layout": {"workos": [40, 120], "cloudflare": [40, 260], "resend": [40, 400], "ci": [40, 540], "dashboard": [330, 60], "core": [330, 210], "identity": [330, 360], "chat-server": [560, 60], "hosted-device": [560, 210], "brain": [560, 360], "sites": [560, 510], "edge": [330, 660], "runner": [790, 210], "agent-runtime": [790, 400], "fbrain-cli": [1020, 360], "fsite-cli": [1020, 510], "chat-clients": [1020, 210]}, "short": {"edge": "edge (Caddy)", "chat-clients": "chat clients", "agent-runtime": "agent runtime", "hosted-device": "hosted-device"}, "draw": [{"from": "hosted-device", "to": "chat-server", "status": "kept", "name": "hosted-device \u2194 chat-server pairing"}, {"from": "dashboard", "to": "hosted-device", "status": "kept", "name": "dashboard vouches users into hosted-device"}, {"from": "hosted-device", "to": "brain", "status": "current", "name": "hosted-device mints brain credentials for browsers"}, {"from": "hosted-device", "to": "sites", "status": "current", "name": "hosted-device mints sites viewer sessions"}, {"from": "runner", "to": "core", "status": "kept", "name": "runner \u2194 core launch leases"}, {"from": "runner", "to": "identity", "status": "current", "name": "runner registers agent names at the directory"}, {"from": "dashboard", "to": "core", "status": "kept", "name": "dashboard reads core"}, {"from": "core", "to": "workos", "status": "kept", "name": "core resolves WorkOS users"}, {"from": "dashboard", "to": "workos", "status": "kept", "name": "dashboard WorkOS sessions"}, {"from": "brain", "to": "resend", "status": "kept", "name": "brain + sites send notification mail"}, {"from": "sites", "to": "resend", "status": "kept", "name": "brain + sites send notification mail"}, {"from": "dashboard", "to": "sites", "status": "current", "name": "dashboard \u2194 sites shared viewer-session token"}, {"from": "sites", "to": "core", "status": "current", "name": "sites reconcile-identity operator CLI \u2192 core"}, {"from": "agent-runtime", "to": "chat-server", "status": "kept", "name": "agent sidecar \u2194 chat-server device sync"}, {"from": "fbrain-cli", "to": "identity", "status": "kept", "name": "public nostr.json resolution"}, {"from": "fsite-cli", "to": "identity", "status": "kept", "name": "public nostr.json resolution"}, {"from": "brain", "to": "identity", "status": "dead", "name": "brain \u2192 identity resolution"}, {"from": "brain", "to": "core", "status": "dead", "name": "brain \u2192 core roster + departure facts"}, {"from": "sites", "to": "identity", "status": "dead", "name": "sites \u2192 identity proofs + mail relay"}, {"from": "hosted-device", "to": "identity", "status": "dead", "name": "hosted-device \u2192 identity account-principal bindings"}]};
const ST = {current:["cur","current"],dying:["dy","dying"],proposed:["prop","proposed"],kept:["kept","kept by design"],dead:["dead","deleted"]};

// header
document.getElementById("lede").textContent =
  "Every place where changing X forces changing Y — runtime calls, shared protocols, data formats, " +
  "deploy couplings, duplicated implementations. " + DATA.meta.total + " contracts: " +
  DATA.counts.current + " current · " + DATA.counts.dying + " dying · " + DATA.counts.proposed +
  " proposed · " + DATA.counts.kept + " kept · " + DATA.counts.dead + " deleted. Source of truth: " +
  "docs/architecture/contracts.py in finite-mono @ " + DATA.meta.rev + ".";
document.getElementById("rules").innerHTML =
  DATA.principles.map(p => "<li><b>" + p[0] + "</b> — " + p[1] + "</li>").join("");
document.getElementById("foot").textContent =
  "Generated by scripts/render-architecture from docs/architecture/contracts.py (updated " +
  DATA.meta.updated + "). Edit the data module in the PR that changes a seam; a PR that adds a " +
  "current contract owes a story about which one it deletes.";

// scoreboard
const score = document.getElementById("score");
score.innerHTML = Object.keys(ST).filter(k=>k!=="proposed"||DATA.counts.proposed>0).map(k =>
  '<div class="s" data-st="' + k + '"><b style="color:var(--' + (k==="current"?"cur":k==="dying"?"dy":k==="proposed"?"prop":k) + ')">' +
  DATA.counts[k] + '</b><span>' + ST[k][1] + "</span></div>").join("");

// diagram
const NS = "http://www.w3.org/2000/svg";
const W = 1230, H = 780, NW = 168, NH = 52;
function el(t,a,c){const n=document.createElementNS(NS,t);for(const k in a)n.setAttribute(k,a[k]);(c||[]).forEach(x=>n.appendChild(x));return n}
const svg = el("svg",{viewBox:"0 0 "+W+" "+H,class:"dg",role:"img","aria-label":"component dependency diagram"});
const groups=[["EXTERNAL",20,60,240,640],["APP PLANE · LAT2 (LIVE)",300,20,460,720],["RUNTIME FLEET · LAT3/4",760,140,210,420],["CLIENTS + PLANNED HOSTS",990,140,210,460]];
groups.forEach(g=>{svg.appendChild(el("rect",{class:"hostbox",x:g[1],y:g[2],width:g[3],height:g[4]}));
svg.appendChild(el("text",{class:"hostl",x:g[1]+10,y:g[2]+18},[document.createTextNode(g[0])]))});
const center=id=>{const p=DATA.layout[id];return{x:p[0]+NW/2,y:p[1]+NH/2}};
let hover=null;
const edgeG=el("g",{}),nodeG=el("g",{});
svg.appendChild(edgeG);svg.appendChild(nodeG);
DATA.draw.forEach(d=>{
  const a=center(d.from),b=center(d.to);
  const dx=b.x-a.x,dy=b.y-a.y,L=Math.hypot(dx,dy),ux=dx/L,uy=dy/L;
  const cut=Math.min(Math.abs((NW/2)/(ux||1e-6)),Math.abs((NH/2)/(uy||1e-6)));
  const p={x:a.x+ux*cut,y:a.y+uy*cut},q={x:b.x-ux*(cut+4),y:b.y-uy*(cut+4)};
  const mx=(p.x+q.x)/2-uy*30,my=(p.y+q.y)/2+ux*30;
  const st=d.status==="current"?"cur":d.status==="dying"?"dy":d.status==="proposed"?"prop":d.status;
  const g=el("g",{class:"edge "+st,"data-parties":d.from+" "+d.to});
  g.appendChild(el("path",{d:"M"+p.x+","+p.y+" Q"+mx+","+my+" "+q.x+","+q.y}));
  const t=el("title",{});t.textContent=d.name+" ("+ST[d.status][1]+")";g.appendChild(t);
  edgeG.appendChild(g);
});
Object.entries(DATA.layout).forEach(([id,pos])=>{
  const comp=DATA.components[id]||{name:id,lane:"",host:""};
  const g=el("g",{class:"node","data-id":id});
  g.appendChild(el("rect",{x:pos[0],y:pos[1],width:NW,height:NH,rx:8}));
  g.appendChild(el("text",{class:"nlabel",x:pos[0]+10,y:pos[1]+21},[document.createTextNode((DATA.short||{})[id]||comp.name)]));
  g.appendChild(el("text",{class:"nsub",x:pos[0]+10,y:pos[1]+38},[document.createTextNode(comp.lane)]));
  const t=el("title",{});t.textContent=comp.name+" — "+comp.summary;g.appendChild(t);
  g.addEventListener("click",()=>{hover=hover===id?null:id;apply()});
  nodeG.appendChild(g);
});
document.getElementById("diagram").appendChild(svg);

// cards
const cards=document.getElementById("cards");
DATA.contracts.forEach(c=>{
  const div=document.createElement("div");
  div.className="card "+ST[c.status][0];div.dataset.id=c.id;div.dataset.kind=c.kind;
  div.dataset.st=c.status;div.dataset.parties=(c.parties||[]).join(" ");
  const parties=(c.parties||[]).map(p=>(DATA.components[p]||{name:p}).name).join(" ↔ ")||"—";
  div.innerHTML='<span class="st '+ST[c.status][0]+'">'+ST[c.status][1]+'</span>'+
    "<h3>"+c.name+"</h3><div class='meta'>"+c.id+" · "+c.kind+" · "+parties+
    (c.via?"<br>"+c.via:"")+(c.owner?" · owner "+c.owner:"")+
    (c.closed?" · closed "+c.closed:"")+"</div>"+
    "<p>"+c.summary+"</p>"+
    (c.death?"<p class='fate'>"+c.death+"</p>":"")+
    (c.campaigns&&c.campaigns.length?"<div class='meta'>campaigns: "+c.campaigns.join(", ")+"</div>":"");
  div.addEventListener("mouseenter",()=>{hover=c.parties&&c.parties[0]||null;apply()});
  div.addEventListener("mouseleave",()=>{hover=null;apply()});
  div.addEventListener("click",()=>{hover=(c.parties||[])[0]||null;apply()});
  cards.appendChild(div);
});

// campaigns
const camps=document.getElementById("camp-tbl");
camps.innerHTML="<tr><th>campaign</th><th>status</th><th>closes</th><th>point</th></tr>"+
  DATA.campaigns.map(([id,c])=>"<tr><td><b>"+c.name+"</b></td><td>"+c.status+"</td><td>"+
  (DATA.contracts.filter(x=>(x.campaigns||[]).includes(id)).map(x=>x.id).join(", ")||"—")+
  "</td><td>"+c.summary+" <i style='color:var(--muted)'>("+c.source+")</i></td></tr>").join("");

// filters — chips are built once; apply() only flips state (rebuilding them
// mid-click breaks pointer interactions)
let fKind=null,fSt=null;
const kindHost=document.getElementById("kind-chips"),stHost=document.getElementById("status-chips");
const kindBtns=[],stBtns=[];
function buildChips(){
  kindHost.innerHTML="";stHost.innerHTML="";
  [[null,"all kinds"]].concat(DATA.kinds.map(k=>[k,k])).forEach(([val,label])=>{
    const b=document.createElement("button");b.className="chip";b.textContent=label;
    b.onclick=()=>{fKind=fKind===val?null:val;apply()};kindHost.appendChild(b);kindBtns.push([val,b])});
  [[null,"all statuses"]].concat(Object.keys(ST).map(s=>[s,ST[s][1]])).forEach(([val,label])=>{
    const b=document.createElement("button");b.className="chip";b.textContent=label;
    b.onclick=()=>{fSt=fSt===val?null:val;apply()};stHost.appendChild(b);stBtns.push([val,b])});
}
function apply(){
  kindBtns.forEach(([v,b])=>b.setAttribute("aria-pressed",String(fKind===v)));
  stBtns.forEach(([v,b])=>b.setAttribute("aria-pressed",String(fSt===v)));
  document.querySelectorAll(".score .s").forEach(s=>s.style.outline=s.dataset.st===fSt?"2px solid var(--fg)":"none");
  let n=0;
  document.querySelectorAll(".card").forEach(c=>{
    const ok=(fKind===null||c.dataset.kind===fKind)&&(fSt===null||c.dataset.st===fSt)&&
      (hover===null||(c.dataset.parties+" "+c.dataset.id).includes(hover));
    c.classList.toggle("show",ok);if(ok)n++});
  document.getElementById("cards-h").textContent="Contracts ("+n+" shown)";
  svg.classList.toggle("f-edge",hover!==null);
  document.querySelectorAll(".dg .edge").forEach(e=>{
    e.classList.toggle("hi",hover!==null&&e.dataset.parties.includes(hover))});
  document.querySelectorAll(".dg .node").forEach(g=>{
    const id=g.dataset.id;
    const touched=DATA.draw.some(d=>(d.from===id||d.to===id)&&(!hover||d.from===hover||d.to===hover));
    g.style.opacity=hover===null?1:(touched?1:.45)});
}
document.querySelectorAll(".score .s").forEach(s=>s.addEventListener("click",()=>{fSt=fSt===s.dataset.st?null:s.dataset.st;apply()}));
buildChips();
apply();
</script>
</body>
