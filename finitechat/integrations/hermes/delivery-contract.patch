+class MessageDisposition(Enum):
+    """Admission into Hermes, distinct from completion or response delivery."""
+
+    STARTED = "started"  # completion hook owns settlement
+    CONSUMED = "consumed"  # control completed inline, no completion hook
+    REJECTED = "rejected"  # terminal refusal, not successful processing
+    DEFERRED = "deferred"  # caller still owns the unaccepted durable input
