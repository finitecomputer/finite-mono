+    async def wait_ready(self) -> None:
+        """Wait for another admission opportunity without cancelling its owner.
+
+        Readiness is not admission: the caller must submit the same input again.
+        Cancelling this wait never interrupts the turn holding the session.
+        """
+        if self.ready is None:
+            raise RuntimeError("Deferred admission has no readiness owner")
+        await asyncio.wait({self.ready})
