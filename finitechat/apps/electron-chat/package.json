{
  "name": "finitechat-electron",
  "version": "0.1.9",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "pnpm run dev:electron",
    "dev:electron": "FINITECHAT_DASHBOARD_URL=http://127.0.0.1:13002 FINITECHAT_DAEMON_BINARY=target/debug/finitechatd electron .",
    "dev:electron:fixture": "node scripts/run-electron-web-design-fixture.mjs",
    "test": "node --test electron/*.test.cjs",
    "check": "pnpm test",
    "electron": "FINITECHAT_DAEMON_BINARY=target/debug/finitechatd electron .",
    "play": "pnpm run electron",
    "package:mac": "node scripts/package-macos-alpha.mjs",
    "package:mac-alpha": "pnpm run package:mac"
  },
  "dependencies": {
    "electron": "42.2.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/osx-sign": "^2.4.0",
    "esbuild": "^0.28.1"
  }
}
